{
  "name": "wood",
  "scopeName": "source.wood",
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#import" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#type" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.wood"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(extern\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.wood" },
            "2": { "name": "storage.type.function.wood" },
            "3": { "name": "entity.name.function.wood" }
          }
        },
        {
          "match": "\\b(record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.wood" },
            "2": { "name": "entity.name.type.wood" }
          }
        }
      ]
    },
    "import": {
      "match": "^\\s*(from|import)\\b",
      "captures": { "1": { "name": "keyword.control.import.wood" } }
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.wood",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.wood" }]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.wood",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.wood" }]
        }
      ]
    },
    "number": {
      "patterns": [
        { "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b", "name": "constant.numeric.float.wood" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.wood" }
      ]
    },
    "keyword": {
      "patterns": [
        { "match": "\\b(if|elif|else|for|while|try|except|finally|raise|return|break|continue|pass|with|in|as|from|import)\\b", "name": "keyword.control.wood" },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.logical.wood" },
        { "match": "\\bmut\\b", "name": "storage.modifier.wood" }
      ]
    },
    "constant": {
      "match": "\\b(True|False|None|true|false)\\b",
      "name": "constant.language.wood"
    },
    "type": {
      "match": "\\b(int|float|str|bool|list|dict|array|json|void|error|tuple|py_object)\\b",
      "name": "support.type.wood"
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.wood" } }
    },
    "operator": {
      "match": "=>|->|==|!=|<=|>=|\\+=|-=|\\*=|//=|/=|%=|//|\\*\\*|[-+*/%<>=|&^~]",
      "name": "keyword.operator.wood"
    }
  }
}
