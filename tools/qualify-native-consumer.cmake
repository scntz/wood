cmake_minimum_required(VERSION 3.25)
# Run against an extracted package, using only its own sources/assets. LLVM and
# linker are explicit host prerequisites. No C/C++ compiler is invoked here.
foreach(required IN ITEMS PREFIX TEST_DIR LLVM_DIR LINKER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
set(wood "${PREFIX}/bin/wood")
if(WIN32)
    string(APPEND wood .exe)
endif()
set(data "${PREFIX}/share/wood")
file(STRINGS "${PREFIX}/MANIFEST.sha256" lines ENCODING UTF-8)
set(files 0)
foreach(line IN LISTS lines)
    string(LENGTH "${line}" size)
    if(size LESS 67)
        message(FATAL_ERROR "Malformed package manifest")
    endif()
    string(SUBSTRING "${line}" 0 64 expected)
    string(SUBSTRING "${line}" 64 2 separator)
    string(SUBSTRING "${line}" 66 -1 name)
    if(NOT expected MATCHES "^[0-9a-f]+$" OR NOT separator STREQUAL "  " OR
       IS_ABSOLUTE "${name}" OR name MATCHES "(^|/)\.\.(/|$)|[:\\\\]" OR IS_SYMLINK "${PREFIX}/${name}")
        message(FATAL_ERROR "Unsafe package manifest entry")
    endif()
    file(SHA256 "${PREFIX}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Installed package byte mismatch: ${name}")
    endif()
    math(EXPR files "${files}+1")
endforeach()
if(files LESS 1)
    message(FATAL_ERROR "Empty package manifest")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(checks 0)
function(invoke label)
    execute_process(COMMAND "${wood}" ${ARGN} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 1800 ENCODING UTF-8)
    file(WRITE "${TEST_DIR}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Native consumer ${label}: ${status}: ${out}${err}")
    endif()
    math(EXPR checks "${checks}+1")
    set(checks ${checks} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
endfunction()
set(native --backend llvm --llvm-dir "${LLVM_DIR}" --linker "${LINKER}")
invoke(metadata --language-info)
string(JSON backend GET "${out}" driver_default_backend)
string(JSON abi GET "${out}" driver_native_runtime_abi)
if(NOT backend STREQUAL llvm OR NOT abi EQUAL 4)
    message(FATAL_ERROR "Consumer package is not an ABI-4 native driver")
endif()
invoke(init init consumer-project)
invoke(project-run run consumer-project ${native})
invoke(project-build build consumer-project ${native} -o "${TEST_DIR}/consumer-app")
invoke(project-tests test "${data}/examples/archive" --locked ${native} --report=json)
string(JSON passed GET "${out}" passed)
if(passed LESS 1)
    message(FATAL_ERROR "Packaged project did not execute tests")
endif()
invoke(mesh run "${data}/examples/mesh_import.wd" ${native} -- "${data}/tests/fixtures/obj/tetrahedron.obj" "${TEST_DIR}/mesh.obj")
invoke(mesh-roundtrip run "${data}/examples/mesh_import.wd" ${native} -- "${TEST_DIR}/mesh.obj" "${TEST_DIR}/mesh-roundtrip.obj")
file(WRITE "${TEST_DIR}/stock.csv" "name,quantity\napple,7\npear,4\n")
invoke(sqlite run "${data}/examples/sqlite_inventory.wd" ${native} -- "${TEST_DIR}/inventory.db" "${TEST_DIR}/stock.csv")
if(NOT out STREQUAL "[{\"name\":\"apple\",\"quantity\":7},{\"name\":\"pear\",\"quantity\":4}]\n")
    message(FATAL_ERROR "Packaged inventory application returned wrong data: ${out}")
endif()
invoke(tls-tasks run "${data}/tests/native_spawn_io.wd" ${native} -- "${data}/tests/fixtures/tls")
if(NOT out STREQUAL "native spawn_io lifecycle passed\n")
    message(FATAL_ERROR "Packaged TLS/task application did not complete")
endif()
file(WRITE "${TEST_DIR}/consumer-validation.txt" "Verified ${files} package files and ${checks} native metadata/project/test/mesh/SQLite/TCP/TLS/task commands. Tools were explicitly configured on this host; no C/C++ compiler was requested. Clean-host status depends on the actual runner, not this script alone.\n")
message(STATUS "Verified native consumer: ${files} package files, ${checks} commands")
