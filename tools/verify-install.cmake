cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS PREFIX TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(NOT DEFINED PROFILE)
    set(PROFILE Core)
endif()
if(NOT PROFILE MATCHES "^(Core|SelfHosted)$")
    message(FATAL_ERROR "PROFILE must be Core or SelfHosted")
endif()
set(name wood)
set(doc "${PREFIX}/share/doc/wood")
if(PROFILE STREQUAL "SelfHosted")
    set(name wood-selfhost)
    set(doc "${PREFIX}/share/wood")
endif()
set(suffix "")
if(WIN32)
    set(suffix .exe)
endif()
set(wood "${PREFIX}/bin/${name}${suffix}")
if(NOT EXISTS "${wood}")
    message(FATAL_ERROR "Installed compiler missing: ${wood}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(work "${TEST_DIR}/run-${run}/project space")
file(MAKE_DIRECTORY "${work}")
set(cxx)
if(DEFINED CXX)
    list(APPEND cxx --cxx "${CXX}")
endif()
function(invoke)
    execute_process(COMMAND "${wood}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
        WORKING_DIRECTORY "${work}" TIMEOUT 240 ENCODING UTF-8)
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Installed ${PROFILE} ${ARGN} failed: ${status}: ${out}${err}")
    endif()
    set(result "${out}" PARENT_SCOPE)
endfunction()
invoke(--version)
if(NOT result STREQUAL "wood 0.4.0\n")
    message(FATAL_ERROR "Unexpected version")
endif()
invoke(--language-info)
string(JSON license GET "${result}" license)
if(NOT license STREQUAL "MIT OR Apache-2.0")
    message(FATAL_ERROR "Stale release license metadata")
endif()
foreach(example IN ITEMS project catalog archive)
    invoke(check "${doc}/examples/${example}" --locked --cxx deliberately-missing)
endforeach()
invoke(init "${work}/app")
invoke(lock "${work}/app")
invoke(check "${work}/app" --locked --cxx deliberately-missing)
invoke(test "${work}/app" --locked --report=json ${cxx})
string(JSON failed GET "${result}" failed)
if(NOT failed EQUAL 0)
    message(FATAL_ERROR "Generated project tests failed")
endif()
invoke(build "${work}/app" --locked -o "${work}/hello${suffix}" ${cxx})
execute_process(COMMAND "${work}/hello${suffix}" "release user" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "hello, release user\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Generated standalone application differs: ${status}: ${out}${err}")
endif()
invoke(build "${doc}/examples/mesh_import.wd" -o "${work}/mesh-import${suffix}" ${cxx})
set(input "${work}/tetrahedron.obj")
file(WRITE "${input}" "v 0 0 0\nv 1 0 0\nv 0 1 0\nv 0 0 1\nf 1 3 2\nf 1 2 4\nf 1 4 3\nf 2 3 4\n")
execute_process(COMMAND "${work}/mesh-import${suffix}" "${input}" "${work}/transformed.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT EXISTS "${work}/transformed.obj" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Installed native OBJ application failed: ${status}: ${out}${err}")
endif()
# Use the original independently specified Wood verifier from the source tree.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
invoke("${root}/tests/mesh_transform_verify.wd" ${cxx} -- "${input}" "${work}/transformed.obj")
file(WRITE "${work}/preserved.obj" "keep-existing-output\n")
file(WRITE "${work}/malformed.obj" "v 0 0 0\nf 1 2 3\n")
execute_process(COMMAND "${work}/mesh-import${suffix}" "${work}/malformed.obj" "${work}/preserved.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
file(READ "${work}/preserved.obj" preserved)
if(NOT status STREQUAL "70" OR NOT preserved STREQUAL "keep-existing-output\n")
    message(FATAL_ERROR "Invalid OBJ did not fail safely")
endif()
file(WRITE "${work}/validation.txt" "${PROFILE}: extracted license metadata, init/check/locked tests, standalone native project, OBJ transform/independent verification and malformed-input output preservation passed.\n")
message(STATUS "Installed release workflow passed: ${work}")
