cmake_minimum_required(VERSION 3.25)
# Export a reviewed immutable Git tree as an ordinary local Wood dependency.
# No checkout, filters, hooks, downloads, archive extraction or Wood code runs.
foreach(required IN ITEMS REPOSITORY REVISION DESTINATION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply REPOSITORY, full REVISION and absent DESTINATION")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
string(LENGTH "${REVISION}" revision_length)
if(NOT REVISION MATCHES "^[0-9a-f]+$" OR NOT revision_length MATCHES "^(40|64)$")
    message(FATAL_ERROR "REVISION must be a full lowercase Git commit ID, not a branch or tag")
endif()
if(NOT DEFINED DIRECTORY)
    set(DIRECTORY "")
endif()
function(safe_name value)
    string(LENGTH "${value}" length)
    if(length GREATER 240 OR NOT value MATCHES "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$")
        message(FATAL_ERROR "Unsupported source path: ${value}; use portable ASCII components")
    endif()
    string(REPLACE "/" ";" components "${value}")
    foreach(component IN LISTS components)
        string(TOUPPER "${component}" upper)
        if(component STREQUAL "." OR component STREQUAL ".." OR upper STREQUAL ".GIT" OR
           component MATCHES "[.]$" OR upper MATCHES "^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])([.]|$)")
            message(FATAL_ERROR "Unsafe source path component: ${component}")
        endif()
    endforeach()
endfunction()
if(NOT DIRECTORY STREQUAL "")
    safe_name("${DIRECTORY}")
endif()
function(read_git output)
    execute_process(COMMAND "${git}" --no-lazy-fetch --no-replace-objects
        --no-optional-locks -C "${REPOSITORY}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error
        TIMEOUT 60 ENCODING UTF-8)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot read requested Git source: ${error}")
    endif()
    # Remove the protocol's last newline only. Trimming arbitrary whitespace
    # could turn a forbidden trailing-space filename into a different safe name.
    string(REGEX REPLACE "\r?\n$" "" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
read_git(kind cat-file -t "${REVISION}")
if(NOT kind STREQUAL "commit")
    message(FATAL_ERROR "REVISION must identify a commit")
endif()
if(DIRECTORY STREQUAL "")
    read_git(tree rev-parse "${REVISION}^{tree}")
else()
    read_git(tree rev-parse "${REVISION}:${DIRECTORY}")
endif()
read_git(kind cat-file -t "${tree}")
if(NOT kind STREQUAL "tree")
    message(FATAL_ERROR "DIRECTORY must identify a tree in the requested commit")
endif()
# Git quotes nonportable names. Reject those, symlinks and submodules before
# creating any staging files. Blobs are copied directly, never checked out.
read_git(inventory -c core.quotePath=true ls-tree -r -l "${tree}")
string(REPLACE "\n" ";" entries "${inventory}")
set(names "")
set(total 0)
set(count 0)
foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^(100644|100755) blob ([0-9a-f]+) +([0-9]+)\t(.+)$")
        message(FATAL_ERROR "Only regular Git files are supported; symlinks/submodules are rejected: ${entry}")
    endif()
    set(size "${CMAKE_MATCH_3}")
    set(name "${CMAKE_MATCH_4}")
    safe_name("${name}")
    string(TOLOWER "${name}" receipt_name)
    if(receipt_name MATCHES "^wood-source[.]json(/|$)")
        message(FATAL_ERROR "wood-source.json is reserved for the export integrity receipt")
    endif()
    # Also compare intermediate directories, including differently cased ones.
    string(REPLACE "/" ";" components "${name}")
    set(prefix "")
    foreach(component IN LISTS components)
        if(prefix STREQUAL "")
            set(prefix "${component}")
        else()
            string(APPEND prefix "/${component}")
        endif()
        string(TOLOWER "${prefix}" lower)
        string(SHA256 key "${lower}")
        if(DEFINED spelling_${key} AND NOT spelling_${key} STREQUAL prefix)
            message(FATAL_ERROR "Case-colliding source paths: ${spelling_${key}}, ${prefix}")
        endif()
        set(spelling_${key} "${prefix}")
    endforeach()
    list(APPEND names "${name}")
    math(EXPR total "${total} + ${size}")
    math(EXPR count "${count} + 1")
    if(count GREATER 4096 OR total GREATER 134217728)
        message(FATAL_ERROR "Source export exceeds 4096 files or 128 MiB")
    endif()
endforeach()
if(NOT "wood.json" IN_LIST names)
    message(FATAL_ERROR "Package tree must contain wood.json at its root")
endif()
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE destination)
if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Destination already exists; refusing to overwrite it")
endif()
cmake_path(GET destination PARENT_PATH parent)
if(NOT IS_DIRECTORY "${parent}")
    message(FATAL_ERROR "Destination parent must already exist")
endif()
set(ancestor "${parent}")
while(TRUE)
    if(IS_SYMLINK "${ancestor}")
        message(FATAL_ERROR "Destination ancestors must not be filesystem links")
    endif()
    cmake_path(GET ancestor PARENT_PATH next)
    if(next STREQUAL ancestor)
        break()
    endif()
    set(ancestor "${next}")
endwhile()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(stage "${destination}.wood-stage-${id}")
if(EXISTS "${stage}" OR IS_SYMLINK "${stage}")
    message(FATAL_ERROR "Source staging collision; choose a different destination")
endif()
file(MAKE_DIRECTORY "${stage}")
set(receipt "{\n  \"format\":1,\n  \"commit\":\"${REVISION}\",\n  \"tree\":\"${tree}\",\n  \"directory\":\"${DIRECTORY}\",\n  \"files\":{")
set(separator "")
foreach(entry IN LISTS entries)
    string(REGEX MATCH "^(100644|100755) blob ([0-9a-f]+) +([0-9]+)\t(.+)$" unused "${entry}")
    set(blob "${CMAKE_MATCH_2}")
    set(size "${CMAKE_MATCH_3}")
    set(name "${CMAKE_MATCH_4}")
    cmake_path(GET name PARENT_PATH directory)
    file(MAKE_DIRECTORY "${stage}/${directory}")
    execute_process(COMMAND "${git}" --no-lazy-fetch --no-replace-objects
        --no-optional-locks -C "${REPOSITORY}" cat-file blob "${blob}"
        RESULT_VARIABLE status OUTPUT_FILE "${stage}/${name}" ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot copy Git blob; partial stage retained: ${error}")
    endif()
    file(SIZE "${stage}/${name}" copied)
    if(NOT copied EQUAL size)
        message(FATAL_ERROR "Git source size changed; partial stage retained")
    endif()
    file(SHA256 "${stage}/${name}" sha)
    string(APPEND receipt "${separator}\n    \"${name}\":{\"size\":${size},\"sha256\":\"${sha}\"}")
    set(separator ",")
endforeach()
string(APPEND receipt "\n  }\n}\n")
file(CONFIGURE OUTPUT "${stage}/wood-source.json" CONTENT "${receipt}" @ONLY NEWLINE_STYLE UNIX)
# CMake 3.31's no-replace directory rename returns EPERM in the qualified Linux
# profile. GNU mv supplies directory-safe no-clobber without an unsafe rename
# fallback. A refused no-clobber move may return 0, so also require stage removal.
if(CMAKE_HOST_WIN32)
    file(RENAME "${stage}" "${destination}" RESULT published NO_REPLACE)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    find_program(mv NAMES mv REQUIRED)
    execute_process(COMMAND "${mv}" --no-clobber --no-target-directory -- "${stage}" "${destination}"
        RESULT_VARIABLE published ERROR_VARIABLE error TIMEOUT 60)
else()
    message(FATAL_ERROR "Source publication is qualified only on Windows/Linux; stage retained")
endif()
if(NOT published STREQUAL "0" OR EXISTS "${stage}")
    message(FATAL_ERROR "Cannot publish without overwriting; stage retained: ${published}")
endif()
message(STATUS "Vendored ${count} regular files (${total} bytes) from ${REVISION}; review wood-source.json, then wood check/lock/test")
