cmake_minimum_required(VERSION 3.25)
# Package only a separately installed, qualified component. Never touch the
# production install or silently overwrite an earlier release artifact.
foreach(required IN ITEMS PREFIX OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<absolute path>")
    endif()
endforeach()
get_filename_component(PREFIX "${PREFIX}" ABSOLUTE)
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}" OR EXISTS "${OUTPUT}.sha256" OR IS_SYMLINK "${OUTPUT}.sha256")
    message(FATAL_ERROR "Package/checksum already exists; choose a new output name")
endif()
if(NOT DEFINED PROFILE)
    set(PROFILE SelfHosted)
endif()
if(NOT PROFILE MATCHES "^(Core|SelfHosted|Native)$")
    message(FATAL_ERROR "PROFILE must be Core, SelfHosted or Native")
endif()
set(executable "bin/wood-selfhost")
set(library "lib/libwood_driver_host.a")
if(WIN32)
    string(APPEND executable ".exe")
    set(library "lib/wood_driver_host.lib")
endif()
set(required_files "${executable}" "${library}"
        share/wood/bootstrap/src/driver_main.wd share/wood/bootstrap/driver-contract.json
        share/wood/bootstrap/project-trust-contract.json
        share/wood/AGENTS.md share/wood/LICENSE share/wood/LICENSE-MIT
        share/wood/LICENSE-APACHE share/wood/THIRD_PARTY_NOTICES.md)
if(PROFILE STREQUAL "Core")
    set(executable bin/wood)
    if(WIN32)
        string(APPEND executable ".exe")
    endif()
    set(required_files "${executable}" share/doc/wood/examples/hello.wd
        share/doc/wood/LICENSE share/doc/wood/LICENSE-MIT
        share/doc/wood/LICENSE-APACHE share/doc/wood/THIRD_PARTY_NOTICES.md)
elseif(PROFILE STREQUAL "Native")
    set(executable bin/wood)
    if(WIN32)
        string(APPEND executable ".exe")
    endif()
    set(required_files "${executable}" share/wood/native.json share/wood/native/managed.o
        share/wood/native/core.ll share/wood/bootstrap/src/driver_main.wd
        share/wood/stdlib.json share/wood/LICENSE share/wood/LICENSE-MIT
        share/wood/LICENSE-APACHE share/wood/THIRD_PARTY_NOTICES.md)
endif()
foreach(required IN LISTS required_files)
    if(NOT EXISTS "${PREFIX}/${required}")
        message(FATAL_ERROR "Incomplete ${PROFILE} installation: ${required}")
    endif()
endforeach()
if(PROFILE STREQUAL "Native")
    file(READ "${PREFIX}/share/wood/native.json" native_config)
    string(JSON native_format GET "${native_config}" format)
    string(JSON native_abi GET "${native_config}" runtime_abi)
    string(JSON native_target GET "${native_config}" target)
    if(NOT native_format EQUAL 1 OR NOT native_abi EQUAL 4 OR NOT native_target MATCHES "^(linux|windows)-x86_64$")
        message(FATAL_ERROR "Native package input has an unsupported format, ABI or target")
    endif()
    if(NOT EXISTS "${PREFIX}/share/wood/native/${native_target}.ll")
        message(FATAL_ERROR "Native package lacks its target LLVM port")
    endif()
endif()
if(PROFILE STREQUAL "SelfHosted" AND (EXISTS "${PREFIX}/bin/wood" OR EXISTS "${PREFIX}/bin/wood.exe"))
    message(FATAL_ERROR "Refusing to package a mixed production/candidate installation")
endif()
if(EXISTS "${PREFIX}/MANIFEST.sha256")
    message(FATAL_ERROR "Package input already contains the reserved MANIFEST.sha256")
endif()
file(REAL_PATH "${PREFIX}" prefix_real)
get_filename_component(output_parent "${OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${output_parent}")
    message(FATAL_ERROR "Archive output parent must exist")
endif()
file(REAL_PATH "${output_parent}" output_parent_real)
get_filename_component(output_name "${OUTPUT}" NAME)
set(output_real "${output_parent_real}/${output_name}")
if(WIN32)
    string(TOLOWER "${prefix_real}" prefix_compare)
    string(TOLOWER "${output_real}" output_compare)
else()
    set(prefix_compare "${prefix_real}")
    set(output_compare "${output_real}")
endif()
cmake_path(IS_PREFIX prefix_compare "${output_compare}" NORMALIZE inside_prefix)
if(inside_prefix)
    message(FATAL_ERROR "Archive must be outside its installed input tree")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "${OUTPUT}.stages/${run_id}")
set(top wood-selfhost)
if(PROFILE STREQUAL "Core")
    set(top wood)
elseif(PROFILE STREQUAL "Native")
    set(top wood-native)
endif()
set(tree "${work}/input/${top}")
file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${PREFIX}" "${PREFIX}/*")
foreach(relative IN LISTS entries)
    file(REAL_PATH "${PREFIX}/${relative}" source_real)
    cmake_path(IS_PREFIX prefix_real "${source_real}" NORMALIZE contained)
    if(IS_SYMLINK "${PREFIX}/${relative}" OR NOT contained)
        message(FATAL_ERROR "Package input must not contain links or escaping entries: ${relative}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${tree}")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${PREFIX}" "${PREFIX}/*")
list(SORT files)
set(manifest "")
foreach(relative IN LISTS files)
    set(source "${PREFIX}/${relative}")
    file(REAL_PATH "${source}" source_real)
    cmake_path(IS_PREFIX prefix_real "${source_real}" NORMALIZE contained)
    if(IS_SYMLINK "${source}" OR NOT contained)
        message(FATAL_ERROR "Package input must contain regular, contained files: ${relative}")
    endif()
    file(SHA256 "${source}" sha)
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${tree}/${parent}")
    file(COPY "${source}" DESTINATION "${tree}/${parent}")
    file(SHA256 "${tree}/${relative}" copied)
    if(NOT copied STREQUAL sha)
        message(FATAL_ERROR "Package input changed while copying: ${relative}")
    endif()
    if(PROFILE STREQUAL "Native" AND PORTABLE_NATIVE_TOOLS AND relative STREQUAL "share/wood/native.json")
        # Normalize only the staged configuration, after verifying the input
        # copy. Never edit the installed prefix or retain build-machine paths.
        file(READ "${tree}/${relative}" portable)
        string(JSON portable SET "${portable}" llvm_dir "\"\"")
        string(JSON portable SET "${portable}" llvm_wsl "\"\"")
        set(default_linker ld)
        if(native_target STREQUAL "windows-x86_64")
            set(default_linker lld-link.exe)
        endif()
        string(JSON portable SET "${portable}" linker "\"${default_linker}\"")
        file(WRITE "${tree}/${relative}" "${portable}\n")
        file(SHA256 "${tree}/${relative}" sha)
    endif()
    string(APPEND manifest "${sha}  ${relative}\n")
endforeach()
file(WRITE "${tree}/MANIFEST.sha256" "${manifest}")
set(pending "${work}/candidate.zip")
set(archive_flags cf)
set(archive_format zip)
if(PROFILE STREQUAL "Native")
    # libarchive ZIP records staging ctime/atime in local extra fields even
    # when --mtime is fixed. GNU tar avoids those nondeterministic fields.
    set(pending "${work}/candidate.tar.gz")
    set(archive_flags cfz)
    set(archive_format gnutar)
endif()
set(archive_time)
if(DEFINED SOURCE_DATE_EPOCH)
    if(NOT "${SOURCE_DATE_EPOCH}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "SOURCE_DATE_EPOCH must be nonnegative Unix seconds")
    endif()
    set(ENV{SOURCE_DATE_EPOCH} "${SOURCE_DATE_EPOCH}")
    string(TIMESTAMP fixed_time "%Y-%m-%d %H:%M:%S UTC" UTC)
    list(APPEND archive_time "--mtime=${fixed_time}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${archive_flags} "${pending}" --format=${archive_format} ${archive_time} "${top}"
    WORKING_DIRECTORY "${work}/input" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Archive creation failed: ${status}: ${err}")
endif()
file(ARCHIVE_EXTRACT INPUT "${pending}" DESTINATION "${work}/extracted")
set(extracted "${work}/extracted/${top}")
foreach(relative IN LISTS files)
    file(SHA256 "${tree}/${relative}" expected)
    file(SHA256 "${extracted}/${relative}" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "Extracted package file differs: ${relative}")
    endif()
endforeach()
file(READ "${extracted}/MANIFEST.sha256" actual_manifest)
if(NOT actual_manifest STREQUAL manifest)
    message(FATAL_ERROR "Extracted manifest differs")
endif()
execute_process(COMMAND "${extracted}/${executable}" --version
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 30)
# A native distribution reports its own version and the language it implements.
if(PROFILE STREQUAL "Native")
    set(version_pattern "^wood [0-9][^ ]* \\(language 0[.]4[.]0, native runtime ABI 4\\)\n$|^wood 0[.]4[.]0\n$")
else()
    set(version_pattern "^wood 0[.]4[.]0\n$")
endif()
if(NOT status STREQUAL "0" OR NOT out MATCHES "${version_pattern}" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Extracted executable failed: ${status}: ${out}${err}")
endif()
if(PROFILE STREQUAL "Native")
    execute_process(COMMAND "${extracted}/${executable}" --language-info
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 30)
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Extracted native metadata failed: ${status}: ${out}${err}")
    endif()
    string(JSON native_backend GET "${out}" driver_default_backend)
    string(JSON runtime_abi GET "${out}" driver_native_runtime_abi)
    if(NOT native_backend STREQUAL llvm OR NOT runtime_abi EQUAL 4)
        message(FATAL_ERROR "Extracted compiler is not an ABI-4 LLVM-native driver")
    endif()
endif()
set(check_input "${extracted}/share/wood/bootstrap/src/driver_main.wd")
if(PROFILE STREQUAL "Core")
    set(check_input "${extracted}/share/doc/wood/examples/hello.wd")
endif()
execute_process(COMMAND "${extracted}/${executable}" check
    "${check_input}" --diagnostics=json --cxx deliberately-missing
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 180)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Extracted compiler/source/assets check failed: ${status}: ${out}${err}")
endif()
file(SHA256 "${pending}" checksum)
file(RENAME "${pending}" "${OUTPUT}" NO_REPLACE RESULT status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot publish verified package: ${status}")
endif()
get_filename_component(name "${OUTPUT}" NAME)
file(WRITE "${OUTPUT}.sha256" "${checksum}  ${name}\n")
list(LENGTH files count)
message(STATUS "Verified ${count} extracted files, manifest, executable and compiler source; package ${OUTPUT}; SHA-256 ${checksum}")
