cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS REFERENCE OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Asset output must not exist: ${OUTPUT}")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
function(quote result value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(stdlib_output "${OUTPUT}")
set(OUTPUT "${stdlib_output}/stdlib.json")
include("${CMAKE_CURRENT_LIST_DIR}/bundle-stdlib.cmake")
set(OUTPUT "${stdlib_output}")
execute_process(COMMAND "${REFERENCE}" --language-info RESULT_VARIABLE status OUTPUT_VARIABLE info ERROR_VARIABLE err TIMEOUT 30 ENCODING UTF-8)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot export language metadata: ${status}: ${err}")
endif()
string(JSON version GET "${info}" version)
# Optional native-only profiles are source-owned metadata, not additions to the
# frozen C++ reference registry exported by REFERENCE.
file(READ "${root}/docs/language.json" source_info)
string(JSON optional_profiles GET "${source_info}" optional_standard_modules)
string(JSON info SET "${info}" optional_standard_modules "${optional_profiles}")
file(WRITE "${OUTPUT}/language.json" "${info}")
set(OUTPUT "${stdlib_output}/explanations.json")
include("${CMAKE_CURRENT_LIST_DIR}/bundle-explanations.cmake")
set(OUTPUT "${stdlib_output}")
message(STATUS "Exported standard sources, ${version} metadata and checked explanation catalog; no C++ compilation")
