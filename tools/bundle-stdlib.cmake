# Writes stdlib.json, the embedded standard library, from this checkout's stdlib directory.
# usage: cmake -DOUTPUT=stdlib.json -P tools/bundle-stdlib.cmake
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Supply OUTPUT")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
function(stdlib_quote result value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(bundle "{}")
file(GLOB modules "${root}/stdlib/*.wd")
list(SORT modules)
foreach(module IN LISTS modules)
    get_filename_component(name "${module}" NAME_WE)
    file(READ "${module}" source)
    stdlib_quote(value "${source}")
    string(JSON bundle SET "${bundle}" "std.${name}" "${value}")
endforeach()
file(WRITE "${OUTPUT}" "${bundle}\n")
