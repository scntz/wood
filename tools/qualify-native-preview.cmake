cmake_minimum_required(VERSION 3.25)
# Consumes an extracted archive, never compiler/application sources from a checkout.
# The caller supplies the isolation boundary, tool PATH and optional libraries.
foreach(required IN ITEMS PREFIX TEST_DIR LLVM_DIR LINKER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(EXISTS "${TEST_DIR}")
    message(FATAL_ERROR "Use a new test directory; preserve previous evidence")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(data "${PREFIX}/share/wood")
set(wood "${PREFIX}/bin/wood")
set(suffix "")
if(WIN32)
    set(suffix .exe)
    string(APPEND wood .exe)
endif()
set(checks 0)
function(run_checked label)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT 7200 ENCODING UTF-8)
    file(WRITE "${TEST_DIR}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "${label}: ${status}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
endfunction()
run_checked(consumer "${CMAKE_COMMAND}" -DPREFIX=${PREFIX}
    -DTEST_DIR=${TEST_DIR}/applications -DLLVM_DIR=${LLVM_DIR} -DLINKER=${LINKER}
    -P "${data}/tools/qualify-native-consumer.cmake")
run_checked(cli "${CMAKE_COMMAND}" -DWOOD=${wood} -DSOURCE_DIR=${data}
    -DTEST_DIR=${TEST_DIR}/cli -P "${data}/tests/native/cli.cmake")
set(native --backend llvm --llvm-dir "${LLVM_DIR}" --linker "${LINKER}")
set(fixtures "${data}/tests/fixtures/tls")
foreach(level IN ITEMS 0 2)
    foreach(corpus IN ITEMS native_runtime_values native_self_update native_arrays native_callables
            native_iteration native_sqlite native_tls native_tls_ipv6 native_spawn_io)
        set(arguments)
        if(corpus STREQUAL native_tls OR corpus STREQUAL native_spawn_io)
            set(arguments -- "${fixtures}")
        elseif(corpus STREQUAL native_tls_ipv6)
            set(arguments -- "${fixtures}/ip.pem" "${fixtures}/server-key.pem")
        endif()
        run_checked(${corpus}-O${level} "${CMAKE_COMMAND}" -E env
            "SSL_CERT_FILE=${fixtures}/ca.pem" "SSL_CERT_DIR=${TEST_DIR}/empty-roots"
            WOOD_REQUIRE_TLS_TESTS=1 "${wood}" run "${data}/tests/${corpus}.wd"
            -O${level} ${native} ${arguments})
    endforeach()
endforeach()
# Cold processes must reject an explicitly invalid dependency directory, even
# when the host provides a working system library. No trust or loader bypass.
foreach(service IN ITEMS tls sqlite)
    set(code R4021)
    set(variable WOOD_OPENSSL_DIR)
    if(service STREQUAL sqlite)
        set(code R4020)
        set(variable WOOD_SQLITE_DIR)
    endif()
    set(probe "${TEST_DIR}/${service}-missing.wd")
    file(WRITE "${probe}" "import std.${service} as service\ntry:\n    service.version()\n    assert(false)\nexcept err:\n    assert(err.code == '${code}')\nprint('dependency rejected')\n")
    run_checked(${service}-missing "${CMAKE_COMMAND}" -E env
        "${variable}=${TEST_DIR}/missing-library" "${wood}" run "${probe}" ${native})
    file(READ "${TEST_DIR}/${service}-missing.log" result)
    if(NOT result STREQUAL "dependency rejected\n")
        message(FATAL_ERROR "${service} did not reject an invalid library override")
    endif()
endforeach()
if(NOT WIN32)
    # Real failed output, with no C/C++ test launcher or compiler dependency.
    execute_process(COMMAND /usr/bin/test -c /dev/full RESULT_VARIABLE full_device)
    if(NOT full_device STREQUAL "0")
        message(FATAL_ERROR "Linux output qualification requires the real /dev/full character device; provision it in the isolated environment")
    endif()
    run_checked(output-build "${wood}" build "${data}/tests/native_output.wd"
        ${native} -o "${TEST_DIR}/checked-output")
    foreach(channel IN ITEMS stdout stderr)
        set(marker "${TEST_DIR}/${channel}-full.marker")
        set(redirection OUTPUT_FILE /dev/full ERROR_VARIABLE err)
        if(channel STREQUAL stderr)
            set(redirection ERROR_FILE /dev/full OUTPUT_VARIABLE err)
        endif()
        execute_process(COMMAND "${TEST_DIR}/checked-output" "${marker}" ${channel}-full
            ${redirection} RESULT_VARIABLE status TIMEOUT 120 ENCODING UTF-8)
        if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
            message(FATAL_ERROR "${channel} full-output lifecycle failed: ${status}: ${err}")
        endif()
        file(READ "${marker}" result)
        if(NOT result STREQUAL "caught and cleaned\n")
            message(FATAL_ERROR "${channel} failed output did not unwind resources")
        endif()
        math(EXPR checks "${checks}+1")
    endforeach()
endif()
if(BOOTSTRAP)
    run_checked(bootstrap "${CMAKE_COMMAND}" -DWOOD=${wood}
        -DTEST_DIR=${TEST_DIR}/bootstrap -P "${data}/tests/native/cli-bootstrap.cmake")
endif()
file(WRITE "${TEST_DIR}/preview-validation.txt"
    "${checks} outer qualification commands passed; consumer and CLI logs record their nested commands. BOOTSTRAP=${BOOTSTRAP}. Isolation is supplied by the caller, not established by this script.\n")
message(STATUS "Native preview qualification passed: ${checks} outer commands; ${TEST_DIR}")
