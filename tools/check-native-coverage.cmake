cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SOURCE_DIR)
    get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
# This is a catalog consistency check, not an execution/parity claim. Concrete
# semantics remain covered by differential, negative and sanitizer corpora.
file(READ "${SOURCE_DIR}/include/wood/builtins.hpp" catalog)
file(READ "${SOURCE_DIR}/bootstrap/src/emit_llvm.wd" emitter)
file(READ "${SOURCE_DIR}/runtime/native/sqlite.inc" sqlite)
file(READ "${SOURCE_DIR}/bootstrap/native-backend-contract.json" contract)
string(REGEX MATCHALL "\{\"[a-z_]+\"," entries "${catalog}")
set(count 0)
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "^\{\"([a-z_]+)\",$" "\\1" name "${entry}")
    if(name MATCHES "^(db_|stmt_)")
        string(FIND "${emitter}" "starts_with(name,\"${CMAKE_MATCH_1}\")" dispatch)
        string(FIND "${sqlite}" "wd_m_${name}(" primitive)
        if(dispatch LESS 0 OR primitive LESS 0)
            message(FATAL_ERROR "Missing native SQLite dispatch/primitive for ${name}")
        endif()
    else()
        string(FIND "${emitter}" "\"${name}\"" lowering)
        if(lowering LESS 0)
            message(FATAL_ERROR "No explicit native builtin classification for ${name}")
        endif()
    endif()
    math(EXPR count "${count}+1")
endforeach()
if(count LESS 1)
    message(FATAL_ERROR "Empty builtin catalog")
endif()
string(JSON unsupported LENGTH "${contract}" unsupported_service_builtins)
if(NOT unsupported EQUAL 0)
    message(FATAL_ERROR "Core service gaps remain in the machine-readable contract")
endif()
message(STATUS "Classified ${count} reference builtins; no declared missing native service builtin. This does not replace runtime qualification.")
