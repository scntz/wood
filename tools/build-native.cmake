cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS EMITTER STDLIB INPUT OUTPUT LLC OPT LINKER TARGET)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
function(llvm_command result tool)
    if(WSL_DISTRIBUTION)
        if(NOT WIN32)
            message(FATAL_ERROR "WSL_DISTRIBUTION requires a Windows host")
        endif()
        set(command wsl.exe -d "${WSL_DISTRIBUTION}" --exec "${tool}")
        foreach(argument IN LISTS ARGN)
            if(argument MATCHES "^([A-Za-z]):[/\\]")
                string(TOLOWER "${CMAKE_MATCH_1}" drive)
                string(SUBSTRING "${argument}" 3 -1 tail)
                string(REPLACE "\\" "/" tail "${tail}")
                set(argument "/mnt/${drive}/${tail}")
            endif()
            list(APPEND command "${argument}")
        endforeach()
    else()
        set(command "${tool}" ${ARGN})
    endif()
    set(${result} "${command}" PARENT_SCOPE)
endfunction()
if(NOT "${TARGET}" MATCHES "^(linux|windows)-x86_64$")
    message(FATAL_ERROR "Unsupported native target: ${TARGET}")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
set(native_libraries)
foreach(library IN LISTS LINK_LIBRARIES)
    get_filename_component(library "${library}" ABSOLUTE)
    if(NOT EXISTS "${library}" OR IS_DIRECTORY "${library}" OR
       NOT library MATCHES "[.](a|lib)$")
        message(FATAL_ERROR "Native link libraries must be existing .a/.lib files: ${library}")
    endif()
    list(APPEND native_libraries "${library}")
endforeach()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Native output already exists: ${OUTPUT}")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED RUNTIME_DIR)
    set(RUNTIME_DIR "${source_root}/runtime/native")
endif()
if(NOT DEFINED RUNTIME_OBJECT)
    set(RUNTIME_OBJECT "${RUNTIME_DIR}/managed-${TARGET}.o")
endif()
if(NOT EXISTS "${RUNTIME_OBJECT}" OR IS_DIRECTORY "${RUNTIME_OBJECT}")
    message(FATAL_ERROR "Supply -DRUNTIME_OBJECT=<prepared freestanding managed runtime object>; no C/C++ compiler is invoked by this script")
endif()
get_filename_component(parent "${OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${parent}")
    message(FATAL_ERROR "Native output parent does not exist")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${OUTPUT}.stages/${id}")
file(MAKE_DIRECTORY "${work}")
set(flags)
if(NOT DEFINED STAGE_TIMEOUT)
    set(STAGE_TIMEOUT 180)
endif()
if(NOT STAGE_TIMEOUT MATCHES "^[1-9][0-9]*$" OR STAGE_TIMEOUT GREATER 7200)
    message(FATAL_ERROR "STAGE_TIMEOUT must be an integer in 1..7200 seconds")
endif()
if(LOCKED)
    list(APPEND flags --locked)
endif()
set(command "${EMITTER}" "${STDLIB}" "${RUNTIME_DIR}" "${TARGET}" "${INPUT}" "${work}/program.ll" ${flags})
file(WRITE "${work}/commands.txt" "${command}\n")
execute_process(COMMAND ${command}
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${STAGE_TIMEOUT} ENCODING UTF-8)
file(WRITE "${work}/frontend.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native lowering failed (${status}): ${out}${err}")
endif()
if(NOT DEFINED OPTIMIZATION)
    set(OPTIMIZATION 2)
endif()
if(NOT OPTIMIZATION MATCHES "^[02]$")
    message(FATAL_ERROR "Native optimization must be 0 or 2")
endif()
set(triple x86_64-unknown-linux-gnu)
if("${TARGET}" STREQUAL "windows-x86_64")
    set(triple x86_64-pc-windows-msvc)
endif()
set(module "${work}/program.ll")
if(OPTIMIZATION STREQUAL "2")
    llvm_command(command "${OPT}" "-passes=default<O2>" -S "${module}" -o "${work}/optimized.ll")
    execute_process(COMMAND ${command}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${STAGE_TIMEOUT})
    file(WRITE "${work}/optimizer.log" "${out}${err}")
    file(APPEND "${work}/commands.txt" "${OPT};-passes=default<O2>;-S;${module};-o;${work}/optimized.ll\n")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "LLVM optimization/verification failed (${status}): ${out}${err}")
    endif()
    set(module "${work}/optimized.ll")
endif()
llvm_command(command "${LLC}" -filetype=obj "-mtriple=${triple}" -O=${OPTIMIZATION} "${module}" -o "${work}/program.o")
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${STAGE_TIMEOUT})
file(WRITE "${work}/codegen.log" "${out}${err}")
file(APPEND "${work}/commands.txt" "${command}\n")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "LLVM native code generation failed (${status}): ${out}${err}")
endif()
set(pending "${work}/program")
if("${TARGET}" STREQUAL "linux-x86_64")
    set(command "${LINKER}" -static --build-id=none -e _start "${work}/program.o" "${RUNTIME_OBJECT}" ${native_libraries} -o "${work}/program")
    file(READ "${work}/program.ll" native_ir)
    string(FIND "${native_ir}" "\n@wd.native.system_libraries = private constant i8 1\n" system_libraries)
    if(NOT system_libraries EQUAL -1)
        set(command "${LINKER}" --build-id=none -e _start_hosted
            --dynamic-linker /lib64/ld-linux-x86-64.so.2 "${work}/program.o"
            "${RUNTIME_OBJECT}" ${native_libraries} --no-as-needed -l:libc.so.6 -o "${work}/program")
    endif()
else()
    if(NOT DEFINED LINKER OR NOT WIN32)
        message(FATAL_ERROR "Windows linking requires -DLINKER=<SDK link.exe> on Windows; object retained at ${work}/program.o")
    endif()
    set(pending "${work}/program.exe")
    set(command "${LINKER}" /nologo /Brepro /OPT:NOICF /nodefaultlib /entry:mainCRTStartup /subsystem:console /machine:x64 /stack:8388608 /out:${pending} "${work}/program.o" "${RUNTIME_OBJECT}" ${native_libraries} kernel32.lib)
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(APPEND "${work}/commands.txt" "${command}\n")
file(WRITE "${work}/link.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native linking failed (${status}): ${out}${err}")
endif()
file(RENAME "${pending}" "${OUTPUT}" NO_REPLACE RESULT status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot publish native executable: ${status}")
endif()
message(STATUS "Native executable built without C++ compilation/runtime: ${OUTPUT}")
