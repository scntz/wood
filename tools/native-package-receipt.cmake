cmake_minimum_required(VERSION 3.25)
# An explicit build-integrity receipt, not a native package resolver or installer.
# Call only on trusted reviewed files. Hashes are not signatures or provenance.
foreach(required IN ITEMS PACKAGE_DIR ARCHIVE IMPORT_LIBRARIES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${PACKAGE_DIR}" OR NOT EXISTS "${ARCHIVE}" OR IS_DIRECTORY "${ARCHIVE}")
    message(FATAL_ERROR "Supply an existing package directory and native archive")
endif()
file(REAL_PATH "${PACKAGE_DIR}" PACKAGE_DIR)
file(READ "${PACKAGE_DIR}/wood.json" manifest)
string(JSON name GET "${manifest}" name)
string(JSON version GET "${manifest}" version)
if(NOT name STREQUAL "wood_windowsgui")
    message(FATAL_ERROR "This receipt profile is for wood_windowsgui only")
endif()
set(inputs "${ARCHIVE}" ${IMPORT_LIBRARIES})
set(labels "adapter")
foreach(library IN LISTS IMPORT_LIBRARIES)
    get_filename_component(label "${library}" NAME)
    string(TOLOWER "${label}" label)
    list(APPEND labels "${label}")
endforeach()
if(NOT labels STREQUAL "adapter;user32.lib;gdi32.lib;kernel32.lib")
    message(FATAL_ERROR "Supply SDK user32, gdi32 and kernel32 import libraries in that order")
endif()
file(GLOB source_inputs RELATIVE "${PACKAGE_DIR}" "${PACKAGE_DIR}/src/*.wd"
    "${PACKAGE_DIR}/native/*.c" "${PACKAGE_DIR}/native/CMakeLists.txt" "${PACKAGE_DIR}/wood.json")
list(SORT source_inputs)
list(LENGTH source_inputs source_count)
if(source_count LESS 5)
    message(FATAL_ERROR "Native receipt source inventory is incomplete")
endif()
foreach(file IN LISTS source_inputs)
    list(APPEND inputs "${PACKAGE_DIR}/${file}")
    list(APPEND labels "${file}")
endforeach()
set(records "[]")
list(LENGTH inputs count)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
    list(GET inputs ${i} file)
    list(GET labels ${i} label)
    if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
        message(FATAL_ERROR "Missing explicit native input: ${label}")
    endif()
    file(SHA256 "${file}" digest)
    file(SIZE "${file}" bytes)
    string(JSON record SET "{}" name "\"${label}\"")
    string(JSON record SET "${record}" sha256 "\"${digest}\"")
    string(JSON record SET "${record}" bytes ${bytes})
    string(JSON records SET "${records}" ${i} "${record}")
endforeach()
if(DEFINED VERIFY)
    file(READ "${VERIFY}" receipt)
    string(JSON actual GET "${receipt}" inputs)
    string(JSON schema GET "${receipt}" schema_version)
    string(JSON actual_name GET "${receipt}" package)
    string(JSON actual_version GET "${receipt}" version)
    string(JSON abi GET "${receipt}" abi)
    string(JSON target GET "${receipt}" target)
    if(NOT schema EQUAL 1 OR NOT actual STREQUAL records OR NOT actual_name STREQUAL name OR NOT actual_version STREQUAL version
        OR NOT abi EQUAL 4 OR NOT target STREQUAL "windows-x86_64")
        message(FATAL_ERROR "Native package integrity mismatch; do not refresh a receipt silently")
    endif()
    message(STATUS "Native package receipt verified: ${count} inputs")
    return()
endif()
foreach(required IN ITEMS COMPILER OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required} to record explicit native inputs")
    endif()
endforeach()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Receipt output already exists")
endif()
execute_process(COMMAND "${COMPILER}" --version RESULT_VARIABLE status OUTPUT_VARIABLE compiler ERROR_VARIABLE err TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot identify native C compiler: ${err}")
endif()
string(REGEX MATCH "^[^\r\n]*" compiler "${compiler}")
string(REPLACE "\\" "\\\\" compiler "${compiler}")
string(REPLACE "\"" "\\\"" compiler "${compiler}")
string(REPLACE "\n" "\\n" compiler "${compiler}")
string(REPLACE "\r" "" compiler "${compiler}")
file(WRITE "${OUTPUT}" "{\"schema_version\":1,\"package\":\"${name}\",\"version\":\"${version}\",\"target\":\"windows-x86_64\",\"abi\":4,\"compiler\":\"${compiler}\",\"inputs\":${records}}\n")
message(STATUS "Recorded ${count} explicit native inputs without embedding machine paths")
