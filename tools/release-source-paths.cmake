cmake_minimum_required(VERSION 3.25)
if(NOT ENABLED)
    return()
endif()
foreach(required IN ITEMS INPUT SOURCE_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
# Only the generated compiler's own source-origin constants are mapped. User
# source paths still come from runtime input and retain their normal diagnostics.
# No qualified binary or original Wood source is edited.
file(READ "${INPUT}" generated)
file(TO_CMAKE_PATH "${SOURCE_ROOT}" normalized)
string(REPLACE "/" "\\" native "${normalized}")
string(REPLACE "\\" "\\\\" escaped "${native}")
string(REPLACE "wd::Site{\"${normalized}/" "wd::Site{\"wood-source/" generated "${generated}")
string(REPLACE "wd::Site{\"${escaped}\\\\" "wd::Site{\"wood-source/" generated "${generated}")
# The production emitter spells every literal byte with a fixed-width octal
# escape. Map only Site filenames, never length-bearing std::string payloads.
foreach(prefix IN ITEMS "${normalized}/" "${native}\\")
    string(HEX "${prefix}" hex)
    string(LENGTH "${hex}" length)
    math(EXPR end "${length}-2")
    set(octal "")
    foreach(index RANGE 0 ${end} 2)
        string(SUBSTRING "${hex}" ${index} 2 byte)
        math(EXPR value "0x${byte}")
        math(EXPR a "${value}/64")
        math(EXPR b "(${value}/8)%8")
        math(EXPR c "${value}%8")
        string(APPEND octal "\\${a}${b}${c}")
    endforeach()
    string(REPLACE "wd::Site{\"${octal}" "wd::Site{\"wood-source/" generated "${generated}")
endforeach()
file(WRITE "${INPUT}" "${generated}")
