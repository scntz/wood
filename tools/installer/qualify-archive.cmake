# Explicit, opt-in consumption of a previously verified Core archive. This is
# an isolated local workflow test, not a clean-host or GUI-installer claim.
cmake_minimum_required(VERSION 3.25)
foreach(name IN ITEMS BUILDER TEMPLATE ARCHIVE EXPECTED_SHA256 CONFIG WORK)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Supply ${name}")
    endif()
endforeach()
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Qualification workspace must not exist")
endif()
file(SHA256 "${ARCHIVE}" actual_hash)
if(NOT actual_hash STREQUAL EXPECTED_SHA256)
    message(FATAL_ERROR "Core archive checksum mismatch")
endif()
file(MAKE_DIRECTORY "${WORK}/extract" "${WORK}/targets")
function(invoke)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600 ENCODING UTF-8 WORKING_DIRECTORY "${WORK}")
    file(APPEND "${WORK}/commands.log" "COMMAND: ${ARGN}\nSTATUS: ${status}\nSTDOUT: ${out}\nSTDERR: ${err}\n")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Core installer workflow failed (${status}): ${ARGN}\n${out}\n${err}")
    endif()
    set(last_out "${out}" PARENT_SCOPE)
endfunction()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${ARCHIVE}"
    WORKING_DIRECTORY "${WORK}/extract" RESULT_VARIABLE extracted)
if(NOT extracted STREQUAL "0")
    message(FATAL_ERROR "Archive extraction failed")
endif()
if(WIN32)
    set(suffix .exe)
else()
    set(suffix "")
endif()
file(READ "${CONFIG}" config)
if(NOT WIN32)
    string(JSON config SET "${config}" architecture "\"linux-x86_64\"")
    string(JSON config SET "${config}" command "\"bin/wood\"")
endif()
file(WRITE "${WORK}/config.json" "${config}\n")
set(setup "${WORK}/wood-setup-cli-unqualified${suffix}")
invoke("${BUILDER}" "${TEMPLATE}" "${WORK}/config.json" "${WORK}/extract/wood-native" "${setup}")
invoke("${setup}" install "${WORK}/targets/Wood á🌳")
file(READ "${WORK}/targets/Wood á🌳/receipt.json" receipt)
string(JSON active GET "${receipt}" active)
set(installed "${WORK}/targets/Wood á🌳/${active}/bin/wood${suffix}")
invoke("${installed}" --version)
if(NOT last_out MATCHES "wood 0[.]4[.]0")
    message(FATAL_ERROR "Installed compiler version mismatch")
endif()
invoke("${installed}" init "${WORK}/hello")
invoke("${installed}" check "${WORK}/hello")
invoke("${installed}" lock "${WORK}/hello")
invoke("${installed}" deps "${WORK}/hello" --locked)
invoke("${installed}" test "${WORK}/hello" --locked --report=json)
invoke("${installed}" build "${WORK}/hello" --locked --backend llvm -o "${WORK}/hello-native${suffix}")
invoke("${WORK}/hello-native${suffix}")
# Preserve additions rather than treating the installation root as disposable.
file(WRITE "${WORK}/targets/Wood á🌳/user-data.txt" "retain me")
invoke("${setup}" uninstall "${WORK}/targets/Wood á🌳" wood)
if(EXISTS "${installed}" OR NOT EXISTS "${WORK}/targets/Wood á🌳/user-data.txt")
    message(FATAL_ERROR "Core uninstall failed to preserve ownership boundary")
endif()
file(SHA256 "${setup}" setup_hash)
file(SIZE "${setup}" setup_size)
file(WRITE "${WORK}/results.json" "{\"archive_sha256\":\"${actual_hash}\",\"setup_sha256\":\"${setup_hash}\",\"setup_bytes\":${setup_size},\"status\":\"passed\",\"qualification\":\"isolated-existing-host-cli-only\"}\n")
message(STATUS "Actual Core archive installer workflow passed: ${WORK}")
