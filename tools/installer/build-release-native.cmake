# Release-only source-name remapping through the existing checked Wood frontend.
# No backend rewrite, C++ generation or mutation of a qualified compiler.
cmake_minimum_required(VERSION 3.25)
foreach(key IN ITEMS EMITTER ASSETS LLVM_DIRECTORY INPUT OUTPUT SOURCE_ROOT)
    if(NOT DEFINED ${key})
        message(FATAL_ERROR "Supply ${key}")
    endif()
endforeach()
if(EXISTS "${OUTPUT}" OR EXISTS "${OUTPUT}.ll")
    message(FATAL_ERROR "Release output already exists")
endif()
function(step label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(APPEND "${OUTPUT}.commands.log" "${label}: ${ARGN}\n${status}\n${out}${err}\n")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${status}): ${out}${err}")
    endif()
endfunction()
if(NOT DEFINED TARGET)
    set(TARGET windows-x86_64)
endif()
if("${TARGET}" STREQUAL "windows-x86_64")
    set(tool_suffix .exe)
    set(triple x86_64-pc-windows-msvc)
elseif("${TARGET}" STREQUAL "linux-x86_64")
    set(tool_suffix "")
    set(triple x86_64-unknown-linux-gnu)
else()
    message(FATAL_ERROR "Unqualified release target")
endif()
step(emit "${EMITTER}" "${ASSETS}/stdlib.json" "${ASSETS}/native" "${TARGET}" "${INPUT}" "${OUTPUT}.ll" "${SOURCE_ROOT}")
step(verify "${LLVM_DIRECTORY}/opt${tool_suffix}" -passes=verify -disable-output "${OUTPUT}.ll")
if(NOT DEFINED OPTIMIZATION)
    set(OPTIMIZATION 0)
endif()
if(NOT OPTIMIZATION MATCHES "^[012]$")
    message(FATAL_ERROR "OPTIMIZATION must be 0, 1 or 2")
endif()
step(optimize "${LLVM_DIRECTORY}/opt${tool_suffix}" "-passes=default<O${OPTIMIZATION}>" -S "${OUTPUT}.ll" -o "${OUTPUT}.optimized.ll")
step(object "${LLVM_DIRECTORY}/llc${tool_suffix}" -filetype=obj "-mtriple=${triple}" "-O=${OPTIMIZATION}" "${OUTPUT}.optimized.ll" -o "${OUTPUT}.obj")
if("${TARGET}" STREQUAL "linux-x86_64")
    if(NOT DEFINED LINKER)
        message(FATAL_ERROR "Supply the qualified Linux LINKER")
    endif()
    step(link "${LINKER}" -static --build-id=none -e _start "${OUTPUT}.obj" "${ASSETS}/native/managed.o" ${LIBRARIES} -o "${OUTPUT}")
    return()
endif()
if(NOT DEFINED SUBSYSTEM)
    set(SUBSYSTEM console)
endif()
step(link "${LLVM_DIRECTORY}/lld-link.exe" /nologo /Brepro /OPT:NOICF /nodefaultlib /entry:mainCRTStartup
    "/subsystem:${SUBSYSTEM}" /machine:x64 /stack:8388608 "/out:${OUTPUT}" "${OUTPUT}.obj" "${ASSETS}/native/managed.o" ${LIBRARIES} kernel32.lib)
