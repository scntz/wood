# Produce one constant C++ string from bounded adjacent raw literals. VS 2022
# versions before MSVC 14.51 reject an individual literal larger than 16,380
# bytes. No allocation or runtime concatenation is needed. CMake indexes bytes;
# keep UTF-8 code points intact at each token boundary.
function(wood_embed_text output content)
    set(delimiter_index 0)
    while(TRUE)
        set(delimiter "WOOD_${delimiter_index}")
        string(FIND "${content}" ")${delimiter}\"" collision)
        if(collision EQUAL -1)
            break()
        endif()
        math(EXPR delimiter_index "${delimiter_index} + 1")
    endwhile()
    string(LENGTH "${delimiter}" delimiter_length)
    if(delimiter_length GREATER 16)
        message(FATAL_ERROR "Cannot select a bounded C++ raw-string delimiter")
    endif()
    string(LENGTH "${content}" length)
    set(offset 0)
    set(literals "")
    while(offset LESS length)
        math(EXPR count "${length} - ${offset}")
        if(count GREATER 8000)
            set(count 8000)
        endif()
        math(EXPR end "${offset} + ${count}")
        if(end LESS length)
            string(SUBSTRING "${content}" ${end} 1 next)
            string(HEX "${next}" next_byte)
            while(next_byte MATCHES "^[89ab][0-9a-f]$")
                math(EXPR count "${count} - 1")
                math(EXPR end "${end} - 1")
                string(SUBSTRING "${content}" ${end} 1 next)
                string(HEX "${next}" next_byte)
            endwhile()
        endif()
        string(SUBSTRING "${content}" ${offset} ${count} chunk)
        string(APPEND literals "R\"${delimiter}(${chunk})${delimiter}\"\n")
        set(offset ${end})
    endwhile()
    if(length EQUAL 0)
        set(literals "R\"${delimiter}()${delimiter}\"")
    endif()
    set(${output} "${literals}" PARENT_SCOPE)
endfunction()
