# Included by check-docs.cmake. Deliberately extracts declarations, not bodies or
# inferred types; compiler inspect independently verifies the exported names.
file(READ "${SOURCE_DIR}/docs/documentation.json" doc_config)
file(READ "${SOURCE_DIR}/docs/language.json" capabilities)
string(JSON module_count LENGTH "${doc_config}" modules)
string(JSON metadata_module_count LENGTH "${capabilities}" standard_modules)
string(JSON optional_module_count LENGTH "${capabilities}" optional_standard_modules)
math(EXPR metadata_module_count "${metadata_module_count} + ${optional_module_count}")
if(NOT module_count EQUAL metadata_module_count)
    message(FATAL_ERROR "Standard module inventory differs from language.json")
endif()
set(api "# Standard library API index\n\n")
string(APPEND api "Generated from public declarations by `cmake -DUPDATE_API=ON -P tools/check-docs.cmake`.\nDo not edit signatures here. [Library guide](stdlib.md) and linked contracts define\nbehavior, errors, costs and limits; this index supplies exact spelling and defaults.\nOmitted return annotations mean inference, not necessarily void. Generic parameters\nand associated types are resolved on specialization. These are declarations, not\ncomplete runnable programs. Underscore declarations are private and excluded.\nRecord fields are shown for layout; prefer documented factories/methods to preserve\ninvariants. Unless explicitly marked LLVM-only, this is the default C++23 path's API, not an LLVM support promise.\n\n## Modules\n\n")
set(module_names "")
set(function_count 0)
set(record_count 0)
set(method_count 0)
set(field_count 0)
math(EXPR last_module "${module_count} - 1")
foreach(index RANGE ${last_module})
    string(JSON name GET "${doc_config}" modules ${index} name)
    string(JSON contract GET "${doc_config}" modules ${index} contract)
    string(JSON summary GET "${doc_config}" modules ${index} summary)
    string(JSON tests GET "${doc_config}" modules ${index} tests)
    list(APPEND module_names "std.${name}")
    string(APPEND api "- [std.${name}](#std${name}) — ${summary}\n")
    set(section "\n## std.${name}\n\n${summary}\n\n[Behavior and limits](${contract}) · [Source](../stdlib/${name}.wd) · [Regression source](../${tests})\n\n```text\n")
    file(STRINGS "${SOURCE_DIR}/stdlib/${name}.wd" lines ENCODING UTF-8)
    set(public_record FALSE)
    set(exports "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^record ([A-Za-z_][A-Za-z_0-9]*)[^:]*:$")
            set(symbol "${CMAKE_MATCH_1}")
            set(public_record TRUE)
            if(symbol MATCHES "^_")
                set(public_record FALSE)
            else()
                set(record_name "${symbol}")
                set(members_${record_name} "")
                list(APPEND exports "${symbol}")
                math(EXPR record_count "${record_count} + 1")
                string(APPEND section "${line}\n")
            endif()
        elseif(line MATCHES "^fn ([A-Za-z_][A-Za-z_0-9]*)")
            set(symbol "${CMAKE_MATCH_1}")
            if(NOT line MATCHES ":$")
                message(FATAL_ERROR "API extractor requires a complete single-line declaration: std.${name}.${symbol}")
            endif()
            set(public_record FALSE)
            if(NOT symbol MATCHES "^_")
                list(APPEND exports "${symbol}")
                math(EXPR function_count "${function_count} + 1")
                string(APPEND section "${line}\n")
            endif()
        elseif(public_record AND line MATCHES "^    fn ([A-Za-z_][A-Za-z_0-9]*)")
            set(symbol "${CMAKE_MATCH_1}")
            if(NOT line MATCHES ":$")
                message(FATAL_ERROR "API extractor requires a complete single-line method: std.${name}.${record_name}.${symbol}")
            endif()
            if(NOT symbol MATCHES "^_")
                math(EXPR method_count "${method_count} + 1")
                list(APPEND members_${record_name} "method:${symbol}")
                string(APPEND section "${line}\n")
            endif()
        elseif(public_record AND line MATCHES "^    [A-Za-z_][A-Za-z_0-9]*: ")
            string(REGEX MATCH "^    ([A-Za-z_][A-Za-z_0-9]*):" unused "${line}")
            list(APPEND members_${record_name} "field:${CMAKE_MATCH_1}")
            math(EXPR field_count "${field_count} + 1")
            string(APPEND section "${line}\n")
        endif()
    endforeach()
    string(APPEND section "```\n")
    string(APPEND api_sections "${section}")
    set(inspector "${WOOD}")
    if(name STREQUAL "python")
        # This explicitly optional LLVM profile is not in the C++ reference.
        # Supply NATIVE_WOOD to verify its exports with the actual native CLI.
        set(inspector "${NATIVE_WOOD}")
    endif()
    if(NOT inspector STREQUAL "")
        execute_process(COMMAND "${inspector}" inspect "${SOURCE_DIR}/stdlib/${name}.wd"
            RESULT_VARIABLE result OUTPUT_VARIABLE inspection ERROR_VARIABLE errors TIMEOUT 60)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "std.${name} inspection failed (${result}): ${errors}")
        endif()
        string(JSON module_total LENGTH "${inspection}" modules)
        math(EXPR last "${module_total} - 1")
        set(found FALSE)
        foreach(m RANGE ${last})
            string(JSON file GET "${inspection}" modules ${m} file)
            if(file MATCHES "/stdlib/${name}\\.wd$")
                set(found TRUE)
                string(JSON n LENGTH "${inspection}" modules ${m} exports)
                set(actual "")
                if(n GREATER 0)
                    math(EXPR end "${n} - 1")
                    foreach(e RANGE ${end})
                        string(JSON symbol GET "${inspection}" modules ${m} exports ${e} name)
                        list(APPEND actual "${symbol}")
                        string(JSON kind ERROR_VARIABLE missing GET "${inspection}" modules ${m} exports ${e} kind)
                        if(NOT missing AND kind STREQUAL "record")
                            set(members "")
                            foreach(family IN ITEMS fields methods)
                                string(JSON count LENGTH "${inspection}" modules ${m} exports ${e} ${family})
                                if(count GREATER 0)
                                    math(EXPR end_member "${count} - 1")
                                    foreach(member RANGE ${end_member})
                                        string(JSON member_name GET "${inspection}" modules ${m} exports ${e} ${family} ${member} name)
                                        if(family STREQUAL "fields")
                                            list(APPEND members "field:${member_name}")
                                        elseif(NOT member_name MATCHES "^_")
                                            list(APPEND members "method:${member_name}")
                                        endif()
                                    endforeach()
                                endif()
                            endforeach()
                            list(SORT members)
                            list(SORT members_${symbol})
                            if(NOT members STREQUAL members_${symbol})
                                message(FATAL_ERROR "std.${name}.${symbol} documented members differ from inspect")
                            endif()
                        endif()
                    endforeach()
                endif()
                list(SORT exports)
                list(SORT actual)
                if(NOT actual STREQUAL exports)
                    message(FATAL_ERROR "std.${name} documented exports '${exports}' differ from inspect '${actual}'")
                endif()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Inspection omitted stdlib/${name}.wd")
        endif()
    endif()
endforeach()
file(GLOB module_files RELATIVE "${SOURCE_DIR}/stdlib" "${SOURCE_DIR}/stdlib/*.wd")
list(LENGTH module_files source_module_count)
if(NOT source_module_count EQUAL module_count)
    message(FATAL_ERROR "New/removed standard module needs documentation.json registration")
endif()
set(metadata_modules "")
string(JSON core_module_count LENGTH "${capabilities}" standard_modules)
math(EXPR last_core "${core_module_count} - 1")
foreach(i RANGE ${last_core})
    string(JSON name GET "${capabilities}" standard_modules ${i})
    list(APPEND metadata_modules "${name}")
endforeach()
if(optional_module_count GREATER 0)
    math(EXPR last_optional "${optional_module_count} - 1")
    foreach(i RANGE ${last_optional})
        string(JSON name GET "${capabilities}" optional_standard_modules ${i} module)
        list(APPEND metadata_modules "${name}")
    endforeach()
endif()
list(SORT module_names)
list(SORT metadata_modules)
if(NOT module_names STREQUAL metadata_modules)
    message(FATAL_ERROR "Standard module names differ from metadata")
endif()
string(APPEND api "${api_sections}\n## Builtin index\n\n")
string(APPEND api "These names come from the compiler registry. Prefer standard-module wrappers for\nOS/numerical services. Signatures/overloads and errors are defined by the linked\ncontracts; registry presence alone does not establish support in another backend.\n\n| Builtin | Contract |\n| --- | --- |\n")
file(STRINGS "${SOURCE_DIR}/include/wood/builtins.hpp" registry REGEX "^[ ]*[{][\"]")
set(builtin_names "")
foreach(line IN LISTS registry)
    string(REGEX MATCH "[{][\"]([^\"]+)" unused "${line}")
    set(name "${CMAKE_MATCH_1}")
    list(APPEND builtin_names "${name}")
    if(name MATCHES "^(array_|math_)")
        set(contract "native-computing.md")
    elseif(name MATCHES "^(db_|stmt_)")
        set(contract "backend.md#sqlite")
    elseif(name MATCHES "^task_")
        set(contract "backend.md#native-tasks")
    elseif(name MATCHES "^tls_")
        set(contract "backend.md#tls-and-https")
    elseif(name MATCHES "^(stream_|tcp_)")
        set(contract "networking.md")
    elseif(name MATCHES "^(path_|fs_)")
        set(contract "stdlib.md#native-filesystem-and-paths")
    elseif(name MATCHES "^time_")
        set(contract "stdlib.md#native-time")
    elseif(name MATCHES "^json")
        set(contract "data-model.md#typed-json-boundaries")
    elseif(name MATCHES "^(iter|next|yielded|finished|has_item|step_value|range)$")
        set(contract "closures-iterators.md")
    elseif(name STREQUAL "error")
        set(contract "errors.md")
    elseif(name MATCHES "^(char_count|chars|char_slice)$")
        set(contract "stdlib.md#bytes-and-utf-8")
    else()
        set(contract "stdlib.md")
    endif()
    string(APPEND api "| `${name}` | [Contract](${contract}) |\n")
endforeach()
list(LENGTH builtin_names builtin_count)
string(JSON metadata_builtin_count LENGTH "${capabilities}" builtins)
set(metadata_builtins "")
math(EXPR last "${metadata_builtin_count} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${capabilities}" builtins ${i})
    list(APPEND metadata_builtins "${name}")
endforeach()
list(SORT builtin_names)
list(SORT metadata_builtins)
if(NOT builtin_names STREQUAL metadata_builtins)
    message(FATAL_ERROR "Builtin registry differs from language.json")
endif()
if(UPDATE_API)
    file(WRITE "${SOURCE_DIR}/docs/stdlib-api.md" "${api}")
elseif(EXISTS "${SOURCE_DIR}/docs/stdlib-api.md")
    file(READ "${SOURCE_DIR}/docs/stdlib-api.md" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL api)
        message(FATAL_ERROR "stdlib-api.md is stale: cmake -DUPDATE_API=ON -P tools/check-docs.cmake")
    endif()
else()
    message(FATAL_ERROR "Missing docs/stdlib-api.md")
endif()
message(STATUS "API coverage: ${module_count} modules, ${function_count} functions, ${record_count} records, ${method_count} methods, ${field_count} fields, ${builtin_count} builtins")
