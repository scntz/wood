cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SOURCE_DIR)
    cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH SOURCE_DIR)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/docs-api.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/check-official-packages.cmake")

# Restrict traversal to maintained public text directories; never recurse through
# ignored build trees, local source snapshots or junctions in the working tree.
file(GLOB documents RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*.md"
    "${SOURCE_DIR}/docs/*.md" "${SOURCE_DIR}/docs/releases/*.md"
    "${SOURCE_DIR}/bootstrap/*.md" "${SOURCE_DIR}/tools/launch/*.md"
    "${SOURCE_DIR}/benchmarks/*.md" "${SOURCE_DIR}/.github/*.md"
    "${SOURCE_DIR}/packages/*/README.md" "${SOURCE_DIR}/examples/*/README.md")
set(link_count 0)
set(external_links 0)
set(fragment_count 0)

function(markdown_text path output)
    file(READ "${path}" remaining)
    string(REPLACE "\r\n" "\n" remaining "${remaining}")
    set(text "")
    set(fence "")
    while(NOT remaining STREQUAL "")
        string(FIND "${remaining}" "\n" newline)
        if(newline EQUAL -1)
            set(line "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${newline} line)
            math(EXPR next "${newline} + 1")
            string(SUBSTRING "${remaining}" ${next} -1 remaining)
        endif()
        if(line MATCHES "^(```+|~~~+)")
            if(fence STREQUAL "")
                set(fence "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^${fence}[ ]*$")
                set(fence "")
            endif()
        elseif(fence STREQUAL "")
            # Inline code can contain 'a](b)' which is not a Markdown link.
            string(REGEX REPLACE "`[^`]*`" "" line "${line}")
            string(APPEND text "${line}\n")
        endif()
    endwhile()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(anchors path output)
    file(STRINGS "${path}" lines ENCODING UTF-8)
    set(result "")
    set(fence "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^(```+|~~~+)")
            if(fence STREQUAL "")
                set(fence "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^${fence}[ ]*$")
                set(fence "")
            endif()
        elseif(fence STREQUAL "" AND line MATCHES "^#+[ ]+(.+)")
            set(title "${CMAKE_MATCH_1}")
            string(TOLOWER "${title}" slug)
            string(REGEX REPLACE "[^a-z0-9_ -]" "" slug "${slug}")
            string(REPLACE " " "-" slug "${slug}")
            set(unique "${slug}")
            set(index 0)
            while(unique IN_LIST result)
                math(EXPR index "${index} + 1")
                set(unique "${slug}-${index}")
            endwhile()
            list(APPEND result "${unique}")
        endif()
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

foreach(document IN LISTS documents)
    markdown_text("${SOURCE_DIR}/${document}" body)
    cmake_path(GET document PARENT_PATH directory)
    # Avoid unmatched ']' elements: CMake lists otherwise coalesce multiple links.
    string(REPLACE "](" "@woodlink(" body "${body}")
    string(REGEX MATCHALL "@woodlink\\([^()\n]+\\)" links "${body}")
    foreach(link IN LISTS links)
        string(REGEX REPLACE "^@woodlink\\((.*)\\)$" "\\1" target "${link}")
        if(target MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:")
            math(EXPR external_links "${external_links} + 1")
            continue()
        endif()
        if(target MATCHES "^<([^>]+)>$")
            set(target "${CMAKE_MATCH_1}")
        endif()
        string(REPLACE "%20" " " target "${target}")
        string(FIND "${target}" "#" hash)
        set(fragment "")
        if(NOT hash EQUAL -1)
            math(EXPR start "${hash} + 1")
            string(SUBSTRING "${target}" ${start} -1 fragment)
            string(SUBSTRING "${target}" 0 ${hash} target)
        endif()
        if(target STREQUAL "")
            set(path "${SOURCE_DIR}/${document}")
        else()
            cmake_path(ABSOLUTE_PATH target BASE_DIRECTORY "${SOURCE_DIR}/${directory}" NORMALIZE OUTPUT_VARIABLE path)
        endif()
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Broken link in ${document}: ${link}")
        endif()
        math(EXPR link_count "${link_count} + 1")
        if(NOT fragment STREQUAL "" AND path MATCHES "\\.md$")
            anchors("${path}" targets)
            if(NOT fragment IN_LIST targets)
                message(FATAL_ERROR "Broken heading link in ${document}: ${link}")
            endif()
            math(EXPR fragment_count "${fragment_count} + 1")
        endif()
    endforeach()
endforeach()

file(READ "${SOURCE_DIR}/docs/examples.md" example_index)
file(GLOB_RECURSE examples RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/examples/*.wd")
foreach(example IN LISTS examples)
    string(FIND "${example_index}" "../${example})" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Example absent from docs/examples.md: ${example}")
    endif()
endforeach()
list(LENGTH documents document_count)
list(LENGTH examples example_count)
message(STATUS "Links: ${document_count} Markdown files, ${link_count} local targets, ${fragment_count} headings; ${external_links} external URLs not fetched")
message(STATUS "Example inventory: ${example_count} Wood files linked")

if(DEFINED REPORT)
    file(WRITE "${REPORT}" "{\n  \"schema_version\": 1,\n  \"modules\": ${module_count},\n  \"functions\": ${function_count},\n  \"records\": ${record_count},\n  \"methods\": ${method_count},\n  \"fields\": ${field_count},\n  \"builtins\": ${builtin_count},\n  \"markdown_files\": ${document_count},\n  \"local_links\": ${link_count},\n  \"heading_links\": ${fragment_count},\n  \"external_urls_unfetched\": ${external_links},\n  \"example_files\": ${example_count}\n}\n")
endif()
