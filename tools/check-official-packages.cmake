cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SOURCE_DIR)
    cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH SOURCE_DIR)
endif()
file(READ "${SOURCE_DIR}/packages/catalog.json" catalog)
string(JSON schema GET "${catalog}" schema_version)
if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported official package catalog schema")
endif()
set(api "# Official package API index\n\nGenerated by `cmake -DUPDATE_API=ON -P tools/check-official-packages.cmake`.\nThese are declarations, not runnable programs. See [package workflows](official-packages.md)\nfor platforms, native inputs, source locks and limitations. Private declarations\nare excluded; field visibility does not make forged records valid.\n")
string(JSON count LENGTH "${catalog}" packages)
math(EXPR last "${count}-1")
set(names)
foreach(i RANGE ${last})
    string(JSON name GET "${catalog}" packages ${i} name)
    string(JSON version GET "${catalog}" packages ${i} version)
    string(JSON directory GET "${catalog}" packages ${i} directory)
    if(NOT name MATCHES "^wood_[a-z][a-z_0-9]*$" OR NOT directory STREQUAL name OR name IN_LIST names)
        message(FATAL_ERROR "Invalid or duplicate official package: ${name}")
    endif()
    list(APPEND names "${name}")
    set(root "${SOURCE_DIR}/packages/${directory}")
    file(READ "${root}/wood.json" manifest)
    foreach(key IN ITEMS name version)
        string(JSON actual GET "${manifest}" ${key})
        if(NOT actual STREQUAL "${${key}}")
            message(FATAL_ERROR "Catalog/manifest ${key} mismatch: ${name}")
        endif()
    endforeach()
    if(NOT EXISTS "${root}/README.md")
        message(FATAL_ERROR "Missing package contract: ${name}")
    endif()
    foreach(license IN ITEMS LICENSE LICENSE-MIT LICENSE-APACHE)
        file(SHA256 "${SOURCE_DIR}/${license}" expected_license)
        file(SHA256 "${root}/${license}" actual_license)
        if(NOT expected_license STREQUAL actual_license)
            message(FATAL_ERROR "Official package license does not match reviewed root license: ${name}")
        endif()
    endforeach()
    string(APPEND api "\n## ${name} ${version}\n\n[Contract](../packages/${directory}/README.md)\n")
    string(JSON modules LENGTH "${catalog}" packages ${i} modules)
    math(EXPR end "${modules}-1")
    foreach(m RANGE ${end})
        string(JSON module GET "${catalog}" packages ${i} modules ${m})
        if(NOT module MATCHES "^[a-z][a-z_0-9]*$")
            message(FATAL_ERROR "Invalid package module")
        endif()
        string(APPEND api "\n### ${module}\n\n```text\n")
        file(STRINGS "${root}/src/${module}.wd" lines ENCODING UTF-8)
        set(record FALSE)
        foreach(line IN LISTS lines)
            if(line MATCHES "^record ([A-Za-z][A-Za-z_0-9]*)[^:]*:$")
                set(record TRUE)
                string(APPEND api "${line}\n")
            elseif(line MATCHES "^fn ([A-Za-z_][A-Za-z_0-9]*)")
                set(record FALSE)
                if(NOT CMAKE_MATCH_1 MATCHES "^_")
                    string(APPEND api "${line}\n")
                endif()
            elseif(record AND line MATCHES "^    (fn [A-Za-z][A-Za-z_0-9]*[(]|[A-Za-z][A-Za-z_0-9]*:)")
                string(APPEND api "${line}\n")
            endif()
        endforeach()
        string(APPEND api "```\n")
    endforeach()
endforeach()
if(UPDATE_API)
    file(WRITE "${SOURCE_DIR}/docs/official-packages-api.md" "${api}")
else()
    file(READ "${SOURCE_DIR}/docs/official-packages-api.md" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL api)
        message(FATAL_ERROR "Official package API index is stale")
    endif()
endif()
message(STATUS "Official catalog and declaration index: ${count} packages")
