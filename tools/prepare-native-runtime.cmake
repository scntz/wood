cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS CLANG TARGET OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
if(NOT "${TARGET}" MATCHES "^(linux|windows)-x86_64$")
    message(FATAL_ERROR "Unsupported native target: ${TARGET}")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Runtime output already exists: ${OUTPUT}")
endif()
get_filename_component(parent "${OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${parent}")
    message(FATAL_ERROR "Runtime output parent does not exist")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(triple x86_64-unknown-linux-gnu)
if("${TARGET}" STREQUAL "windows-x86_64")
    set(triple x86_64-pc-windows-msvc)
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${OUTPUT}.stages/${id}")
file(MAKE_DIRECTORY "${work}")
if(NOT DEFINED RUNTIME_DIR)
    set(RUNTIME_DIR "${source_root}/runtime/native")
endif()
set(command "${CLANG}" -x c -std=c17 "--target=${triple}" -ffreestanding
    -fno-builtin -fno-stack-protector -O2 -Wall -Wextra -Werror
    -c "${RUNTIME_DIR}/managed.c" -o "${work}/managed.o")
execute_process(COMMAND ${command} RESULT_VARIABLE status
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${work}/commands.txt" "${command}\n")
file(WRITE "${work}/compile.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Freestanding C17 runtime preparation failed (${status}): ${out}${err}")
endif()
file(RENAME "${work}/managed.o" "${OUTPUT}" NO_REPLACE RESULT status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot publish runtime object: ${status}")
endif()
message(STATUS "Prepared C++-free freestanding runtime: ${OUTPUT}")
