fn is_prime(n: int) -> bool:
    if n < 2:
        return false
    divisor = 2
    while divisor <= n // divisor:
        if n % divisor == 0:
            return false
        divisor = divisor + 1
    return true

count = 0
for n in range(2, 101):
    if is_prime(n):
        print(n)
        count = count + 1
assert(count == 25)
