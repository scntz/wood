# Import a CSV snapshot atomically, then print a deterministic JSON report.
# Usage: wood run examples/sqlite_inventory.wd -- inventory.db stock.csv
import std.csv as csv
import std.sqlite as sql

fn import_inventory(database_path: str, csv_path: str) -> list[dict[str, json]]:
    rows = csv.parse(read_text(csv_path), ",")
    if len(rows) == 0 or rows[0] != ["name", "quantity"]:
        raise "expected CSV header: name,quantity"
    with sql.open(database_path, 10000) as connection:
        sql.execute(connection, "CREATE TABLE IF NOT EXISTS inventory(name TEXT PRIMARY KEY, quantity INTEGER NOT NULL CHECK(quantity>=0))", [])
        with sql.begin(connection) as transaction_scope:
            with sql.prepare(connection, "INSERT INTO inventory VALUES(?,?) ON CONFLICT(name) DO UPDATE SET quantity=excluded.quantity") as insert:
                for row in rows[1:]:
                    if len(row) != 2 or row[0] == "":
                        raise "inventory rows require a nonempty name and quantity"
                    quantity = int(row[1])
                    if quantity < 0:
                        raise "inventory quantity cannot be negative"
                    stmt_bind_text(insert, 1, row[0])
                    stmt_bind_int(insert, 2, quantity)
                    assert(not stmt_step(insert))
                    stmt_reset(insert)
            sql.commit(transaction_scope)
        return sql.query(connection, "SELECT name,quantity FROM inventory ORDER BY name", [], 10000, 16777216)

if len(args()) != 2:
    eprint("usage: sqlite_inventory inventory.db stock.csv")
    exit(2)
try:
    print(json_dump(import_inventory(args()[0], args()[1])))
except err:
    eprint(err.code, err.message)
    exit(1)
