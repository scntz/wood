{
  "maximum_file_bytes": 1048576,
  "forbidden_paths": "(?i)(^|/)(build[^/]*|out|install|node_modules|__pycache__|[.]vs|[.]vscode|[.]idea)/|(^|/)([.]env(?![.]example$)[^/]*|credentials[.]json|secrets[.]json|id_rsa[^/]*|id_ed25519[^/]*)(/|$)|^benchmarks/results/|[.](exe|dll|o|pdb|lib|a|so|dylib|pyc|zip|log|tmp|pfx|p12)$",
  "patterns": [
    {
      "name": "private-key",
      "regex": "-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----"
    },
    {
      "name": "GitHub-token",
      "regex": "(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})"
    },
    {
      "name": "AWS-access-id",
      "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}"
    },
    {
      "name": "API-secret",
      "regex": "sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{32,}"
    },
    {
      "name": "private-Windows-home",
      "regex": "(?i)[a-z]:[\\\\/]+Users[\\\\/]+(?!developer(?:[\\\\/]|\\b)|Public(?:[\\\\/]|\\b)|Default(?:[\\\\/]|\\b))[^\\\\/\\s\"'<>]+"
    },
    {
      "name": "private-Unix-home",
      "regex": "/(?:home|Users)/(?!developer(?:/|\\b))[^/\\s\"\\\\]+/"
    }
  ],
