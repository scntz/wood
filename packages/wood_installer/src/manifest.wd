# Payload names are a deliberately portable subset. No links or install hooks.
import std.utf8 as utf8

record File:
    name: str
    size: int
    digest: str
    offset: int

record Application:
    id: str
    architecture: str
    name: str
    version: str
    publisher: str
    license: str
    command: str
    path_default: bool
    desktop: str
    start_menu: str
    files: list[File]

fn lower(value: str) -> str:
    result: list[str] = []
    for c in value:
        index = find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c)
        append(result, "abcdefghijklmnopqrstuvwxyz"[index] if index >= 0 else c)
    return join(result, "")

fn upper(value: str) -> str:
    result: list[str] = []
    for c in value:
        index = find("abcdefghijklmnopqrstuvwxyz", c)
        append(result, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"[index] if index >= 0 else c)
    return join(result, "")

fn object(value: json) -> dict[str,json]:
    if json_kind(value) != "dict":
        raise "setup: expected JSON object"
    return json_dict(value)

fn text(value: dict[str,json], key: str) -> str:
    if key not in value or json_kind(value[key]) != "str":
        raise "setup: expected string '" + key + "'"
    result = json_str(value[key])
    if len(result) > 65536 or "\0" in result or not utf8.is_valid(result):
        raise "setup: invalid UTF-8 metadata '" + key + "'"
    return result

fn identifier(value: str):
    if len(value) == 0 or len(value) > 80:
        raise "setup: application ID/version must contain 1..80 ASCII characters"
    for c in value:
        if c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.":
            raise "setup: invalid application ID/version"
    if value in [".", ".."]:
        raise "setup: invalid application ID/version"

fn relative(value: str):
    if len(value) == 0 or len(value) > 1024 or not utf8.is_valid(value):
        raise "setup: invalid payload path"
    for part in split(value, "/"):
        if len(part) == 0 or len(part) > 200 or part in [".", ".."] or ends_with(part, ".") or ends_with(part, " "):
            raise "setup: unsafe payload path '" + value + "'"
        base = upper(split(part, ".")[0])
        if base in ["CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"]:
            raise "setup: reserved device name in payload"
        for c in part:
            if byte_value(c) < 32 or c in "\\:*?\"<>|":
                raise "setup: unsafe payload path '" + value + "'"

fn hash_text(value: str):
    if len(value) != 64:
        raise "setup: expected SHA-256 digest"
    for c in value:
        if c not in "0123456789abcdef":
            raise "setup: expected lowercase SHA-256 digest"

fn decode(value: json) -> Application:
    data = object(value)
    if json_int(data["format"]) != 1 or text(data, "architecture") not in ["windows-x86_64", "linux-x86_64"]:
        raise "setup: unsupported manifest format/architecture"
    id = text(data, "id")
    version = text(data, "version")
    identifier(id)
    identifier(version)
    files: list[File] = []
    names: dict[str,bool] = {}
    total = 0
    for entry in json_list(data["files"]):
        item = object(entry)
        name = text(item, "name")
        relative(name)
        key = lower(name)
        if key in names:
            raise "setup: duplicate/case-colliding payload path '" + name + "'"
        names[key] = true
        size = json_int(item["size"])
        offset = json_int(item["offset"])
        if size < 0 or offset < 0 or size > 1073741824 or offset > 4294967296:
            raise "setup: invalid payload size/offset"
        total += size
        if total > 2147483648 or len(files) >= 16384:
            raise "setup: payload budget exceeded"
        digest = text(item, "sha256")
        hash_text(digest)
        append(files, File(name, size, digest, offset))
    for key in names:
        parts = split(key, "/")
        for n in range(1, len(parts)):
            if join(parts[:n], "/") in names:
                raise "setup: file/directory collision in payload"
    command = text(data, "command")
    relative(command)
    if lower(command) not in names:
        raise "setup: command is not a payload file"
    desktop = text(data, "desktop")
    menu = text(data, "start_menu")
    for target in [desktop, menu]:
        if target != "":
            relative(target)
            if lower(target) not in names:
                raise "setup: shortcut target is not a payload file"
    return Application(id, text(data, "architecture"), text(data, "name"), version, text(data, "publisher"), text(data, "license"), command, json_bool(data["path_default"]), desktop, menu, files)
