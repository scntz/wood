cmake_minimum_required(VERSION 3.25)
foreach(name IN ITEMS WOOD ADAPTER SOURCE WORK)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Supply ${name}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(WORK "${WORK}/run-${run}")
file(MAKE_DIRECTORY "${WORK}/payload/bin" "${WORK}/payload/docs" "${WORK}/targets")
file(READ "${SOURCE}/tools/installer/config/wood.json" wood_config)
string(JSON wood_desktop GET "${wood_config}" desktop)
string(JSON wood_path GET "${wood_config}" path_default)
string(JSON wood_menu GET "${wood_config}" start_menu)
string(JSON wood_command GET "${wood_config}" command)
if(NOT wood_desktop STREQUAL "" OR NOT wood_path OR wood_menu STREQUAL wood_command)
    message(FATAL_ERROR "Wood CLI installer presentation policy regressed")
endif()
set(command_count 0)
function(invoke expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
    file(APPEND "${WORK}/commands.log" "COMMAND: ${ARGN}\nEXPECTED: ${expected}\nSTATUS: ${status}\nSTDOUT: ${out}\nSTDERR: ${err}\n")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${out}\n${err}")
    endif()
    set(last_out "${out}" PARENT_SCOPE)
    math(EXPR count "${command_count}+1")
    set(command_count "${count}" PARENT_SCOPE)
endfunction()
if(WIN32)
    set(suffix .exe)
else()
    set(suffix "")
endif()
foreach(tool IN ITEMS cli builder)
    invoke(0 "${WOOD}" build "${SOURCE}/tools/installer/${tool}.wd" -O0
        --link-library "${ADAPTER}" -o "${WORK}/${tool}${suffix}")
endforeach()
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_manifest.wd" --link-library "${ADAPTER}")
if(NOT last_out STREQUAL "installer manifest contracts passed\n")
    message(FATAL_ERROR "Manifest regression output mismatch")
endif()
file(WRITE "${WORK}/abc.txt" "abc")
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_adapter.wd" --link-library "${ADAPTER}" -- "${WORK}/targets/adapter" "${WORK}/abc.txt")
set(hash_args)
foreach(length IN ITEMS 0 1 55 56 63 64 65 127 128 4096 1048576)
    string(REPEAT "a" ${length} content)
    file(WRITE "${WORK}/hash-${length}" "${content}")
    file(SHA256 "${WORK}/hash-${length}" digest)
    list(APPEND hash_args "${WORK}/hash-${length}" "${digest}")
endforeach()
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_hashes.wd" --link-library "${ADAPTER}" -- ${hash_args})
invoke(0 "${WOOD}" build "${SOURCE}/tools/installer/sample.wd" -o "${WORK}/payload/bin/sample.exe")
file(WRITE "${WORK}/payload/docs/á.txt" "Unicode 🌳\n")
file(READ "${SOURCE}/tools/installer/config/sample.json" config_text)
if(NOT WIN32)
    string(JSON config_text SET "${config_text}" architecture "\"linux-x86_64\"")
endif()
set(config "${WORK}/sample.json")
file(WRITE "${config}" "${config_text}\n")
set(package "${WORK}/sample-setup${suffix}")
invoke(0 "${WORK}/builder${suffix}" "${WORK}/cli${suffix}" "${config}" "${WORK}/payload" "${package}")
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_bundle.wd" --link-library "${ADAPTER}" -- "${package}" "${WORK}/targets")
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_transactions.wd" --link-library "${ADAPTER}" -- "${package}" "${WORK}/targets/transactions" "${WORK}/payload/bin/sample.exe")
invoke(0 "${WOOD}" "${SOURCE}/tools/installer/tests/test_hooks.wd" --link-library "${ADAPTER}" -- "${package}" "${WORK}/targets")
# Building the same template/configuration/tree produces the same exact bytes.
invoke(0 "${WORK}/builder${suffix}" "${WORK}/cli${suffix}" "${config}" "${WORK}/payload" "${WORK}/repeat${suffix}")
file(SHA256 "${package}" first_hash)
file(SHA256 "${WORK}/repeat${suffix}" second_hash)
if(NOT first_hash STREQUAL second_hash)
    message(FATAL_ERROR "Installer packaging is not deterministic")
endif()
set(target "${WORK}/targets/custom á🌳")
invoke(0 "${package}" install "${target}")
file(READ "${target}/receipt.json" receipt)
string(JSON active GET "${receipt}" active)
file(SHA256 "${target}/${active}/bin/sample.exe" installed_hash)
file(SHA256 "${WORK}/payload/bin/sample.exe" source_hash)
if(NOT installed_hash STREQUAL source_hash)
    message(FATAL_ERROR "Installed bytes differ")
endif()
invoke(0 "${target}/${active}/bin/sample.exe" --version)
if(NOT last_out STREQUAL "installer sample 1.0.0\n")
    message(FATAL_ERROR "Actual installed application failed")
endif()
# Reinstall is idempotent. Missing owned files are repaired.
invoke(0 "${WORK}/cli${suffix}" install "${package}" "${target}")
file(REMOVE "${target}/${active}/docs/á.txt")
invoke(0 "${WORK}/cli${suffix}" install "${package}" "${target}")
if(NOT EXISTS "${target}/${active}/docs/á.txt")
    message(FATAL_ERROR "Repair failed")
endif()
# Upgrade retains the prior generation and activates a new one without overwrites.
string(JSON upgrade_config SET "${config_text}" version "\"1.1.0\"")
file(WRITE "${WORK}/upgrade.json" "${upgrade_config}\n")
invoke(0 "${WORK}/builder${suffix}" "${WORK}/cli${suffix}" "${WORK}/upgrade.json" "${WORK}/payload" "${WORK}/upgrade${suffix}")
invoke(0 "${WORK}/upgrade${suffix}" install "${target}")
file(READ "${target}/receipt.json" receipt)
string(JSON upgraded GET "${receipt}" active)
string(JSON generations LENGTH "${receipt}" history)
if(upgraded STREQUAL active OR NOT generations EQUAL 2 OR NOT EXISTS "${target}/${active}/bin/sample.exe")
    message(FATAL_ERROR "Upgrade lost a generation or failed to activate")
endif()
invoke(0 "${target}/${upgraded}/bin/sample.exe" --version)
file(WRITE "${target}/${active}/bin/user.txt" "user data")
file(WRITE "${target}/${active}/docs/á.txt" "modified user data")
invoke(70 "${WORK}/cli${suffix}" install "${package}" "${target}")
invoke(0 "${WORK}/cli${suffix}" uninstall "${target}" wood_setup_sample)
file(READ "${target}/${active}/docs/á.txt" retained)
if(NOT retained STREQUAL "modified user data" OR NOT EXISTS "${target}/${active}/bin/user.txt" OR EXISTS "${target}/${active}/bin/sample.exe")
    message(FATAL_ERROR "Uninstall ownership/preservation mismatch")
endif()
if(EXISTS "${target}/${upgraded}/bin/sample.exe")
    message(FATAL_ERROR "Uninstall did not clean the upgraded generation")
endif()
file(MAKE_DIRECTORY "${WORK}/targets/occupied")
file(WRITE "${WORK}/targets/occupied/user.txt" "do not change")
invoke(70 "${WORK}/cli${suffix}" install "${package}" "${WORK}/targets/occupied")
file(GLOB occupied "${WORK}/targets/occupied/*")
list(LENGTH occupied occupied_count)
if(NOT occupied_count EQUAL 1)
    message(FATAL_ERROR "Occupied directory was modified")
endif()
file(COPY_FILE "${package}" "${WORK}/bad${suffix}")
file(APPEND "${WORK}/bad${suffix}" "corrupt")
invoke(70 "${WORK}/cli${suffix}" install "${WORK}/bad${suffix}" "${WORK}/targets/bad")
if(EXISTS "${WORK}/targets/bad")
    message(FATAL_ERROR "Corrupt bundle touched destination")
endif()
invoke(70 "${WORK}/builder${suffix}" "${WORK}/cli${suffix}" "${config}" "${WORK}/payload" "${package}")
file(WRITE "${WORK}/results.json" "{\"passed_commands\":${command_count},\"failed_commands\":0,\"work\":\"${WORK}\"}\n")
message(STATUS "Installer engine qualification passed: ${command_count} commands; ${WORK}")
