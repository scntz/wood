# Build trees, installations, private evidence and release staging.
/build*/
/out/
/install/
/dist/
/releases/
/bootstrap/build/
/wood-[0-9]*/
/wood
/wood-selfhost
/wood-native
*.stages/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
Testing/
compile_commands.json
.ninja_*
build.ninja
cmake_install.cmake
install_manifest*.txt

# Native outputs. Wavefront OBJ fixtures and the runtime's LLVM sources are source.
*.exe
*.dll
*.obj
!tests/fixtures/obj/*.obj
*.ll
!runtime/native/*.ll
*.o
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.a
*.lib
*.so
*.so.*
*.dylib
*.dSYM/
*.wasm
*.gcda
*.gcno
*.profraw
*.profdata
*.dmp
/core
/core.[0-9]*

# Editor packages and JavaScript dependencies.
.vscode-test/
node_modules/
*.vsix

# Installed package source, restored from wood.lock with 'wood install', and packed packages.
/vendor/
.wood/
*.woodpkg

# Generated measurements, archives and logs.
/benchmarks/results/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~

# Python and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.cache/
.venv/
venv/
coverage/
.coverage

# Local settings, assistant state and operating system files.
.claude/
.codex/
.agents/
.vs/
.vscode/
.idea/
*.local
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Credentials. Never commit them. Legitimate wood.lock files remain tracked.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.json
.git-credentials
.npmrc
.pypirc
.netrc
/.ssh/
/.aws/
/.azure/
/.docker/
/.terraform/
*.tfstate
*.tfstate.*

# Public offline TLS identities; the audit pins the three private-key hashes.
!tests/fixtures/tls/ca.pem
!tests/fixtures/tls/cn-only.pem
!tests/fixtures/tls/encrypted-key.pem
!tests/fixtures/tls/ip.pem
!tests/fixtures/tls/expired-chain.pem
!tests/fixtures/tls/expired-key.pem
!tests/fixtures/tls/expired.pem
!tests/fixtures/tls/malformed.pem
!tests/fixtures/tls/server-chain.pem
!tests/fixtures/tls/server-key.pem
!tests/fixtures/tls/server.pem
