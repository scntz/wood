# Cryptographic entropy comes from the OS; no user-space PRNG or insecure fallback.
import std.binary as binary

fn bytes(size: int) -> str:
    return random_bytes(size)

fn below(bound: int) -> int:
    if bound <= 0:
        raise "random bound must be positive"
    if bound == 1:
        return 0
    maximum = 9223372036854775807
    # 2**63 cannot be represented as an int. Compute its remainder without
    # overflowing; rejection keeps the accepted population divisible by bound.
    remainder = (maximum % bound + 1) % bound
    cutoff = maximum - remainder
    for attempt in range(256):
        raw = bytes(8)
        value = binary.unpack_uint(raw[:7], "little") | ((byte_value(raw[7]) & 127) << 56)
        if value <= cutoff:
            return value % bound
    raise "random selection retry budget exhausted"
