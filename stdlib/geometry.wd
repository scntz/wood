import std.num as num
import std.linalg as la
import std.io as io

record Mesh:
    vertices: array[float]
    triangles: array[int]

fn validate(mesh: Mesh):
    points = num.shape(mesh.vertices)
    faces = num.shape(mesh.triangles)
    if len(points) != 2 or len(faces) != 2:
        raise "mesh buffers must be rank two"
    if points[1] != 3 or faces[1] != 3:
        raise "mesh buffers must have three columns"
    for value in mesh.vertices:
        if not num.finite(value):
            raise "mesh coordinates must be finite"
    for index in mesh.triangles:
        if index < 0 or index >= points[0]:
            raise "triangle vertex index is out of bounds"

fn point(vertices: array[float], index: int):
    return la.Vec3(vertices[index,0],vertices[index,1],vertices[index,2])

fn transformed(mesh: Mesh, matrix: array[float]):
    validate(mesh)
    return Mesh(la.transform_points(mesh.vertices,matrix), mesh.triangles)

fn bounds(mesh: Mesh) -> tuple[la.Vec3,la.Vec3]:
    validate(mesh)
    count = num.shape(mesh.vertices)[0]
    if count == 0:
        raise "an empty mesh has no bounding box"
    low = point(mesh.vertices,0)
    high = low
    for index in range(1,count):
        value = point(mesh.vertices,index)
        if value.x < low.x:
            low.x = value.x
        if value.y < low.y:
            low.y = value.y
        if value.z < low.z:
            low.z = value.z
        if value.x > high.x:
            high.x = value.x
        if value.y > high.y:
            high.y = value.y
        if value.z > high.z:
            high.z = value.z
    return (low,high)

fn area(mesh: Mesh) -> float:
    validate(mesh)
    areas = num.zeros(num.shape(mesh.triangles)[0])
    for face in range(len(areas)):
        a = point(mesh.vertices,mesh.triangles[face,0])
        b = point(mesh.vertices,mesh.triangles[face,1])
        c = point(mesh.vertices,mesh.triangles[face,2])
        areas[face] = b.minus(a).cross(c.minus(a)).length() * 0.5
    return num.sum(areas)

fn normals(mesh: Mesh) -> array[float]:
    validate(mesh)
    result = num.zeros(num.shape(mesh.vertices))
    for face in range(num.shape(mesh.triangles)[0]):
        a = point(mesh.vertices,mesh.triangles[face,0])
        b = point(mesh.vertices,mesh.triangles[face,1])
        c = point(mesh.vertices,mesh.triangles[face,2])
        normal = b.minus(a).cross(c.minus(a))
        if not num.finite(normal.x) or not num.finite(normal.y) or not num.finite(normal.z):
            raise "triangle normal is not representable"
        for corner in range(3):
            index = mesh.triangles[face,corner]
            result[index,0] += normal.x
            result[index,1] += normal.y
            result[index,2] += normal.z
    for index in range(num.shape(result)[0]):
        normal = point(result,index).normalized()
        result[index,0] = normal.x
        result[index,1] = normal.y
        result[index,2] = normal.z
    return result

# Closed, outward-wound, periodic triangle mesh with no duplicated seam vertices.
fn torus(rings: int, sides: int, major: float = 2.0, minor: float = 0.5) -> Mesh:
    if rings < 3 or sides < 3 or rings > 2048 or sides > 2048:
        raise "torus subdivisions must be in 3..2048"
    if major <= minor or minor <= 0.0 or not num.finite(major) or not num.finite(minor):
        raise "torus requires finite major > minor > 0"
    if not num.finite(major + minor):
        raise "torus radius is not representable"
    vertices = num.zeros((rings*sides,3))
    faces = num.ints((rings*sides*2,3))
    tau = 6.283185307179586
    for ring in range(rings):
        u = tau * float(ring) / float(rings)
        for side in range(sides):
            v = tau * float(side) / float(sides)
            index = ring*sides + side
            radius = major + minor*num.cos(v)
            vertices[index,0] = radius*num.cos(u)
            vertices[index,1] = minor*num.sin(v)
            vertices[index,2] = radius*num.sin(u)
            a = index
            b = ((ring+1)%rings)*sides + side
            c = ((ring+1)%rings)*sides + (side+1)%sides
            d = ring*sides + (side+1)%sides
            faces[index*2,0] = a
            faces[index*2,1] = c
            faces[index*2,2] = b
            faces[index*2+1,0] = a
            faces[index*2+1,1] = d
            faces[index*2+1,2] = c
    return Mesh(vertices,faces)

fn write_obj(mesh: Mesh, path: str):
    validate(mesh)
    normal = normals(mesh)
    # Validate/compute before opening output, so invalid geometry cannot truncate it.
    with io.open(path,"w") as output:
        io.write(output,"# Wood native triangle mesh\n")
        for index in range(num.shape(mesh.vertices)[0]):
            vertex = point(mesh.vertices,index)
            n = point(normal,index)
            io.write(output,"v " + str(vertex.x) + " " + str(vertex.y) + " " + str(vertex.z) + "\n")
            io.write(output,"vn " + str(n.x) + " " + str(n.y) + " " + str(n.z) + "\n")
        for face in range(num.shape(mesh.triangles)[0]):
            a = str(mesh.triangles[face,0]+1)
            b = str(mesh.triangles[face,1]+1)
            c = str(mesh.triangles[face,2]+1)
            io.write(output,"f " + a + "//" + a + " " + b + "//" + b + " " + c + "//" + c + "\n")
        io.flush(output)

fn _obj_message(line_number: int, detail: str) -> str:
    return "OBJ line " + str(line_number) + ": " + detail

# At most four fields: do not construct a token list proportional to a bad line.
fn _obj_fields(text: str, line_number: int) -> list[str]:
    if "\0" in text:
        raise _obj_message(line_number,"NUL bytes are not supported")
    comment = find(text,"#")
    content = text
    if comment >= 0:
        content = content[:comment]
    remaining = strip(replace(content,"\t"," "))
    fields: list[str] = []
    while len(remaining) > 0:
        if len(fields) == 4:
            raise _obj_message(line_number,"expected at most four fields; only triangles are supported")
        separator = find(remaining," ")
        if separator < 0:
            append(fields,remaining)
            break
        append(fields,remaining[:separator])
        remaining = strip(remaining[separator+1:])
    return fields

fn _obj_real(text: str, line_number: int) -> float:
    # OBJ decimals may omit the digits on either side of a decimal point.
    # Normalize those spellings for Wood's stricter finite float conversion.
    normalized = text
    sign = 0
    if starts_with(text,"+") or starts_with(text,"-"):
        sign = 1
    if len(text) > sign + 1 and text[sign] == "." and "0" <= text[sign+1] <= "9":
        normalized = text[:sign] + "0" + text[sign:]
    dot = find(normalized,".")
    if dot >= 0:
        if dot + 1 == len(normalized) or normalized[dot+1] in ["e","E"]:
            normalized = normalized[:dot+1] + "0" + normalized[dot+1:]
    try:
        return float(normalized)
    except err:
        if err.code != "R4003":
            raise err
        raise _obj_message(line_number,"invalid finite coordinate: " + text[:48])

fn _obj_index(text: str, count: int, line_number: int) -> int:
    value = 0
    try:
        value = int(text)
    except err:
        if err.code != "R4003":
            raise err
        raise _obj_message(line_number,"invalid index: " + text[:48])
    if value < 0:
        # Compare before adding; never negate an untrusted INT64_MIN index.
        if value < -count:
            raise _obj_message(line_number,"relative index precedes available records")
        return count + value
    if value == 0 or value > count:
        raise _obj_message(line_number,"index must reference an already defined record")
    return value - 1

fn _obj_corner(text: str, vertex_count: int, normal_count: int, line_number: int) -> tuple[int,bool]:
    separator = find(text,"/")
    if separator < 0:
        return (_obj_index(text,vertex_count,line_number),false)
    if text[separator:separator+2] != "//" or "/" in text[separator+2:]:
        raise _obj_message(line_number,"face corners must use v or v//vn; texture coordinates are unsupported")
    vertex = _obj_index(text[:separator],vertex_count,line_number)
    _obj_index(text[separator+2:],normal_count,line_number)
    return (vertex,true)

# Geometry-only OBJ subset. Normal records/references are validated but Mesh does
# not retain shading normals; write_obj recomputes them from the final geometry.
fn read_obj(path: str, *, max_bytes: int = 16777216, max_vertices: int = 1000000, max_triangles: int = 1000000, max_normals: int = 1000000, max_line_bytes: int = 4096) -> Mesh:
    if max_bytes < 0 or max_bytes > 1073741824:
        raise "OBJ max_bytes must be in 0..1073741824"
    if max_vertices < 0 or max_vertices > 1000000 or max_triangles < 0 or max_triangles > 1000000 or max_normals < 0 or max_normals > 1000000:
        raise "OBJ record limits must be in 0..1000000"
    if max_line_bytes < 1 or max_line_bytes > 65536:
        raise "OBJ max_line_bytes must be in 1..65536"
    coordinates: list[float] = []
    indices: list[int] = []
    vertex_count = 0
    triangle_count = 0
    normal_count = 0
    consumed = 0
    line_number = 0
    with io.open(path,"r") as source:
        while true:
            budget = max_line_bytes
            if max_bytes - consumed < budget:
                budget = max_bytes - consumed
            # line reads at most the budget plus one excess-detection byte.
            # A zero budget still distinguishes exact EOF from excess input.
            text = io.line(source,budget)
            if len(text) == 0:
                break
            consumed += len(text)
            line_number += 1
            fields = _obj_fields(text,line_number)
            if len(fields) == 0:
                continue
            kind = fields[0]
            if kind not in ["v","vn","f"]:
                raise _obj_message(line_number,"unsupported record: " + kind[:48])
            if len(fields) != 4:
                raise _obj_message(line_number,"v, vn and triangular f records require exactly three arguments")
            if kind == "v":
                if vertex_count == max_vertices:
                    raise _obj_message(line_number,"vertex limit exceeded")
                for component in range(1,4):
                    append(coordinates,_obj_real(fields[component],line_number))
                vertex_count += 1
            elif kind == "vn":
                if normal_count == max_normals:
                    raise _obj_message(line_number,"normal record limit exceeded")
                for component in range(1,4):
                    _obj_real(fields[component],line_number)
                normal_count += 1
            elif kind == "f":
                if triangle_count == max_triangles:
                    raise _obj_message(line_number,"triangle limit exceeded")
                first = _obj_corner(fields[1],vertex_count,normal_count,line_number)
                second = _obj_corner(fields[2],vertex_count,normal_count,line_number)
                third = _obj_corner(fields[3],vertex_count,normal_count,line_number)
                if first[1] != second[1] or first[1] != third[1]:
                    raise _obj_message(line_number,"a face must use the same corner syntax throughout")
                append(indices,first[0])
                append(indices,second[0])
                append(indices,third[0])
                triangle_count += 1
    result = Mesh(num.reshape(num.from_list(coordinates),(vertex_count,3)),num.reshape(num.from_list(indices),(triangle_count,3)))
    validate(result)
    return result
