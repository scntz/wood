fn sum_int(values: list[int]) -> int:
    total = 0
    for value in values:
        total = total + value
    return total

fn mean(values: list[float]) -> float:
    if len(values) == 0:
        raise "mean requires a nonempty list"
    # Split only an overflowing subtraction. Splitting ordinary/subnormal terms
    # separately can lose cancellation when division underflows.
    result = 0.0
    count = 0
    for value in values:
        count = count + 1
        delta = value - result
        if delta > 1.7976931348623157e308 or delta < -1.7976931348623157e308:
            result = result - result / count + value / count
        else:
            result = result + delta / count
    return result

fn variance(values: list[float]) -> float:
    if len(values) == 0:
        raise "variance requires a nonempty list"
    # Normalize first: the unscaled sum of squares can overflow even when
    # population variance is representable. Reconstruct in a safe order.
    scale = 0.0
    for value in values:
        if value != value:
            return value
        magnitude = value
        if magnitude < 0.0:
            magnitude = -magnitude
        if magnitude > scale:
            scale = magnitude
    if scale == 0.0:
        return 0.0
    average = 0.0
    squares = 0.0
    count = 0
    for value in values:
        value = value / scale
        count = count + 1
        delta = value - average
        average = average + delta / count
        squares = squares + delta * (value - average)
    return ((squares / count) * scale) * scale
