cmake_minimum_required(VERSION 3.25)
foreach(name IN ITEMS INPUT OUTPUT)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Supply ${name}")
    endif()
endforeach()
if(NOT EXISTS "${INPUT}" OR IS_SYMLINK "${INPUT}" OR EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Use a regular generated C++ input and a new output file")
endif()
file(READ "${INPUT}" text)
set(count 0)
foreach(entry IN ITEMS "int main(int argc, char** argv) {" "int wmain(int argc, wchar_t** argv) {")
    string(FIND "${text}" "${entry}" position)
    if(NOT position LESS 0)
        math(EXPR count "${count}+1")
        string(REPLACE "${entry}" "${entry}\n    bench_reset();" text "${text}")
    endif()
endforeach()
if(count EQUAL 0)
    message(FATAL_ERROR "No supported Wood-generated C++ main/wmain entry")
endif()
file(WRITE "${OUTPUT}" "${text}")
message(STATUS "Counter reset inserted in ${count} platform entries; compile with compiler_cpp_profile.hpp preincluded")
