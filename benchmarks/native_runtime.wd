# Deterministic work/allocation profile. No clocks or timings.
import std.iter as it
import std.csv as csv
import std.num as num
extern fn bench_reset()
extern fn bench_stop() -> int
extern fn bench_bytes() -> int
extern fn bench_peak() -> int
extern fn bench_retains() -> int
extern fn bench_releases() -> int
extern fn bench_unique() -> int
extern fn bench_shared() -> int

record Metrics:
    checksum: int
    allocations: int
    requested_bytes: int
    peak_additional_bytes: int
    retains: int
    releases: int
    unique_managed_slots: int
    shared_managed_slots: int

arguments = args()
if len(arguments) != 4:
    raise "expected mode, count, rounds, output path"
mode = arguments[0]
count = int(arguments[1])
rounds = int(arguments[2])
if count < 1 or count > 10000 or rounds < 1 or rounds > 100:
    raise "unsupported profile size"
if mode not in ["list", "snapshot", "scalars", "map", "pipeline", "csv", "array"]:
    raise "unknown profile mode"
fields = ["member-"+str(i)+":"+"payload-"*12 for i in range(count)]
rows = [[fields[(i+j)%count] for j in range(16)] for i in range(count)]
numeric = num.from_list([float(i%17) for i in range(count)])
result: list[str] = []
scalar: list[int] = []
array_result = numeric
text = ""
checksum = 0
bench_reset()
for round in range(rounds):
    if mode == "list" or mode == "snapshot":
        values: list[str] = []
        for field in fields:
            append(values, field)
        if mode == "snapshot":
            snapshot = values
            values[-1] = "changed"
            assert(snapshot[-1] == fields[-1])
        for value in values:
            checksum += len(value)
        result = values
    elif mode == "scalars":
        numbers: list[int] = []
        for value in range(count):
            append(numbers, value)
        for value in numbers:
            checksum += value
        scalar = numbers
    elif mode == "map":
        table: dict[int,str] = {}
        for index in range(count):
            table[index] = fields[index]
        for index in range(count):
            checksum += len(table[index])
        result = [table[index] for index in range(count)]
    elif mode == "pipeline":
        checksum += it.fold(it.map(fields, fn(value) => len(value)), 0, fn(total, value) => total+value)
        result = fields
    elif mode == "csv":
        text = csv.dump(rows, ",")
        checksum += len(text)
    else:
        array_result = numeric*2.0+1.0
        checksum += int(num.sum(array_result))
allocations = bench_stop()
metrics = Metrics(checksum, allocations, bench_bytes(), bench_peak(), bench_retains(), bench_releases(), bench_unique(), bench_shared())
if mode == "scalars":
    text = join([str(value) for value in scalar], "\n")
elif mode == "array":
    text = join([str(int(value)) for value in array_result], "\n")
elif mode != "csv":
    text = join(result, "\n")
write_text(arguments[3], text)
print(json_dump(metrics))
