cmake_minimum_required(VERSION 3.25)
# Counter/output-only replay. This script deliberately has no timing mode.
foreach(required IN ITEMS BEFORE OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Use a new output directory; preserve prior profiles")
endif()
if(NOT DEFINED COUNT)
    set(COUNT 2000)
endif()
if(NOT DEFINED ROUNDS)
    set(ROUNDS 6)
endif()
if(NOT DEFINED SAMPLES)
    set(SAMPLES 3)
endif()
if(SAMPLES LESS 1 OR SAMPLES GREATER 10)
    message(FATAL_ERROR "SAMPLES must be 1..10")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
set(results "[]")
set(index 0)
foreach(mode IN ITEMS list snapshot scalars map pipeline csv array)
    set(expected_hash "")
    set(expected_checksum "")
    foreach(sample RANGE 1 ${SAMPLES})
        foreach(variant IN ITEMS BEFORE AFTER CPP PYTHON)
            if(NOT DEFINED ${variant} OR "${${variant}}" STREQUAL "")
                continue()
            endif()
            set(program "${${variant}}")
            if("${variant}" STREQUAL "PYTHON")
                list(APPEND program "${CMAKE_CURRENT_LIST_DIR}/reference_native_runtime.py")
            endif()
            set(label "${mode}-${variant}-${sample}")
            set(payload "${OUTPUT}/${label}.output")
            execute_process(COMMAND ${program} "${mode}" "${COUNT}" "${ROUNDS}" "${payload}"
                RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
            file(WRITE "${OUTPUT}/${label}.stdout" "${out}")
            file(WRITE "${OUTPUT}/${label}.stderr" "${err}")
            if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
                message(FATAL_ERROR "${label}: ${status}: ${out}${err}")
            endif()
            string(JSON checksum GET "${out}" checksum)
            file(SHA256 "${payload}" hash)
            if(expected_hash STREQUAL "")
                set(expected_hash "${hash}")
                set(expected_checksum "${checksum}")
            elseif(NOT hash STREQUAL expected_hash OR NOT checksum STREQUAL expected_checksum)
                message(FATAL_ERROR "Complete output/checksum differs: ${label}")
            endif()
            if("${variant}" STREQUAL "BEFORE" OR "${variant}" STREQUAL "AFTER")
                set(key "${mode}_${variant}")
                if(DEFINED previous_${key})
                    if(NOT out STREQUAL "${previous_${key}}")
                        message(FATAL_ERROR "Non-reproducible native counters: ${label}")
                    endif()
                endif()
                set(previous_${key} "${out}")
            endif()
            set(row "{}")
            string(JSON row SET "${row}" mode "\"${mode}\"")
            string(JSON row SET "${row}" variant "\"${variant}\"")
            string(JSON row SET "${row}" sample "${sample}")
            string(JSON row SET "${row}" metrics "${out}")
            string(JSON row SET "${row}" output_sha256 "\"${hash}\"")
            string(JSON results SET "${results}" ${index} "${row}")
            math(EXPR index "${index}+1")
        endforeach()
    endforeach()
endforeach()
file(WRITE "${OUTPUT}/profiles.json" "${results}\n")
message(STATUS "${index} counter/output profiles passed; no execution times collected")
