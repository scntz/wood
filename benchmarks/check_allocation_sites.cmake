cmake_minimum_required(VERSION 3.25)
foreach(name IN ITEMS CLANG SOURCE_DIR OUTPUT)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Supply ${name}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(OUTPUT "${OUTPUT}/run-${id}")
if(EXISTS "${OUTPUT}")
    message(FATAL_ERROR "Use a new oracle output directory")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
execute_process(COMMAND "${CLANG}" -std=c17 -O1 -g -fsanitize=address,undefined
    -fno-omit-frame-pointer -Wall -Wextra -Werror
    "${SOURCE_DIR}/benchmarks/allocation_sites_test.c" -o "${OUTPUT}/oracle"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${OUTPUT}/build.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Profiler oracle compilation failed: ${out}${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
    UBSAN_OPTIONS=halt_on_error=1 "${OUTPUT}/oracle" RESULT_VARIABLE status
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${OUTPUT}/stdout" "${out}")
file(WRITE "${OUTPUT}/stderr" "${err}")
if(NOT status STREQUAL "0" OR NOT out STREQUAL "allocation-site registry/lifetime oracle passed\n")
    message(FATAL_ERROR "Profiler oracle failed: ${status}: ${out}${err}")
endif()
file(STRINGS "${OUTPUT}/stderr" reports)
list(LENGTH reports count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "Missing profiler metadata/site reports")
endif()
foreach(report IN LISTS reports)
    string(JSON valid TYPE "${report}")
    if(NOT valid STREQUAL OBJECT)
        message(FATAL_ERROR "Invalid profiler JSON")
    endif()
endforeach()
foreach(mode IN ITEMS unknown-free wrong-size table-full)
    execute_process(COMMAND "${OUTPUT}/oracle" "${mode}" RESULT_VARIABLE status
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    file(WRITE "${OUTPUT}/${mode}.log" "${out}${err}")
    if(NOT status STREQUAL "Illegal instruction" OR out MATCHES "oracle passed")
        message(FATAL_ERROR "Expected a profiler trap for ${mode}, received ${status}: ${out}${err}")
    endif()
endforeach()
message(STATUS "Profiler registry, all age bins and invalid-accounting guards passed under ASan/UBSan")
