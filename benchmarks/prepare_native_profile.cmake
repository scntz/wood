cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS CLANG TARGET OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Use a new profile output directory")
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED RUNTIME_DIR)
    set(RUNTIME_DIR "${root}/runtime/native")
endif()
foreach(required IN ITEMS managed.c managed.h core.ll ${TARGET}.ll)
    if(NOT EXISTS "${RUNTIME_DIR}/${required}" OR IS_SYMLINK "${RUNTIME_DIR}/${required}")
        message(FATAL_ERROR "Supply a regular ABI-4 runtime source directory: ${required}")
    endif()
endforeach()
file(REAL_PATH "${RUNTIME_DIR}" runtime_real)
get_filename_component(output_absolute "${OUTPUT}" ABSOLUTE)
cmake_path(IS_PREFIX runtime_real "${output_absolute}" NORMALIZE inside_runtime)
if(inside_runtime)
    message(FATAL_ERROR "Profile output must be outside the input runtime directory")
endif()
file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE "${RUNTIME_DIR}/*")
foreach(entry IN LISTS entries)
    if(IS_SYMLINK "${entry}")
        message(FATAL_ERROR "Profile source must not contain links: ${entry}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT}")
file(COPY "${RUNTIME_DIR}/" DESTINATION "${OUTPUT}/runtime")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/native_profile.c" DESTINATION "${OUTPUT}/runtime")
file(READ "${OUTPUT}/runtime/managed.c" managed)
foreach(name IN ITEMS retain release)
    set(needle "void wd_m_${name}(void *value) {")
    string(REGEX MATCHALL "void wd_m_${name}\\(void \\*value\\) \\{" found "${managed}")
    list(LENGTH found count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one ABI-4 ${name} definition; update profiling explicitly")
    endif()
    string(REPLACE "${needle}" "void wd_profile_raw_${name}(void *value) {" managed "${managed}")
endforeach()
set(copy "copy_bytes(data(next), data(old), (WSize)(old->length * old->stride));")
string(FIND "${managed}" "${copy}" position)
if(position LESS 0)
    message(FATAL_ERROR "Sequence-copy instrumentation site changed")
endif()
string(REPLACE "${copy}" "wd_profile_seq_copy(old->length,old->retain!=0,owner_refs(&old->owner)==1);\n    ${copy}" managed "${managed}")
string(REPLACE "#include \"managed.h\"" "#include \"managed.h\"\nvoid wd_profile_seq_copy(WInt,WInt,WInt);" managed "${managed}")
file(WRITE "${OUTPUT}/runtime/managed.c" "${managed}\n#include \"native_profile.c\"\n")
if(ALLOCATION_SITES)
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/native_allocation_sites.c" DESTINATION "${OUTPUT}/runtime")
    set(needle "static WOwner *allocate(void *ctx, WInt bytes, void (*destroy)(void *)) {")
    string(FIND "${managed}" "${needle}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Allocation tracing requires the known owner allocation helper")
    endif()
    string(REPLACE "${needle}" "static WOwner *profile_owner_allocate(void *ctx, WInt bytes, void (*destroy)(void *), const char *function, const char *file, WInt line, WInt stride) {\n    wd_profile_request(ctx,function,file,line,stride);" managed "${managed}")
    string(REPLACE "void *p = wd_platform_alloc((WSize)bytes);" "void *p = wd_platform_alloc((WSize)bytes);\n    wd_profile_request_end();" managed "${managed}")
    string(REPLACE "void wd_profile_raw_retain(void *value) {" "#define allocate(ctx,bytes,destroy) profile_owner_allocate(ctx,bytes,destroy,__func__,__FILE__,__LINE__,0)\n#define allocate_sequence(ctx,bytes,destroy,stride) profile_owner_allocate(ctx,bytes,destroy,__func__,__FILE__,__LINE__,stride)\nvoid wd_profile_raw_retain(void *value) {" managed "${managed}")
    string(REPLACE "allocate(ctx, bytes, seq_destroy)" "allocate_sequence(ctx, bytes, seq_destroy, stride)" managed "${managed}")
    string(REPLACE "#include \"managed.h\"" "#include \"managed.h\"\nvoid wd_profile_request(void *,const char *,const char *,WInt,WInt);\nvoid wd_profile_request_end(void);" managed "${managed}")
    file(WRITE "${OUTPUT}/runtime/managed.c" "#define WOOD_PROFILE_SITES 1\n${managed}\n#include \"native_profile.c\"\n")
endif()
foreach(target IN ITEMS linux-x86_64 windows-x86_64)
    file(READ "${OUTPUT}/runtime/${target}.ll" port)
    string(REPLACE "define ptr @wd_platform_alloc(" "define ptr @wd_profile_platform_alloc(" port "${port}")
    string(REPLACE "define void @wd_platform_free(" "define void @wd_profile_platform_free(" port "${port}")
    file(WRITE "${OUTPUT}/runtime/${target}.ll" "${port}\ndeclare ptr @wd_platform_alloc(i64)\ndeclare void @wd_platform_free(ptr,i64)\n")
endforeach()
file(READ "${OUTPUT}/runtime/core.ll" core)
string(FIND "${core}" "define void @wd.check_memory() {" position)
if(position LESS 0)
    message(FATAL_ERROR "Missing normal-exit profiling hook")
endif()
string(REPLACE "define void @wd.check_memory() {" "define void @wd.check_memory() {\n  call void @wd_profile_report()" core "${core}")
file(WRITE "${OUTPUT}/runtime/core.ll" "${core}\ndeclare void @wd_profile_report()\n")
if(ALLOCATION_SITES)
    string(FIND "${core}" "%wd.ctx = type { i1, %wd.error, %wd.str, i64, i64, i1, i32 }" context_layout)
    if(context_layout LESS 0)
        message(FATAL_ERROR "Allocation source tracing requires the qualified ABI-4 context layout")
    endif()
    file(APPEND "${OUTPUT}/runtime/core.ll" "\ndefine void @wd_profile_location(ptr %ctx,ptr %file,ptr %line,ptr %column) {\n  %fp = getelementptr %wd.ctx,ptr %ctx,i32 0,i32 2\n  %lp = getelementptr %wd.ctx,ptr %ctx,i32 0,i32 3\n  %cp = getelementptr %wd.ctx,ptr %ctx,i32 0,i32 4\n  %f = load %wd.str,ptr %fp\n  %l = load i64,ptr %lp\n  %c = load i64,ptr %cp\n  store %wd.str %f,ptr %file\n  store i64 %l,ptr %line\n  store i64 %c,ptr %column\n  ret void\n}\n")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DCLANG=${CLANG} -DTARGET=${TARGET}
    -DRUNTIME_DIR=${OUTPUT}/runtime -DOUTPUT=${OUTPUT}/managed.o
    -P "${root}/tools/prepare-native-runtime.cmake" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Instrumented primitive preparation failed")
endif()
message(STATUS "Prepared private counters, no timing instrumentation: ${OUTPUT}")
