cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(project "${SOURCE_DIR}/examples/project")
foreach(compiler IN ITEMS "${WOOD}" "${PRODUCTION}")
    execute_process(COMMAND "${compiler}" check "${project}" --locked --diagnostics=json
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120 ENCODING UTF-8)
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Shipped project lock is unusable: ${status}: ${out}${err}")
    endif()
endforeach()
set(flags)
if(SANITIZE_GENERATED)
    list(APPEND flags --sanitize=address)
endif()
execute_process(COMMAND "${WOOD}" test "${project}" --locked --report=json ${flags}
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Shipped locked project tests failed: ${status}: ${out}${err}")
endif()
string(JSON passed GET "${out}" passed)
string(JSON failed GET "${out}" failed)
if(NOT passed EQUAL 1 OR NOT failed EQUAL 0)
    message(FATAL_ERROR "Shipped project test report differs: ${out}")
endif()
file(WRITE "${TEST_DIR}/input.txt" "3\n1\n2\n")
execute_process(COMMAND "${WOOD}" run "${project}" --locked ${flags} --
    "${TEST_DIR}/input.txt" "${TEST_DIR}/report.txt"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Shipped locked application failed: ${status}: ${out}${err}")
endif()
file(READ "${TEST_DIR}/report.txt" report)
if(NOT report STREQUAL "count: 3\nsum: 6\nsorted: [1, 2, 3]\n")
    message(FATAL_ERROR "Shipped project report differs: ${report}")
endif()
message(STATUS "Unmodified shipped project passes locked checks, tests and native execution")
