set(TEST_DIR "${TEST_DIR}/run-${run_id}/diagnostics á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(compare)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE actual_status
        OUTPUT_VARIABLE actual_out ERROR_VARIABLE actual_err
        WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 120 ENCODING UTF-8)
    execute_process(COMMAND "${PRODUCTION}" ${ARGN} RESULT_VARIABLE expected_status
        OUTPUT_VARIABLE expected_out ERROR_VARIABLE expected_err
        WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 120 ENCODING UTF-8)
    if(NOT actual_status STREQUAL expected_status OR NOT actual_out STREQUAL expected_out
            OR NOT actual_err STREQUAL expected_err)
        message(FATAL_ERROR "Diagnostic/CLI difference for ${ARGN}:\nactual=${actual_status}: ${actual_out}${actual_err}\nexpected=${expected_status}: ${expected_out}${expected_err}")
    endif()
endfunction()
foreach(option IN ITEMS --timeout-ms --max-output-bytes)
    foreach(value IN ITEMS -1 +1 999999999999999999999999)
        compare(check --diagnostics=json "${option}" "${value}")
    endforeach()
    compare(check --diagnostics=json "${option}")
endforeach()
compare(check --unknown --diagnostics=json)
