# Force an unclassified host exception in a generated translation unit. This is
# deliberate failure injection at the top-level native boundary, not a C API.
file(WRITE "${TEST_DIR}/native.wd" "print(1)\n")
foreach(label IN ITEMS candidate production)
    set(compiler "${WOOD}")
    if(label STREQUAL "production")
        set(compiler "${PRODUCTION}")
    endif()
    set(cpp "${TEST_DIR}/${label}.cpp")
    execute_process(COMMAND "${compiler}" emit-cpp "${TEST_DIR}/native.wd" --diagnostics=json -o "${cpp}"
        RESULT_VARIABLE status ERROR_VARIABLE err TIMEOUT 120 ENCODING UTF-8)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Exception-boundary emission failed: ${err}")
    endif()
    file(READ "${cpp}" generated)
    string(REPLACE "wd::init_args(argc,argv);" "wd::init_args(argc,argv); throw std::runtime_error(\"qualification failure\");" generated "${generated}")
    string(REPLACE "wd::init_args(argc, argv);" "wd::init_args(argc, argv); throw std::runtime_error(\"qualification failure\");" generated "${generated}")
    file(WRITE "${cpp}" "${generated}")
    set(executable "${TEST_DIR}/${label}")
    if(HOST_MSVC)
        string(APPEND executable ".exe")
        execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /EHsc /utf-8 /Od
            "/Fe:${executable}" "/Fo:${TEST_DIR}/${label}.obj" "${cpp}"
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
    else()
        execute_process(COMMAND "${HOST_CXX}" -std=c++23 -O0 "${cpp}" -pthread -ldl -o "${executable}"
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
    endif()
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Exception-boundary build failed: ${out}${err}")
    endif()
    execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE out
        ERROR_VARIABLE err TIMEOUT 30 ENCODING UTF-8)
    if(NOT status STREQUAL "70" OR NOT out STREQUAL "")
        message(FATAL_ERROR "Injected exception did not reach the native boundary: ${status}: ${out}${err}")
    endif()
    set(${label}_err "${err}")
endforeach()
