string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected)
    set(flags)
    if(SANITIZE_GENERATED AND (ARGV1 STREQUAL "build" OR ARGV1 MATCHES "[.]wd$"))
        list(APPEND flags --sanitize=address)
    endif()
    execute_process(COMMAND "${WOOD}" ${ARGN} ${flags} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 150 ENCODING UTF-8
        WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
invoke(0 --language-info)
string(JSON clauses GET "${last_output}" syntax comprehensions max_clauses)
string(JSON stores GET "${last_output}" syntax slice_assignment)
if(NOT clauses EQUAL 64 OR stores)
    message(FATAL_ERROR "Missing or incorrect expression capability metadata")
endif()
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${SOURCE_DIR}/tests/expressions.wd" "${level}")
    if(NOT last_output STREQUAL "native expressive language passed\n")
        message(FATAL_ERROR "Expression corpus output: ${last_output}")
    endif()
endforeach()
set(boundary "")
foreach(iterable IN ITEMS "range(1)" "[0]" "'x'" "{0:0}")
    string(APPEND boundary "assert([0")
    foreach(index RANGE 0 63)
        string(APPEND boundary " for x${index} in ${iterable}")
    endforeach()
    string(APPEND boundary "] == [0])\n")
endforeach()
string(APPEND boundary "assert(0")
foreach(index RANGE 1 255)
    string(APPEND boundary " == 0")
endforeach()
string(APPEND boundary ")\n")
file(WRITE "${TEST_DIR}/boundary.wd" "${boundary}")
invoke(0 "${TEST_DIR}/boundary.wd")
# Real imported functions, record results, list comprehensions and a standalone app.
file(WRITE "${TEST_DIR}/helpers.wd"
    "def collect(n: int) -> list[int]:\n    return [i * i for i in range(n) if i % 2 == 0]\n")
file(WRITE "${TEST_DIR}/imports.wd"
    "from helpers import collect as squares\nassert(squares(5)[::-1] == [16,4,0])\n")
invoke(0 "${TEST_DIR}/imports.wd")
invoke(0 inspect "${TEST_DIR}/helpers.wd")
string(JSON kind GET "${last_output}" modules 0 exports 0 returns_ref kind)
if(NOT kind STREQUAL "list")
    message(FATAL_ERROR "Inspection lost a def/comprehension function signature")
endif()
file(WRITE "${TEST_DIR}/sales.csv" "category,quantity,unit_cents\nbooks,2,1250\nfood,3,200\nbooks,1,10000\n")
if(WIN32)
    set(executable "${TEST_DIR}/report.exe")
else()
    set(executable "${TEST_DIR}/report")
endif()
invoke(0 build "${SOURCE_DIR}/examples/sales_report.wd" -o "${executable}")
execute_process(COMMAND "${executable}" "${TEST_DIR}/sales.csv" "${TEST_DIR}/sales.json"
    RESULT_VARIABLE status TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Standalone sales application failed: ${status}")
endif()
file(READ "${TEST_DIR}/sales.json" report)
string(JSON grand_total GET "${report}" total_cents)
string(JSON first_total GET "${report}" categories 0 total_cents)
string(JSON first_count GET "${report}" categories 0 entries)
string(JSON high_value GET "${report}" high_value_cents 0)
if(NOT grand_total EQUAL 13100 OR NOT first_total EQUAL 12500 OR
   NOT first_count EQUAL 2 OR NOT high_value EQUAL 10000)
    message(FATAL_ERROR "Sales report mismatch: ${report}")
endif()
file(WRITE "${TEST_DIR}/sales.csv" "category,quantity,unit_cents\nbooks,0,100\n")
execute_process(COMMAND "${executable}" "${TEST_DIR}/sales.csv" "${TEST_DIR}/sales.json"
    RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 30)
file(READ "${TEST_DIR}/sales.json" preserved)
if(NOT status STREQUAL "70" OR NOT error MATCHES "R4010" OR NOT preserved STREQUAL report)
    message(FATAL_ERROR "Invalid sales input replaced a valid report: ${status}: ${error}")
endif()
message(STATUS "Expression contracts, imports, standalone sales report and negative input passed")
