# Unpacking is checked before any code runs: tuples only, with exactly as many names as values.
function(rejected name source message)
    file(WRITE "${TEST_DIR}/rejected-${name}.wd" "${source}")
    invoke(1 check "${TEST_DIR}/rejected-${name}.wd")
    string(FIND "${last_error}" "${message}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Rejected case ${name} reported: ${last_error}")
    endif()
endfunction()
rejected(count "a, b = (1, 2, 3)\n" "cannot unpack a tuple of 3 values into 2 names")
rejected(list "a, b = [1, 2]\n" "cannot unpack list[int]; unpacking needs a tuple")
rejected(twice "a, a = (1, 2)\n" "'a' appears twice in the names to unpack into")
rejected(loop "for a, b in [1, 2]:\n    print(a)\n" "cannot unpack int; unpacking needs a tuple")
rejected(type "a = 1\na, b = ('s', 2)\n" "expected int, got str")
# Narrowing never lets a change reach a copy, and ends wherever the value may be None again.
rejected(narrow-append "xs: list[int] | None = [1]\nif xs is not None:\n    append(xs, 2)\n"
    "'xs' was narrowed from an optional here, so it cannot be changed in place")
rejected(narrow-augment "x: int | None = 1\nif x is not None:\n    x += 1\n"
    "'x' was narrowed from an optional here, so it cannot be changed in place")
rejected(narrow-loop "x: int | None = 3\nif x is not None:\n    n = 0\n    while n < 2:\n        print(x + 1)\n        x = None\n        n += 1\n"
    "operator '+' cannot combine int | None and int")
rejected(narrow-fallthrough "x: int | None = 3\nif x is None:\n    print('a')\nprint(x + 1)\n"
    "operator '+' cannot combine int | None and int")
# A bare raise needs an error being handled, and nothing jumps out of a finally block.
rejected(raise-bare "raise\n" "raise without a value re-raises the error being handled")
rejected(raise-function "try:\n    pass\nexcept err:\n    fn later():\n        raise\n"
    "raise without a value re-raises the error being handled")
rejected(finally-return "fn f():\n    try:\n        pass\n    finally:\n        return\n"
    "return cannot leave a finally block")
rejected(finally-break "for i in range(2):\n    try:\n        pass\n    finally:\n        break\n"
    "break and continue cannot leave a finally block")
rejected(finally-missing "try:\n    pass\nprint(1)\n" "expected 'except name:' or 'finally:' after try block")
rejected(error-type "e = error(1, 'm')\n" "expected str, got int")
rejected(char-slice "x = char_slice('abc', 1)\n" "wrong number of arguments to 'char_slice' (expected 3, got 2)")
