file(WRITE "${TEST_DIR}/imports.wd"
    "from helpers import wrap as pack\nfn offset(x: int) -> int:\n    return x + 100\nassert(pack('ok', count=3) == ('ok',4))\nassert(pack(5) == (5,2))\n")
