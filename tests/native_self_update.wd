# A write that reads the collection it writes must keep value semantics, keep its evaluation
# order and errors, and not copy the collection. Sizes make a copy on each write take minutes,
# so the CTest timeout fails a return of that behavior.
import std.num as num

record Point:
    name: str
    score: int

record Log:
    items: list[int]
    fn note(mut self, value: int) -> int:
        append(self.items, value)
        return value

record Box:
    items: list[int]
    fn add(mut self, value: int):
        append(self.items, value)
    fn bump(mut self, index: int):
        self.items[index] = self.items[index] + 1
    fn first(self) -> int:
        return self.items[0]

fn long(text: str) -> str:
    # Long enough to need its own allocation, so a dropped owner is a real use after free.
    return text + "-" + text + "-" + text + "-" + text + "-" + text + "-" + text

fn identity(values: list[int]) -> list[int]:
    return values

fn lists():
    values = [1, 2, 3]
    alias = values
    values[0] = values[0] + 10
    assert(values == [11, 2, 3] and alias == [1, 2, 3], "a copy made earlier is not changed")
    values[1] = values[2]
    values[2] = values[1] * values[0]
    assert(values == [11, 3, 33], "reads see the values before the write")
    values[values[1] - 3] = values[values[1] - 2] + 1
    assert(values == [4, 3, 33], "indexes may read the same list")
    values[0] = identity(values)[1]
    assert(values == [3, 3, 33], "calls may read the same list")
    values[0] += values[2]
    assert(values == [36, 3, 33], "augmented assignment may read the same list")
    append(values, values[0])
    append(values, values[len(values) - 1] + 1)
    assert(values == [36, 3, 33, 36, 37], "append may read the same list")

fn strings():
    names = [long("a"), long("b"), long("c")]
    alias = names
    names[0] = names[1]
    assert(names[0] == long("b") and alias[0] == long("a"), "a shared string stays alive")
    names[1] = names[1] + "!"
    names[2] = names[0] + names[2]
    assert(names[1] == long("b") + "!" and names[2] == long("b") + long("c"), "strings read before the write")
    names[0] += names[0]
    assert(names[0] == long("b") + long("b"), "augmented strings")
    only = [long("z")]
    only[0] = only[0][1:] + only[0][:1]
    assert(only[0] == long("z")[1:] + "z", "a slice of the old value outlives it")
    append(only, only[0] + only[0])
    assert(len(only) == 2 and only[1] == only[0] + only[0], "append keeps its argument alive")
    made: list[str] = []
    append(made, long("k") + "!")
    assert(made == [long("k") + "!"], "a fresh string moves into the list")
    table: dict[str,str] = {}
    table[long("k") + "?"] = long("v") + "!"
    assert(table[long("k") + "?"] == long("v") + "!", "a fresh key and value keep their owners")
    fresh = [long("q")]
    fresh[0] = str(len(fresh[0])) + fresh[0]
    assert(fresh[0] == str(len(long("q"))) + long("q"), "a computed value replaces its source")

fn nested():
    rows = [[1, 2], [3, 4]]
    alias = rows
    inner = rows[0]
    rows[0][1] = rows[0][1] + rows[1][1]
    assert(rows == [[1, 6], [3, 4]], "nested write")
    assert(alias == [[1, 2], [3, 4]] and inner == [1, 2], "earlier copies keep their values")
    rows[1] = rows[0]
    rows[1][0] = rows[0][0] + 100
    assert(rows == [[1, 6], [101, 6]], "an element copied from a sibling is independent")
    words = [[long("x")]]
    words[0] = [words[0][0] + "?"]
    assert(words[0][0] == long("x") + "?", "a list built from the old element")

fn records():
    points = [Point(long("p"), 1), Point(long("q"), 2)]
    alias = points
    points[0].score = points[0].score + points[1].score
    points[0].name = points[1].name + points[0].name
    assert(points[0].score == 3 and points[0].name == long("q") + long("p"), "fields")
    assert(alias[0].score == 1 and alias[0].name == long("p"), "a copy of the list is not changed")
    points[1] = points[0]
    points[1].score = points[1].score + 1
    assert(points[0].score == 3 and points[1].score == 4, "a copied record is independent")
    box = Box([1, 2])
    copy = box
    box.items[0] = box.items[1] + box.first()
    assert(box.items == [3, 2] and copy.items == [1, 2], "a list in a record")
    box.bump(1)
    box.add(box.items[0])
    box.add(box.first() + box.items[1])
    assert(box.items == [3, 3, 3, 6] and copy.items == [1, 2], "mutating methods may read what they change")

fn dictionaries():
    counts: dict[str, int] = {"a": 1}
    alias = counts
    counts["a"] = counts["a"] + 1
    counts["b"] = get(counts, "b", 10) + counts["a"]
    assert(counts["a"] == 2 and counts["b"] == 12, "dictionary reads")
    assert(alias["a"] == 1 and "b" not in alias, "a copy of the dictionary is not changed")
    counts[str(counts["a"])] = counts["b"]
    assert(counts["2"] == 12, "keys may read the same dictionary")
    text: dict[str, str] = {"k": long("v")}
    text["k"] = text["k"] + text["k"]
    text[text["k"]] = text["k"]
    assert(text[long("v") + long("v")] == long("v") + long("v"), "dictionary strings")
    assert(remove(text, text["k"]), "remove may read the same dictionary")

fn arrays():
    values = num.zeros([2, 2])
    alias = values
    view = values[0:1]
    values[0, 0] = values[0, 1] + 1.0
    values[1, 1] = values[0, 0] + 2.0
    values[0, 1] += values[1, 1]
    assert(values[0, 0] == 1.0 and values[1, 1] == 3.0 and values[0, 1] == 3.0, "array reads")
    assert(alias[0, 0] == 0.0 and view[0, 0] == 0.0, "copies and views keep their values")
    view[0, 1] = view[0, 1] + 5.0
    assert(view[0, 1] == 5.0 and values[0, 1] == 3.0, "a view written alone copies only itself")

fn calls_in_expressions():
    # An earlier operand may be owned only by its pin. Nothing here may end it early.
    names = [long("first"), long("second")]
    joined = names[0] + pop(names)
    assert(joined == long("first") + long("second"), "pop inside an expression")
    box = Box([5])
    total = box.first() + box.items[0]
    box.items[0] = total
    assert(box.items[0] == 10, "reads in an expression")

fn fails(code: int, list_index: int) -> str:
    # The error and its position must be the same as before this write ended its pins early.
    values = [1, 2, 3]
    alias = values
    try:
        if code == 0:
            values[list_index] = values[0] + 1
        elif code == 1:
            values[0] = values[list_index] + 1
        else:
            values[0] += values[list_index]
    except err:
        assert(values == [1, 2, 3] and alias == [1, 2, 3], "a failed write changes nothing")
        return err.code+" "+str(err.line)+":"+str(err.column)
    return "none"

fn order():
    log = Log([])
    values = [0, 0]
    values[log.note(1)] = log.note(7)
    assert(values == [0, 7] and log.items == [7, 1], "the value is evaluated before the index")

fn large():
    size = 400000
    values: list[float] = []
    for i in range(size):
        append(values, 1.0)
    for i in range(size):
        values[i] = values[i] + 1.0
    assert(values[size - 1] == 2.0, "list")
    grid = num.zeros([600, 600])
    for i in range(600):
        for j in range(600):
            grid[i, j] = grid[i, j] + 1.0
    assert(grid[599, 599] == 1.0, "array")
    points: list[Point] = []
    for i in range(100000):
        append(points, Point("p", i))
    for i in range(100000):
        points[i].score = points[i].score + 1
    assert(points[99999].score == 100000, "records")
    counts: dict[str, int] = {}
    for i in range(300000):
        key = "key" + str(i % 50021)
        counts[key] = get(counts, key, 0) + 1
    assert(len(counts) == 50021, "dictionary")
    growing: list[int] = [1]
    for i in range(300000):
        append(growing, growing[i] + 1)
    assert(growing[300000] == 300001, "append")

lists()
strings()
nested()
records()
dictionaries()
arrays()
calls_in_expressions()
order()
print(fails(0, 9))
print(fails(1, 9))
print(fails(2, 9))
large()
print("self update ok")
