# Exercise real frontend messages, the unchanged JSON schema, and imported
# source attribution without invoking a native compiler for rejected programs.
function(check_diagnostic source code line column message)
    file(WRITE "${TEST_DIR}/diagnostic.wd" "${source}")
    invoke(1 check "${TEST_DIR}/diagnostic.wd" --diagnostics=json --cxx not-a-real-toolchain)
    string(JSON field_count LENGTH "${last_error}")
    foreach(field IN ITEMS severity code file line column message)
        string(JSON actual_${field} GET "${last_error}" "${field}")
    endforeach()
    if(NOT field_count EQUAL 6 OR NOT actual_severity STREQUAL "error"
       OR NOT actual_code STREQUAL code OR NOT actual_line EQUAL line
       OR NOT actual_column EQUAL column OR NOT actual_message STREQUAL message
       OR NOT actual_file STREQUAL "${TEST_DIR}/diagnostic.wd" OR NOT last_output STREQUAL "")
        message(FATAL_ERROR "Unexpected frontend diagnostic: ${last_error}")
    endif()
endfunction()
