foreach(case IN ITEMS overflow zero step conversion assertion)
    if(case STREQUAL "overflow")
        set(source "print(9223372036854775807 + 1)\n")
        set(code R4001)
    elseif(case STREQUAL "zero")
        set(source "print(1 / 0)\n")
        set(code R4002)
    elseif(case STREQUAL "step")
        set(source "for i in range(0, 10, 0):\n    pass\n")
        set(code R4005)
    elseif(case STREQUAL "conversion")
        set(source "print(int(1e100))\n")
        set(code R4003)
    else()
        set(source "assert(false, 'deliberate failure')\n")
        set(code R4004)
    endif()
    file(WRITE "${TEST_DIR}/${case}.wd" "${source}")
    invoke(70 "${TEST_DIR}/${case}.wd")
    if(NOT last_error MATCHES "${code}" OR NOT last_error MATCHES ":1:[0-9]+: runtime error")
        message(FATAL_ERROR "Missing runtime diagnostic ${code}: ${last_error}")
    endif()
endforeach()
