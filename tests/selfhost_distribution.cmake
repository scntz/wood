cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/installed á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BINARY_DIR}" --config "${CONFIG}" --component SelfHosted --prefix "${TEST_DIR}/prefix"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120 ENCODING UTF-8)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Self-hosted installation failed: ${status}: ${out}${err}")
endif()
file(RENAME "${TEST_DIR}/prefix" "${TEST_DIR}/relocated")
set(prefix "${TEST_DIR}/relocated")
set(candidate "${prefix}/bin/wood-selfhost")
set(library "${prefix}/lib/libwood_driver_host.a")
set(stage2 "${TEST_DIR}/stage2")
if(WIN32)
    string(APPEND candidate ".exe")
    string(APPEND stage2 ".exe")
    set(library "${prefix}/lib/wood_driver_host.lib")
endif()
if(EXISTS "${prefix}/bin/wood" OR EXISTS "${prefix}/bin/wood.exe")
    message(FATAL_ERROR "Standalone component unexpectedly contains the C++ production compiler")
endif()
function(invoke expected)
    execute_process(COMMAND "${candidate}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
        WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 300 ENCODING UTF-8)
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "Installed CLI ${ARGN}: expected ${expected}, got ${status}: ${out}${err}")
    endif()
    set(last_out "${out}" PARENT_SCOPE)
    set(last_err "${err}" PARENT_SCOPE)
endfunction()
invoke(0 --version)
if(NOT last_out STREQUAL "wood 0.4.0\n" OR NOT last_err STREQUAL "")
    message(FATAL_ERROR "Installed version differs: ${last_out}${last_err}")
endif()
invoke(0 --language-info)
execute_process(COMMAND "${PRODUCTION}" --language-info RESULT_VARIABLE status OUTPUT_VARIABLE expected ERROR_VARIABLE err TIMEOUT 30 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT last_out STREQUAL expected)
    message(FATAL_ERROR "Installed language metadata differs")
endif()
invoke(0 init "${TEST_DIR}/app")
invoke(0 lock "${TEST_DIR}/app")
file(SHA256 "${TEST_DIR}/app/wood.lock" first)
invoke(0 lock "${TEST_DIR}/app")
file(SHA256 "${TEST_DIR}/app/wood.lock" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Lock refresh was nondeterministic")
endif()
invoke(0 check "${TEST_DIR}/app" --locked --cxx deliberately-missing)
invoke(0 run "${TEST_DIR}/app" --locked -- "installed user")
if(NOT last_out STREQUAL "hello, installed user\n")
    message(FATAL_ERROR "Installed project output differs: ${last_out}")
endif()
invoke(0 test "${TEST_DIR}/app" --locked --report=json)
string(JSON failed GET "${last_out}" failed)
if(NOT failed EQUAL 0)
    message(FATAL_ERROR "Installed test runner failed")
endif()
invoke(0 deps "${TEST_DIR}/app" --locked)
execute_process(COMMAND "${PRODUCTION}" deps "${TEST_DIR}/app" --locked RESULT_VARIABLE status OUTPUT_VARIABLE expected ERROR_VARIABLE err TIMEOUT 60 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT last_out STREQUAL expected)
    message(FATAL_ERROR "Installed dependency JSON differs")
endif()
invoke(0 inspect "${TEST_DIR}/app" --locked)
execute_process(COMMAND "${PRODUCTION}" inspect "${TEST_DIR}/app" --locked
    RESULT_VARIABLE status OUTPUT_VARIABLE expected ERROR_VARIABLE err TIMEOUT 60 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT last_out STREQUAL expected)
    message(FATAL_ERROR "Installed typed inspection JSON differs")
endif()
invoke(2 emit-cpp "${TEST_DIR}/app" --locked -o "${TEST_DIR}/app/wood.json" --diagnostics=json)
file(WRITE "${TEST_DIR}/bad.wd" "count: int = \"bad\"\n")
invoke(1 check "${TEST_DIR}/bad.wd" --diagnostics=json)
execute_process(COMMAND "${PRODUCTION}" check "${TEST_DIR}/bad.wd" --diagnostics=json
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE expected TIMEOUT 60 ENCODING UTF-8)
if(NOT status STREQUAL "1" OR NOT last_err STREQUAL expected)
    message(FATAL_ERROR "Frontend JSON differs from production:\n${last_err}\n${expected}")
endif()
file(WRITE "${TEST_DIR}/runtime.wd" "raise \"driver failure\"\n")
invoke(70 "${TEST_DIR}/runtime.wd" --diagnostics=json)
string(JSON code GET "${last_err}" code)
string(JSON message GET "${last_err}" message)
if(NOT code STREQUAL "R4010" OR NOT message STREQUAL "driver failure")
    message(FATAL_ERROR "Generated runtime JSON contract differs")
endif()
file(WRITE "${TEST_DIR}/args.wd" [==[
values=args()
assert(len(values)==5)
assert(values[0]=="a b" and values[1]=="")
assert(values[2]=="quotes \" and \\")
assert(values[3]=="á 🌳" and values[4]=="--diagnostics=json")
print("arguments preserved")
]==])
# Bracket arguments preserve the exact quote and trailing backslash.
execute_process(COMMAND "${candidate}" "${TEST_DIR}/args.wd" -- "a b" "" [=[quotes " and \]=] "á 🌳" "--diagnostics=json"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "arguments preserved\n")
    message(FATAL_ERROR "Argument forwarding differs: ${status}: ${out}${err}")
endif()
# A single executable copied away from the installation still embeds its assets.
file(COPY "${candidate}" DESTINATION "${TEST_DIR}/single")
set(single "${TEST_DIR}/single/wood-selfhost")
if(WIN32)
    string(APPEND single ".exe")
endif()
execute_process(COMMAND "${single}" check "${TEST_DIR}/app" --locked --cxx deliberately-missing
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60 ENCODING UTF-8)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Single-executable check depends on external bundles/frontend: ${out}${err}")
endif()
# Validate the eventual primary executable name in an isolated directory;
# never replace the current production command or change PATH.
file(MAKE_DIRECTORY "${TEST_DIR}/primary-name")
set(primary "${TEST_DIR}/primary-name/wood")
if(WIN32)
    string(APPEND primary ".exe")
endif()
file(COPY_FILE "${candidate}" "${primary}")
execute_process(COMMAND "${primary}" run "${TEST_DIR}/app" --locked -- "primary name"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "hello, primary name\n")
    message(FATAL_ERROR "Renamed primary compiler failed native project execution: ${status}: ${out}${err}")
endif()
# Rebuild the complete compiler/driver using installed Wood sources and OS bridge.
set(source "${prefix}/share/wood/bootstrap/src/driver_main.wd")
execute_process(COMMAND "${candidate}" build "${source}" --link-library "${library}" -O0 -o "${stage2}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900 ENCODING UTF-8)
file(WRITE "${TEST_DIR}/self-build.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Installed self-build failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${stage2}" check "${source}" --diagnostics=json
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Self-built driver cannot check itself: ${status}: ${out}${err}")
endif()
invoke(0 emit-cpp "${source}" -o "${TEST_DIR}/stage2.cpp")
execute_process(COMMAND "${stage2}" emit-cpp "${source}" -o "${TEST_DIR}/stage3.cpp"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Self-built driver failed next emission: ${status}: ${out}${err}")
endif()
file(SHA256 "${TEST_DIR}/stage2.cpp" first)
file(SHA256 "${TEST_DIR}/stage3.cpp" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Installed self-hosted fixed point differs: ${first}/${second}")
endif()
execute_process(COMMAND "${stage2}" run "${TEST_DIR}/app" --locked -- "self-built user"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "hello, self-built user\n")
    message(FATAL_ERROR "Self-built compiler cannot compile/run a locked application: ${status}: ${out}${err}")
endif()
file(WRITE "${TEST_DIR}/fixed-point.txt" "${first}\n")
message(STATUS "Standalone install, relocation, native workflows and self-built driver fixed point passed: ${TEST_DIR}")
