cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR PYTHON_EXECUTABLE NUMPY_EXECUTABLE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}; this opt-in gate uses real CPython and NumPy")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
if(WIN32)
    set(suffix .exe)
endif()
set(checks 0)
function(checked label expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    file(WRITE "${work}/${label}.log" "status=${status}\n${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}: ${out}${err}")
    endif()
    math(EXPR count "${checks}+1")
    set(checks "${count}" PARENT_SCOPE)
    set(last_output "${out}" PARENT_SCOPE)
    set(last_error "${err}" PARENT_SCOPE)
endfunction()
function(build label source level)
    checked("${label}-build" 0 "${WOOD}" build "${source}" --backend=llvm -O${level} -o "${work}/${label}${suffix}")
    set(checks "${checks}" PARENT_SCOPE)
endfunction()
checked(optional-metadata 0 "${WOOD}" --language-info)
string(JSON optional_module GET "${last_output}" optional_standard_modules 0 module)
string(JSON optional_backend GET "${last_output}" optional_standard_modules 0 backend)
if(NOT optional_module STREQUAL "std.python" OR NOT optional_backend STREQUAL "llvm")
    message(FATAL_ERROR "Native installation omitted the optional profile metadata")
endif()
foreach(level IN ITEMS 0 2)
    build("correctness-O${level}" "${SOURCE_DIR}/tests/native_python.wd" ${level})
    checked("correctness-O${level}-run" 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${PYTHON_EXECUTABLE}" "${work}/correctness-O${level}${suffix}")
    if(NOT last_output MATCHES "Python interop correctness passed" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Correctness output differs: ${last_output}${last_error}")
    endif()
endforeach()
checked(venv-correctness 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${NUMPY_EXECUTABLE}" "${work}/correctness-O2${suffix}")
build(numpy "${SOURCE_DIR}/examples/python_numpy.wd" 2)
checked(numpy-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${NUMPY_EXECUTABLE}" "${work}/numpy${suffix}")
string(REPLACE "\r\n" "\n" last_output "${last_output}")
if(NOT last_output STREQUAL "[[1.0,2.0],[3.0,4.0]]\n10.0\n[[7.0,10.0],[15.0,22.0]]\ncaught Python ValueError\n" OR NOT last_error STREQUAL "")
    message(FATAL_ERROR "NumPy output differs: ${last_output}${last_error}")
endif()
set(native_numpy_output "${last_output}")
checked(numpy-independent-reference 0 "${NUMPY_EXECUTABLE}" -I "${SOURCE_DIR}/tests/fixtures/python/numpy_reference.py")
string(REPLACE "\r\n" "\n" last_output "${last_output}")
if(NOT native_numpy_output STREQUAL last_output OR NOT last_error STREQUAL "")
    message(FATAL_ERROR "Real Python/NumPy and Wood results differ: ${last_output}${last_error}")
endif()
file(WRITE "${work}/plain.wd" "import python@math\nprint(42)\n")
build(plain "${work}/plain.wd" 2)
checked(no-python-core 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${work}/missing-python" "${work}/plain${suffix}")
file(WRITE "${work}/optional-only.wd" "fn inspect(value: py_object | None):\n    if value is not None:\n        with unwrap(value) as object:\n            pass\ninspect(None)\nprint(\"optional resource stayed native\")\n")
build(optional-only "${work}/optional-only.wd" 2)
checked(optional-without-python 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${work}/missing-python" "${work}/optional-only${suffix}")
file(WRITE "${work}/missing.wd" "import std.python as py\ncaught = false\ntry:\n    py.import_module(\"math\")\nexcept err:\n    caught = err.code == \"R4030\"\nassert(caught)\nprint(\"missing interpreter caught\")\n")
build(missing "${work}/missing.wd" 2)
checked(missing-interpreter 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${work}/missing-python" "${work}/missing${suffix}")
if(WIN32)
    # The exercised Windows launcher retains PATH after --unset; verified empty
    # values for both spellings reliably exercise zero search directories.
    checked(missing-path 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=" "VIRTUAL_ENV=" "PATH=" "Path=" "${work}/missing${suffix}")
else()
    checked(missing-path 0 "${CMAKE_COMMAND}" -E env --unset=WOOD_PYTHON --unset=VIRTUAL_ENV --unset=PATH "${work}/missing${suffix}")
endif()
checked(check-without-python 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${work}/missing-python" "${WOOD}" check "${SOURCE_DIR}/examples/python_numpy.wd")
file(WRITE "${work}/discovery.wd" "import python@math\nimport std.python as py\nassert(py.to_float(math.call(\"sqrt\",[py.value(81)])) == 9.0)\n")
build(discovery "${work}/discovery.wd" 2)
get_filename_component(python_bin "${NUMPY_EXECUTABLE}" DIRECTORY)
get_filename_component(venv_root "${python_bin}" DIRECTORY)
checked(activated-venv-discovery 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=" "VIRTUAL_ENV=${venv_root}" "${work}/discovery${suffix}")
checked(path-discovery 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=" "VIRTUAL_ENV=" "PATH=${python_bin}" "${work}/discovery${suffix}")
file(WRITE "${work}/submodule.wd" "import python@xml.etree.ElementTree as xml\nimport std.python as py\nwith xml.call(\"Element\",[py.value(\"wood\")]) as element:\n    assert(py.text(py.attr(element,\"tag\")) == \"wood\")\n")
build(submodule "${work}/submodule.wd" 2)
checked(submodule-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${PYTHON_EXECUTABLE}" "${work}/submodule${suffix}")
file(WRITE "${work}/worker-first.wd" "import std.python as py\nimport std.task as task\nfn worker(payload: json) -> json:\n    return py.to_json(py.value(payload))\ncaught = false\nwith task.spawn(worker,json(1)) as work:\n    try:\n        task.wait(work,10000)\n    except err:\n        caught = err.code == \"R4030\"\nassert(caught)\nassert(py.to_int(py.value(2)) == 2)\n")
build(worker-first "${work}/worker-first.wd" 2)
checked(worker-first-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${PYTHON_EXECUTABLE}" "${work}/worker-first${suffix}")
file(WRITE "${work}/cancel.wd" "import std.python as py\nimport std.task as task\nfn worker(payload: json) -> json:\n    with py.value(1) as object:\n        while not task.cancelled():\n            pass\n        return py.to_json(py.value(payload))\npy.close(py.import_module(\"math\"))\ncaught = false\nwith task.spawn(worker,json(1)) as work:\n    task.cancel(work)\n    try:\n        task.wait(work,10000)\n    except err:\n        caught = err.code == \"R4022\"\nassert(caught)\n")
build(cancel "${work}/cancel.wd" 2)
checked(cancel-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${PYTHON_EXECUTABLE}" "${work}/cancel${suffix}")
file(WRITE "${work}/shutdown.wd" "import std.python as py\nobject = py.value(1)\nrefused = false\ntry:\n    py.shutdown()\nexcept err:\n    refused = err.code == \"R4032\"\nassert(refused)\npy.close(object)\npy.shutdown()\nassert(py.closed(object))\ncaught = false\ntry:\n    py.value(1)\nexcept err:\n    caught = err.code == \"R4030\"\nassert(caught)\n")
build(shutdown "${work}/shutdown.wd" 2)
checked(shutdown-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${PYTHON_EXECUTABLE}" "${work}/shutdown${suffix}")
foreach(source IN ITEMS "import std@math\n" "from python@math import sqrt\n" "import python@\n")
    string(SHA256 name "${source}")
    file(WRITE "${work}/${name}.wd" "${source}")
    checked("syntax-${name}" 1 "${WOOD}" check "${work}/${name}.wd" --diagnostics=json)
    if(NOT last_error MATCHES "E[12][0-9][0-9][0-9]")
        message(FATAL_ERROR "Missing syntax diagnostic: ${last_error}")
    endif()
endforeach()
file(WRITE "${work}/bad-type.wd" "import std.python as py\npy.to_int(1)\n")
checked(type-error 1 "${WOOD}" check "${work}/bad-type.wd" --diagnostics=json)
if(NOT last_error MATCHES "E3002" OR NOT last_error MATCHES "py_object")
    message(FATAL_ERROR "Missing static type diagnostic: ${last_error}")
endif()
checked(no-cpp-fallback 1 "${WOOD}" emit-cpp "${SOURCE_DIR}/examples/python_numpy.wd" --backend=cpp --diagnostics=json -o "${work}/forbidden.cpp")
if(EXISTS "${work}/forbidden.cpp" OR NOT last_error MATCHES "B3501")
    message(FATAL_ERROR "Optional profile was not explicitly rejected by the C++ driver: ${last_error}")
endif()
checked(project-init 0 "${WOOD}" init "${work}/project")
file(COPY_FILE "${SOURCE_DIR}/examples/python_numpy.wd" "${work}/project/src/main.wd")
checked(project-lock 0 "${WOOD}" lock "${work}/project")
checked(project-inspect 0 "${WOOD}" inspect "${work}/project" --locked)
if(NOT last_output MATCHES "<python@numpy>")
    message(FATAL_ERROR "Provider module missing from structured inspection: ${last_output}")
endif()
checked(project-build 0 "${WOOD}" build "${work}/project" --locked --backend=llvm -O2 -o "${work}/project-app${suffix}")
checked(project-run 0 "${CMAKE_COMMAND}" -E env "WOOD_PYTHON=${NUMPY_EXECUTABLE}" "${work}/project-app${suffix}")
string(REPLACE "\r\n" "\n" last_output "${last_output}")
if(NOT last_output STREQUAL native_numpy_output OR NOT last_error STREQUAL "")
    message(FATAL_ERROR "Locked project NumPy results differ: ${last_output}${last_error}")
endif()
file(WRITE "${work}/validation.txt" "${checks} commands passed; real CPython, NumPy, O0/O2, venv, missing interpreter, cold-worker refusal, cancellation, shutdown, syntax/types and no-C++ fallback.\n")
message(STATUS "Optional Python qualification passed: ${checks} commands; evidence ${work}")
