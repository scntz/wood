cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR OUTPUT_FIXTURE BACKEND_TEST)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(cxx /usr/bin/g++)
set(suffix "")
set(modes stdout-closed stderr-closed stdout-invalid stderr-invalid stdout-pipe stderr-pipe)
if(WIN32)
    set(cxx cl.exe)
    set(suffix .exe)
else()
    list(APPEND modes stdout-full stderr-full)
    list(APPEND modes stdout-pipe-masked stderr-pipe-masked stdout-pipe-masked-pending stderr-pipe-masked-pending)
endif()
set(checks 0)
function(invoke label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR checks "${checks}+1")
    set(checks ${checks} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
if(NOT WIN32)
    invoke(thread-fixture-compile 0 /usr/bin/clang-19 -std=c17 -Wall -Wextra -Werror
        -c "${SOURCE_DIR}/tests/native/thread_failure.c" -o "${work}/thread-failure.o")
    invoke(thread-fixture-archive 0 ar rcs "${work}/thread-failure.a" "${work}/thread-failure.o")
endif()
foreach(level IN ITEMS 0 2)
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        foreach(source IN ITEMS native_spawn_io tasks)
            invoke(${source}-${backend}-O${level} 0 "${compiler}" run "${SOURCE_DIR}/tests/${source}.wd"
                -O${level} ${flags} -- "${SOURCE_DIR}/tests/fixtures/tls")
            if(NOT err STREQUAL "")
                message(FATAL_ERROR "${source}: unexpected stderr ${err}")
            endif()
            set(${source}_${backend} "${out}")
        endforeach()
        set(binary "${work}/output-${backend}-O${level}${suffix}")
        invoke(output-build-${backend}-O${level} 0 "${compiler}" build "${SOURCE_DIR}/tests/native_output.wd"
            -O${level} ${flags} -o "${binary}")
        foreach(mode IN LISTS modes)
            invoke(output-${backend}-${mode}-O${level} 0 "${OUTPUT_FIXTURE}" "${binary}" "${mode}"
                "${work}/${backend}-${mode}-O${level}.marker")
        endforeach()
        if(NOT WIN32)
            invoke(thread-start-failure-${backend}-O${level} 0 "${compiler}" run
                "${SOURCE_DIR}/tests/native_spawn_io_failure.wd" -O${level} ${flags}
                --link-library "${work}/thread-failure.a")
            if(NOT out STREQUAL "native spawn_io startup failure recovery passed\n" OR NOT err STREQUAL "")
                message(FATAL_ERROR "OS thread-start failure did not recover: ${out}${err}")
            endif()
        endif()
    endforeach()
    foreach(source IN ITEMS native_spawn_io tasks)
        if(NOT ${source}_native STREQUAL ${source}_cpp)
            message(FATAL_ERROR "${source}: native/reference output differs")
        endif()
    endforeach()
endforeach()
# Existing complete HTTPS + transactional SQLite application, including process
# restart, independent peers, concurrent requests and bounded worker scopes.
invoke(backend 0 "${CMAKE_COMMAND}" -DWOOD=${WOOD} -DSOURCE_DIR=${SOURCE_DIR}
    -DBACKEND_TEST=${BACKEND_TEST} -DPWSH=${PWSH} -DTEST_DIR=${work}/backend
    -P "${SOURCE_DIR}/tests/backend.cmake")
file(WRITE "${work}/validation.txt" "${checks} commands passed: O0/O2 socket/TLS transfer, buffered ownership, repeated errors/waits, nested handoff, cancellation/scoped joining, real failed output handles/pipes, and complete installed HTTPS/SQLite/task application.\n")
message(STATUS "Native Core lifecycle: ${checks} commands passed: ${work}")
