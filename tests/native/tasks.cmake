cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
set(cxx /usr/bin/g++)
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
endif()
if(NOT DEFINED TASK_LIBRARY)
    if(WIN32)
        message(FATAL_ERROR "Supply freestanding TASK_LIBRARY built from task_fixture.c")
    endif()
    set(TASK_LIBRARY "${work}/task-fixture.a")
    execute_process(COMMAND /usr/bin/clang-19 -std=c17 -ffreestanding -fno-builtin -fno-stack-protector
        -O2 -Wall -Wextra -Werror -c "${SOURCE_DIR}/tests/native/task_fixture.c" -o "${work}/fixture.o"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot build task callback fixture: ${out}${err}")
    endif()
    execute_process(COMMAND ar rcs "${TASK_LIBRARY}" "${work}/fixture.o" RESULT_VARIABLE status)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot archive task callback fixture")
    endif()
endif()
set(checks 0)
function(invoke label expected compiler)
    execute_process(COMMAND "${compiler}" ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label} failed: ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR checks "${checks}+1")
    set(checks ${checks} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS 0 2)
    foreach(case IN ITEMS native_task_boundary native_tasks native_task_limits)
        foreach(backend IN ITEMS native cpp)
            set(compiler "${WOOD}")
            set(flags)
            if(backend STREQUAL cpp)
                set(compiler "${PRODUCTION}")
                list(APPEND flags --cxx "${cxx}")
            endif()
            invoke(${case}-${backend}-O${level} 0 "${compiler}" run "${SOURCE_DIR}/tests/${case}.wd" -O${level} ${flags} --timeout-ms 120000)
            if(NOT err STREQUAL "")
                message(FATAL_ERROR "Unexpected task stderr: ${err}")
            endif()
            set(${backend} "${out}")
        endforeach()
        if(NOT native STREQUAL cpp)
            message(FATAL_ERROR "${case} native/C++ output differs")
        endif()
    endforeach()
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        set(binary "${work}/ffi-${backend}-O${level}${suffix}")
        invoke(ffi-build-${backend}-O${level} 0 "${compiler}" build "${SOURCE_DIR}/tests/native_task_ffi.wd" -O${level} ${flags} --link-library "${TASK_LIBRARY}" -o "${binary}")
        invoke(ffi-run-${backend}-O${level} 0 "${binary}")
        if(NOT err STREQUAL "" OR NOT out STREQUAL "native concurrent callback isolation passed\n")
            message(FATAL_ERROR "${backend} concurrent callback scope failed: ${out}${err}")
        endif()
        if(backend STREQUAL native AND NOT WIN32)
            execute_process(COMMAND readelf -l -d "${binary}" OUTPUT_VARIABLE elf RESULT_VARIABLE status)
            if(NOT status STREQUAL "0" OR elf MATCHES "INTERP|NEEDED")
                message(FATAL_ERROR "Native task program acquired a hosted runtime: ${elf}")
            endif()
        endif()
    endforeach()
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        invoke(resources-${backend}-O${level} 0 "${compiler}" run "${SOURCE_DIR}/tests/native_task_resources.wd" -O${level} ${flags} --link-library "${TASK_LIBRARY}")
        if(NOT out MATCHES "^native task resource bounds passed [0-9]+ [0-9]+\n$" OR NOT err STREQUAL "")
            message(FATAL_ERROR "Task resource cleanup failed: ${out}${err}")
        endif()
    endforeach()
endforeach()
foreach(mode IN ITEMS worker ignore parent)
    set(expected 23)
    if(mode STREQUAL ignore)
        set(expected 0)
    elseif(mode STREQUAL parent)
        set(expected 31)
    endif()
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        invoke(exit-${mode}-${backend} ${expected} "${compiler}" run "${SOURCE_DIR}/tests/native_task_exit.wd" -O0 ${flags} --timeout-ms 120000 -- ${mode})
        set(${backend} "${out}${err}")
    endforeach()
    if(NOT native STREQUAL cpp)
        message(FATAL_ERROR "${mode} exit/unwind differs")
    endif()
endforeach()
set(index 0)
foreach(source IN ITEMS
    "fn work(x:json)->json:\n    raise 'original worker error'\nwith task_spawn(work,json_null()) as job:\n    task_wait(job,10000)"
    "fn work(x:json)->json:\n    return x\njob=task_spawn(work,json_null())\ntask_close(job)\ntask_wait(job,10)"
    "fn work(x:json)->json:\n    return x\nwith task_spawn(work,json_null()) as job:\n    task_wait(job,0)")
    file(WRITE "${work}/error-${index}.wd" "${source}\n")
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        invoke(error-${index}-${backend} 70 "${compiler}" run "${work}/error-${index}.wd" -O0 ${flags} --diagnostics=json)
        if(NOT out STREQUAL "")
            message(FATAL_ERROR "Unexpected negative task stdout")
        endif()
        string(JSON size LENGTH "${err}")
        if(NOT size EQUAL 6)
            message(FATAL_ERROR "Task error schema changed: ${err}")
        endif()
        set(${backend} "${err}")
    endforeach()
    foreach(field IN ITEMS severity code message file line column)
        string(JSON a GET "${native}" ${field})
        string(JSON b GET "${cpp}" ${field})
        if(NOT a STREQUAL b)
            message(FATAL_ERROR "Worker/closed/timeout ${field} differs: ${native}${cpp}")
        endif()
    endforeach()
    math(EXPR index "${index}+1")
endforeach()
file(WRITE "${work}/one.txt" "green red green\n")
file(WRITE "${work}/two.txt" "red blue\n")
file(WRITE "${work}/three.txt" "green\n")
file(WRITE "${work}/empty.txt" "")
foreach(backend IN ITEMS native cpp)
    set(compiler "${WOOD}")
    set(flags)
    if(backend STREQUAL cpp)
        set(compiler "${PRODUCTION}")
        list(APPEND flags --cxx "${cxx}")
    endif()
    invoke(word-count-${backend} 0 "${compiler}" run "${SOURCE_DIR}/examples/parallel_word_counts.wd" -O2 ${flags} --
        "${work}/one.txt" "${work}/two.txt" "${work}/three.txt" "${work}/empty.txt")
    if(NOT out STREQUAL "{\"blue\":1,\"green\":3,\"red\":2}\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Concurrent file application differs: ${out}${err}")
    endif()
endforeach()
file(WRITE "${work}/stdin.txt" "0\n1\n2\n3\n4\n5\n6\n7\n")
foreach(level IN ITEMS 0 2)
    execute_process(COMMAND "${WOOD}" run "${SOURCE_DIR}/tests/native_task_stdin.wd" -O${level}
        INPUT_FILE "${work}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "native concurrent stdin passed\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Concurrent stdin failed: ${status}: ${out}${err}")
    endif()
    math(EXPR checks "${checks}+1")
endforeach()
file(WRITE "${work}/validation.txt" "${checks} task/application build and execution checks passed; O0/O2 C++ differentials, synchronized callback isolation, 256-worker bound/recovery, repeated waits/cancellation/scopes/COW, exact worker errors and exits, file application and concurrent stdin.\n")
message(STATUS "Native installed task lifecycle qualification passed (${checks} invocations): ${work}")
