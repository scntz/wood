cmake_minimum_required(VERSION 3.25)
# Shared Windows/Linux application/differential checks. Executables are already
# built through the native path; production builds are explicitly separate.
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(case IN ITEMS native_arrays native_array_errors)
    if(case STREQUAL native_arrays)
        set(expected "native numerical arrays passed\n")
        set(app "${ARRAY_EXE}")
    else()
        set(expected "native numerical failures passed\n")
        set(app "${ERROR_EXE}")
    endif()
    execute_process(COMMAND "${app}" WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    file(WRITE "${TEST_DIR}/${case}-native.log" "${out}${err}")
    if(NOT status STREQUAL "0" OR NOT out STREQUAL expected OR NOT err STREQUAL "")
        message(FATAL_ERROR "Native ${case} failed: ${status}: ${out}${err}")
    endif()
    execute_process(COMMAND "${PRODUCTION}" "${SOURCE_DIR}/tests/${case}.wd" --cxx "${CXX}" -O${LEVEL}
        WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE baseline ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${TEST_DIR}/${case}-production.log" "${baseline}${err}")
    if(NOT status STREQUAL "0" OR NOT baseline STREQUAL out OR NOT err STREQUAL "")
        message(FATAL_ERROR "Numerical production baseline differs: ${status}: ${baseline}${err}")
    endif()
endforeach()
execute_process(COMMAND "${DIAGNOSTIC_EXE}" RESULT_VARIABLE status OUTPUT_VARIABLE diagnostics ERROR_VARIABLE err TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native numerical diagnostics failed: ${status}: ${diagnostics}${err}")
endif()
execute_process(COMMAND "${PRODUCTION}" "${SOURCE_DIR}/tests/native_array_diagnostics.wd" --cxx "${CXX}" -O${LEVEL}
    RESULT_VARIABLE status OUTPUT_VARIABLE baseline ERROR_VARIABLE err TIMEOUT 180)
file(WRITE "${TEST_DIR}/diagnostics-native.jsonl" "${diagnostics}")
file(WRITE "${TEST_DIR}/diagnostics-production.jsonl" "${baseline}")
if(NOT status STREQUAL "0" OR NOT diagnostics STREQUAL baseline OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native numerical diagnostic fields differ: ${diagnostics}\n${baseline}${err}")
endif()
set(fixture "${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj")
execute_process(COMMAND "${LIMIT_EXE}" RESULT_VARIABLE native_status OUTPUT_VARIABLE native_out ERROR_VARIABLE native_error TIMEOUT 30)
execute_process(COMMAND "${PRODUCTION}" "${SOURCE_DIR}/tests/native_array_limit.wd" --cxx "${CXX}" -O${LEVEL} --diagnostics=json
    RESULT_VARIABLE cpp_status OUTPUT_VARIABLE cpp_out ERROR_VARIABLE cpp_error TIMEOUT 180)
file(WRITE "${TEST_DIR}/allocation-native.json" "${native_error}")
file(WRITE "${TEST_DIR}/allocation-production.json" "${cpp_error}")
if(NOT native_status STREQUAL "70" OR NOT cpp_status STREQUAL "70" OR NOT native_out STREQUAL "" OR NOT cpp_out STREQUAL "")
    message(FATAL_ERROR "Allocation boundary did not fail safely: ${native_status}/${cpp_status}: ${native_error}${cpp_error}")
endif()
if(WIN32)
    set(expected_code R4099)
else()
    set(expected_code R4026)
endif()
foreach(diagnostic IN ITEMS native_error cpp_error)
    string(JSON count LENGTH "${${diagnostic}}")
    string(JSON code GET "${${diagnostic}}" code)
    if(NOT count EQUAL 6 OR NOT code STREQUAL expected_code)
        message(FATAL_ERROR "Allocation-boundary schema/category differs: ${${diagnostic}}")
    endif()
endforeach()
# Native ABI-4 allocation errors have operation locations; production std::bad_alloc
# is classified at its outer boundary (0:0), so this OOM case compares the category.
set(output "${TEST_DIR}/native.obj")
execute_process(COMMAND "${MESH_EXE}" "${fixture}" "${output}"
    RESULT_VARIABLE status OUTPUT_VARIABLE native ERROR_VARIABLE err TIMEOUT 60)
file(WRITE "${TEST_DIR}/mesh-native.log" "${native}${err}")
if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native mesh import application failed: ${status}: ${native}${err}")
endif()
set(reference "${TEST_DIR}/production-mesh")
if(WIN32)
    string(APPEND reference ".exe")
endif()
execute_process(COMMAND "${PRODUCTION}" build "${SOURCE_DIR}/examples/mesh_import.wd"
    --cxx "${CXX}" -O${LEVEL} -o "${reference}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Production mesh build failed: ${out}${err}")
endif()
execute_process(COMMAND "${reference}" "${fixture}" "${TEST_DIR}/production.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE baseline ERROR_VARIABLE err TIMEOUT 60)
file(WRITE "${TEST_DIR}/mesh-production.log" "${baseline}${err}")
if(NOT status STREQUAL "0" OR NOT native STREQUAL baseline OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native mesh report differs from production: ${native}\n${baseline}${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${output}" "${TEST_DIR}/production.obj" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native/production OBJ bytes differ")
endif()
execute_process(COMMAND "${VERIFY_EXE}" "${fixture}" "${output}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "native mesh workflow verified\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native mesh coordinates/round-trip verification failed: ${out}${err}")
endif()
file(WRITE "${TEST_DIR}/malformed.obj" "f 1 2 3\n")
file(WRITE "${TEST_DIR}/preserve.obj" "preserve")
execute_process(COMMAND "${MESH_EXE}" "${TEST_DIR}/malformed.obj" "${TEST_DIR}/preserve.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
file(READ "${TEST_DIR}/preserve.obj" preserved)
string(JSON code ERROR_VARIABLE json_error GET "${err}" code)
if(NOT status STREQUAL "70" OR NOT code STREQUAL R4010 OR NOT preserved STREQUAL preserve)
    message(FATAL_ERROR "Native invalid mesh did not preserve output: ${status}: ${out}${err}")
endif()
set(REFERENCE_EXE "${reference}")
include("${SOURCE_DIR}/tests/native/array-large-geometry.cmake")
file(WRITE "${TEST_DIR}/validation.txt" "O${LEVEL}: numerical success/failure suites match production; unchanged mesh_import application report and OBJ bytes match production; native coordinate verification and malformed-input preservation passed.\n")
