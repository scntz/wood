cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}/CLI árbol 🌳")
file(MAKE_DIRECTORY "${work}")
set(invocations 0)
function(invoke label expected)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    math(EXPR count "${invocations}+1")
    set(invocations ${count} PARENT_SCOPE)
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: exit ${status}, expected ${expected}: ${out}${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
function(code expected)
    string(JSON actual GET "${err}" code)
    string(JSON fields LENGTH "${err}")
    if(NOT actual STREQUAL expected OR NOT fields EQUAL 6)
        message(FATAL_ERROR "Expected six-field ${expected} diagnostic: ${err}")
    endif()
endfunction()
invoke(metadata 0 --language-info)
string(JSON backend GET "${out}" driver_default_backend)
string(JSON abi GET "${out}" driver_native_runtime_abi)
string(JSON parity GET "${out}" driver_llvm_full_compatibility)
if(NOT backend STREQUAL llvm OR NOT abi EQUAL 4 OR parity)
    message(FATAL_ERROR "Incorrect native capability metadata")
endif()
invoke(help 0 --help)
if(NOT out MATCHES "emit-llvm")
    message(FATAL_ERROR "Missing native CLI help")
endif()
invoke(explain 0 explain E3030)
invoke(cli-units 0 "${SOURCE_DIR}/bootstrap/tests/test_driver_cli.wd" -O0)
invoke(init 0 init project)
invoke(init-refuses-existing 2 init project --diagnostics=json)
code(D5001)
invoke(init-sanitized-name 0 init bad-name!)
file(READ "${work}/bad-name!/wood.json" manifest)
string(JSON name GET "${manifest}" name)
if(NOT name STREQUAL "bad_name_")
    message(FATAL_ERROR "Existing project-name sanitization changed")
endif()
file(MAKE_DIRECTORY "${work}/current")
invoke(init-empty-directory 0 init current)
file(MAKE_DIRECTORY "${work}/blocked")
file(WRITE "${work}/blocked/important.txt" "preserve me")
invoke(init-nonempty 2 init blocked --diagnostics=json)
code(D5001)
file(READ "${work}/blocked/important.txt" preserved)
if(NOT preserved STREQUAL "preserve me")
    message(FATAL_ERROR "init modified user data")
endif()
invoke(check 0 check project)
invoke(run-args 0 run project -O0 -- "world & 🌳")
if(NOT out STREQUAL "hello, world & 🌳\n")
    message(FATAL_ERROR "Program argument corruption: ${out}")
endif()
invoke(test 0 test project -O0 --report=json)
string(JSON passed GET "${out}" passed)
string(JSON failed GET "${out}" failed)
if(NOT passed EQUAL 1 OR NOT failed EQUAL 0)
    message(FATAL_ERROR "Generated project tests did not pass")
endif()
set(executable "${work}/hello")
if(WIN32)
    string(APPEND executable .exe)
endif()
invoke(build-O2 0 build project -O2 -o "${executable}")
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status STREQUAL "0" OR NOT text STREQUAL "hello, wood\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Built executable failed: ${status}: ${text}${errors}")
endif()
invoke(emit 0 emit-llvm project -o "${work}/project.ll")
file(READ "${work}/project.ll" ir LIMIT 10000)
if(NOT ir MATCHES "target triple")
    message(FATAL_ERROR "Missing emitted native IR")
endif()
invoke(prevent-source-overwrite 2 build project -o "${work}/project/src/greeting.wd" --diagnostics=json)
code(D5001)
invoke(sanitizer-rejected 2 build project --sanitize=address --diagnostics=json)
code(D5001)
invoke(cxx-option-rejected 2 build project --cxx nonexistent --diagnostics=json)
code(D5001)
file(WRITE "${work}/bad.wd" "print(misspelled_identifier)\n")
invoke(semantic-diagnostic 1 check "${work}/bad.wd" --diagnostics=json)
code(E3007)
string(JSON line GET "${err}" line)
string(JSON column GET "${err}" column)
if(NOT line EQUAL 1 OR NOT column EQUAL 7)
    message(FATAL_ERROR "Incorrect semantic source position: ${err}")
endif()
invoke(tool-failure 2 build project --llvm-dir "${work}/missing-tools" -o "${work}/no-fallback" --diagnostics=json)
if(EXISTS "${work}/no-fallback")
    message(FATAL_ERROR "Failed native tool discovery published an output")
endif()
if(NOT err MATCHES "D500[12]")
    message(FATAL_ERROR "Missing native tools were not diagnosed: ${err}")
endif()
# Existing package and lock conventions, including exact dependency-byte trust.
file(MAKE_DIRECTORY "${work}/dep/src" "${work}/app/src")
file(WRITE "${work}/dep/wood.json" "{\"format\":1,\"name\":\"dep\",\"version\":\"1.0.0\",\"source\":\"src\"}")
set(model "fn identity[T](value:T)->T:\n    return value\n")
file(WRITE "${work}/dep/src/model.wd" "${model}")
file(WRITE "${work}/app/wood.json" "{\"format\":1,\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"src\",\"entry\":\"main.wd\",\"dependencies\":{\"dep\":{\"path\":\"../dep\",\"version\":\"1.0.0\"}}}")
file(WRITE "${work}/app/src/main.wd" "from dep.model import identity\nassert(identity(7)==7)\nprint(\"locked native project passed\")\n")
invoke(lock 0 lock app)
invoke(deps 0 deps app --locked)
invoke(locked-run 0 run app --locked -O0)
if(NOT out STREQUAL "locked native project passed\n")
    message(FATAL_ERROR "Native locked project failed")
endif()
file(APPEND "${work}/dep/src/model.wd" "# changed bytes\n")
invoke(stale-lock 2 check app --locked --diagnostics=json)
code(D5001)
file(WRITE "${work}/dep/src/model.wd" "${model}")
invoke(inspect 0 inspect app --locked)
invoke(restored-lock 0 check app --locked)
# Real numeric application: import, transform and export a checked mesh.
invoke(mesh 0 run "${SOURCE_DIR}/examples/mesh_import.wd" -O0 --
    "${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj" "${work}/mesh.obj")
if(NOT EXISTS "${work}/mesh.obj")
    message(FATAL_ERROR "Mesh application did not export")
endif()
invoke(mesh-roundtrip 0 run "${SOURCE_DIR}/examples/mesh_import.wd" -O0 --
    "${work}/mesh.obj" "${work}/mesh-again.obj")
file(WRITE "${work}/validation.txt" "${invocations} normal native CLI invocations passed; generated executable and OBJ round-trip passed.\n")
message(STATUS "Native normal CLI integration passed (${invocations} invocations): ${work}")
