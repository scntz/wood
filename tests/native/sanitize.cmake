cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS CLANG EMITTER STDLIB INPUT SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
if(NOT DEFINED SANITIZER_TIMEOUT)
    set(SANITIZER_TIMEOUT 240)
endif()
if(NOT DEFINED EXPECTED_EXIT)
    set(EXPECTED_EXIT 0)
endif()
if(NOT DEFINED IR_OPTIMIZATION)
    set(IR_OPTIMIZATION 1)
endif()
if(NOT DEFINED SANITIZER)
    set(SANITIZER address)
endif()
if(NOT SANITIZER MATCHES "^(address|thread)$")
    message(FATAL_ERROR "SANITIZER must be address or thread")
endif()
if(NOT IR_OPTIMIZATION MATCHES "^[012]$")
    message(FATAL_ERROR "IR_OPTIMIZATION must be 0, 1 or 2")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(TEST_DIR "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${TEST_DIR}/runtime")
if(INPUT MATCHES "native_file_main[.]wd$")
    file(WRITE "${TEST_DIR}/input.wd" "fn square(x:int)->int:\n    return x*x\nprint(square(3))\n")
endif()
file(COPY "${SOURCE_DIR}/runtime/native/core.ll" DESTINATION "${TEST_DIR}/runtime")
file(WRITE "${TEST_DIR}/runtime/linux-x86_64.ll" "target triple = \"x86_64-unknown-linux-gnu\"\ndeclare ptr @wd_platform_alloc(i64)\ndeclare void @wd_platform_free(ptr,i64)\ndeclare i64 @wd.sys_write(i64,ptr,i64)\ndeclare void @wd.exit(i32) noreturn\n")
# Exercise the exact ordinary per-thread SIGPIPE guard, with the hosted write
# syscall boundary substituted below it for instrumentation.
file(READ "${SOURCE_DIR}/runtime/native/linux-x86_64.ll" port)
string(FIND "${port}" "define i64 @wd.output_write(" begin)
if(begin LESS 0)
    message(FATAL_ERROR "Missing production checked-output port")
endif()
string(SUBSTRING "${port}" ${begin} -1 guard)
string(FIND "${guard}" "\n}" end)
math(EXPR end "${end}+2")
string(SUBSTRING "${guard}" 0 ${end} guard)
file(APPEND "${TEST_DIR}/runtime/linux-x86_64.ll" "\n${guard}\n")
execute_process(COMMAND "${EMITTER}" "${STDLIB}" "${TEST_DIR}/runtime" linux-x86_64
    "${INPUT}" "${TEST_DIR}/program.ll" RESULT_VARIABLE status
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${SANITIZER_TIMEOUT})
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Sanitizer native lowering failed: ${status}: ${out}${err}")
endif()
file(READ "${TEST_DIR}/program.ll" ir)
string(REGEX REPLACE "(define [^\n]+) \\{" "\\1 sanitize_${SANITIZER} {" ir "${ir}")
file(WRITE "${TEST_DIR}/instrumented.ll" "${ir}")
execute_process(COMMAND "${CLANG}" -x ir -O${IR_OPTIMIZATION} -g -fsanitize=${SANITIZER} -fno-omit-frame-pointer
    -c "${TEST_DIR}/instrumented.ll" -o "${TEST_DIR}/program.o"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${SANITIZER_TIMEOUT})
file(WRITE "${TEST_DIR}/ir-compile.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native ASan instrumentation failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${CLANG}" -x c -std=c17 -O1 -g -fsanitize=${SANITIZER},undefined -DWOOD_NATIVE_HOSTED_THREADS=1
    -fno-omit-frame-pointer -c "${SOURCE_DIR}/runtime/native/managed.c" -o "${TEST_DIR}/managed.o"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Managed runtime sanitizers failed: ${status}: ${out}${err}")
endif()
set(host_flags)
if(CLOSE_FAULT)
    list(APPEND host_flags -DWOOD_NATIVE_CLOSE_FAULT=1)
endif()
execute_process(COMMAND "${CLANG}" -std=c17 -O1 -g -fsanitize=${SANITIZER},undefined ${host_flags}
    -fno-omit-frame-pointer "${TEST_DIR}/program.o" "${TEST_DIR}/managed.o"
    "${SOURCE_DIR}/tests/native/sanitizer_host.c" "${SOURCE_DIR}/tests/native/thread_host.c" -pthread ${EXTRA_SOURCES} -o "${TEST_DIR}/program"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native sanitizer linkage failed: ${status}: ${out}${err}")
endif()
set(program "${TEST_DIR}/program")
if(DEFINED INSTALL_DATA)
    # The normal native driver discovers sidecars relative to its executable.
    # Exercise that real contract rather than adding a test-only runtime override.
    file(MAKE_DIRECTORY "${TEST_DIR}/bin" "${TEST_DIR}/share")
    file(COPY "${INSTALL_DATA}" DESTINATION "${TEST_DIR}/share")
    set(program "${TEST_DIR}/bin/wood")
    file(COPY_FILE "${TEST_DIR}/program" "${program}")
endif()
set(stdin_options)
if(DEFINED STDIN_FILE)
    list(APPEND stdin_options INPUT_FILE "${STDIN_FILE}")
endif()
set(external_runner)
if(DEFINED OUTPUT_FIXTURE)
    set(external_runner "${OUTPUT_FIXTURE}")
    set(RUN_ARGS "${OUTPUT_MODE};${TEST_DIR}/output.marker")
endif()
if(DEFINED EXTERNAL_RUNNER)
    if(DEFINED RUN_ARGS OR DEFINED STDIN_FILE)
        message(FATAL_ERROR "Backpressure runner supplies its own arguments and stdin policy")
    endif()
    set(external_runner "${EXTERNAL_RUNNER}" --pressure)
    set(RUN_ARGS "${TEST_DIR}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
    TSAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 ${ENVIRONMENT_VARIABLES} ${external_runner} "${program}" ${RUN_ARGS} WORKING_DIRECTORY "${TEST_DIR}"
    ${stdin_options} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${SANITIZER_TIMEOUT})
file(WRITE "${TEST_DIR}/run.log" "${out}${err}")
if(NOT status STREQUAL "${EXPECTED_EXIT}" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Native sanitizer execution failed: ${status}: ${out}${err}")
endif()
if(DEFINED EXPECTED AND NOT out STREQUAL EXPECTED)
    message(FATAL_ERROR "Native sanitizer output differs: ${out}")
endif()
if(DEFINED RESULT_FILE)
    file(WRITE "${RESULT_FILE}" "${TEST_DIR}")
endif()
message(STATUS "Native LLVM/C runtime ${SANITIZER}+UBSan passed: ${TEST_DIR}: ${out}")
