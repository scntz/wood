cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR NETWORK_TEST)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
set(cxx /usr/bin/g++)
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
endif()
set(checks 0)
function(invoke label expected)
    file(MAKE_DIRECTORY "${work}/${label}-data")
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}/${label}-data"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
if(DEFINED CLANG AND NOT CLANG STREQUAL "")
    invoke(sdk-abi 0 "${CLANG}" -x c -std=c17 -Wall -Wextra -Werror -c
        "${SOURCE_DIR}/tests/native/network_abi.c" -o "${work}/network-abi.o")
endif()
invoke(resolver 0 "${NETWORK_TEST}" --resolver)
string(JSON ipv6 GET "${out}" ipv6)
set(network_args)
if(ipv6)
    list(APPEND network_args ipv6-dns)
endif()
foreach(level IN ITEMS 0 2)
    foreach(case IN ITEMS streams http native_network)
        foreach(backend IN ITEMS native cpp)
            set(compiler "${WOOD}")
            set(flags)
            if(backend STREQUAL cpp)
                set(compiler "${PRODUCTION}")
                list(APPEND flags --cxx "${cxx}")
            endif()
            set(case_args)
            if(case STREQUAL native_network)
                set(case_args ${network_args})
            endif()
            invoke(${case}-${backend}-O${level} 0 "${compiler}" run "${SOURCE_DIR}/tests/${case}.wd" -O${level} ${flags} -- ${case_args})
            if(NOT err STREQUAL "")
                message(FATAL_ERROR "${case} ${backend} unexpected stderr: ${err}")
            endif()
            set(${backend} "${out}")
        endforeach()
        if(NOT native STREQUAL cpp)
            message(FATAL_ERROR "${case} O${level} native/reference differs: ${native}${cpp}")
        endif()
    endforeach()
    foreach(app IN ITEMS http_json_server http_get)
        invoke(${app}-build-O${level} 0 "${WOOD}" build "${SOURCE_DIR}/examples/${app}.wd" -O${level} -o "${work}/${app}-O${level}${suffix}")
    endforeach()
    file(MAKE_DIRECTORY "${work}/wire-O${level}")
    invoke(independent-wire-O${level} 0 "${NETWORK_TEST}" "${work}/http_json_server-O${level}${suffix}"
        "${work}/http_get-O${level}${suffix}" "${work}/wire-O${level}")
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        invoke(pressure-build-${backend}-O${level} 0 "${compiler}" build "${SOURCE_DIR}/tests/native_network_pressure.wd"
            -O${level} ${flags} -o "${work}/pressure-${backend}-O${level}${suffix}")
        invoke(pressure-${backend}-O${level} 0 "${NETWORK_TEST}" --pressure
            "${work}/pressure-${backend}-O${level}${suffix}" "${work}/pressure-${backend}-O${level}-data")
    endforeach()
endforeach()
# One located uncaught failure must preserve the structured diagnostic contract.
file(WRITE "${work}/diagnostic.wd" "tcp_listen('localhost',0,1000)\n")
foreach(backend IN ITEMS native cpp)
    set(compiler "${WOOD}")
    set(flags)
    if(backend STREQUAL cpp)
        set(compiler "${PRODUCTION}")
        list(APPEND flags --cxx "${cxx}")
    endif()
    invoke(diagnostic-build-${backend} 0 "${compiler}" build "${work}/diagnostic.wd" --diagnostics=json ${flags} -o "${work}/diagnostic-${backend}${suffix}")
    invoke(diagnostic-run-${backend} 70 "${work}/diagnostic-${backend}${suffix}")
    if(NOT out STREQUAL "")
        message(FATAL_ERROR "Unexpected diagnostic stdout")
    endif()
    set(diagnostic_${backend} "${err}")
endforeach()
foreach(field IN ITEMS severity code message file line column)
    string(JSON a GET "${diagnostic_native}" ${field})
    string(JSON b GET "${diagnostic_cpp}" ${field})
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "Network diagnostic ${field} differs: ${diagnostic_native}${diagnostic_cpp}")
    endif()
endforeach()
file(WRITE "${work}/validation.txt" "${checks} commands passed; SDK ABI declarations, O0/O2 streams/HTTP/network differential, IPv4/IPv6/DNS/cold workers/half-close/cancellation, independent HTTP wire fixture, exact six-field diagnostics. OS localhost IPv6=${ipv6}; numeric IPv6 always required.\n")
message(STATUS "Native TCP/HTTP qualification: ${checks} commands passed: ${work}")
