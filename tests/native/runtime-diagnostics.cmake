cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
    execute_process(COMMAND cl.exe /nologo /TC "${SOURCE_DIR}/tests/native/stdin_failure.c"
        "/Fo:${work}/failure.obj" "/Fe:${work}/failure.exe" RESULT_VARIABLE built OUTPUT_VARIABLE out ERROR_VARIABLE err)
else()
    set(cxx /usr/bin/g++)
    execute_process(COMMAND /usr/bin/clang-19 -std=c17 "${SOURCE_DIR}/tests/native/stdin_failure.c"
        -o "${work}/failure" RESULT_VARIABLE built OUTPUT_VARIABLE out ERROR_VARIABLE err)
endif()
if(NOT built STREQUAL "0")
    message(FATAL_ERROR "Cannot build closed-input launcher: ${out}${err}")
endif()
set(case_index 0)
foreach(source IN ITEMS "time_sleep(-1.0)" "time_sleep(86401)" "time_sleep(1.0e308*2.0)" "infinity=1.0e308*2.0\ntime_sleep(infinity-infinity)" "read_line()")
    file(WRITE "${work}/case.wd" "${source}\n")
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        execute_process(COMMAND "${compiler}" build "${work}/case.wd" -O0 --diagnostics=json
            ${flags} -o "${work}/${backend}${suffix}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "${backend} diagnostic fixture build failed: ${out}${err}")
        endif()
        set(command "${work}/${backend}${suffix}")
        if(case_index EQUAL 4)
            set(command "${work}/failure${suffix}" "${work}/${backend}${suffix}")
        endif()
        execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
        file(WRITE "${work}/${case_index}-${backend}.log" "${out}${err}")
        if(NOT status STREQUAL "70" OR NOT out STREQUAL "")
            message(FATAL_ERROR "${backend} negative runtime exit differed: ${status}: ${out}${err}")
        endif()
        string(JSON fields LENGTH "${err}")
        if(NOT fields EQUAL 6)
            message(FATAL_ERROR "Diagnostic schema changed: ${err}")
        endif()
        set(${backend} "${err}")
    endforeach()
    foreach(field IN ITEMS severity code message file line column)
        string(JSON a GET "${native}" ${field})
        string(JSON b GET "${cpp}" ${field})
        if(NOT a STREQUAL b)
            message(FATAL_ERROR "Runtime ${case_index} ${field} differs: ${native}${cpp}")
        endif()
    endforeach()
    math(EXPR case_index "${case_index}+1")
endforeach()
foreach(level IN ITEMS 0 2)
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        execute_process(COMMAND "${compiler}" run "${SOURCE_DIR}/tests/native_format_resources.wd" -O${level} ${flags}
            WORKING_DIRECTORY "${work}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
        file(WRITE "${work}/format-${backend}-O${level}.log" "${out}${err}")
        if(NOT status STREQUAL "0" OR NOT out STREQUAL "native resource formatting passed\n" OR NOT err STREQUAL "")
            message(FATAL_ERROR "${backend} resource formatting failed: ${status}: ${out}${err}")
        endif()
    endforeach()
endforeach()
file(WRITE "${work}/validation.txt" "Five uncaught runtime cases matched six production diagnostic fields; O0/O2 resource/array/function/closure/callable/cursor formatting passed on both backends.\n")
message(STATUS "Native runtime diagnostics and resource formatting passed: ${work}")
