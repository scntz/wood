cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
get_filename_component(bin "${WOOD}" DIRECTORY)
get_filename_component(prefix "${bin}" DIRECTORY)
set(data "${prefix}/share/wood")
file(READ "${data}/native.json" config)
foreach(key IN ITEMS target llvm_dir linker llvm_wsl)
    string(JSON ${key} GET "${config}" ${key})
endforeach()
# A relocatable release records no tool directory, and finds its tools on PATH.
if(llvm_dir STREQUAL "")
    find_program(opt_tool opt REQUIRED)
    get_filename_component(llvm_dir "${opt_tool}" DIRECTORY)
endif()
if(linker STREQUAL "" AND NOT target MATCHES "windows")
    find_program(linker ld REQUIRED)
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
execute_process(COMMAND "${CMAKE_COMMAND}" -DREFERENCE=${WOOD} -DOUTPUT=${work}/assets
    -P "${SOURCE_DIR}/tools/prepare-native-assets.cmake"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120 ENCODING UTF-8)
file(WRITE "${work}/assets.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native-only asset export failed: ${status}: ${out}${err}")
endif()
set(command "${CMAKE_COMMAND}" -DEMITTER=${WOOD} -DSEED_IS_DRIVER=ON
    -DASSETS=${work}/assets -DRUNTIME_OBJECT=${data}/native/managed.o
    -DTARGET=${target} -DPREFIX=${work}/installed -DLLVM_DIR=${llvm_dir}
    -DLINKER=${linker} -DWSL_DISTRIBUTION=${llvm_wsl}
    -P "${SOURCE_DIR}/tools/install-native.cmake")
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 2100 ENCODING UTF-8)
file(WRITE "${work}/install.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native-only installation failed: ${status}: ${out}${err}")
endif()
set(suffix "")
if(WIN32)
    set(suffix .exe)
endif()
set(binary "${work}/installed/bin/wood${suffix}")
file(SHA256 "${binary}" original)
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
file(WRITE "${work}/refuse-existing.log" "${out}${err}")
file(SHA256 "${binary}" after)
if(NOT status STREQUAL "1" OR NOT original STREQUAL after)
    message(FATAL_ERROR "Existing installation was not preserved")
endif()
file(GLOB_RECURSE contents RELATIVE "${work}/installed" "${work}/installed/*")
foreach(name IN LISTS contents)
    if(name MATCHES "[.]stages/|CMakeCache[.]txt$|[.]log$|[.]obj$" AND NOT name MATCHES "tests/fixtures/obj/")
        message(FATAL_ERROR "Generated build artifact in native installation: ${name}")
    endif()
    if(name MATCHES "[.]o$" AND NOT name STREQUAL "share/wood/native/managed.o")
        message(FATAL_ERROR "Unexpected object in installation: ${name}")
    endif()
    if(name MATCHES "[.](zip|7z|tar|gz|a|lib|exe)$" AND NOT name STREQUAL "bin/wood.exe")
        message(FATAL_ERROR "Unexpected archive or executable in installation: ${name}")
    endif()
endforeach()
if(EXISTS "${work}/installed/share/wood/runtime.hpp")
    message(FATAL_ERROR "Native-only installation unexpectedly contains C++ prelude")
endif()
file(MAKE_DIRECTORY "${work}/relocated")
file(COPY "${work}/installed/bin" "${work}/installed/share" DESTINATION "${work}/relocated")
execute_process(COMMAND "${CMAKE_COMMAND}" -DWOOD=${work}/relocated/bin/wood${suffix}
    -DSOURCE_DIR=${work}/relocated/share/wood -DTEST_DIR=${work}/relocation-check
    -P "${SOURCE_DIR}/tests/native/cli.cmake"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 1200 ENCODING UTF-8)
file(WRITE "${work}/relocation.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Relocated installation workflow failed: ${status}: ${out}${err}")
endif()
file(WRITE "${work}/validation.txt" "Native-only metadata export, self-reinstallation, no-overwrite check, artifact allowlist and relocated normal CLI/project/OBJ workflows passed.\n")
message(STATUS "Native clean-prefix installation/relocation passed: ${work}")
