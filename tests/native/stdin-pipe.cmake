cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}/input")
execute_process(COMMAND "${WOOD}" run "${SOURCE_DIR}/tests/native_stdin.wd" -O0 -- generate "${work}/input"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Pipe fixtures failed: ${out}${err}")
endif()
file(WRITE "${work}/input/unicode" "árbol 🌳\n最后行")
set(cxx /usr/bin/g++)
if(WIN32)
    set(cxx cl.exe)
endif()
foreach(case IN ITEMS empty lines crlf binary ctrl-z boundary unicode)
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E cat "${work}/input/${case}"
            COMMAND "${compiler}" run "${SOURCE_DIR}/tests/native_stdin.wd" -O0 ${flags}
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
        file(WRITE "${work}/${case}-${backend}.log" "${out}${err}")
        if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
            message(FATAL_ERROR "${backend} actual stdin pipe ${case} failed: ${status}: ${err}")
        endif()
        set(${backend} "${out}")
    endforeach()
    if(NOT native STREQUAL cpp)
        message(FATAL_ERROR "Actual pipe ${case} bytes differ")
    endif()
endforeach()
file(WRITE "${work}/validation.txt" "Fourteen real piped CLI executions passed; empty/LF/CRLF/NUL/invalid-byte/Ctrl-Z/chunk-boundary/Unicode behavior matches C++ on this OS.\n")
message(STATUS "Native stdin actual-pipe differential passed: ${work}")
