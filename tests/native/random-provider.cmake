cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS CLANG SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
file(READ "${SOURCE_DIR}/runtime/native/random.inc" source)
string(FIND "${source}" "static int r_random(" begin)
if(begin LESS 0)
    message(FATAL_ERROR "Actual entropy helper not found")
endif()
string(SUBSTRING "${source}" ${begin} -1 helper)
string(FIND "${helper}" "\n}" end)
if(end LESS 0)
    message(FATAL_ERROR "Actual entropy helper boundary not found")
endif()
math(EXPR end "${end}+2")
string(SUBSTRING "${helper}" 0 ${end} helper)
file(WRITE "${work}/random-helper.h" "${helper}\n")
execute_process(COMMAND "${CLANG}" -std=c17 -O1 -g -fsanitize=address,undefined
    -fno-sanitize-recover=all -I "${SOURCE_DIR}/runtime/native" -I "${work}"
    "${SOURCE_DIR}/tests/native/random_provider.c" -o "${work}/random-provider"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${work}/build.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Entropy helper sanitizer build failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
    UBSAN_OPTIONS=halt_on_error=1 "${work}/random-provider"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
file(WRITE "${work}/run.log" "${out}${err}")
if(NOT status STREQUAL "0" OR NOT out STREQUAL "actual entropy loop fault cases passed\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Entropy helper sanitizer failed: ${status}: ${out}${err}")
endif()
message(STATUS "Actual entropy helper partial/EINTR/failure/cancellation/driver-policy cases passed")
