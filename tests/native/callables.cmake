cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(TEST_DIR "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
if(NOT DEFINED CXX)
    set(CXX /usr/bin/g++)
endif()
function(build source name)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DEMITTER=${EMITTER} -DSTDLIB=${STDLIB}
        -DINPUT=${SOURCE_DIR}/${source} -DOUTPUT=${TEST_DIR}/${name} -DTARGET=linux-x86_64
        -DLLC=${LLC} -DOPT=${OPT} -DLINKER=${LINKER} -DOPTIMIZATION=${LEVEL}
        -DRUNTIME_OBJECT=${RUNTIME_OBJECT} -P "${SOURCE_DIR}/tools/build-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    file(WRITE "${TEST_DIR}/${name}-build.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native ${name} build failed: ${status}: ${out}${err}")
    endif()
    execute_process(COMMAND readelf -l -d "${TEST_DIR}/${name}"
        RESULT_VARIABLE status OUTPUT_VARIABLE deps ERROR_VARIABLE err)
    if(NOT status STREQUAL "0" OR deps MATCHES "INTERP|NEEDED")
        message(FATAL_ERROR "Native ${name} is not an independent static executable: ${deps}${err}")
    endif()
endfunction()
set(cases native_callables native_iteration native_stream_lines closures_iterators binding_lifetimes functional)
set(outputs "native callable ownership passed" "native iterator ownership passed"
    "native buffered file lines passed" "native closures and lazy iterators passed"
    "binding and iteration lifetimes passed" "native generic algorithms passed")
foreach(index RANGE 0 5)
    list(GET cases ${index} name)
    list(GET outputs ${index} expected)
    build("tests/${name}.wd" "${name}")
    execute_process(COMMAND "${TEST_DIR}/${name}" WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    file(WRITE "${TEST_DIR}/${name}-run.log" "${out}${err}")
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "${expected}\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Native ${name} failed: ${status}: ${out}${err}")
    endif()
    execute_process(COMMAND "${PRODUCTION}" "${SOURCE_DIR}/tests/${name}.wd" --cxx "${CXX}"
        WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE status
        OUTPUT_VARIABLE baseline ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${TEST_DIR}/${name}-production.log" "${baseline}${err}")
    if(NOT status STREQUAL "0" OR NOT baseline STREQUAL out OR NOT err STREQUAL "")
        message(FATAL_ERROR "Production ${name} differs: ${status}: ${baseline}${err}")
    endif()
endforeach()
build(examples/log_report.wd log-report)
set(executable "${TEST_DIR}/log-report")
set(saved_dir "${TEST_DIR}")
set(TEST_DIR "${saved_dir}/native-report")
file(MAKE_DIRECTORY "${TEST_DIR}")
include("${SOURCE_DIR}/tests/log_report_oracle.cmake")
set(TEST_DIR "${saved_dir}")
set(executable "${TEST_DIR}/production-report")
execute_process(COMMAND "${PRODUCTION}" build "${SOURCE_DIR}/examples/log_report.wd" -o "${executable}" --cxx "${CXX}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
file(WRITE "${TEST_DIR}/production-report-build.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Production log report build failed: ${out}${err}")
endif()
set(TEST_DIR "${saved_dir}/production-report-data")
file(MAKE_DIRECTORY "${TEST_DIR}")
include("${SOURCE_DIR}/tests/log_report_oracle.cmake")
file(WRITE "${saved_dir}/validation.txt" "Six native/production differential suites and native/production log-report application oracles passed at O${LEVEL}; seven static ELF executables without dynamic dependencies.\n")
message(STATUS "Native callables, iteration, lifetimes, buffered lines and log-report application passed at O${LEVEL}")
