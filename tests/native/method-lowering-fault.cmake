cmake_minimum_required(VERSION 3.25)
foreach(name IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Supply ${name}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(TEST_DIR "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
file(SHA256 "${SOURCE_DIR}/bootstrap/src/body_semantics.wd" original)
file(GLOB sources "${SOURCE_DIR}/bootstrap/src/*.wd")
foreach(mode IN ITEMS restore missing-restore)
    set(root "${TEST_DIR}/${mode}")
    file(MAKE_DIRECTORY "${root}/src" "${root}/tests")
    foreach(source IN LISTS sources)
        if(IS_SYMLINK "${source}")
            message(FATAL_ERROR "Use regular compiler sources")
        endif()
        file(COPY "${source}" DESTINATION "${root}/src")
    endforeach()
    file(COPY "${SOURCE_DIR}/bootstrap/wood.json" DESTINATION "${root}")
    file(COPY "${SOURCE_DIR}/tests/fixtures/method_lowering_fault.wd" DESTINATION "${root}/tests")
    file(READ "${root}/src/body_semantics.wd" text)
    string(FIND "${text}" "# Release only the checkpoint alias" start)
    if(start LESS 0)
        message(FATAL_ERROR "Checkpoint handoff changed; review fault injection")
    endif()
    string(SUBSTRING "${text}" ${start} -1 tail)
    string(FIND "${tail}" "                    append(self.kernel.types,0)" offset)
    if(offset LESS 0)
        message(FATAL_ERROR "Synthetic expression append not found")
    endif()
    math(EXPR at "${start}+${offset}")
    string(SUBSTRING "${text}" 0 ${at} head)
    string(SUBSTRING "${text}" ${at} -1 tail)
    set(text "${head}                    if first == \"item\":\n                        raise \"checkpoint construction fault\"\n${tail}")
    set(assignment "                    self.resolver.compilation.modules[self.module].tree.expressions = self.kernel.tree.expressions\n")
    set(needle "                except err:\n${assignment}                    raise err")
    string(FIND "${text}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Checkpoint restoration guard changed")
    endif()
    if(mode STREQUAL "missing-restore")
        set(assignment "")
    endif()
    set(replacement "                except err:\n${assignment}                    assert(self.resolver.compilation.modules[self.module].tree.expressions == self.kernel.tree.expressions,\"checkpoint was not restored\")\n                    raise err")
    string(REPLACE "${needle}" "${replacement}" text "${text}")
    file(WRITE "${root}/src/body_semantics.wd" "${text}")
    set(cxx)
    if(DEFINED CXX)
        set(cxx --cxx "${CXX}")
    endif()
    execute_process(COMMAND "${WOOD}" run "${root}/tests/method_lowering_fault.wd" -O0
        --timeout-ms 1800000 ${cxx} RESULT_VARIABLE status
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 1900)
    file(WRITE "${root}/stdout" "${out}")
    file(WRITE "${root}/stderr" "${err}")
    file(WRITE "${root}/status" "${status}\n")
    string(STRIP "${out}" clean)
    if(mode STREQUAL "restore")
        if(NOT status STREQUAL "0" OR NOT clean STREQUAL "checkpoint restoration and original error propagation passed" OR NOT err STREQUAL "")
            message(FATAL_ERROR "Checkpoint restoration failed: ${status}: ${out}${err}")
        endif()
    elseif(NOT status STREQUAL "70" OR NOT "${out}${err}" MATCHES "construction error was not propagated")
        message(FATAL_ERROR "Missing-restoration control did not fail as expected: ${status}: ${out}${err}")
    endif()
endforeach()
file(SHA256 "${SOURCE_DIR}/bootstrap/src/body_semantics.wd" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "Fault tests modified the real analyzer")
endif()
message(STATUS "Checkpoint throw restoration and missing-restoration control passed")
