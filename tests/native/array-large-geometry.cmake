cmake_minimum_required(VERSION 3.25)
# Independent integer fixture: 256 closed tetrahedra, 1024 vertices/triangles.
# No trigonometry, external generator or timing benchmark is involved.
file(MAKE_DIRECTORY "${TEST_DIR}")
set(model "# deterministic disconnected closed mesh\n")
foreach(component RANGE 0 255)
    math(EXPR x "(${component}%16)*3")
    math(EXPR y "(${component}*7)%11")
    math(EXPR z "(${component}/16)*3")
    math(EXPR xx "${x}+1")
    math(EXPR yy "${y}+1")
    math(EXPR zz "${z}+1")
    math(EXPR a "${component}*4+1")
    math(EXPR b "${a}+1")
    math(EXPR c "${a}+2")
    math(EXPR d "${a}+3")
    string(APPEND model "v ${x} ${y} ${z}\nv ${xx} ${y} ${z}\nv ${x} ${yy} ${z}\nv ${x} ${y} ${zz}\nf ${a} ${c} ${b}\nf ${a} ${b} ${d}\nf ${a} ${d} ${c}\nf ${b} ${c} ${d}\n")
endforeach()
set(fixture "${TEST_DIR}/large-input.obj")
file(WRITE "${fixture}" "${model}")
foreach(backend IN ITEMS native reference)
    set(app "${MESH_EXE}")
    if(backend STREQUAL reference)
        set(app "${REFERENCE_EXE}")
    endif()
    execute_process(COMMAND "${app}" "${fixture}" "${TEST_DIR}/large-${backend}.obj"
        RESULT_VARIABLE status OUTPUT_VARIABLE report_${backend} ERROR_VARIABLE err TIMEOUT 120)
    file(WRITE "${TEST_DIR}/large-${backend}.log" "${report_${backend}}${err}")
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Large geometry ${backend} failed: ${status}: ${err}")
    endif()
endforeach()
if(NOT report_native STREQUAL report_reference)
    message(FATAL_ERROR "Large native/production mesh reports differ")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${TEST_DIR}/large-native.obj" "${TEST_DIR}/large-reference.obj" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Large native/production OBJ bytes differ")
endif()
execute_process(COMMAND "${VERIFY_EXE}" "${fixture}" "${TEST_DIR}/large-native.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "native mesh workflow verified\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Large native reimport/coordinate verification failed: ${out}${err}")
endif()
file(WRITE "${TEST_DIR}/large-validation.txt" "1024 vertices/1024 triangles: native import/inspect/transform/normals/export matches production report and OBJ bytes; native reimport checks every transformed coordinate and triangle.\n")
message(STATUS "Large native geometry differential workflow passed")
