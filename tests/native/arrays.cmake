cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(TEST_DIR "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(case IN ITEMS native_arrays native_array_errors native_array_diagnostics native_array_limit mesh_import mesh_transform_verify)
    set(source "${SOURCE_DIR}/tests/${case}.wd")
    if(case STREQUAL mesh_import)
        set(source "${SOURCE_DIR}/examples/mesh_import.wd")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -DEMITTER=${EMITTER} -DSTDLIB=${STDLIB}
        -DINPUT=${source} -DOUTPUT=${TEST_DIR}/${case} -DTARGET=linux-x86_64
        -DLLC=${LLC} -DOPT=${OPT} -DLINKER=${LINKER} -DOPTIMIZATION=${LEVEL}
        -DRUNTIME_OBJECT=${RUNTIME_OBJECT} -P "${SOURCE_DIR}/tools/build-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    file(WRITE "${TEST_DIR}/${case}-build.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native array/application build failed: ${status}: ${out}${err}")
    endif()
    execute_process(COMMAND readelf -l -d "${TEST_DIR}/${case}" RESULT_VARIABLE status OUTPUT_VARIABLE deps)
    if(NOT status STREQUAL "0" OR deps MATCHES "INTERP|NEEDED")
        message(FATAL_ERROR "Native array application is not static: ${deps}")
    endif()
endforeach()
set(ARRAY_EXE "${TEST_DIR}/native_arrays")
set(ERROR_EXE "${TEST_DIR}/native_array_errors")
set(DIAGNOSTIC_EXE "${TEST_DIR}/native_array_diagnostics")
set(LIMIT_EXE "${TEST_DIR}/native_array_limit")
set(MESH_EXE "${TEST_DIR}/mesh_import")
set(VERIFY_EXE "${TEST_DIR}/mesh_transform_verify")
set(CXX /usr/bin/g++)
include("${SOURCE_DIR}/tests/native/array-oracle.cmake")
message(STATUS "Six static numerical/geometry applications and production differential checks passed O${LEVEL}")
