cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS CLANG SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
if(NOT DEFINED SERVICES_INPUT)
    set(SERVICES_INPUT "${SOURCE_DIR}/runtime/native/services.inc")
endif()
file(READ "${SERVICES_INPUT}" services)
string(FIND "${services}" "static unsigned short *p_wide(" start)
if(start LESS 0)
    message(FATAL_ERROR "Missing actual Windows path conversion helper")
endif()
string(SUBSTRING "${services}" ${start} -1 helper)
string(FIND "${helper}" "\n}" end)
if(end LESS 0)
    message(FATAL_ERROR "Missing helper boundary")
endif()
math(EXPR end "${end}+2")
string(SUBSTRING "${helper}" 0 ${end} helper)
file(WRITE "${work}/wide-helper.h" "${helper}\n")
execute_process(COMMAND "${CLANG}" -std=c17 -O1 -g -fsanitize=undefined
    -fno-sanitize-recover=all -I "${SOURCE_DIR}/runtime/native" -I "${work}"
    "${SOURCE_DIR}/tests/native/wide_size.c" -o "${work}/wide-size"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${work}/compile.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Helper arithmetic build failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${work}/wide-size" RESULT_VARIABLE status
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
file(WRITE "${work}/run.log" "${out}${err}")
if(NOT status STREQUAL "0" OR NOT out STREQUAL "Windows UTF-16 reservation arithmetic passed\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Helper arithmetic failed: ${status}: ${out}${err}")
endif()
message(STATUS "Actual Windows helper INT32_MAX reservation arithmetic passed with UBSan; no large allocation")
