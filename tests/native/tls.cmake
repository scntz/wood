cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR BACKEND_TEST)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
set(cxx /usr/bin/g++)
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
endif()
set(fixtures "${SOURCE_DIR}/tests/fixtures/tls")
# Only these child processes use this offline trust store. No OS store changes.
set(trust "${CMAKE_COMMAND}" -E env "SSL_CERT_FILE=${fixtures}/ca.pem"
    "SSL_CERT_DIR=${work}/no-additional-roots" WOOD_REQUIRE_TLS_TESTS=1)
set(checks 0)
set(dotnet FALSE)
function(invoke label expected)
    file(MAKE_DIRECTORY "${work}/${label}-data")
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}/${label}-data"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS 0 2)
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            list(APPEND flags --cxx "${cxx}")
        endif()
        set(program "${SOURCE_DIR}/tests/native_tls.wd")
        set(arguments "${fixtures}")
        if(TLS_IPV6_ONLY)
            set(program "${SOURCE_DIR}/tests/native_tls_ipv6.wd")
            set(arguments "${fixtures}/ip.pem" "${fixtures}/server-key.pem")
        endif()
        invoke(corpus-${backend}-O${level} 0 ${trust} "${compiler}" run
            "${program}" -O${level} ${flags} -- ${arguments})
        if(NOT err STREQUAL "")
            message(FATAL_ERROR "Unexpected TLS corpus stderr: ${err}")
        endif()
        set(${backend} "${out}")
    endforeach()
    if(NOT native STREQUAL cpp)
        message(FATAL_ERROR "O${level} TLS corpus differs: ${native}${cpp}")
    endif()
    if(TLS_IPV6_ONLY)
        continue()
    endif()
    foreach(app IN ITEMS https_json_server https_client)
        invoke(${app}-build-O${level} 0 "${WOOD}" build "${SOURCE_DIR}/examples/${app}.wd"
            -O${level} -o "${work}/${app}-O${level}${suffix}")
    endforeach()
    invoke(independent-apps-O${level} 0 ${trust} "${BACKEND_TEST}" json-apps "${fixtures}"
        "${work}/https_json_server-O${level}${suffix}" "${work}/https_client-O${level}${suffix}" "${work}/independent-apps-O${level}-data")
    if(DEFINED PWSH AND NOT PWSH STREQUAL "" AND NOT PWSH MATCHES "NOTFOUND$")
        invoke(dotnet-O${level} 0 ${trust} "${PWSH}" -NoProfile -File "${SOURCE_DIR}/tests/tls_interop.ps1"
            -Server "${work}/https_json_server-O${level}${suffix}" -Fixtures "${fixtures}"
            -Work "${work}/dotnet-O${level}-data" -JsonService)
        set(dotnet TRUE)
    endif()
endforeach()
if(TLS_IPV6_ONLY)
    file(WRITE "${work}/validation.txt" "${checks} commands passed: O0/O2 numeric IPv6 TLS, explicit IP SAN verification, scoped context/connection/task cleanup and native/reference equivalence.\n")
    message(STATUS "Native IPv6 TLS qualification: ${checks} commands passed: ${work}")
    return()
endif()
# Loader policy and missing dependencies fail closed in separate cold processes.
file(WRITE "${work}/loader.wd" "try:\n    tls_version()\n    assert(false)\nexcept err:\n    assert(err.code == 'R4021')\nprint('TLS loader rejected')\n")
file(WRITE "${work}/diagnostic.wd" "tls_connect('bad host',443,'',1000)\n")
foreach(backend IN ITEMS native cpp)
    set(compiler "${WOOD}")
    set(flags)
    if(backend STREQUAL cpp)
        set(compiler "${PRODUCTION}")
        list(APPEND flags --cxx "${cxx}")
    endif()
    invoke(loader-build-${backend} 0 "${compiler}" build "${work}/loader.wd" ${flags} -o "${work}/loader-${backend}${suffix}")
    foreach(directory IN ITEMS relative "${work}/missing-library-directory")
        string(MD5 key "${directory}")
        invoke(loader-${backend}-${key} 0 "${CMAKE_COMMAND}" -E env "WOOD_OPENSSL_DIR=${directory}" "${work}/loader-${backend}${suffix}")
    endforeach()
    invoke(diagnostic-build-${backend} 0 "${compiler}" build "${work}/diagnostic.wd"
        --diagnostics=json ${flags} -o "${work}/diagnostic-${backend}${suffix}")
    invoke(diagnostic-run-${backend} 70 "${work}/diagnostic-${backend}${suffix}")
    set(diagnostic_${backend} "${err}")
endforeach()
foreach(field IN ITEMS severity code message file line column)
    string(JSON a GET "${diagnostic_native}" ${field})
    string(JSON b GET "${diagnostic_cpp}" ${field})
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "TLS diagnostic ${field} differs: ${diagnostic_native}${diagnostic_cpp}")
    endif()
endforeach()
file(WRITE "${work}/validation.txt" "${checks} commands passed: O0/O2 TLS lifecycle/security/ownership/cancellation/bounded pressure differential, installed HTTPS applications, C++ TLS-1.2 peer/SNI/chunked binary wire checks, loader failure policy and six-field diagnostics. .NET executed=${dotnet}; PWSH=${PWSH}\n")
message(STATUS "Native TLS qualification: ${checks} commands passed: ${work}")
