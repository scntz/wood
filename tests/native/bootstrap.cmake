cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SEED STDLIB RUNTIME_OBJECT LLC OPT LINKER SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
if(NOT DEFINED STAGE_TIMEOUT)
    set(STAGE_TIMEOUT 1800)
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
file(GLOB sources "${SOURCE_DIR}/bootstrap/src/*.wd")
list(APPEND sources "${STDLIB}" "${RUNTIME_OBJECT}" "${SOURCE_DIR}/runtime/native/core.ll" "${SOURCE_DIR}/runtime/native/linux-x86_64.ll")
foreach(source IN LISTS sources)
    file(SHA256 "${source}" hash)
    string(SHA256 key "${source}")
    set(frozen_${key} "${hash}")
    file(APPEND "${work}/sources.sha256" "${hash} ${source}\n")
endforeach()
set(previous "${SEED}")
foreach(stage RANGE 1 3)
    set(output "${work}/stage${stage}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DEMITTER=${previous}
        -DSTDLIB=${STDLIB} -DRUNTIME_OBJECT=${RUNTIME_OBJECT}
        -DRUNTIME_DIR=${SOURCE_DIR}/runtime/native -DINPUT=${SOURCE_DIR}/bootstrap/src/native_main.wd
        -DOUTPUT=${output} -DTARGET=linux-x86_64 -DOPTIMIZATION=0
        -DSTAGE_TIMEOUT=${STAGE_TIMEOUT} -DLLC=${LLC} -DOPT=${OPT} -DLINKER=${LINKER}
        -P "${SOURCE_DIR}/tools/build-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${work}/stage${stage}.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native bootstrap stage ${stage} failed (${status}): ${out}${err}")
    endif()
    foreach(source IN LISTS sources)
        file(SHA256 "${source}" hash)
        string(SHA256 key "${source}")
        if(NOT hash STREQUAL frozen_${key})
            message(FATAL_ERROR "Bootstrap input changed during validation: ${source}")
        endif()
    endforeach()
    execute_process(COMMAND readelf -l -d "${output}" RESULT_VARIABLE status OUTPUT_VARIABLE dependencies)
    file(WRITE "${work}/stage${stage}-dependencies.txt" "${dependencies}")
    if(NOT status STREQUAL "0" OR dependencies MATCHES "INTERP|NEEDED")
        message(FATAL_ERROR "Unexpected dynamic runtime dependency at stage ${stage}")
    endif()
    file(SHA256 "${output}" hash)
    file(APPEND "${work}/hashes.txt" "${hash} stage${stage}\n")
    set(previous "${output}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${work}/stage2" "${work}/stage3" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native stage2/stage3 executables differ")
endif()
file(GLOB ir2 "${work}/stage2.stages/*/program.ll")
file(GLOB ir3 "${work}/stage3.stages/*/program.ll")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${ir2}" "${ir3}" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native stage2/stage3 generated IR differs")
endif()
file(WRITE "${work}/validation.txt" "Three actual compiler builds passed; native stage2/stage3 IR and executables identical; no interpreter/dynamic runtime. External LLVM tools and prebuilt C17 primitive object remain required.\n")
message(STATUS "Native bootstrap fixed point verified: ${work}")
