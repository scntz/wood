cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
set(cxx /usr/bin/g++)
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
endif()
set(checks 0)
function(invoke label expected)
    file(MAKE_DIRECTORY "${work}/${label}")
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}/${label}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: exit ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS 0 2)
    foreach(case IN ITEMS sqlite native_sqlite)
        foreach(backend IN ITEMS native cpp)
            set(compiler "${WOOD}")
            set(flags)
            if(backend STREQUAL cpp)
                set(compiler "${PRODUCTION}")
                list(APPEND flags --cxx "${cxx}")
            endif()
            invoke(${case}-${backend}-O${level} 0 "${compiler}" run "${SOURCE_DIR}/tests/${case}.wd" -O${level} ${flags})
            if(NOT err STREQUAL "")
                message(FATAL_ERROR "${case} unexpected stderr: ${err}")
            endif()
            set(${backend} "${out}")
        endforeach()
        if(NOT native STREQUAL cpp)
            message(FATAL_ERROR "${case} O${level} differs: ${native}${cpp}")
        endif()
    endforeach()
endforeach()
file(WRITE "${work}/loader.wd" "try:\n    db_version()\n    assert(false)\nexcept err:\n    assert(err.code == 'R4020')\nprint('loader rejected')\n")
file(WRITE "${work}/diagnostic.wd" "connection=db_open(':memory:',10000)\ncursor=db_prepare(connection,'SELECT 1')\nstmt_int(cursor,0)\n")
file(WRITE "${work}/stock.csv" "name,quantity\npear,4\napple,7\n")
file(WRITE "${work}/invalid.csv" "name,quantity\napple,99\npear,-1\n")
file(WRITE "${work}/empty.csv" "name,quantity\n")
foreach(backend IN ITEMS native cpp)
    set(compiler "${WOOD}")
    set(flags)
    if(backend STREQUAL cpp)
        set(compiler "${PRODUCTION}")
        list(APPEND flags --cxx "${cxx}")
    endif()
    invoke(loader-build-${backend} 0 "${compiler}" build "${work}/loader.wd" -O0 ${flags} -o "${work}/loader-${backend}${suffix}")
    foreach(directory IN ITEMS relative "${work}/missing-library-directory")
        string(MD5 key "${directory}")
        invoke(loader-${backend}-${key} 0 "${CMAKE_COMMAND}" -E env "WOOD_SQLITE_DIR=${directory}" "${work}/loader-${backend}${suffix}")
        if(NOT out STREQUAL "loader rejected\n" OR NOT err STREQUAL "")
            message(FATAL_ERROR "Optional loader policy differs: ${out}${err}")
        endif()
    endforeach()
    invoke(diagnostic-build-${backend} 0 "${compiler}" build "${work}/diagnostic.wd" -O0 --diagnostics=json ${flags} -o "${work}/diagnostic-${backend}${suffix}")
    invoke(diagnostic-run-${backend} 70 "${work}/diagnostic-${backend}${suffix}")
    if(NOT out STREQUAL "")
        message(FATAL_ERROR "Unexpected diagnostic stdout")
    endif()
    set(diagnostic_${backend} "${err}")
    invoke(inventory-build-${backend} 0 "${compiler}" build "${SOURCE_DIR}/examples/sqlite_inventory.wd" -O2 ${flags} -o "${work}/inventory-${backend}${suffix}")
    foreach(operation IN ITEMS import reject verify)
        set(input "${work}/stock.csv")
        set(expected 0)
        if(operation STREQUAL reject)
            set(input "${work}/invalid.csv")
            set(expected 1)
        elseif(operation STREQUAL verify)
            set(input "${work}/empty.csv")
        endif()
        invoke(inventory-${backend}-${operation} ${expected} "${work}/inventory-${backend}${suffix}" "${work}/inventory-${backend}.db" "${input}")
        if(expected EQUAL 0)
            if(NOT out STREQUAL "[{\"name\":\"apple\",\"quantity\":7},{\"name\":\"pear\",\"quantity\":4}]\n" OR NOT err STREQUAL "")
                message(FATAL_ERROR "Inventory import/persistence/rollback differs: ${out}${err}")
            endif()
        elseif(NOT out STREQUAL "" OR NOT err MATCHES "R4010 inventory quantity cannot be negative")
            message(FATAL_ERROR "Inventory rejection differs: ${out}${err}")
        endif()
    endforeach()
endforeach()
foreach(field IN ITEMS severity code message file line column)
    string(JSON a GET "${diagnostic_native}" ${field})
    string(JSON b GET "${diagnostic_cpp}" ${field})
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "SQLite diagnostic ${field} differs: ${diagnostic_native}${diagnostic_cpp}")
    endif()
endforeach()
if(NOT WIN32)
    execute_process(COMMAND readelf -d "${work}/inventory-native" OUTPUT_VARIABLE dynamic RESULT_VARIABLE status)
    if(NOT status STREQUAL "0" OR NOT dynamic MATCHES "libc[.]so[.]6" OR dynamic MATCHES "libstdc[+][+]|libgcc")
        message(FATAL_ERROR "Optional SQLite dependency boundary differs: ${dynamic}")
    endif()
    execute_process(COMMAND readelf -l -d "${WOOD}" OUTPUT_VARIABLE compiler_dependencies RESULT_VARIABLE status)
    if(NOT status STREQUAL "0" OR compiler_dependencies MATCHES "INTERP|NEEDED")
        message(FATAL_ERROR "Native compiler gained a hosted runtime dependency: ${compiler_dependencies}")
    endif()
    file(WRITE "${work}/independent.wd" "print('independent')\n")
    foreach(level IN ITEMS 0 2)
        invoke(independent-build-O${level} 0 "${WOOD}" build "${work}/independent.wd" -O${level} -o "${work}/independent-${level}")
        invoke(independent-run-O${level} 0 "${work}/independent-${level}")
        if(NOT out STREQUAL "independent\n" OR NOT err STREQUAL "")
            message(FATAL_ERROR "Independent output differs: ${out}${err}")
        endif()
        execute_process(COMMAND readelf -l -d "${work}/independent-${level}" OUTPUT_VARIABLE dependencies RESULT_VARIABLE status)
        if(NOT status STREQUAL "0" OR dependencies MATCHES "INTERP|NEEDED")
            message(FATAL_ERROR "Ordinary O${level} application gained a C runtime: ${dependencies}")
        endif()
    endforeach()
endif()
file(WRITE "${work}/validation.txt" "${checks} commands passed; O0/O2 SQLite and lifecycle/concurrency corpus differential; six-field diagnostic equivalence; trusted-loader rejection; real CSV-to-SQLite import/persistence/rollback application; explicit optional-library dependency boundary.\n")
message(STATUS "Native SQLite qualification: ${checks} commands passed: ${work}")
