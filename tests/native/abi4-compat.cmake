cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS EMITTER STDLIB LEGACY_RUNTIME_OBJECT LLC OPT LINKER TARGET SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
foreach(path IN ITEMS EMITTER STDLIB LEGACY_RUNTIME_OBJECT SOURCE_DIR)
    if(NOT EXISTS "${${path}}")
        message(FATAL_ERROR "Supply an existing ${path}")
    endif()
endforeach()
if(NOT "${TARGET}" MATCHES "^(linux|windows)-x86_64$")
    message(FATAL_ERROR "Unsupported test target: ${TARGET}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
if(WIN32)
    set(suffix .exe)
endif()
function(build label input level expected)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -DEMITTER=${EMITTER} -DSTDLIB=${STDLIB} -DRUNTIME_DIR=${SOURCE_DIR}/runtime/native
        -DRUNTIME_OBJECT=${LEGACY_RUNTIME_OBJECT} -DTARGET=${TARGET} -DINPUT=${input}
        -DOUTPUT=${work}/${label}${suffix} -DLLC=${LLC} -DOPT=${OPT} -DLINKER=${LINKER}
        -DOPTIMIZATION=${level} -DWSL_DISTRIBUTION=${WSL_DISTRIBUTION}
        -P "${SOURCE_DIR}/tools/build-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(WRITE "${work}/${label}-build.log" "${out}${err}")
    if(expected AND NOT status STREQUAL "0")
        message(FATAL_ERROR "Legacy runtime cannot link ${label}: ${status}: ${out}${err}")
    elseif(NOT expected AND (status STREQUAL "0" OR NOT err MATCHES "Native linking failed" OR EXISTS "${work}/${label}${suffix}"))
        message(FATAL_ERROR "Unsupported SQLite was not rejected during linking: ${status}: ${out}${err}")
    endif()
endfunction()
foreach(level IN ITEMS 0 2)
    build(legacy-O${level} "${SOURCE_DIR}/tests/native_backend.wd" ${level} TRUE)
    execute_process(COMMAND "${work}/legacy-O${level}${suffix}" RESULT_VARIABLE status
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    string(REPLACE "\r\n" "\n" out "${out}")
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "independent native core passed 55 true None\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Legacy runtime O${level} execution differed: ${status}: ${out}${err}")
    endif()
endforeach()
file(WRITE "${work}/sqlite.wd" "connection=db_open(':memory:',1000)\ndb_close(connection)\n")
build(unsupported-sqlite "${work}/sqlite.wd" 0 FALSE)
file(WRITE "${work}/validation.txt" "Previously qualified ABI-4 runtime links and runs ordinary O0/O2 code; missing SQLite ABI fails closed at link time, without a published executable.\n")
message(STATUS "Legacy ABI-4 runtime O0/O2 compatibility and unsupported-service rejection passed: ${work}")
