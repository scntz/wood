cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
get_filename_component(bin "${WOOD}" DIRECTORY)
get_filename_component(prefix "${bin}" DIRECTORY)
set(data "${prefix}/share/wood")
set(suffix "")
if(WIN32)
    set(suffix .exe)
endif()
file(GLOB sources "${data}/bootstrap/src/*.wd" "${data}/native/*")
list(APPEND sources "${data}/stdlib.json" "${data}/native.json")
foreach(source IN LISTS sources)
    if(IS_DIRECTORY "${source}")
        continue()
    endif()
    file(SHA256 "${source}" hash)
    string(SHA256 key "${source}")
    set(frozen_${key} "${hash}")
    file(APPEND "${work}/sources.sha256" "${hash} ${source}\n")
endforeach()
set(previous "${WOOD}")
foreach(stage RANGE 1 3)
    set(stage_root "${work}/stage${stage}")
    file(MAKE_DIRECTORY "${stage_root}/bin" "${stage_root}/share")
    file(COPY "${data}" DESTINATION "${stage_root}/share")
    set(output "${stage_root}/bin/wood${suffix}")
    execute_process(COMMAND "${previous}" build "${data}/bootstrap/src/driver_main.wd"
        --backend=llvm -O0 -o "${output}" --timeout-ms 1800000
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 2100 ENCODING UTF-8)
    file(WRITE "${work}/stage${stage}.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native normal-driver bootstrap stage ${stage} failed: ${status}: ${out}${err}")
    endif()
    execute_process(COMMAND "${output}" --language-info RESULT_VARIABLE status OUTPUT_VARIABLE metadata ERROR_VARIABLE err TIMEOUT 60)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Stage ${stage} cannot discover its own installation: ${err}")
    endif()
    string(JSON backend GET "${metadata}" driver_default_backend)
    if(NOT backend STREQUAL llvm)
        message(FATAL_ERROR "Stage ${stage} lost native default")
    endif()
    file(SHA256 "${output}" hash)
    file(APPEND "${work}/hashes.txt" "${hash} stage${stage}\n")
    set(previous "${output}")
endforeach()
file(SHA256 "${work}/stage2/bin/wood${suffix}" stage2)
file(SHA256 "${work}/stage3/bin/wood${suffix}" stage3)
if(NOT stage2 STREQUAL stage3)
    message(FATAL_ERROR "Native normal-driver stage2/stage3 executables differ")
endif()
foreach(source IN LISTS sources)
    if(IS_DIRECTORY "${source}")
        continue()
    endif()
    file(SHA256 "${source}" hash)
    string(SHA256 key "${source}")
    if(NOT hash STREQUAL frozen_${key})
        message(FATAL_ERROR "Bootstrap input changed: ${source}")
    endif()
endforeach()
file(WRITE "${work}/validation.txt" "Three normal-driver native self-builds passed; stage2/stage3 binaries identical. No C++ source/compiler/runtime used. External LLVM/linker and prepared C17 object remain required.\n")
message(STATUS "Native installed normal-driver bootstrap fixed point passed: ${work}")
