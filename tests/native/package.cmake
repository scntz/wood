cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
get_filename_component(bin "${WOOD}" DIRECTORY)
get_filename_component(prefix "${bin}" DIRECTORY)
# A fixed test epoch proves repeatability without requiring a Git checkout in
# an installed source tree. Release callers supply their source commit epoch.
set(epoch 1704067200)
foreach(name IN ITEMS candidate repeat)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
        -DOUTPUT=${work}/${name}.tar.gz -DSOURCE_DATE_EPOCH=${epoch}
        -P "${SOURCE_DIR}/tools/package-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(WRITE "${work}/${name}.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native package ${name} failed: ${status}: ${out}${err}")
    endif()
endforeach()
file(SHA256 "${work}/candidate.tar.gz" a)
file(SHA256 "${work}/repeat.tar.gz" b)
if(NOT a STREQUAL b)
    message(FATAL_ERROR "Identical native inputs and epoch produced different archives: ${a} ${b}")
endif()
file(SHA256 "${prefix}/share/wood/native.json" original_config)
foreach(name IN ITEMS portable portable-repeat)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
        -DOUTPUT=${work}/${name}.tar.gz -DSOURCE_DATE_EPOCH=${epoch} -DPORTABLE_NATIVE_TOOLS=ON
        -P "${SOURCE_DIR}/tools/package-native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(WRITE "${work}/${name}.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Portable native package ${name} failed: ${status}: ${out}${err}")
    endif()
endforeach()
file(SHA256 "${work}/portable.tar.gz" portable)
file(SHA256 "${work}/portable-repeat.tar.gz" portable_repeat)
file(SHA256 "${prefix}/share/wood/native.json" preserved_config)
if(NOT portable STREQUAL portable_repeat OR NOT original_config STREQUAL preserved_config)
    message(FATAL_ERROR "Portable packaging was not repeatable or modified its input installation")
endif()
file(ARCHIVE_EXTRACT INPUT "${work}/portable.tar.gz" DESTINATION "${work}/portable-extracted")
file(READ "${work}/portable-extracted/wood-native/share/wood/native.json" config)
foreach(key IN ITEMS llvm_dir llvm_wsl)
    string(JSON value GET "${config}" ${key})
    if(NOT value STREQUAL "")
        message(FATAL_ERROR "Portable package retained host-specific ${key}")
    endif()
endforeach()
string(JSON value GET "${config}" linker)
if(NOT value MATCHES "^(ld|lld-link[.]exe)$")
    message(FATAL_ERROR "Portable package retained a host-specific linker")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
    -DOUTPUT=${work}/candidate.tar.gz -DSOURCE_DATE_EPOCH=${epoch}
    -P "${SOURCE_DIR}/tools/package-native.cmake"
    RESULT_VARIABLE refused OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
file(SHA256 "${work}/candidate.tar.gz" after)
if(refused STREQUAL "0" OR NOT a STREQUAL after OR NOT err MATCHES "already exists")
    message(FATAL_ERROR "Native packager did not preserve an existing archive: ${out}${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
    -DOUTPUT=${prefix}/must-not-create.tar.gz -DSOURCE_DATE_EPOCH=${epoch}
    -P "${SOURCE_DIR}/tools/package-native.cmake"
    RESULT_VARIABLE refused OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
if(refused STREQUAL "0" OR EXISTS "${prefix}/must-not-create.tar.gz" OR NOT err MATCHES "outside its installed input tree")
    message(FATAL_ERROR "Native packager did not reject an archive inside its input: ${out}${err}")
endif()
if(NOT WIN32)
    # Resolve output-parent aliases before creating staging files; lexical path
    # comparison alone can put the archive inside the input via a symlink.
    file(CREATE_LINK "${prefix}" "${work}/prefix-alias" SYMBOLIC RESULT status)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot prepare package path-alias regression: ${status}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
        -DOUTPUT=${work}/prefix-alias/must-not-create.tar.gz -DSOURCE_DATE_EPOCH=${epoch}
        -P "${SOURCE_DIR}/tools/package-native.cmake"
        RESULT_VARIABLE refused OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(refused STREQUAL "0" OR EXISTS "${prefix}/must-not-create.tar.gz" OR NOT err MATCHES "outside its installed input tree")
        message(FATAL_ERROR "Native packager did not reject an aliased in-input output: ${out}${err}")
    endif()
    foreach(kind IN ITEMS archive checksum)
        set(reserved "${work}/reserved-${kind}.tar.gz")
        set(link "${reserved}")
        if(kind STREQUAL checksum)
            string(APPEND link ".sha256")
        endif()
        file(CREATE_LINK "${work}/missing" "${link}" SYMBOLIC RESULT status)
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "Cannot prepare dangling package-link regression: ${status}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -DPREFIX=${prefix}
            -DOUTPUT=${reserved} -DSOURCE_DATE_EPOCH=${epoch}
            -P "${SOURCE_DIR}/tools/package-native.cmake"
            RESULT_VARIABLE refused OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
        if(refused STREQUAL "0" OR EXISTS "${work}/missing" OR NOT err MATCHES "already exists")
            message(FATAL_ERROR "Native packager did not preserve dangling ${kind} link: ${out}${err}")
        endif()
    endforeach()
endif()
set(extracted "${work}/extracted")
file(ARCHIVE_EXTRACT INPUT "${work}/candidate.tar.gz" DESTINATION "${extracted}")
set(compiler "${extracted}/wood-native/bin/wood")
set(suffix "")
if(WIN32)
    set(suffix .exe)
    string(APPEND compiler ".exe")
endif()
function(invoke label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "Extracted native ${label} failed: ${status}: ${out}${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
invoke(init 0 "${compiler}" init "${work}/project")
invoke(lock 0 "${compiler}" lock "${work}/project")
invoke(check 0 "${compiler}" check "${work}/project" --locked --diagnostics=json)
invoke(test 0 "${compiler}" test "${work}/project" --locked --report=json)
invoke(build 0 "${compiler}" build "${work}/project" --locked -O2 -o "${work}/application${suffix}")
invoke(run 0 "${work}/application${suffix}")
if(out STREQUAL "" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Extracted initialized application did not run cleanly: ${out}${err}")
endif()
invoke(official-packages 0 "${CMAKE_COMMAND}" -DWOOD=${compiler}
    -DSOURCE_DIR=${extracted}/wood-native/share/wood -DTEST_DIR=${work}/official-packages
    -P "${extracted}/wood-native/share/wood/tests/official_packages.cmake")
if(NOT EXISTS "${extracted}/wood-native/share/wood/examples/desktop_notes/tests/test_presentation.wd")
    message(FATAL_ERROR "Extracted package omitted the desktop presentation regression")
endif()
invoke(desktop-presentation 0 "${compiler}" test
    "${extracted}/wood-native/share/wood/examples/desktop_notes" --locked --report=json)
file(WRITE "${work}/stock.csv" "name,quantity\npear,4\napple,7\n")
invoke(sqlite-build 0 "${compiler}" build "${extracted}/wood-native/share/wood/examples/sqlite_inventory.wd"
    -O2 -o "${work}/inventory${suffix}")
invoke(sqlite-run 0 "${work}/inventory${suffix}" "${work}/inventory.db" "${work}/stock.csv")
if(NOT out STREQUAL "[{\"name\":\"apple\",\"quantity\":7},{\"name\":\"pear\",\"quantity\":4}]\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Extracted native SQLite application differs: ${out}${err}")
endif()
# A broken native toolchain must fail without C++ fallback or publication.
invoke(no-fallback 2 "${compiler}" build "${extracted}/wood-native/share/wood/examples/hello.wd"
    --llvm-dir "${work}/missing-llvm-tools" --diagnostics=json -o "${work}/no-fallback${suffix}")
if(NOT err MATCHES "D500[12]" OR EXISTS "${work}/no-fallback${suffix}")
    message(FATAL_ERROR "Extracted compiler did not fail closed for missing native tools: ${out}${err}")
endif()
file(WRITE "${work}/validation.txt" "Two identical native tar.gz hashes ${a}; two identical portable-config package hashes ${portable}; input configuration preserved; payload manifests/extraction checked; existing-output and in-input-output rejection; extracted locked project and native SQLite application; missing-native-tool rejection with no C++ fallback.\n")
message(STATUS "Reproducible native package and extracted installed workflows passed: ${work}; SHA-256 ${a}")
