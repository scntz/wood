cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(cxx /usr/bin/g++)
if(WIN32)
    set(cxx cl.exe)
endif()
foreach(level IN ITEMS 0 2)
    foreach(backend IN ITEMS native cpp)
        set(compiler "${WOOD}")
        set(flags)
        if(backend STREQUAL cpp)
            set(compiler "${PRODUCTION}")
            set(flags --cxx "${cxx}")
        endif()
        execute_process(COMMAND "${compiler}" run "${SOURCE_DIR}/tests/native_sequence_ownership.wd"
            -O${level} ${flags} WORKING_DIRECTORY "${work}"
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 400 ENCODING UTF-8)
        file(WRITE "${work}/${backend}-O${level}.log" "${out}${err}")
        if(NOT status STREQUAL "0" OR NOT err STREQUAL "" OR NOT out STREQUAL "native sequence ownership passed\n")
            message(FATAL_ERROR "${backend}-O${level}: ${status}: ${out}${err}")
        endif()
    endforeach()
endforeach()
file(WRITE "${work}/validation.txt" "4 O0/O2 native/reference ownership commands passed, including 13 growth boundaries, nested record/list/array COW and escaping popped values.\n")
message(STATUS "Native sequence ownership differential passed")
