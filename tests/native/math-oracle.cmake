cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_DIR}")
get_filename_component(cxx_name "${CXX}" NAME)
set(oracle "${TEST_DIR}/vectors")
if(cxx_name MATCHES "^cl([.]exe)?$")
    set(oracle "${oracle}.exe")
    set(flags /nologo /std:c++latest /EHsc /O2 /fp:precise
        /Fo${TEST_DIR}/vectors.obj /Fe${oracle})
else()
    set(flags -std=c++23 -O2 -ffp-contract=off -o "${oracle}")
endif()
execute_process(COMMAND "${CXX}" ${flags} "${SOURCE_DIR}/tests/native/math_vectors.cpp"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
file(WRITE "${TEST_DIR}/oracle-build.log" "${out}${err}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Independent math oracle build failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${oracle}" "${TEST_DIR}/vectors.json" RESULT_VARIABLE status TIMEOUT 60)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Independent math vector generation failed: ${status}")
endif()
foreach(pair IN ITEMS "MATH|native_math" "TEXT|native_text" "COMPUTING|native_computing" "OBJ|obj_import")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 case)
    set(arguments)
    if(name STREQUAL MATH)
        list(APPEND arguments "${TEST_DIR}/vectors.json")
    elseif(name STREQUAL OBJ)
        list(APPEND arguments "${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj")
    endif()
    file(MAKE_DIRECTORY "${TEST_DIR}/${case}-native" "${TEST_DIR}/${case}-production")
    execute_process(COMMAND "${${name}_EXE}" ${arguments} WORKING_DIRECTORY "${TEST_DIR}/${case}-native"
        RESULT_VARIABLE status OUTPUT_VARIABLE native ERROR_VARIABLE err TIMEOUT 120)
    file(WRITE "${TEST_DIR}/${case}-native.log" "${native}${err}")
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Native ${case} failed: ${status}: ${native}${err}")
    endif()
    execute_process(COMMAND "${PRODUCTION}" "${SOURCE_DIR}/tests/${case}.wd" --cxx "${CXX}" -O${LEVEL} -- ${arguments}
        WORKING_DIRECTORY "${TEST_DIR}/${case}-production"
        RESULT_VARIABLE status OUTPUT_VARIABLE reference ERROR_VARIABLE err TIMEOUT 180)
    file(WRITE "${TEST_DIR}/${case}-production.log" "${reference}${err}")
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "" OR NOT native STREQUAL reference)
        message(FATAL_ERROR "Production ${case} differs: ${status}: ${reference}${err}; native: ${native}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/validation.txt" "7278 full-range binary64 cases, <=2 local-reference ULP sine/cosine, unit circle, six nonfinite failures, signed zero; binary whole-file reads; unchanged numerical and complete OBJ-import regressions; all exact production stdout checks passed.\n")
message(STATUS "Native math/files/numerical/OBJ differential checks passed O${LEVEL}")
