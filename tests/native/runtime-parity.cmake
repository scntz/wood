cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD PRODUCTION SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}" "${work}/input")
set(suffix "")
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
else()
    set(cxx /usr/bin/g++)
endif()
set(checks 0)
function(invoke label expected exe)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${work}"
        INPUT_FILE "${work}/input/empty" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label} exited ${status}, expected ${expected}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
file(WRITE "${work}/input/empty" "")
invoke(generate 0 "${WOOD}" run "${SOURCE_DIR}/tests/native_stdin.wd" -O0 -- generate "${work}/input")
foreach(level IN ITEMS 0 2)
    foreach(case IN ITEMS time dictionaries collections native_runtime_values native_self_update)
        invoke(${case}-native-O${level} 0 "${WOOD}" run "${SOURCE_DIR}/tests/${case}.wd" -O${level})
        set(native "${out}")
        invoke(${case}-cpp-O${level} 0 "${PRODUCTION}" run "${SOURCE_DIR}/tests/${case}.wd" -O${level} --cxx "${cxx}")
        if(NOT native STREQUAL out OR NOT err STREQUAL "")
            message(FATAL_ERROR "${case} differs from production: ${native}${out}${err}")
        endif()
    endforeach()
    invoke(stdin-native-build-O${level} 0 "${WOOD}" build "${SOURCE_DIR}/tests/native_stdin.wd" -O${level} -o "${work}/stdin-native-${level}${suffix}")
    invoke(stdin-cpp-build-O${level} 0 "${PRODUCTION}" build "${SOURCE_DIR}/tests/native_stdin.wd" -O${level} --cxx "${cxx}" -o "${work}/stdin-cpp-${level}${suffix}")
    foreach(case IN ITEMS empty lines crlf binary ctrl-z boundary)
        foreach(backend IN ITEMS native cpp)
            execute_process(COMMAND "${work}/stdin-${backend}-${level}${suffix}" INPUT_FILE "${work}/input/${case}"
                RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
            file(WRITE "${work}/stdin-${backend}-${case}-O${level}.log" "${output}${errors}")
            if(NOT status STREQUAL "0" OR NOT errors STREQUAL "")
                message(FATAL_ERROR "${backend} stdin ${case} failed: ${status}: ${errors}")
            endif()
            set(${backend} "${output}")
            math(EXPR checks "${checks}+1")
        endforeach()
        if(NOT native STREQUAL cpp)
            message(FATAL_ERROR "stdin ${case} O${level} differs")
        endif()
        # The real CLI must preserve input across verifier/codegen/linker tools.
        execute_process(COMMAND "${WOOD}" run "${SOURCE_DIR}/tests/native_stdin.wd" -O${level}
            INPUT_FILE "${work}/input/${case}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 300)
        file(WRITE "${work}/stdin-cli-${case}-O${level}.log" "${output}${errors}")
        if(NOT status STREQUAL "0" OR NOT output STREQUAL cpp OR NOT errors STREQUAL "")
            message(FATAL_ERROR "Installed CLI stdin ${case} O${level} differs: ${status}: ${errors}")
        endif()
        math(EXPR checks "${checks}+1")
    endforeach()
endforeach()
if(WIN32)
    execute_process(COMMAND cl.exe /nologo /TC "${SOURCE_DIR}/tests/native/stdin_failure.c"
        "/Fo:${work}/failure.obj" "/Fe:${work}/failure.exe" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
else()
    execute_process(COMMAND /usr/bin/clang-19 -std=c17 "${SOURCE_DIR}/tests/native/stdin_failure.c"
        -o "${work}/failure" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
endif()
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Real closed-stdin launcher build failed: ${out}${err}")
endif()
foreach(backend IN ITEMS native cpp)
    invoke(closed-${backend} 0 "${work}/failure${suffix}" "${work}/stdin-${backend}-0${suffix}" failure)
    if(NOT out STREQUAL "stdin failure passed\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Repeated stdin failure behavior differs: ${out}${err}")
    endif()
endforeach()
file(WRITE "${work}/input/words" "green red green\nignore red\nblue")
execute_process(COMMAND "${WOOD}" run "${SOURCE_DIR}/examples/native_word_counts.wd" -O2
    INPUT_FILE "${work}/input/words" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 300)
file(WRITE "${work}/word-counts.log" "${output}${errors}")
if(NOT status STREQUAL "0" OR NOT output STREQUAL "lines: 3\ncounts: {\"green\": 2, \"red\": 2, \"blue\": 1}\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Real stdin/time/collections application failed: ${status}: ${output}${errors}")
endif()
math(EXPR checks "${checks}+1")
file(WRITE "${work}/validation.txt" "${checks} installed-CLI/runtime invocations passed; O0/O2 stdin bytes, timing, deletion, COW, deep formatting, closed-stdin errors and word-count application qualified against C++ on this OS.\n")
message(STATUS "Native runtime differential checks passed (${checks} invocations): ${work}")
