cmake_minimum_required(VERSION 3.25)
# The audit's binary exemption must apply only at the reviewed path with the reviewed
# bytes. Runs the real audit script in temporary repositories, so it needs PowerShell 7.
foreach(required IN ITEMS WORK SOURCE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
find_program(pwsh NAMES pwsh REQUIRED)
get_filename_component(WORK "${WORK}" ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${WORK}/run-${run_id}")
set(ENV{GIT_CEILING_DIRECTORIES} "${WORK}")
function(audit name expected)
    set(repo "${WORK}/${name}")
    file(MAKE_DIRECTORY "${repo}/.github" "${repo}/docs/assets")
    file(COPY_FILE "${SOURCE_DIR}/.github/release-audit.json" "${repo}/.github/release-audit.json")
    file(WRITE "${repo}/README.md" "fixture\n")
    foreach(pair IN LISTS ARGN)
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 from)
        list(GET parts 1 to)
        get_filename_component(parent "${repo}/${to}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${from}" "${repo}/${to}")
    endforeach()
    foreach(step IN ITEMS "init;-q;-b;main" "add;-A" "-c;user.name=fixture;-c;user.email=fixture@example.invalid;commit;-qm;fixture")
        execute_process(COMMAND "${git}" -C "${repo}" ${step} RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name}: git ${step} failed")
        endif()
    endforeach()
    execute_process(COMMAND "${pwsh}" -NoProfile -File "${SOURCE_DIR}/tools/release-audit.ps1"
        WORKING_DIRECTORY "${repo}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected audit exit ${expected}, got ${status}\n${out}${err}")
    endif()
    if(NOT expected EQUAL 0 AND NOT out MATCHES "binary-NUL")
        message(FATAL_ERROR "${name}: expected a binary finding\n${out}${err}")
    endif()
    message(STATUS "PASS: ${name}")
endfunction()
set(logo "${SOURCE_DIR}/docs/assets/logo.png")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${pwsh}" -NoProfile -Command "$b=[IO.File]::ReadAllBytes('${logo}'); $b[100]=$b[100] -bxor 1; [IO.File]::WriteAllBytes('${WORK}/changed.png',$b)" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "cannot create the changed fixture")
endif()
audit(reviewed-file 0 "${logo}|docs/assets/logo.png")
audit(same-bytes-other-path 1 "${logo}|docs/assets/other.png")
audit(changed-bytes 1 "${WORK}/changed.png|docs/assets/logo.png")
message(STATUS "Audit binary exemption passed: 3 cases")
