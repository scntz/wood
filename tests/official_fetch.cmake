cmake_minimum_required(VERSION 3.25)
# Check actual release packages. PACKAGE_ARCHIVES selects a local mirror with
# the same hashes as the public catalog.
foreach(required IN ITEMS WOOD WORK SOURCE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
get_filename_component(WORK "${WORK}" ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${WORK}/run-${run_id}")
file(MAKE_DIRECTORY "${WORK}")
set(count 0)
file(READ "${SOURCE_DIR}/catalog/index.json" index)
if(DEFINED PACKAGE_ARCHIVES)
    file(TO_CMAKE_PATH "${PACKAGE_ARCHIVES}" archives)
    if(WIN32)
        set(origin "file:///${archives}/")
    else()
        set(origin "file://${archives}/")
    endif()
    string(REPLACE "https://github.com/scntz/wood/releases/download/v1.1.0/" "${origin}" index "${index}")
endif()
file(WRITE "${WORK}/index.json" "${index}")
set(environment "WOOD_PACKAGE_INDEX=${WORK}/index.json" "WOOD_CACHE_DIR=${WORK}/cache")
function(wood expected label)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    file(APPEND "${WORK}/commands.log" "== ${label}: ${ARGN}\nstatus=${status}\n${out}${err}\n")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}\n${out}${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()


string(JSON total LENGTH "${index}" packages)
math(EXPR last "${total}-1")
set(names "")
foreach(position RANGE ${last})
    string(JSON owner GET "${index}" packages ${position} owner)
    if(owner STREQUAL "wood")
        string(JSON name GET "${index}" packages ${position} name)
        list(APPEND names "${name}")
    endif()
endforeach()
if(NOT names)
    message(FATAL_ERROR "The catalog lists no official packages")
endif()
foreach(name IN LISTS names)
    set(project "${WORK}/app-${name}")
    wood(0 "init-${name}" init "${project}")
    wood(0 "add-${name}" add "wood@${name}" --project "${project}")
    if(NOT EXISTS "${project}/wood.lock")
        message(FATAL_ERROR "wood@${name}: no lock was written")
    endif()
    file(READ "${project}/wood.lock" lock)
    if(NOT lock MATCHES "[.]woodpkg" OR NOT lock MATCHES "sha256")
        message(FATAL_ERROR "wood@${name}: the lock does not pin an archive: ${lock}")
    endif()
    wood(0 "list-${name}" list --project "${project}")
    wood(0 "check-${name}" check "${project}" --locked)
endforeach()

# Installing on a fresh machine restores exactly the same bytes from the lock.
file(RENAME "${WORK}/cache" "${WORK}/first-cache")
file(RENAME "${WORK}/app-image/vendor" "${WORK}/first-vendor")
wood(0 install-image install --locked --project "${WORK}/app-image")
wood(0 check-restored check "${WORK}/app-image" --locked)

# The guide's program really runs from the fetched package.
file(WRITE "${WORK}/app-image/src/main.wd" "import image.image as img\nimport image.codecs as codecs\n\npicture = img.filled(160, 100, img.rgb(244, 241, 234))\ncodecs.save(\"card.png\", img.fill_circle(picture, 80, 50, 30, img.rgb(46, 110, 80)))\nprint(\"drew a card\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${WOOD}" run "${WORK}/app-image" WORKING_DIRECTORY "${WORK}/app-image" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
if(NOT status EQUAL 0 OR NOT out MATCHES "drew a card" OR NOT EXISTS "${WORK}/app-image/card.png")
    message(FATAL_ERROR "The fetched wood@image did not run: ${status}\n${out}${err}")
endif()
math(EXPR count "${count}+1")
list(LENGTH names installed)
message(STATUS "Official package fetch passed: ${installed} packages, ${count} commands")
