cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../tools/embed-text.cmake")
function(check content)
    wood_embed_text(encoded "${content}")
    set(remaining "${encoded}")
    set(decoded "")
    while(NOT remaining STREQUAL "")
        string(STRIP "${remaining}" remaining)
        if(remaining STREQUAL "")
            break()
        endif()
        string(REGEX MATCH "^R\"([A-Za-z0-9_]+)\\(" prefix "${remaining}")
        if(prefix STREQUAL "")
            message(FATAL_ERROR "Generated text is not adjacent raw literals")
        endif()
        set(ending ")${CMAKE_MATCH_1}\"")
        string(LENGTH "${prefix}" start)
        string(SUBSTRING "${remaining}" ${start} -1 body)
        string(FIND "${body}" "${ending}" end)
        if(end LESS 0 OR end GREATER 8000)
            message(FATAL_ERROR "Missing delimiter or oversized literal: ${end}")
        endif()
        string(SUBSTRING "${body}" 0 ${end} chunk)
        if(NOT chunk STREQUAL "")
            string(SUBSTRING "${chunk}" 0 1 first)
            string(HEX "${first}" byte)
            if(byte MATCHES "^[89ab][0-9a-f]$")
                message(FATAL_ERROR "Literal starts inside a UTF-8 code point")
            endif()
        endif()
        string(APPEND decoded "${chunk}")
        string(LENGTH "${ending}" ending_length)
        math(EXPR next "${end} + ${ending_length}")
        string(SUBSTRING "${body}" ${next} -1 remaining)
    endwhile()
    if(NOT decoded STREQUAL content)
        message(FATAL_ERROR "Literal generation changed input bytes")
    endif()
endfunction()

check("")
check("quotes;\\\" )WOOD_0\" )WOOD_1\" @source@\n")
foreach(length IN ITEMS 7999 8000 8001 16380 65536 65537)
    string(REPEAT "a" ${length} text)
    check("${text}")
endforeach()
string(REPEAT "tail;\\\"\n" 3000 tail)
foreach(length IN ITEMS 7995 7997 7998 7999 8000)
    string(REPEAT "p" ${length} prefix)
    check("${prefix}🌳é${tail}")
endforeach()
message(STATUS "13 embedded-text cases: exact reconstruction, bounded literals, UTF-8 boundaries and delimiters passed")
