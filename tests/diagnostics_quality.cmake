cmake_minimum_required(VERSION 3.25)
# Each mistake here once produced a message that did not help. The check pins its code, its
# location and the advice, so the wording can improve but the help cannot silently disappear.
foreach(required IN ITEMS WOOD WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${WORK}/run-${run_id}")
file(MAKE_DIRECTORY "${WORK}")
set(count 0)
function(rejected name source code location advice)
    set(file "${WORK}/${name}.wd")
    file(WRITE "${file}" "${source}")
    execute_process(COMMAND "${WOOD}" check "${file}" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(status EQUAL 0)
        message(FATAL_ERROR "${name}: expected a diagnostic")
    endif()
    string(FIND "${err}" ":${location}: error[${code}]:" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "${name}: expected ${code} at ${location}, got: ${err}")
    endif()
    string(FIND "${err}" "${advice}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${name}: expected advice '${advice}', got: ${err}")
    endif()
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()
function(valid name source)
    set(file "${WORK}/${name}.wd")
    file(WRITE "${file}" "${source}")
    execute_process(COMMAND "${WOOD}" check "${file}" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name}: a valid program was rejected: ${err}")
    endif()
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()
function(command_fails name advice)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(status EQUAL 0)
        message(FATAL_ERROR "${name}: expected failure")
    endif()
    string(FIND "${out}${err}" "${advice}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${name}: expected advice '${advice}', got: ${out}${err}")
    endif()
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()

# Methods on builtin values, which used to say "expected error, got list[int]".
rejected(list-append "items = [1]\nitems.append(2)\n" E3016 2:1 "call it as append(items, value)")
rejected(string-method "text = \"abc\"\ntext.startswith(\"a\")\n" E3016 2:1 "starts_with(text, prefix)")
rejected(string-length "text = \"abc\"\nprint(text.length)\n" E3016 2:7 "len(value)")
rejected(dict-keys "items = {\"a\": 1}\nitems.keys()\n" E3016 2:1 "keys(items)")
rejected(int-member "value = 1\nprint(value.size)\n" E3016 2:7 "int has no field or method 'size'")
rejected(no-such-method "text = \"abc\"\ntext.upper()\n" E3016 2:1 "str has no field or method 'upper'")

# Records: what exists, instead of a remark about methods.
set(point "record Point:\n    x: int\n    y: int\n\n    fn moved(self) -> Point:\n        return self\n\np = Point(1, 2)\n")
rejected(record-typo "${point}print(p.z)\n" E3016 9:7 "it has x, y, moved()")
rejected(record-similar "${point}print(p.movd())\n" E3016 9:7 "did you mean 'moved'?")
rejected(method-not-called "${point}print(p.moved)\n" E3016 9:7 "method 'moved' must be called")
valid(record-fine "${point}print(p.x)\nprint(p.moved().y)\n")

# Modules.
rejected(module-member "import std.path as path\npath.nothing(\"x\")\n" E3005 2:1 "module 'path' does not export it")
rejected(missing-import-call "path.name(\"x\")\n" E3005 1:1 "add 'import std.path as path'")
rejected(missing-import-name "print(math)\n" E3007 1:7 "add 'import std.math as math'")
rejected(missing-module "import nothing_here\n" E3101 1:1 "cannot find module 'nothing_here'")
rejected(unknown-standard "import std.nope as nope\n" E3101 1:1 "unknown standard module 'std.nope'")

# Operators and calls say which types are involved.
rejected(string-plus-int "s = \"a\" + 1\n" E3002 1:9 "cannot combine str and int; convert with str(value)")
rejected(none-plus-int "print(None + 1)\n" E3002 1:12 "cannot combine None and int")
rejected(call-non-function "x = 1\nx()\n" E3002 2:1 "int cannot be called")
rejected(iterate-int "for i in 5:\n    pass\n" E3010 1:10 "cannot iterate over int")
rejected(iterate-int-range "for i in 5:\n    pass\n" E3010 1:10 "use range(value)")
rejected(null-keyword "x = null\n" E3007 1:5 "wood spells this None")
rejected(keyword-unknown "fn f() -> int:\n    return 1\nnothing_here(x=1)\n" E3005 3:1 "unknown function 'nothing_here'")

# Habits from other languages.
rejected(assign-in-condition "x = 1\nif x = 1:\n    pass\n" E2001 2:6 "use '==' to compare")
rejected(else-if "if True:\n    pass\nelse if False:\n    pass\n" E2001 3:6 "write 'elif'")
rejected(double-and "x = 1\nif x == 1 && x == 2:\n    pass\n" E2004 2:12 "wood spells this 'and'")
rejected(double-or "x = 1\nif x == 1 || x == 2:\n    pass\n" E2004 2:12 "wood spells this 'or'")
rejected(bang "x = True\nif !x:\n    pass\n" E1007 2:4 "wood spells this 'not'")
rejected(semicolon "x = 1;\n" E1007 1:6 "statements end at the end of the line")
rejected(increment "x = 1\nx++\n" E2004 2:4 "wood has no ++")
rejected(let-keyword "let y = 1\n" E2001 1:5 "declare a variable by assigning")
rejected(var-keyword "var y = 1\n" E2001 1:5 "declare a variable by assigning")
rejected(class-keyword "class A:\n    pass\n" E2001 1:7 "declare a type with 'record'")
rejected(function-keyword "function f():\n    pass\n" E2001 1:10 "declare a function with 'fn'")
rejected(print-statement "print \"a\"\n" E2001 1:7 "write print(value)")
rejected(f-string "print(f\"x\")\n" E2001 1:8 "wood has no f-strings")
rejected(ternary "x = True ? 1 : 2\n" E1007 1:10 "wood has no ternary")
valid(habits-fine "f = 1\nprint(f)\nlet = 2\nprint(let)\nclass_name = \"a\"\nprint(class_name)\n")

# The command line.
command_fails(typo-command "did you mean 'wood build'?" buidl x.wd)
command_fails(typo-command-2 "did you mean 'wood check'?" chek x.wd)
command_fails(unknown-command "unknown command 'frobnicate'" frobnicate x.wd)
command_fails(unknown-option "see 'wood --help'" --nope)
command_fails(install-package "use: wood add wood@image" install wood@image)
command_fails(add-source "python@name" add foo)
execute_process(COMMAND "${WOOD}" --help OUTPUT_VARIABLE help RESULT_VARIABLE status)
string(FIND "${help}" "lsp" found)
if(NOT status EQUAL 0 OR found EQUAL -1)
    message(FATAL_ERROR "--help must mention the language server")
endif()
# A file the user named, inside a project but outside its source directory.
execute_process(COMMAND "${WOOD}" init project WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_QUIET)
file(WRITE "${WORK}/project/scratch.wd" "print(1)\n")
execute_process(COMMAND "${WOOD}" check scratch.wd WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE status ERROR_VARIABLE err OUTPUT_QUIET)
string(FIND "${err}" "'scratch.wd' is outside this project's source directory" found)
if(status EQUAL 0 OR found EQUAL -1)
    message(FATAL_ERROR "a file outside the source directory must be named: ${err}")
endif()
math(EXPR count "${count}+1")

# An error found while loading still shows the line it is about.
file(WRITE "${WORK}/project/src/main.wd" "import missing_module as gone\nprint(1)\n")
execute_process(COMMAND "${WOOD}" check WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE status ERROR_VARIABLE err OUTPUT_QUIET)
string(FIND "${err}" "  import missing_module as gone" found)
if(status EQUAL 0 OR found EQUAL -1)
    message(FATAL_ERROR "the source line must be shown: ${err}")
endif()
math(EXPR count "${count}+1")

# Help is where people look, on any command.
foreach(command IN ITEMS run check build test lock)
    execute_process(COMMAND "${WOOD}" ${command} --help RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_QUIET)
    string(FIND "${out}" "Usage: wood" found)
    if(NOT status EQUAL 0 OR found EQUAL -1)
        message(FATAL_ERROR "wood ${command} --help must show help: ${status} ${out}")
    endif()
    math(EXPR count "${count}+1")
endforeach()

# Help does not describe a released toolchain as an unfinished candidate, or pin a version.
execute_process(COMMAND "${WOOD}" --help RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT status EQUAL 0 OR out MATCHES "candidate" OR out MATCHES "wood 0[.]4[.]0" OR NOT out MATCHES "Usage: wood")
    message(FATAL_ERROR "--help must describe the tool as released: ${out}")
endif()
math(EXPR count "${count}+1")

# Metadata and version agree with what is actually running.
execute_process(COMMAND "${WOOD}" --language-info RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_QUIET)
string(JSON default_backend GET "${out}" driver_default_backend)
string(JSON backend GET "${out}" backend)
if(default_backend STREQUAL "llvm" AND NOT backend MATCHES "LLVM")
    message(FATAL_ERROR "a native installation must not report a C++ backend: ${backend}")
endif()
math(EXPR count "${count}+1")
execute_process(COMMAND "${WOOD}" --version RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_QUIET)
if(NOT status EQUAL 0 OR NOT out MATCHES "^wood [0-9]")
    message(FATAL_ERROR "--version: ${out}")
endif()
math(EXPR count "${count}+1")

# A bare -o name is an executable you can run on every platform. An explicit extension is respected.
file(WRITE "${WORK}/named.wd" "print(\"named\")\n")
execute_process(COMMAND "${WOOD}" build "${WORK}/named.wd" -o "${WORK}/named-app" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "build -o failed: ${out}${err}")
endif()
if(WIN32)
    set(named "${WORK}/named-app.exe")
else()
    set(named "${WORK}/named-app")
endif()
if(NOT EXISTS "${named}")
    message(FATAL_ERROR "build -o named-app must create ${named}")
endif()
execute_process(COMMAND "${named}" RESULT_VARIABLE status OUTPUT_VARIABLE out)
if(NOT status EQUAL 0 OR NOT out MATCHES "named")
    message(FATAL_ERROR "the built program did not run: ${status} ${out}")
endif()
math(EXPR count "${count}+1")
execute_process(COMMAND "${WOOD}" build "${WORK}/named.wd" -o "${WORK}/named.custom" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT EXISTS "${WORK}/named.custom" OR EXISTS "${WORK}/named.custom.exe")
    message(FATAL_ERROR "an explicit extension must be kept: ${err}")
endif()
math(EXPR count "${count}+1")

# An official package that cannot be reached says why, and what to do. Git is pointed at nothing, so
# this stays true after the repository is public.
file(WRITE "${WORK}/gitconfig" "[url \"file:///${WORK}/nothing/\"]\n\tinsteadOf = https://github.com/\n[protocol \"file\"]\n\tallow = always\n")
file(WRITE "${WORK}/index.json" "{\"schema_version\":1,\"packages\":[{\"owner\":\"wood\",\"name\":\"log\",\"package\":\"wood_log\",\"tier\":\"official\",\"description\":\"d\",\"versions\":[{\"version\":\"0.1.0\",\"published\":\"2026-11-01\",\"source\":{\"type\":\"github\",\"repo\":\"scntz/wood\",\"directory\":\"packages/wood_log\",\"commit\":\"8ac882c1348bf63d17021fb1dcc354f332d472cc\"}}]}]}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CONFIG_GLOBAL=${WORK}/gitconfig" "WOOD_CACHE_DIR=${WORK}/cache" "WOOD_PACKAGE_INDEX=${WORK}/index.json" "${WOOD}" add wood@log
    WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(FIND "${out}${err}" "share/wood/packages" found)
if(status EQUAL 0 OR found EQUAL -1)
    message(FATAL_ERROR "an unreachable official package must explain the alternative: ${out}${err}")
endif()
math(EXPR count "${count}+1")

# Missing tools name what to install. This is the likeliest first failure on Linux.
file(WRITE "${WORK}/tool.wd" "print(1)\n")
execute_process(COMMAND "${WOOD}" build "${WORK}/tool.wd" --llvm-dir "${WORK}/no-llvm" -o "${WORK}/tool-out"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(FIND "${out}${err}" "cannot run" found)
string(FIND "${out}${err}" "--llvm-dir" advice)
if(NOT status EQUAL 2 OR found EQUAL -1 OR advice EQUAL -1)
    message(FATAL_ERROR "a missing LLVM tool must say what to do, got ${status}: ${out}${err}")
endif()
math(EXPR count "${count}+1")

message(STATUS "Diagnostics quality passed: ${count} checks")
