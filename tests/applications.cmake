file(WRITE "${work}/errors.wd" [=[
mode = args()[0]
if mode == "bounds":
    print([1][-9223372036854775808])
elif mode == "pop":
    values: list[int] = []
    pop(values)
elif mode == "split":
    split("text", "")
elif mode == "read" or mode == "read_dir":
    read_text(args()[1])
elif mode == "write":
    write_text(args()[1], "data")
elif mode == "convert":
    int("9223372036854775808")
elif mode == "nul":
    assert(false, "a\0b")
elif mode == "bytes":
    assert(false, read_text(args()[1]))
]=])
invoke(0 build "${work}/errors.wd" -o "${errors}" --diagnostics=json)
foreach(mode IN ITEMS bounds pop split read read_dir write convert nul bytes)
    if(mode STREQUAL "read")
        set(argument "${work}/missing.txt")
    elseif(mode STREQUAL "write" OR mode STREQUAL "read_dir")
        set(argument "${work}")
    elseif(mode STREQUAL "bytes")
        string(ASCII 255 invalid_utf8)
        file(WRITE "${work}/invalid.dat" "${invalid_utf8}")
        set(argument "${work}/invalid.dat")
    else()
        set(argument "unused")
    endif()
    execute_process(COMMAND "${errors}" "${mode}" "${argument}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15 ENCODING UTF-8)
    if(NOT status EQUAL 70)
        message(FATAL_ERROR "Expected runtime exit 70 for ${mode}: ${status}\n${output}\n${error}")
    endif()
    string(JSON code GET "${error}" code)
    string(JSON line GET "${error}" line)
    if(mode STREQUAL "bounds")
        set(expected R4006)
    elseif(mode STREQUAL "pop")
        set(expected R4007)
    elseif(mode STREQUAL "split")
        set(expected R4009)
    elseif(mode STREQUAL "convert")
        set(expected R4003)
    elseif(mode STREQUAL "nul" OR mode STREQUAL "bytes")
        set(expected R4004)
    else()
        set(expected R4008)
    endif()
    if(NOT code STREQUAL expected OR line LESS 1)
        message(FATAL_ERROR "Wrong runtime diagnostic for ${mode}: ${error}")
    endif()
    if(mode STREQUAL "nul" AND NOT error MATCHES "u0000")
        message(FATAL_ERROR "Runtime diagnostic lost embedded NUL")
    endif()
endforeach()
