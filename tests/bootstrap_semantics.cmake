cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/native á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(build_native source label output_variable)
    set(executable "${TEST_DIR}/${label}${CMAKE_EXECUTABLE_SUFFIX}")
    if(WIN32)
        set(executable "${executable}.exe")
    endif()
    execute_process(COMMAND "${WOOD}" emit-cpp "${source}" -o "${TEST_DIR}/${label}.cpp"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 240)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Semantic emission failed: ${status}\n${output}\n${error}")
    endif()
    if(HOST_MSVC)
        set(flags)
        if(SANITIZE_GENERATED)
            list(APPEND flags /fsanitize=address /Zi)
        endif()
        execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /O2 /EHsc /utf-8 /permissive- /bigobj
            ${flags} "/Fo:${TEST_DIR}/${label}.obj" "/Fd:${TEST_DIR}/${label}.pdb"
            "/Fe:${executable}" "${TEST_DIR}/${label}.cpp" /link /INCREMENTAL:NO /STACK:8388608
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 480)
    else()
        set(flags -O2)
        if(SANITIZE_GENERATED)
            set(flags -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer)
        endif()
        execute_process(COMMAND "${HOST_CXX}" -std=c++23 ${flags} "${TEST_DIR}/${label}.cpp" -pthread -ldl -o "${executable}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 600)
    endif()
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Semantic native build failed: ${status}\n${output}\n${error}")
    endif()
    set(${output_variable} "${executable}" PARENT_SCOPE)
endfunction()
build_native("${SOURCE_DIR}/bootstrap/src/semantic_query_main.wd" "wood-bootstrap-semantics" executable)
build_native("${SOURCE_DIR}/bootstrap/tests/test_semantics.wd" "semantic-units" units)
execute_process(COMMAND "${units}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "bootstrap semantic kernel unit checks passed\n" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Semantic native units failed: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${ORACLE}" --generate "${TEST_DIR}/queries.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE count ERROR_VARIABLE error TIMEOUT 90)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Semantic corpus generation failed: ${error}")
endif()
execute_process(COMMAND "${ORACLE}" "${TEST_DIR}/queries.json"
    RESULT_VARIABLE expected_status OUTPUT_FILE "${TEST_DIR}/expected.jsonl" ERROR_VARIABLE expected_error TIMEOUT 240)
execute_process(COMMAND "${executable}" "${TEST_DIR}/queries.json"
    RESULT_VARIABLE actual_status OUTPUT_FILE "${TEST_DIR}/actual.jsonl" ERROR_VARIABLE actual_error TIMEOUT 240)
if(NOT expected_status STREQUAL "0" OR NOT actual_status STREQUAL "0" OR NOT expected_error STREQUAL "" OR NOT actual_error STREQUAL "")
    message(FATAL_ERROR "Semantic differential execution failed: ${actual_status}/${expected_status}\n${actual_error}${expected_error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${TEST_DIR}/expected.jsonl" "${TEST_DIR}/actual.jsonl" RESULT_VARIABLE different)
if(different)
    message(FATAL_ERROR "Semantic differential mismatch; retained query/expected/actual files in ${TEST_DIR}")
endif()
# Inspect real source graphs with the new stage. Production checking remains a
# separate requirement: this prepass deliberately does not check body types.
# Make a source-only application copy: existing example locks may be stale and
# belong to the user. Never refresh those locks or copy a whole directory tree.
foreach(relative IN ITEMS catalog/wood.json catalog/src/main.wd catalog/src/report.wd catalog/tests/test_report.wd
        packages/catalog_schema/wood.json packages/catalog_schema/src/models.wd)
    get_filename_component(parent "${TEST_DIR}/application/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    configure_file("${SOURCE_DIR}/examples/${relative}" "${TEST_DIR}/application/${relative}" COPYONLY)
endforeach()
set(project "${TEST_DIR}/application/catalog")
execute_process(COMMAND "${WOOD}" lock "${project}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Isolated catalog lock failed: ${output}${error}")
endif()
set(inputs "${SOURCE_DIR}/bootstrap/src/semantic_query_main.wd" "${SOURCE_DIR}/bootstrap/tests/test_semantics.wd"
    "${project}/src/main.wd" "${SOURCE_DIR}/examples/mesh_import.wd")
execute_process(COMMAND "${executable}" --inspect "${STDLIB_BUNDLE}" ${inputs}
    RESULT_VARIABLE status OUTPUT_FILE "${TEST_DIR}/applications.jsonl" ERROR_VARIABLE error TIMEOUT 120)
if(NOT status STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Semantic real source inspection failed: ${status}\n${error}")
endif()
foreach(input IN LISTS inputs)
    execute_process(COMMAND "${WOOD}" check "${input}" --diagnostics=json
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Production compatibility check failed: ${input}\n${output}${error}")
    endif()
endforeach()
set(application "${TEST_DIR}/catalog")
if(WIN32)
    set(application "${application}.exe")
endif()
set(sanitizer)
if(SANITIZE_GENERATED)
    set(sanitizer --sanitize=address)
endif()
execute_process(COMMAND "${WOOD}" build "${project}" --locked --cxx "${HOST_CXX}" ${sanitizer} -o "${application}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native catalog build failed: ${output}${error}")
endif()
file(WRITE "${TEST_DIR}/inventory.json" "[{\"sku\":\"apple\",\"unit_price\":1.5,\"quantity\":4},{\"sku\":\"pear\",\"unit_price\":2,\"quantity\":3}]")
execute_process(COMMAND "${application}" "${TEST_DIR}/inventory.json" "${TEST_DIR}/report.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Native catalog execution failed: ${status}\n${output}${error}")
endif()
file(READ "${TEST_DIR}/report.json" report)
string(JSON items GET "${report}" items)
string(JSON units GET "${report}" units)
string(JSON value GET "${report}" inventory_value)
if(NOT items EQUAL 2 OR NOT units EQUAL 7 OR NOT value EQUAL 12)
    message(FATAL_ERROR "Native catalog produced incorrect report: ${report}")
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT status STREQUAL "2" OR NOT error STREQUAL "" OR NOT output MATCHES "usage:")
    message(FATAL_ERROR "Semantic CLI usage contract failed")
endif()
string(STRIP "${count}" count)
file(WRITE "${TEST_DIR}/validation.txt" "${count} exact semantic differential queries; native units; four source graphs; production checks; native catalog; CLI usage passed\n")
message(STATUS "${count} exact semantic differential queries; native units; four source graphs; production checks; native catalog; CLI usage passed")
