# Runs every example in docs/reference/explanations.md, so an explanation cannot drift from behavior.
# A failing example must report its own code, and its correction must run and exit 0.
# usage: cmake -DWOOD=wood -DROOT=checkout -DTEST_DIR=new-directory -P tests/explanations.cmake
cmake_minimum_required(VERSION 3.25)
foreach(required WOOD ROOT TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_DIR}")
file(READ "${ROOT}/docs/reference/explanations.md" text)
set(ENV{WOOD_DIAGNOSTICS} "")
set(checked 0)
set(sections 0)
set(failures "")
string(FIND "${text}" "\n## " at)
math(EXPR at "${at} + 4")
string(SUBSTRING "${text}" ${at} -1 text)
function(fence_after section label result)
    string(FIND "${section}" "${label}\n```wood\n" start)
    if(start EQUAL -1)
        set(${result} "" PARENT_SCOPE)
        return()
    endif()
    string(LENGTH "${label}\n```wood\n" skip)
    math(EXPR start "${start} + ${skip}")
    string(SUBSTRING "${section}" ${start} -1 rest)
    string(FIND "${rest}" "```" stop)
    string(SUBSTRING "${rest}" 0 ${stop} code)
    set(${result} "${code}" PARENT_SCOPE)
endfunction()
while(TRUE)
    string(FIND "${text}" "\n## " next)
    if(next EQUAL -1)
        set(section "${text}")
    else()
        string(SUBSTRING "${text}" 0 ${next} section)
    endif()
    string(SUBSTRING "${section}" 0 5 code)
    math(EXPR sections "${sections} + 1")
    foreach(part IN ITEMS "Meaning:\n" "How to fix:\n")
        string(FIND "${section}" "${part}" found)
        if(found EQUAL -1)
            string(APPEND failures "${code} lacks ${part}")
        endif()
    endforeach()
    execute_process(COMMAND "${WOOD}" explain "${code}" RESULT_VARIABLE status OUTPUT_VARIABLE shown ERROR_VARIABLE err)
    if(NOT status EQUAL 0 OR NOT shown MATCHES "^${code} - ")
        string(APPEND failures "wood explain ${code} failed: ${shown}${err}\n")
    endif()
    fence_after("${section}" "Example that fails:" before)
    fence_after("${section}" "One correction:" after)
    if(NOT before STREQUAL "")
        file(WRITE "${TEST_DIR}/${code}-before.wd" "${before}")
        execute_process(COMMAND "${WOOD}" run "${TEST_DIR}/${code}-before.wd" WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 60
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(status EQUAL 0 OR NOT err MATCHES "error\\[${code}\\]")
            string(APPEND failures "${code} example gave status ${status}: ${err}\n")
        endif()
        math(EXPR checked "${checked} + 1")
    endif()
    if(NOT after STREQUAL "")
        file(WRITE "${TEST_DIR}/${code}-after.wd" "${after}")
        execute_process(COMMAND "${WOOD}" run "${TEST_DIR}/${code}-after.wd" WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 60
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT status EQUAL 0)
            string(APPEND failures "${code} correction gave status ${status}: ${err}\n")
        endif()
        math(EXPR checked "${checked} + 1")
    endif()
    if(next EQUAL -1)
        break()
    endif()
    math(EXPR next "${next} + 4")
    string(SUBSTRING "${text}" ${next} -1 text)
endwhile()
# A readable error by default, and JSON when a tool asks for it at build time.
file(WRITE "${TEST_DIR}/index.wd" "items = [1]\nprint(items[3])\n")
execute_process(COMMAND "${WOOD}" run "${TEST_DIR}/index.wd" WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 60
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 70 OR NOT err MATCHES "index.wd:2:[0-9]+: runtime error\\[R4006\\]: index out of bounds\n  help: wood explain R4006\n$")
    string(APPEND failures "Readable runtime error: ${status}: ${err}\n")
endif()
execute_process(COMMAND "${WOOD}" run "${TEST_DIR}/index.wd" --diagnostics=json WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 60
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(JSON code ERROR_VARIABLE problem GET "${err}" code)
if(NOT status EQUAL 70 OR NOT code STREQUAL "R4006")
    string(APPEND failures "JSON runtime error: ${status}: ${err}\n")
endif()
if(NOT failures STREQUAL "")
    message(FATAL_ERROR "Explanations failed:\n${failures}")
endif()
message(STATUS "Explanations passed: ${sections} codes, ${checked} programs")
