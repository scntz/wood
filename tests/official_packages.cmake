cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}/original/vendor" "${work}/original/app/src")
file(COPY "${SOURCE_DIR}/packages/wood_cli" DESTINATION "${work}/original/vendor")
file(WRITE "${work}/original/app/wood.json" "{\"format\":1,\"name\":\"consumer\",\"version\":\"0.1.0\",\"source\":\"src\",\"entry\":\"main.wd\",\"dependencies\":{\"cli\":{\"path\":\"../vendor/wood_cli\",\"version\":\"0.1.0\"}}}\n")
file(READ "${SOURCE_DIR}/packages/wood_cli/tests/test_args.wd" fixture)
string(REPLACE "import args as cli" "import cli.args as cli" fixture "${fixture}")
file(WRITE "${work}/original/app/src/main.wd" "${fixture}")
set(checks 0)
function(run label expected)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: ${status} expected ${expected}: ${out}${err}")
    endif()
    math(EXPR next "${checks}+1")
    set(checks ${next} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
run(cli-check 0 check "${SOURCE_DIR}/packages/wood_cli")
run(cli-tests 0 test "${SOURCE_DIR}/packages/wood_cli" --report=json)
string(JSON failed GET "${out}" failed)
if(NOT failed EQUAL 0)
    message(FATAL_ERROR "Official CLI package tests failed: ${out}")
endif()
run(store-tests 0 test "${SOURCE_DIR}/examples/packages/notes_store" --report=json)
run(lock 0 lock "${work}/original/app")
file(COPY "${work}/original/" DESTINATION "${work}/relocated")
run(locked-check 0 check "${work}/relocated/app" --locked)
run(locked-deps 0 deps "${work}/relocated/app" --locked)
run(locked-inspect 0 inspect "${work}/relocated/app" --locked)
foreach(level IN ITEMS 0 2)
    set(app "${work}/consumer-O${level}")
    if(WIN32)
        string(APPEND app .exe)
    endif()
    run(build-O${level} 0 build "${work}/relocated/app" --locked -O${level} -o "${app}")
    execute_process(COMMAND "${app}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "official CLI argument contracts passed\n" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Relocated package execution failed: ${status}: ${out}${err}")
    endif()
    math(EXPR checks "${checks}+1")
endforeach()
file(APPEND "${work}/relocated/vendor/wood_cli/src/args.wd" "\n# Tampered dependency\n")
run(tampered-lock 2 check "${work}/relocated/app" --locked --diagnostics=json)
if(NOT err MATCHES "D5001" OR NOT err MATCHES "wood.lock differs")
    message(FATAL_ERROR "Tampered package did not preserve the established D5001 lock diagnostic: ${err}")
endif()
file(WRITE "${work}/validation.txt" "${checks} commands passed; real CLI/model tests, exact local source locks, relocated consumer at O0/O2, tamper rejection.\n")
message(STATUS "Official package workflows: ${checks} commands passed")
