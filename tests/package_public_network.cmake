cmake_minimum_required(VERSION 3.25)
# Real public-network check against any small public library. It needs internet access, so
# it is not part of the normal test suite. Git runs with an empty configuration, so no credential
# or URL rewrite can help it succeed. REPOSITORY must hold a library named PACKAGE, whose highest
# version tag is TAG at COMMIT on its default branch main, with a module greeting whose
# greet("x") returns "hello, x". TAG must be vVERSION.
foreach(required IN ITEMS WOOD WORK REPOSITORY PACKAGE TAG COMMIT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
get_filename_component(WORK "${WORK}" ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${WORK}/run-${run_id}")
file(MAKE_DIRECTORY "${WORK}/home")
file(WRITE "${WORK}/home/gitconfig" "[user]\n\tname = fixture\n\temail = fixture@example.invalid\n[init]\n\tdefaultBranch = main\n")
set(ENV{HOME} "${WORK}/home")
set(ENV{USERPROFILE} "${WORK}/home")
set(ENV{GIT_CONFIG_NOSYSTEM} "1")
set(ENV{GIT_CONFIG_GLOBAL} "${WORK}/home/gitconfig")
set(ENV{GIT_CEILING_DIRECTORIES} "${WORK}")
set(ENV{WOOD_CACHE_DIR} "${WORK}/cache")
unset(ENV{WOOD_PACKAGE_INDEX})
set(count 0)
function(run directory expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    file(APPEND "${WORK}/commands.log" "== ${ARGN}\nstatus=${status}\n${out}${err}\n")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}\n${out}${err}")
    endif()
    message(STATUS "PASS: ${ARGN}")
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()
string(SUBSTRING "${TAG}" 1 -1 version)
set(usage "import ${PACKAGE}.greeting as greeting\nprint(greeting.greet(\"wood\"))\n")

# Install by tag, run it locked, and check what the lock recorded.
run("${WORK}" 0 "${WOOD}" init app)
set(app "${WORK}/app")
run("${app}" 0 "${WOOD}" install dependency "github@${REPOSITORY}#${TAG}")
if(NOT out MATCHES "Added ${PACKAGE} ${version}" OR NOT out MATCHES "${COMMIT}")
    message(FATAL_ERROR "install summary: ${out}")
endif()
file(READ "${app}/wood.lock" lock)
if(NOT lock MATCHES "\"commit\":\"${COMMIT}\"" OR NOT lock MATCHES "\"source\":\"github@${REPOSITORY}\"")
    message(FATAL_ERROR "wood.lock must pin the real commit: ${lock}")
endif()
file(WRITE "${app}/src/main.wd" "${usage}")
file(WRITE "${app}/.gitignore" "build/\nvendor/\n")
run("${app}" 0 "${WOOD}" run --locked)
if(NOT out MATCHES "hello, wood")
    message(FATAL_ERROR "application output: ${out}")
endif()

# Another machine: a clone with an empty cache restores from the lock over the network.
run("${app}" 0 "${git}" init -q -b main)
run("${app}" 0 "${git}" add -A)
run("${app}" 0 "${git}" commit -qm app)
set(ENV{WOOD_CACHE_DIR} "${WORK}/second cache")
run("${WORK}" 0 "${git}" clone -q "${app}" "second machine")
set(clone "${WORK}/second machine")
run("${clone}" 0 "${WOOD}" install)
if(NOT out MATCHES "Restored 1 and verified 1")
    message(FATAL_ERROR "restore summary: ${out}")
endif()
run("${clone}" 0 "${WOOD}" build --locked -o "${WORK}/standalone${CMAKE_EXECUTABLE_SUFFIX}")
run("${WORK}" 0 "${WORK}/standalone${CMAKE_EXECUTABLE_SUFFIX}")
if(NOT out MATCHES "hello, wood")
    message(FATAL_ERROR "standalone output: ${out}")
endif()

# Offline from the validated cache, with no network use allowed.
file(REMOVE_RECURSE "${clone}/vendor")
run("${clone}" 0 "${WOOD}" install --offline)
run("${clone}" 0 "${WOOD}" check --locked)

# Tampering with the real package is caught.
file(APPEND "${clone}/vendor/${REPOSITORY}/src/greeting.wd" "\n# tampered\n")
execute_process(COMMAND "${WOOD}" install WORKING_DIRECTORY "${clone}" RESULT_VARIABLE status ERROR_VARIABLE err OUTPUT_QUIET)
if(status EQUAL 0 OR NOT err MATCHES "changed or removed")
    message(FATAL_ERROR "tampering was not detected: ${status} ${err}")
endif()
message(STATUS "PASS: tampered package rejected")

# Other reference forms against the real host.
set(ENV{WOOD_CACHE_DIR} "${WORK}/third cache")
run("${WORK}" 0 "${WOOD}" init latest)
run("${WORK}/latest" 0 "${WOOD}" add github@${REPOSITORY})
file(READ "${WORK}/latest/wood.lock" latest_lock)
if(NOT latest_lock MATCHES "${COMMIT}")
    message(FATAL_ERROR "the highest version tag must resolve to the release commit")
endif()
run("${WORK}" 0 "${WOOD}" init pinned)
run("${WORK}/pinned" 0 "${WOOD}" add "github@${REPOSITORY}#${COMMIT}")
run("${WORK}" 0 "${WOOD}" init branch)
run("${WORK}/branch" 0 "${WOOD}" add "github@${REPOSITORY}#main")
execute_process(COMMAND "${WOOD}" add "github@${REPOSITORY}#v9.9.9" WORKING_DIRECTORY "${WORK}/branch" RESULT_VARIABLE status ERROR_VARIABLE err OUTPUT_QUIET)
if(status EQUAL 0 OR NOT err MATCHES "does not exist")
    message(FATAL_ERROR "a deleted reference must be reported: ${status} ${err}")
endif()
message(STATUS "PASS: missing reference reported")

# Catalog path with a real source: a local index that points at the real repository.
file(WRITE "${WORK}/index.json" "{\"schema_version\":1,\"packages\":[{\"owner\":\"example\",\"name\":\"hello\",\"package\":\"${PACKAGE}\",\"tier\":\"community\",\"description\":\"Demo.\",\"versions\":[{\"version\":\"${version}\",\"published\":\"2026-11-01\",\"source\":{\"type\":\"github\",\"repo\":\"${REPOSITORY}\",\"commit\":\"${COMMIT}\"}}]}]}\n")
set(ENV{WOOD_PACKAGE_INDEX} "${WORK}/index.json")
run("${WORK}" 0 "${WOOD}" init named)
run("${WORK}/named" 0 "${WOOD}" add example@hello)
file(WRITE "${WORK}/named/src/main.wd" "import hello.greeting as greeting\nprint(greeting.greet(\"catalog\"))\n")
run("${WORK}/named" 0 "${WOOD}" run --locked)
if(NOT out MATCHES "hello, catalog")
    message(FATAL_ERROR "catalog application output: ${out}")
endif()
message(STATUS "Public network workflow passed: ${count} commands")
