# Shared native application oracle; caller supplies executable and TEST_DIR.
function(run_report expected minimum maximum)
    execute_process(COMMAND "${executable}" "${TEST_DIR}/input.jsonl" "${TEST_DIR}/output.json" "${minimum}" "${maximum}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Log report expected ${expected}, got ${status}: ${output}\n${error}")
    endif()
endfunction()
# Independent scalar oracle for streaming map/filter/take and group aggregation.
foreach(seed RANGE 0 9)
    set(input "")
    set(expected_count 0)
    foreach(group RANGE 0 2)
        set(count_${group} 0)
        set(failures_${group} 0)
        set(elapsed_${group} 0)
    endforeach()
    foreach(index RANGE 0 99)
        math(EXPR group "(${index} * 7 + ${seed}) % 3")
        math(EXPR status "200 + ((${index} + ${seed}) % 2) * 300")
        math(EXPR elapsed "(${index} * 17 + ${seed} * 11) % 100")
        string(APPEND input "{\"service\":\"s${group}\",\"status\":${status},\"elapsed_ms\":${elapsed}}\n")
        if(elapsed GREATER_EQUAL 40 AND expected_count LESS 17)
            math(EXPR expected_count "${expected_count} + 1")
            math(EXPR count_${group} "${count_${group}} + 1")
            math(EXPR elapsed_${group} "${elapsed_${group}} + ${elapsed}")
            if(status GREATER_EQUAL 500)
                math(EXPR failures_${group} "${failures_${group}} + 1")
            endif()
        endif()
    endforeach()
    file(WRITE "${TEST_DIR}/input.jsonl" "${input}")
    run_report(0 40 17)
    file(READ "${TEST_DIR}/output.json" result)
    string(JSON service_count LENGTH "${result}" services)
    if(NOT service_count EQUAL 3)
        message(FATAL_ERROR "Wrong service count: ${result}")
    endif()
    set(seen_services "")
    string(JSON actual GET "${result}" matches)
    if(NOT actual EQUAL expected_count)
        message(FATAL_ERROR "Wrong match count: ${result}")
    endif()
    foreach(index RANGE 0 2)
        string(JSON name GET "${result}" services ${index} service)
        string(SUBSTRING "${name}" 1 1 group)
        list(FIND seen_services "${group}" existing_service)
        if(NOT name MATCHES "^s[012]$" OR existing_service GREATER_EQUAL 0)
            message(FATAL_ERROR "Duplicate or unknown service: ${result}")
        endif()
        list(APPEND seen_services "${group}")
        foreach(field IN ITEMS requests failures elapsed_ms)
            string(JSON actual GET "${result}" services ${index} totals ${field})
            if(field STREQUAL "requests")
                set(expected "${count_${group}}")
            elseif(field STREQUAL "failures")
                set(expected "${failures_${group}}")
            else()
                set(expected "${elapsed_${group}}")
            endif()
            if(NOT actual EQUAL expected)
                message(FATAL_ERROR "Aggregation mismatch ${field}: ${result}")
            endif()
        endforeach()
    endforeach()
endforeach()
# Lazy termination must not parse an invalid trailing line.
file(WRITE "${TEST_DIR}/input.jsonl" "{\"service\":\"ok\",\"status\":200,\"elapsed_ms\":4}\nINVALID\n")
run_report(0 0 1)
run_report(0 0 0)
file(READ "${TEST_DIR}/output.json" result)
string(JSON count GET "${result}" matches)
string(JSON services LENGTH "${result}" services)
if(NOT count EQUAL 0 OR NOT services EQUAL 0)
    message(FATAL_ERROR "Zero take must produce an empty report: ${result}")
endif()
# Invalid input leaves existing output intact, including budget failures.
foreach(input IN ITEMS "INVALID\n" "{\"service\":\"s\",\"status\":600,\"elapsed_ms\":1}\n" "{\"service\":\"s\"}\n")
    file(WRITE "${TEST_DIR}/input.jsonl" "${input}")
    file(WRITE "${TEST_DIR}/output.json" "preserve")
    run_report(70 0 10)
    file(READ "${TEST_DIR}/output.json" result)
    if(NOT result STREQUAL "preserve")
        message(FATAL_ERROR "Invalid input replaced output")
    endif()
endforeach()
string(REPEAT "x" 65537 oversized)
file(WRITE "${TEST_DIR}/input.jsonl" "${oversized}\n")
run_report(70 0 1)
file(READ "${TEST_DIR}/output.json" result)
if(NOT result STREQUAL "preserve")
    message(FATAL_ERROR "Oversized line replaced output")
endif()
foreach(bounds IN ITEMS "-1;1" "0;-1")
    list(GET bounds 0 minimum)
    list(GET bounds 1 maximum)
    run_report(70 "${minimum}" "${maximum}")
    file(READ "${TEST_DIR}/output.json" result)
    if(NOT result STREQUAL "preserve")
        message(FATAL_ERROR "Invalid bounds replaced output")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/input.jsonl" "")
run_report(0 0 1)
file(READ "${TEST_DIR}/output.json" result)
string(JSON count GET "${result}" matches)
string(JSON services LENGTH "${result}" services)
if(NOT count EQUAL 0 OR NOT services EQUAL 0)
    message(FATAL_ERROR "Empty input must produce an empty report: ${result}")
endif()
