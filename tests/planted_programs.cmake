# A project cannot supply its own program in place of a tool wood starts, and on Windows a batch file's
# arguments cannot carry commands. Windows searches the current directory for a bare program name, unless
# NoDefaultCurrentDirectoryInExePath is set, so that is removed here, as on a normal machine.
# usage: cmake -DWOOD=wood -DROOT=checkout -DTEST_DIR=new-directory -P tests/planted_programs.cmake
cmake_minimum_required(VERSION 3.25)
foreach(required WOOD ROOT TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
get_filename_component(TEST_DIR "${TEST_DIR}" ABSOLUTE)
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
file(MAKE_DIRECTORY "${TEST_DIR}")
unset(ENV{NoDefaultCurrentDirectoryInExePath})
set(ENV{WOOD_CACHE_DIR} "${TEST_DIR}/cache")
set(suffix "")
if(CMAKE_HOST_WIN32)
    set(suffix ".exe")
endif()
set(project "${TEST_DIR}/project")
set(marker "${project}/PLANTED-RAN.txt")

function(wood directory)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${directory}" INPUT_FILE "${TEST_DIR}/empty"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    set(status "${status}" PARENT_SCOPE)
    set(output "${out}${err}" PARENT_SCOPE)
endfunction()
file(WRITE "${TEST_DIR}/empty" "")

# The planted program leaves a marker where it is started, which is the project.
file(WRITE "${TEST_DIR}/marker.wd" "write_text(\"PLANTED-RAN.txt\", \"ran\")\n")
wood("${TEST_DIR}" build marker.wd -O0 -o "planted${suffix}")
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot build the planted program: ${output}")
endif()
wood("${TEST_DIR}" init project)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot create the project: ${output}")
endif()
foreach(name IN ITEMS git opt llc lld-link link ld clang python py wood-compiler)
    file(COPY_FILE "${TEST_DIR}/planted${suffix}" "${project}/${name}${suffix}")
endforeach()

# Git is still found on PATH, and the planted one is not used.
wood("${project}" add wood@log --offline)
if(EXISTS "${marker}")
    message(FATAL_ERROR "wood add ran a program from the project: ${output}")
endif()
if(output MATCHES "require the git executable")
    message(FATAL_ERROR "wood add no longer finds Git on PATH: ${output}")
endif()

wood("${project}" build src/main.wd -O0 -o "out${suffix}")
if(NOT status EQUAL 0)
    message(FATAL_ERROR "wood build failed: ${output}")
endif()
if(EXISTS "${marker}")
    message(FATAL_ERROR "wood build ran a program from the project: ${output}")
endif()

if(CMAKE_HOST_WIN32)
    set(batch "${TEST_DIR}/batch")
    wood("${TEST_DIR}" init batch)
    file(RELATIVE_PATH package "${batch}" "${ROOT}/packages/wood_process")
    file(WRITE "${batch}/wood.json" "{\"format\":1,\"name\":\"batch\",\"version\":\"0.1.0\",\"source\":\"src\",\"entry\":\"main.wd\",\"dependencies\":{\"process\":{\"path\":\"${package}\",\"version\":\"0.1.0\"}}}\n")
    file(WRITE "${batch}/t.bat" "@echo off\r\necho %*\r\n")
    file(WRITE "${batch}/src/main.wd" "import process.process as p\nfor name in [\"t.bat\", \"T.CMD\", \"t.bat.\", \"t.bat \", \"./t.bat\"]:\n    try:\n        p.run([name, \"a&echo.INJECTED\"], 10000, 65536)\n        print(\"STARTED\", name)\n    except err:\n        print(\"REFUSED\", err.message)\nresult = p.run([\"git\", \"--version\"], 10000, 65536)\nprint(\"GIT\", result.status)\n")
    file(WRITE "${batch}/T.CMD" "@echo off\r\necho %*\r\n")
    wood("${batch}" lock .)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot lock the batch project: ${output}")
    endif()
    wood("${batch}" run .)
    if(output MATCHES "INJECTED|STARTED")
        message(FATAL_ERROR "A batch file was started: ${output}")
    endif()
    string(REGEX MATCHALL "REFUSED" refused "${output}")
    list(LENGTH refused refused)
    if(NOT refused EQUAL 5 OR NOT output MATCHES "GIT 0")
        message(FATAL_ERROR "Expected five refusals, then Git to start: ${output}")
    endif()
endif()
message(STATUS "Planted programs passed")
