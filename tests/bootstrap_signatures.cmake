cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/frontend-profiles.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/native á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(build_native source label output_variable)
if(WIN32)
    set(executable "${TEST_DIR}/${label}.exe")
else()
    set(executable "${TEST_DIR}/${label}")
endif()
# This frontend nests bounded module DFS and parser calls. Use the same explicit
# MSVC stack budget as wood_compiler; Linux keeps its normal host stack.
execute_process(COMMAND "${WOOD}" emit-cpp "${source}"
    -o "${TEST_DIR}/${label}.cpp" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 240)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Signature frontend emission failed: ${status}\n${error}")
endif()
set(flags)
if(HOST_MSVC)
    if(SANITIZE_GENERATED)
        list(APPEND flags /fsanitize=address /Zi)
    endif()
    execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /O2 /EHsc /utf-8 /permissive- /bigobj
        ${flags} "/Fo:${TEST_DIR}/${label}.obj" "/Fd:${TEST_DIR}/${label}.pdb"
        "/Fe:${executable}" "${TEST_DIR}/${label}.cpp" /link /INCREMENTAL:NO /STACK:8388608
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 360)
else()
    if(SANITIZE_GENERATED)
        list(APPEND flags -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer)
    else()
        list(APPEND flags -O2)
    endif()
    execute_process(COMMAND "${HOST_CXX}" -std=c++23 ${flags} "${TEST_DIR}/${label}.cpp" -pthread -ldl -o "${executable}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 420)
endif()
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Signature frontend native build failed: ${status}\n${output}\n${error}")
endif()
    set(${output_variable} "${executable}" PARENT_SCOPE)
endfunction()
build_native("${SOURCE_DIR}/bootstrap/src/signature_main.wd" "wood-bootstrap-signatures" executable)
build_native("${SOURCE_DIR}/bootstrap/tests/test_signatures.wd" "signature-units" unit_executable)
execute_process(COMMAND "${unit_executable}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "bootstrap signature unit checks passed\n" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Signature native units failed: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${unit_executable}" "${SOURCE_DIR}/tests/bootstrap_signature_projections.json"
    RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 90)
execute_process(COMMAND "${ORACLE}" --projections "${SOURCE_DIR}/tests/bootstrap_signature_projections.json"
    RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 90)
if(NOT actual_status STREQUAL "0" OR NOT expected_status STREQUAL "0" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
    file(WRITE "${TEST_DIR}/projection-actual.json" "${actual}")
    file(WRITE "${TEST_DIR}/projection-expected.json" "${expected}")
    message(FATAL_ERROR "Signature associated-type differential failed: ${actual_status}/${expected_status}\n${actual_error}${expected_error}\nSee ${TEST_DIR}/projection-actual.json")
endif()
if(HOST_MSVC AND SANITIZE_GENERATED)
    # Regression for MSVC C1128: exercise the normal Wood native command too,
    # not only this test's direct emitted-code compiler invocation.
    set(driver_unit "${TEST_DIR}/driver-signature-units.exe")
    execute_process(COMMAND "${WOOD}" build "${SOURCE_DIR}/bootstrap/tests/test_signatures.wd"
        --sanitize=address -o "${driver_unit}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 420)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Normal driver large-object regression failed: ${status}\n${output}\n${error}")
    endif()
    execute_process(COMMAND "${driver_unit}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "bootstrap signature unit checks passed\n" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Normal driver sanitized unit execution failed: ${status}\n${output}\n${error}")
    endif()
endif()
execute_process(COMMAND "${MODULE_ORACLE}" --verify-stdlib "${STDLIB_BUNDLE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Configured source bundle does not match the compiler: ${error}")
endif()
configure_file("${STDLIB_BUNDLE}" "${TEST_DIR}/stdlib.json" COPYONLY)
execute_process(COMMAND "${ORACLE}" --generate "${TEST_DIR}/fixtures"
    RESULT_VARIABLE status OUTPUT_VARIABLE count ERROR_VARIABLE error TIMEOUT 90)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Signature fixture generation failed: ${status}\n${error}")
endif()
file(READ "${TEST_DIR}/fixtures/entries.json" entries)
string(JSON count LENGTH "${entries}")
math(EXPR last "${count}-1")
set(inputs)
foreach(index RANGE 0 ${last})
    string(JSON entry GET "${entries}" ${index})
    list(APPEND inputs "${entry}")
endforeach()
# Include bounded source-only sets; never walk build artifacts or junctions.
file(GLOB sources "${SOURCE_DIR}/bootstrap/src/*.wd" "${SOURCE_DIR}/bootstrap/tests/*.wd"
    "${SOURCE_DIR}/stdlib/*.wd" "${SOURCE_DIR}/examples/*.wd"
    "${SOURCE_DIR}/examples/project/src/*.wd" "${SOURCE_DIR}/examples/catalog/src/*.wd"
    "${SOURCE_DIR}/examples/archive/src/*.wd")
list(APPEND inputs ${sources})
# Reuse the established project/module corpus, including source-root link tests.
execute_process(COMMAND "${MODULE_ORACLE}" --generate "${TEST_DIR}/module-fixtures"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Module fixture generation failed (${status}): ${error}")
endif()
if(WIN32)
    find_program(powershell NAMES pwsh powershell REQUIRED)
    execute_process(COMMAND "${powershell}" -NoProfile -File "${SOURCE_DIR}/tests/bootstrap_modules_links.ps1" -FixtureRoot "${TEST_DIR}/module-fixtures"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Junction fixture generation failed: ${error}")
    endif()
endif()
file(READ "${TEST_DIR}/module-fixtures/entries.json" module_entries)
string(JSON count LENGTH "${module_entries}")
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
    string(JSON entry GET "${module_entries}" ${index})
    list(APPEND inputs "${entry}")
endforeach()
set(count 0)
set(optional_count 0)
foreach(entry IN LISTS inputs)
    execute_process(COMMAND "${executable}" "${TEST_DIR}/stdlib.json" "${entry}"
        RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 120)
    execute_process(COMMAND "${ORACLE}" "${entry}"
        RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 120)
    wood_optional_frontend("${entry}" signatures "${actual_status}" "${actual}" "${expected_status}" "${expected}" "${actual_error}" "${expected_error}" optional)
    if(optional)
        math(EXPR optional_count "${optional_count}+1")
        continue()
    endif()
    if(NOT "${actual_status}" STREQUAL "${expected_status}" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
        file(WRITE "${TEST_DIR}/actual.json" "${actual}")
        file(WRITE "${TEST_DIR}/expected.json" "${expected}")
        message(FATAL_ERROR "Signature differential failed: ${entry}\nWood: ${actual_status}; C++: ${expected_status}\n${actual_error}${expected_error}\nSee ${TEST_DIR}/actual.json and expected.json")
    endif()
    math(EXPR count "${count}+1")
endforeach()
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT status STREQUAL "2" OR NOT output MATCHES "^usage: wood-bootstrap-signatures" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Signature CLI usage contract failed")
endif()
list(GET inputs 0 good)
list(GET inputs 9 bad)
execute_process(COMMAND "${executable}" "${TEST_DIR}/stdlib.json" "${good}" "${bad}"
    RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 30)
execute_process(COMMAND "${ORACLE}" "${good}" "${bad}"
    RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 30)
if(NOT actual_status STREQUAL "1" OR NOT expected_status STREQUAL "1" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
    message(FATAL_ERROR "Signature CLI batch contract failed")
endif()
file(WRITE "${TEST_DIR}/validation.txt" "${count} exact common-profile signature/default/declaration/diagnostic comparisons and 60 associated-type cases passed\n${optional_count} optional-profile acceptance/rejection pairs passed\n")
message(STATUS "Bootstrap signatures: native units and ${count} exact signature/default/declaration/diagnostic comparisons and 60 associated-type cases passed")
