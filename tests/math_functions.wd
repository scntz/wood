# Elementary functions in std.math, against reference values within a few units in the last place.
import std.math as math

fn check(actual: float, expected: float, label: str):
    difference = actual-expected if actual > expected else expected-actual
    size = expected if expected > 0.0 else -expected
    # Three units in the last place, relative to the expected value.
    allowed = size*0.00000000000000067
    if allowed < 5e-324:
        allowed = 5e-324
    if not (difference <= allowed):
        print(label, actual, expected)
        raise "inaccurate: "+label

fn exactly(actual: float, expected: float):
    assert(actual == expected)

check(math.exp(0.0), 1.0, "exp(0.0)")
check(math.exp(1.0), 2.718281828459045, "exp(1.0)")
check(math.exp(-1.0), 0.36787944117144233, "exp(-1.0)")
check(math.exp(0.5), 1.6487212707001282, "exp(0.5)")
check(math.exp(2.5), 12.182493960703473, "exp(2.5)")
check(math.exp(10.0), 22026.465794806718, "exp(10.0)")
check(math.exp(100.0), 2.6881171418161356e+43, "exp(100.0)")
check(math.exp(709.0), 8.218407461554972e+307, "exp(709.0)")
check(math.exp(-700.0), 9.85967654375977e-305, "exp(-700.0)")
check(math.exp(1e-10), 1.0000000001, "exp(1e-10)")
check(math.exp(0.6931471805599453), 2.0, "exp(0.6931471805599453)")
check(math.exp(3.3), 27.112638920657883, "exp(3.3)")
check(math.log(1.0), 0.0, "log(1.0)")
check(math.log(2.0), 0.6931471805599453, "log(2.0)")
check(math.log(0.5), -0.6931471805599453, "log(0.5)")
check(math.log(10.0), 2.302585092994046, "log(10.0)")
check(math.log(1e+300), 690.7755278982137, "log(1e+300)")
check(math.log(1e-300), -690.7755278982137, "log(1e-300)")
check(math.log(2.718281828459045), 1.0, "log(2.718281828459045)")
check(math.log(1.0000001), 9.999999505838704e-08, "log(1.0000001)")
check(math.log(0.9999999), -1.0000000494736474e-07, "log(0.9999999)")
check(math.log(5e-324), -744.4400719213812, "log(5e-324)")
check(math.log(12345.678), 9.421061321291832, "log(12345.678)")
check(math.log2(1.0), 0.0, "log2(1.0)")
check(math.log2(2.0), 1.0, "log2(2.0)")
check(math.log2(8.0), 3.0, "log2(8.0)")
check(math.log2(1024.0), 10.0, "log2(1024.0)")
check(math.log2(0.125), -3.0, "log2(0.125)")
check(math.log2(3.0), 1.584962500721156, "log2(3.0)")
check(math.log2(1e+100), 332.19280948873626, "log2(1e+100)")
check(math.log10(1.0), 0.0, "log10(1.0)")
check(math.log10(10.0), 1.0, "log10(10.0)")
check(math.log10(100.0), 2.0, "log10(100.0)")
check(math.log10(1000.0), 3.0, "log10(1000.0)")
check(math.log10(1e+22), 22.0, "log10(1e+22)")
check(math.log10(0.001), -3.0, "log10(0.001)")
check(math.log10(2.0), 0.3010299956639812, "log10(2.0)")
check(math.log10(12345.0), 4.091491094267951, "log10(12345.0)")
check(math.pow(2.0, 10.0), 1024.0, "pow(2.0, 10.0)")
check(math.pow(2.0, 0.5), 1.4142135623730951, "pow(2.0, 0.5)")
check(math.pow(10.0, -2.0), 0.01, "pow(10.0, -2.0)")
check(math.pow(1.5, 2.5), 2.7556759606310752, "pow(1.5, 2.5)")
check(math.pow(9.0, 0.5), 3.0, "pow(9.0, 0.5)")
check(math.pow(-2.0, 3.0), -8.0, "pow(-2.0, 3.0)")
check(math.pow(-2.0, 2.0), 4.0, "pow(-2.0, 2.0)")
check(math.pow(0.5, 1000.0), 9.332636185032189e-302, "pow(0.5, 1000.0)")
check(math.pow(10.0, 300.0), 1e+300, "pow(10.0, 300.0)")
check(math.pow(2.0, -1074.0), 5e-324, "pow(2.0, -1074.0)")
check(math.pow(7.0, 0.0), 1.0, "pow(7.0, 0.0)")
check(math.sqrt(2.0), 1.4142135623730951, "sqrt(2.0)")
check(math.sin(1.0), 0.8414709848078965, "sin(1.0)")
check(math.cos(1.0), 0.5403023058681398, "cos(1.0)")
assert(math.abs(-2.5) == 2.5)
assert(math.abs_float(-2.5) == 2.5)
check(math.atan(0.0), 0.0, "atan(0.0)")
check(math.atan(0.1), 0.09966865249116204, "atan(0.1)")
check(math.atan(0.4), 0.3805063771123649, "atan(0.4)")
check(math.atan(0.5), 0.4636476090008061, "atan(0.5)")
check(math.atan(0.7), 0.6107259643892086, "atan(0.7)")
check(math.atan(1.0), 0.7853981633974483, "atan(1.0)")
check(math.atan(1.5), 0.982793723247329, "atan(1.5)")
check(math.atan(2.0), 1.1071487177940904, "atan(2.0)")
check(math.atan(3.0), 1.2490457723982544, "atan(3.0)")
check(math.atan(100.0), 1.5607966601082315, "atan(100.0)")
check(math.atan(1e+20), 1.5707963267948966, "atan(1e+20)")
check(math.atan(-0.3), -0.2914567944778671, "atan(-0.3)")
check(math.atan(-1.0), -0.7853981633974483, "atan(-1.0)")
check(math.atan(-5.0), -1.373400766945016, "atan(-5.0)")
check(math.atan2(1.0, 1.0), 0.7853981633974483, "atan2(1.0, 1.0)")
check(math.atan2(1.0, -1.0), 2.356194490192345, "atan2(1.0, -1.0)")
check(math.atan2(-1.0, -1.0), -2.356194490192345, "atan2(-1.0, -1.0)")
check(math.atan2(-1.0, 1.0), -0.7853981633974483, "atan2(-1.0, 1.0)")
check(math.atan2(0.0, 1.0), 0.0, "atan2(0.0, 1.0)")
check(math.atan2(0.0, -1.0), 3.141592653589793, "atan2(0.0, -1.0)")
check(math.atan2(1.0, 0.0), 1.5707963267948966, "atan2(1.0, 0.0)")
check(math.atan2(-1.0, 0.0), -1.5707963267948966, "atan2(-1.0, 0.0)")
check(math.atan2(3.0, 4.0), 0.6435011087932844, "atan2(3.0, 4.0)")
check(math.asin(0.0), 0.0, "asin(0.0)")
check(math.acos(0.0), 1.5707963267948966, "acos(0.0)")
check(math.asin(0.5), 0.5235987755982989, "asin(0.5)")
check(math.acos(0.5), 1.0471975511965979, "acos(0.5)")
check(math.asin(-0.5), -0.5235987755982989, "asin(-0.5)")
check(math.acos(-0.5), 2.0943951023931957, "acos(-0.5)")
check(math.asin(1.0), 1.5707963267948966, "asin(1.0)")
check(math.acos(1.0), 0.0, "acos(1.0)")
check(math.asin(-1.0), -1.5707963267948966, "asin(-1.0)")
check(math.acos(-1.0), 3.141592653589793, "acos(-1.0)")
check(math.asin(0.1), 0.1001674211615598, "asin(0.1)")
check(math.acos(0.1), 1.4706289056333368, "acos(0.1)")
check(math.asin(0.99), 1.4292568534704695, "asin(0.99)")
check(math.acos(0.99), 0.1415394733244273, "acos(0.99)")
check(math.tan(0.0), 0.0, "tan(0.0)")
check(math.tan(0.5), 0.5463024898437905, "tan(0.5)")
check(math.tan(1.0), 1.5574077246549023, "tan(1.0)")
check(math.tan(-1.0), -1.5574077246549023, "tan(-1.0)")
check(math.tan(1.5), 14.101419947171719, "tan(1.5)")
check(math.tan(100.0), -0.5872139151569291, "tan(100.0)")
check(math.hypot(3.0, 4.0), 5.0, "hypot(3.0, 4.0)")
check(math.hypot(0.0, 0.0), 0.0, "hypot(0.0, 0.0)")
check(math.hypot(1e+300, 1e+300), 1.4142135623730952e+300, "hypot(1e+300, 1e+300)")
check(math.hypot(1e-300, 1e-300), 1.414213562373095e-300, "hypot(1e-300, 1e-300)")
check(math.hypot(-5.0, 12.0), 13.0, "hypot(-5.0, 12.0)")

# Rounding, including halves, negatives and values too large to be fractional.
exactly(math.floor(2.5), 2.0)
exactly(math.floor(-2.5), -3.0)
exactly(math.ceil(2.1), 3.0)
exactly(math.ceil(-2.1), -2.0)
exactly(math.trunc(-2.9), -2.0)
exactly(math.round(2.5), 3.0)
exactly(math.round(-2.5), -3.0)
exactly(math.round(2.4), 2.0)
exactly(math.floor(1e300), 1e300)
exactly(math.ceil(4503599627370497.0), 4503599627370497.0)

# Exact where it matters.
exactly(math.log2(1024.0), 10.0)
exactly(math.log10(1000.0), 3.0)
exactly(math.pow(2.0, 10.0), 1024.0)
exactly(math.pow(3.0, 0.0), 1.0)
exactly(math.exp(0.0), 1.0)
exactly(math.log(1.0), 0.0)
exactly(math.pi(), 3.141592653589793)
exactly(math.degrees(math.pi()), 180.0)
check(math.radians(180.0), 3.141592653589793, "radians")
check(math.e(), math.exp(1.0), "e")

# IEEE propagation at the edges, with no exception and no wrong finite value.
infinity = 1e308*10.0
assert(math.exp(1000.0) == infinity)
exactly(math.exp(-1000.0), 0.0)
assert(math.exp(infinity) == infinity)
exactly(math.exp(-infinity), 0.0)
assert(math.log(0.0) == -infinity)
assert(math.log(infinity) == infinity)
nan = infinity-infinity
for bad in [math.log(-1.0), math.asin(2.0), math.acos(-2.0), math.pow(-8.0, 0.5), math.log(nan), math.exp(nan), math.floor(nan), math.atan(nan), math.pow(nan, 2.0)]:
    assert(bad != bad)
assert(math.pow(0.0, -1.0) == infinity)
exactly(math.pow(0.0, 2.0), 0.0)
exactly(math.pow(1.0, nan), 1.0)
assert(math.pow(2.0, infinity) == infinity)
exactly(math.pow(0.5, infinity), 0.0)
assert(math.hypot(infinity, nan) == infinity)
exactly(math.atan(infinity), 1.5707963267948966)
exactly(math.atan2(infinity, infinity), 0.7853981633974483)
print("math functions ok")
