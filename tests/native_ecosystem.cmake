file(WRITE "${TEST_DIR}/test_fs.wd" [=[
import std.fs as fs
import std.path as path
root = path.normalize(args()[0])
assert(fs.make_dirs(path.combine(root, "nested/leaf")))
assert(not fs.make_dirs(path.combine(root, "nested/leaf")))
assert(fs.kind(root) == "directory")
assert(fs.kind(path.combine(root, "missing")) == "missing")
assert(fs.entries(path.combine(root, "nested/leaf"), 0) == [])
assert(path.name(path.combine(root, "a.txt")) == "a.txt")
assert(path.parent(path.combine(root, "a.txt")) == path.normalize(root))
file = path.combine(root, "a.txt")
write_text(file, "a\0b")
assert(fs.size(file) == 3)
assert(fs.kind(file) == "file")
assert(fs.entries(root, 2) == ["a.txt", "nested"])
assert(path.normalize(path.combine(root, "nested/../a.txt")) == file)
failed = 0
try:
    fs.entries(root, 1)
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.entries(root, -1)
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.remove(root)
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.size(root)
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.kind("bad\0path")
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.walk_files(root, 1)
except err:
    assert(err.code == "R4008")
    failed = failed + 1
try:
    fs.walk_files(file, 10)
except err:
    assert(err.code == "R4010")
    failed = failed + 1
assert(failed == 7)
assert(fs.walk_files(root, 4) == [file])
assert(fs.remove(file))
assert(not fs.remove(file))
assert(fs.remove(path.combine(root, "nested/leaf")))
assert(fs.remove(path.combine(root, "nested")))
assert(fs.remove(root))
]=])
