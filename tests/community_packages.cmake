cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}/author" "${work}/consumer/src" "${work}/consumer/tests" "${work}/consumer/vendor" "${work}/tmp")
set(ENV{TMP} "${work}/tmp")
set(ENV{TEMP} "${work}/tmp")
file(COPY "${SOURCE_DIR}/examples/library_author/" DESTINATION "${work}/author")
set(cli_commands 0)
set(exports 0)
set(git_commands 0)
function(command label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
    file(WRITE "${work}/${label}.log" "exit=${status}\n${out}${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}: ${out}${err}")
    endif()
    string(REPLACE "\r\n" "\n" out "${out}")
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
function(wood label expected)
    command("${label}" "${expected}" "${WOOD}" ${ARGN})
    math(EXPR cli_commands "${cli_commands}+1")
    set(cli_commands "${cli_commands}" PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
function(git_author label)
    command("${label}" 0 "${git}" -C "${work}/author" -c "core.hooksPath=${work}/no-hooks"
        -c commit.gpgsign=false ${ARGN})
    math(EXPR git_commands "${git_commands}+1")
    set(git_commands "${git_commands}" PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
endfunction()
function(export label expected revision destination)
    command("${label}" "${expected}" "${CMAKE_COMMAND}"
        "-DREPOSITORY=${work}/author" "-DREVISION=${revision}" "-DDESTINATION=${destination}"
        ${ARGN} -P "${SOURCE_DIR}/tools/vendor-library.cmake")
    math(EXPR exports "${exports}+1")
    set(exports "${exports}" PARENT_SCOPE)
endfunction()
wood(author-check 0 check "${work}/author")
wood(author-lock 0 lock "${work}/author")
file(SHA256 "${work}/author/wood.lock" lock_before)
wood(author-relock 0 lock "${work}/author")
file(SHA256 "${work}/author/wood.lock" lock_after)
if(NOT lock_before STREQUAL lock_after)
    message(FATAL_ERROR "Unchanged package lock is not reproducible")
endif()
wood(author-test 0 test "${work}/author" --locked --report=json)
string(JSON passed GET "${out}" passed)
string(JSON failed GET "${out}" failed)
if(NOT passed EQUAL 1 OR NOT failed EQUAL 0)
    message(FATAL_ERROR "Library's real tests did not run")
endif()
# The synthetic fixtures have their own local test identity. Never configure the
# user's identity, run downloaded hooks or commit in their source branches.
git_author(git-init init -q)
git_author(identity-name config user.name "Wood package workflow fixture")
git_author(identity-email config user.email "package-tests@example.invalid")
git_author(git-add add -- .)
git_author(git-commit commit -qm "Package workflow fixture 1.0.0")
git_author(git-revision rev-parse HEAD)
string(STRIP "${out}" revision)
file(WRITE "${work}/revision.txt" "${revision}\n")
set(dependency "${work}/consumer/vendor/northstar_measurements")
export(vendor 0 "${revision}" "${dependency}")
file(READ "${dependency}/wood-source.json" receipt)
string(JSON commit GET "${receipt}" commit)
if(NOT commit STREQUAL revision)
    message(FATAL_ERROR "Export lost immutable source identity")
endif()
string(JSON files LENGTH "${receipt}" files)
math(EXPR last "${files}-1")
foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${receipt}" files ${index})
    string(JSON hash GET "${receipt}" files "${name}" sha256)
    file(SHA256 "${dependency}/${name}" actual)
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "Exported blob integrity mismatch: ${name}")
    endif()
endforeach()
export(vendor-repeat 0 "${revision}" "${work}/same-source")
file(READ "${work}/same-source/wood-source.json" receipt_again)
if(NOT receipt STREQUAL receipt_again)
    message(FATAL_ERROR "Export identity/hashes changed on identical input")
endif()
export(refuse-existing 1 "${revision}" "${dependency}")
export(refuse-mutable-ref 1 HEAD "${work}/invalid-ref")
export(refuse-path-traversal 1 "${revision}" "${work}/invalid-tree" "-DDIRECTORY=../outside")
export(refuse-non-package 1 "${revision}" "${work}/invalid-package" -DDIRECTORY=src)
foreach(invalid IN ITEMS invalid-ref invalid-tree invalid-package)
    if(EXISTS "${work}/${invalid}")
        message(FATAL_ERROR "Rejected export published a destination: ${invalid}")
    endif()
endforeach()
file(WRITE "${work}/consumer/wood.json" "{\"format\":1,\"name\":\"warehouse_report\",\"version\":\"0.1.0\",\"source\":\"src\",\"entry\":\"main.wd\",\"tests\":\"tests\",\"dependencies\":{\"metrics\":{\"path\":\"vendor/northstar_measurements\",\"version\":\"1.0.0\"}}}\n")
file(WRITE "${work}/consumer/src/main.wd" [=[
import metrics.measurements as measurements

first = 1000 if len(args()) == 0 else int(args()[0])
values = [measurements.Reading("first", first), measurements.Reading("second", 2000)]
print(measurements.mean_kilograms(values))
]=])
file(WRITE "${work}/consumer/tests/test_report.wd" [=[
from metrics.measurements import Reading, mean_kilograms
assert(mean_kilograms([Reading("one", 2500), Reading("two", 3500)]) == 3.0)
]=])
wood(consumer-lock 0 lock "${work}/consumer")
file(READ "${work}/consumer/wood.lock" original_lock)
string(JSON packages LENGTH "${original_lock}" packages)
if(NOT packages EQUAL 3)
    message(FATAL_ERROR "Transitive package missing from lock")
endif()
wood(consumer-relock 0 lock "${work}/consumer")
file(READ "${work}/consumer/wood.lock" repeated_lock)
if(NOT repeated_lock STREQUAL original_lock)
    message(FATAL_ERROR "Consumer lock changed without changed inputs")
endif()
file(RENAME "${work}/consumer" "${work}/relocated application")
set(app "${work}/relocated application")
set(dependency "${app}/vendor/northstar_measurements")
file(RENAME "${work}/author" "${work}/author-kept-aside")
wood(relocated-check 0 check "${app}" --locked)
wood(relocated-deps 0 deps "${app}" --locked)
wood(relocated-inspect 0 inspect "${app}" --locked)
wood(relocated-tests 0 test "${app}" --locked --report=json)
string(JSON passed GET "${out}" passed)
if(NOT passed EQUAL 1)
    message(FATAL_ERROR "Relocated consumer tests did not execute")
endif()
wood(relocated-run 0 run "${app}" --locked -- 4000)
if(NOT out STREQUAL "3.0\n")
    message(FATAL_ERROR "Consumer output mismatch: ${out}")
endif()
set(binary "${work}/warehouse-report")
if(WIN32)
    string(APPEND binary .exe)
endif()
wood(relocated-build 0 build "${app}" --locked -o "${binary}")
command(standalone 0 "${binary}")
if(NOT out STREQUAL "1.5\n")
    message(FATAL_ERROR "Distributable native application output mismatch: ${out}")
endif()
file(READ "${dependency}/vendor/northstar_units/src/mass.wd" original_units)
file(APPEND "${dependency}/vendor/northstar_units/src/mass.wd" "\n# changed dependency\n")
wood(tampered-transitive 2 check "${app}" --locked --diagnostics=json)
if(NOT err MATCHES "D5001" OR NOT err MATCHES "wood.lock differs")
    message(FATAL_ERROR "Dependency tamper was not rejected by the lock")
endif()
file(READ "${app}/wood.lock" unchanged_lock)
if(NOT unchanged_lock STREQUAL original_lock)
    message(FATAL_ERROR "A failed check silently refreshed the lock")
endif()
file(COPY_FILE "${work}/same-source/vendor/northstar_units/src/mass.wd" "${dependency}/vendor/northstar_units/src/mass.wd")
# An intended exact-version update must also update the application declaration
# and receive an explicitly reviewed new lock; it is never silently selected.
file(READ "${dependency}/wood.json" original_manifest)
string(JSON updated_manifest SET "${original_manifest}" version "\"1.0.1\"")
file(WRITE "${dependency}/wood.json" "${updated_manifest}")
wood(version-mismatch 2 check "${app}" --locked --diagnostics=json)
file(COPY_FILE "${work}/same-source/wood.json" "${dependency}/wood.json")
file(READ "${app}/wood.json" app_manifest)
foreach(field IN ITEMS author license)
    # Strip the final newline before inserting the deliberately unknown field.
    string(STRIP "${app_manifest}" stripped_manifest)
    string(REGEX REPLACE "}$" ",\"${field}\":\"not-a-format-1-field\"}" bad_manifest "${stripped_manifest}")
    file(WRITE "${app}/wood.json" "${bad_manifest}\n")
    wood("unknown-${field}" 2 check "${app}" --diagnostics=json)
endforeach()
file(WRITE "${app}/wood.json" "${app_manifest}")
string(JSON invalid_name SET "${app_manifest}" name "\"bad-package-name\"")
file(WRITE "${app}/wood.json" "${invalid_name}\n")
wood(invalid-name 2 check "${app}" --diagnostics=json)
string(JSON invalid_root SET "${app_manifest}" source "\"../outside\"")
file(WRITE "${app}/wood.json" "${invalid_root}\n")
wood(invalid-source-root 2 check "${app}" --diagnostics=json)
file(WRITE "${app}/wood.json" "${app_manifest}")
file(WRITE "${app}/src/private_import.wd" "from metrics.measurements import _total\n")
wood(private-export 1 check "${app}/src/private_import.wd" --locked --diagnostics=json)
file(WRITE "${app}/src/transitive_import.wd" "from units.mass import kilograms\n")
wood(transitive-alias-hidden 1 check "${app}/src/transitive_import.wd" --locked --diagnostics=json)
wood(restored-check 0 check "${app}" --locked)
file(RENAME "${work}/author-kept-aside" "${work}/author")
file(READ "${work}/author/wood.json" author_manifest)
string(JSON author_manifest SET "${author_manifest}" version "\"1.0.1\"")
file(WRITE "${work}/author/wood.json" "${author_manifest}\n")
wood(author-upgrade-lock 0 lock "${work}/author")
git_author(add-upgrade add -- .)
git_author(commit-upgrade commit -qm "Package workflow fixture 1.0.1")
git_author(revision-upgrade rev-parse HEAD)
string(STRIP "${out}" upgrade_revision)
export(vendor-upgrade 0 "${upgrade_revision}" "${app}/vendor/northstar_measurements_1_0_1")
git_author(replace-fixture replace "${revision}" "${upgrade_revision}")
export(ignore-replacement 0 "${revision}" "${work}/replacement-proof")
file(READ "${work}/replacement-proof/wood-source.json" replacement_receipt)
if(NOT replacement_receipt STREQUAL receipt)
    message(FATAL_ERROR "Local replacement ref changed the pinned export")
endif()
string(JSON upgraded_app SET "${app_manifest}" dependencies metrics path "\"vendor/northstar_measurements_1_0_1\"")
string(JSON upgraded_app SET "${upgraded_app}" dependencies metrics version "\"1.0.1\"")
file(WRITE "${app}/wood.json" "${upgraded_app}\n")
wood(upgrade-needs-lock 2 check "${app}" --locked --diagnostics=json)
wood(upgrade-lock 0 lock "${app}")
wood(upgrade-deps 0 deps "${app}" --locked)
wood(upgrade-tests 0 test "${app}" --locked --report=json)
string(JSON failed GET "${out}" failed)
if(NOT failed EQUAL 0)
    message(FATAL_ERROR "Explicitly upgraded dependency tests failed")
endif()
# Symlinks and case aliases are rejected from Git objects, without creating an
# actual filesystem link. Existing application/vendor bytes must stay unchanged.
file(WRITE "${work}/link-target" "../../outside\n")
git_author(hash-link hash-object -w "${work}/link-target")
string(STRIP "${out}" link_blob)
git_author(index-link update-index --add --cacheinfo "120000,${link_blob},escape")
git_author(commit-link commit -qm "Negative control: forbidden source link")
git_author(revision-link rev-parse HEAD)
string(STRIP "${out}" link_revision)
export(reject-link 1 "${link_revision}" "${work}/linked-export")
git_author(remove-link update-index --force-remove escape)
git_author(index-case update-index --add --cacheinfo "100644,${link_blob},SRC/other.wd")
git_author(commit-case commit -qm "Negative control: case-colliding source directories")
git_author(revision-case rev-parse HEAD)
string(STRIP "${out}" case_revision)
export(reject-case 1 "${case_revision}" "${work}/case-export")
git_author(remove-case update-index --force-remove SRC/other.wd)
git_author(index-device -c core.protectNTFS=false update-index --add --cacheinfo "100644,${link_blob},aux.txt")
git_author(commit-device commit -qm "Negative control: Windows device name")
git_author(revision-device rev-parse HEAD)
string(STRIP "${out}" device_revision)
export(reject-device 1 "${device_revision}" "${work}/device-export")
git_author(remove-device update-index --force-remove aux.txt)
git_author(index-space -c core.protectNTFS=false update-index --add --cacheinfo "100644,${link_blob},trailing ")
git_author(commit-space commit -qm "Negative control: trailing-space name")
git_author(revision-space rev-parse HEAD)
string(STRIP "${out}" space_revision)
export(reject-space 1 "${space_revision}" "${work}/space-export")
git_author(remove-space update-index --force-remove "trailing ")
git_author(index-submodule update-index --add --cacheinfo "160000,${revision},submodule")
git_author(commit-submodule commit -qm "Negative control: forbidden submodule")
git_author(revision-submodule rev-parse HEAD)
string(STRIP "${out}" submodule_revision)
export(reject-submodule 1 "${submodule_revision}" "${work}/submodule-export")
foreach(rejected IN ITEMS linked-export case-export device-export space-export submodule-export)
    if(EXISTS "${work}/${rejected}")
        message(FATAL_ERROR "Rejected Git object published an unsafe export")
    endif()
endforeach()
file(WRITE "${work}/validation.json" "{\"cli_commands\":${cli_commands},\"export_commands\":${exports},\"git_commands\":${git_commands},\"status\":\"PASS\",\"lock_packages\":3,\"exported_files\":${files}}\n")
message(STATUS "Community library workflow passed: ${cli_commands} Wood commands, ${exports} source-export commands, ${git_commands} isolated Git commands; three-package lock, relocation, standalone execution and negative cases")
