string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected)
    set(arguments ${ARGN})
    if(SANITIZE_GENERATED AND (ARGV1 STREQUAL "run" OR ARGV1 STREQUAL "build" OR ARGV1 MATCHES "[.]wd$"))
        list(INSERT arguments 1 --sanitize=address)
    endif()
    execute_process(COMMAND "${WOOD}" ${arguments} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180 ENCODING UTF-8
        WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${SOURCE_DIR}/tests/performance.wd" "${level}")
    if(NOT last_output STREQUAL "ownership and read borrowing passed\n" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Unexpected ownership output: ${last_output}${last_error}")
    endif()
    invoke(0 "${SOURCE_DIR}/tests/string_buffers.wd" "${level}")
    if(NOT last_output STREQUAL "native string buffers passed\n" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Unexpected string buffer output: ${last_output}${last_error}")
    endif()
    invoke(0 "${SOURCE_DIR}/tests/csv_dump.wd" "${level}")
    if(NOT last_output STREQUAL "CSV dump and owned pipelines passed\n" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Unexpected CSV dump output: ${last_output}${last_error}")
    endif()
    invoke(0 "${SOURCE_DIR}/tests/binding_lifetimes.wd" "${level}")
    if(NOT last_output STREQUAL "binding and iteration lifetimes passed\n" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Unexpected binding lifetime output: ${last_output}${last_error}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/events.log" "INFO|mesh|loaded árbol\nWARN|mesh|degenerate triangle\nERROR|io|missing file\nINFO|io|ready")
set(application "${SOURCE_DIR}/examples/delimited_log_report.wd")
invoke(0 "${application}" -- "${TEST_DIR}/events.log")
set(expected "${last_output}")
foreach(field IN ITEMS records message_bytes)
    string(JSON actual GET "${expected}" "${field}")
    if(field STREQUAL "records" AND NOT actual EQUAL 4)
        message(FATAL_ERROR "Wrong application record count")
    elseif(field STREQUAL "message_bytes" AND NOT actual EQUAL 49)
        message(FATAL_ERROR "Wrong application byte count: ${actual}")
    endif()
endforeach()
string(JSON info GET "${expected}" levels INFO)
string(JSON warn GET "${expected}" levels WARN)
string(JSON errors GET "${expected}" levels ERROR)
string(JSON mesh GET "${expected}" categories mesh)
string(JSON io GET "${expected}" categories io)
string(JSON preview GET "${expected}" preview 0)
if(NOT info EQUAL 2 OR NOT warn EQUAL 1 OR NOT errors EQUAL 1 OR NOT mesh EQUAL 2
   OR NOT io EQUAL 2 OR NOT preview STREQUAL "[1] INFO mesh: loaded árbol")
    message(FATAL_ERROR "Wrong native log summary: ${expected}")
endif()
set(extension "")
if(WIN32)
    set(extension ".exe")
endif()
set(executable "${TEST_DIR}/text-report${extension}")
invoke(0 build "${application}" -o "${executable}" --diagnostics=json)
execute_process(COMMAND "${executable}" "${TEST_DIR}/events.log" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
if(NOT status EQUAL 0 OR NOT output STREQUAL expected OR NOT error STREQUAL "")
    message(FATAL_ERROR "Standalone application differs: ${output}${error}")
endif()
foreach(record IN ITEMS "DEBUG|mesh|bad level" "INFO|mesh" "INFO||missing category" "WARN|mesh|")
    file(WRITE "${TEST_DIR}/invalid.log" "${record}\n")
    execute_process(COMMAND "${executable}" "${TEST_DIR}/invalid.log" RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
    string(JSON code GET "${error}" code)
    if(NOT status EQUAL 70 OR NOT code STREQUAL "R4010" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Malformed application input not rejected: ${output}${error}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/events.log" "")
execute_process(COMMAND "${executable}" "${TEST_DIR}/events.log" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
string(JSON actual GET "${output}" records)
if(NOT status EQUAL 0 OR NOT actual EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "Empty application input failed")
endif()
