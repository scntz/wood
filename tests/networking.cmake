string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 120 ENCODING UTF-8)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${WOOD}" "${SOURCE_DIR}/tests/streams.wd" "${level}")
    if(NOT last_output STREQUAL "native streams passed\n")
        message(FATAL_ERROR "Streams output mismatch: ${last_output}")
    endif()
    invoke(0 "${WOOD}" "${SOURCE_DIR}/tests/http.wd" "${level}")
    if(NOT last_output STREQUAL "native HTTP passed\n")
        message(FATAL_ERROR "HTTP output mismatch: ${last_output}")
    endif()
endforeach()
if(WIN32)
    set(suffix ".exe")
else()
    set(suffix "")
endif()
foreach(app IN ITEMS http_json_server http_get stream_copy)
    set(${app} "${TEST_DIR}/${app}${suffix}")
    invoke(0 "${WOOD}" build "${SOURCE_DIR}/examples/${app}.wd" -o "${${app}}")
endforeach()
invoke(0 "${NETWORK_TEST}" "${http_json_server}" "${http_get}" "${TEST_DIR}")

# File larger than the 16 MiB single-allocation read cap; the application copies
# in 64 KiB chunks rather than materializing the file as a Wood string.
string(REPEAT "0123456789abcdef" 1572864 content)
file(WRITE "${TEST_DIR}/large-input.bin" "${content}")
unset(content)
invoke(0 "${stream_copy}" "${TEST_DIR}/large-input.bin" "${TEST_DIR}/large-output.bin" 25165824)
file(SHA256 "${TEST_DIR}/large-input.bin" source_hash)
file(SHA256 "${TEST_DIR}/large-output.bin" destination_hash)
if(NOT source_hash STREQUAL destination_hash)
    message(FATAL_ERROR "Streaming copy checksum mismatch")
endif()
invoke(70 "${stream_copy}" "${TEST_DIR}/large-input.bin" "${TEST_DIR}/large-output.bin" 25165824)
file(SHA256 "${TEST_DIR}/large-output.bin" preserved_hash)
if(NOT source_hash STREQUAL preserved_hash)
    message(FATAL_ERROR "Exclusive creation did not preserve existing output")
endif()
invoke(70 "${stream_copy}" "${TEST_DIR}/large-input.bin" "${TEST_DIR}/partial.bin" 10)
invoke(7 "${WOOD}" "${SOURCE_DIR}/tests/streams.wd" -- "${TEST_DIR}/exit.txt")
file(READ "${TEST_DIR}/exit.txt" exit_bytes)
if(NOT exit_bytes STREQUAL "exit cleanup")
    message(FATAL_ERROR "Exit failed to flush/close scoped output")
endif()
message(STATUS "Native scoped streams, TCP/HTTP O0/O2, standalone applications and large-file copy passed")
