cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/frontend-profiles.cmake")
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
message(STATUS "Documentation evidence: ${TEST_DIR}")
if(NOT DEFINED DOCS_SQLITE)
    set(DOCS_SQLITE ON)
endif()
set(REPORT "${TEST_DIR}/coverage.json")
include("${SOURCE_DIR}/tools/check-docs.cmake")
set(native_flags -O0)
if(DOCS_SANITIZE)
    list(APPEND native_flags --sanitize=address)
endif()
set(command_count 0)
set(input_file "${TEST_DIR}/empty.stdin")
file(WRITE "${input_file}" "")
function(invoke label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${case_dir}"
        INPUT_FILE "${input_file}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 240)
    file(WRITE "${TEST_DIR}/${label}.stdout" "${output}")
    file(WRITE "${TEST_DIR}/${label}.stderr" "${errors}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}\n${output}\n${errors}")
    endif()
    math(EXPR count "${command_count} + 1")
    set(command_count "${count}" PARENT_SCOPE)
    set(output "${output}" PARENT_SCOPE)
    set(errors "${errors}" PARENT_SCOPE)
endfunction()

set(case_dir "${TEST_DIR}")
invoke(version 0 "${WOOD}" --version)
invoke(help 0 "${WOOD}" --help)
invoke(language-info 0 "${WOOD}" --language-info)
string(JSON schema GET "${output}" schema_version)
string(JSON version GET "${output}" version)
string(JSON expected_version GET "${capabilities}" version)
if(NOT schema EQUAL 1 OR NOT version STREQUAL expected_version)
    message(FATAL_ERROR "Installed capability version/schema differs from documentation")
endif()
string(JSON n LENGTH "${output}" builtins)
set(actual_builtins "")
math(EXPR end "${n} - 1")
foreach(i RANGE ${end})
    string(JSON name GET "${output}" builtins ${i})
    list(APPEND actual_builtins "${name}")
endforeach()
list(SORT actual_builtins)
if(NOT actual_builtins STREQUAL builtin_names)
    message(FATAL_ERROR "Compiler embeds stale builtin metadata; build the current source in a separate directory")
endif()

file(GLOB guides RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/docs/*.md")
list(APPEND guides "README.md")
if(DEFINED DOCS_GUIDES)
    foreach(guide IN LISTS DOCS_GUIDES)
        if(NOT guide IN_LIST guides)
            message(FATAL_ERROR "DOCS_GUIDES must select maintained root guides: ${guide}")
        endif()
    endforeach()
    set(guides "${DOCS_GUIDES}")
endif()
set(snippet_count 0)
set(run_count 0)
set(check_count 0)
set(unexecuted_count 0)
foreach(guide IN LISTS guides)
    file(READ "${SOURCE_DIR}/${guide}" remaining)
    string(REPLACE "\r\n" "\n" remaining "${remaining}")
    set(block 0)
    set(in_block FALSE)
    set(fence "")
    set(code "")
    while(NOT remaining STREQUAL "")
        string(FIND "${remaining}" "\n" newline)
        if(newline EQUAL -1)
            set(line "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${newline} line)
            math(EXPR next "${newline} + 1")
            string(SUBSTRING "${remaining}" ${next} -1 remaining)
        endif()
        if(NOT in_block AND line MATCHES "^(```|~~~)wood[ ]*$")
            set(fence "${CMAKE_MATCH_1}")
            set(in_block TRUE)
            set(code "")
        elseif(in_block AND line STREQUAL fence)
            set(in_block FALSE)
            string(JSON spec ERROR_VARIABLE missing GET "${doc_config}" snippets "${guide}" ${block})
            if(missing)
                message(FATAL_ERROR "Unregistered Wood fence ${guide} block ${block}; update documentation.json")
            endif()
            string(JSON mode GET "${spec}" mode)
            set(execute FALSE)
            string(JSON after ERROR_VARIABLE absent GET "${spec}" after)
            if(NOT absent)
                string(APPEND code "\n${after}")
            endif()
            math(EXPR block "${block} + 1")
            math(EXPR snippet_count "${snippet_count} + 1")
            set(label "snippet-${snippet_count}")
            set(case_dir "${TEST_DIR}/${label}")
            file(MAKE_DIRECTORY "${case_dir}/geometry")
            file(WRITE "${case_dir}/main.wd" "${code}")
            string(JSON library_fixture ERROR_VARIABLE absent GET "${spec}" library_fixture)
            if(NOT absent AND library_fixture)
                file(MAKE_DIRECTORY "${case_dir}/vendor")
                file(COPY "${SOURCE_DIR}/examples/library_author" DESTINATION "${case_dir}/vendor")
                file(WRITE "${case_dir}/wood.json" "{\"format\":1,\"name\":\"library_docs\",\"version\":\"0.1.0\",\"source\":\".\",\"entry\":\"main.wd\",\"dependencies\":{\"metrics\":{\"path\":\"vendor/library_author\",\"version\":\"1.0.0\"}}}\n")
            endif()
            file(WRITE "${case_dir}/input.txt" "sample input\n")
            file(WRITE "${case_dir}/input.bin" "sample binary\r\nbytes\n")
            file(WRITE "${case_dir}/geometry/area.wd" "fn rectangle(width: int, height: int) -> int:\n    return width * height\n")
            configure_file("${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj" "${case_dir}/input.obj" COPYONLY)
            if(mode STREQUAL "reject")
                invoke("${label}-check" 1 "${WOOD}" check "${case_dir}/main.wd" --diagnostics=json)
                string(JSON expected_code GET "${spec}" code)
                string(STRIP "${errors}" diagnostic)
                string(JSON actual_code GET "${diagnostic}" code)
                if(NOT expected_code STREQUAL actual_code)
                    message(FATAL_ERROR "${guide}:${block}: expected ${expected_code}, got ${actual_code}")
                endif()
            elseif(mode STREQUAL "run" OR mode STREQUAL "check")
                invoke("${label}-check" 0 "${WOOD}" check "${case_dir}/main.wd" --diagnostics=json)
                set(execute TRUE)
                if(mode STREQUAL "check")
                    string(JSON reason GET "${spec}" reason)
                    if(reason STREQUAL "")
                        message(FATAL_ERROR "Check-only example needs a reason")
                    endif()
                    math(EXPR check_count "${check_count} + 1")
                    set(execute FALSE)
                elseif(DOCS_CHECK_ONLY OR (guide STREQUAL "docs/backend.md" AND block EQUAL 1 AND NOT DOCS_SQLITE))
                    math(EXPR unexecuted_count "${unexecuted_count} + 1")
                    set(execute FALSE)
                endif()
                set(link_flags "")
                string(JSON ffi ERROR_VARIABLE absent GET "${spec}" requires_ffi)
                if(NOT absent AND ffi)
                    if(DEFINED DOCS_FFI_LIBRARY AND EXISTS "${DOCS_FFI_LIBRARY}")
                        list(APPEND link_flags --link-library "${DOCS_FFI_LIBRARY}")
                    elseif(execute)
                        math(EXPR unexecuted_count "${unexecuted_count} + 1")
                        set(execute FALSE)
                        message(STATUS "${guide} block ${block}: native fixture library not supplied; execution not validated")
                    endif()
                endif()
                if(execute)
                    set(executable "${case_dir}/program")
                    if(WIN32)
                        string(APPEND executable ".exe")
                    endif()
                    invoke("${label}-build" 0 "${WOOD}" build "${case_dir}/main.wd" ${native_flags} ${link_flags} -o "${executable}")
                    set(arguments "")
                    string(JSON argc ERROR_VARIABLE absent LENGTH "${spec}" args)
                    if(NOT absent AND argc GREATER 0)
                        math(EXPR last "${argc} - 1")
                        foreach(a RANGE ${last})
                            string(JSON arg GET "${spec}" args ${a})
                            list(APPEND arguments "${arg}")
                        endforeach()
                    endif()
                    string(JSON stdin ERROR_VARIABLE absent GET "${spec}" stdin)
                    if(NOT absent)
                        set(input_file "${case_dir}/input.stdin")
                        file(WRITE "${input_file}" "${stdin}")
                    endif()
                    invoke("${label}-run" 0 "${executable}" ${arguments})
                    set(input_file "${TEST_DIR}/empty.stdin")
                    string(JSON expected_output ERROR_VARIABLE absent GET "${spec}" stdout)
                    string(REPLACE "\r\n" "\n" output "${output}")
                    if(NOT absent AND NOT output STREQUAL expected_output)
                        message(FATAL_ERROR "Unexpected stdout in ${guide} block ${block}: ${output}")
                    endif()
                    math(EXPR run_count "${run_count} + 1")
                endif()
            else()
                message(FATAL_ERROR "Unknown example mode: ${mode}")
            endif()
            message(STATUS "${guide} block ${block}: declared ${mode}; native execution ${execute}")
        elseif(in_block)
            string(APPEND code "${line}\n")
        endif()
    endwhile()
    if(in_block)
        message(FATAL_ERROR "Unclosed Wood fence in ${guide}")
    endif()
    string(JSON registered ERROR_VARIABLE missing LENGTH "${doc_config}" snippets "${guide}")
    if((block GREATER 0 AND missing) OR (NOT missing AND NOT registered EQUAL block))
        message(FATAL_ERROR "Fence count changed in ${guide}; update documentation.json")
    endif()
endforeach()

# Exercise diagnostic contracts with actual rejected source, independently of
# successful examples and human-readable message wording.
set(case_dir "${TEST_DIR}")
set(negative_sources "print(unknown_name)\n" "fn take(value: int):\n    pass\ntake()\n"
    "amount: int = \"wrong\"\n" "fn recurse(value: int):\n    return recurse(value)\nrecurse(1)\n")
set(negative_codes E3007 E3003 E3002 E3030)
foreach(i RANGE 0 3)
    list(GET negative_sources ${i} code)
    list(GET negative_codes ${i} expected)
    file(WRITE "${TEST_DIR}/negative-${i}.wd" "${code}")
    invoke("negative-${i}" 1 "${WOOD}" check "${TEST_DIR}/negative-${i}.wd" --diagnostics=json)
    string(STRIP "${errors}" diagnostic)
    string(JSON actual GET "${diagnostic}" code)
    foreach(field IN ITEMS severity code file line column message)
        string(JSON value GET "${diagnostic}" "${field}")
    endforeach()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Diagnostic changed: expected ${expected}, got ${actual}")
    endif()
endforeach()
invoke(explain 0 "${WOOD}" explain E3030)
invoke(explain-unknown 2 "${WOOD}" explain E9999 --diagnostics=json)
string(STRIP "${errors}" diagnostic)
string(JSON code GET "${diagnostic}" code)
if(NOT code STREQUAL "D5001")
    message(FATAL_ERROR "Undocumented explain code contract changed")
endif()

# Check complete example sources in place so their actual package roots/imports
# and included locks participate. Never refresh their checked-in locks.
set(example_number 0)
foreach(example IN LISTS examples)
    math(EXPR example_number "${example_number} + 1")
    wood_python_provider("${SOURCE_DIR}/${example}" optional_provider)
    if(optional_provider AND NOT DOCS_NATIVE_FRONTEND)
        # The C++ reference intentionally rejects the separately verified LLVM
        # extension. Assert its real boundary instead of silently skipping it.
        invoke("example-${example_number}-reference-boundary" 1 "${WOOD}" check "${SOURCE_DIR}/${example}" --diagnostics=json)
        string(STRIP "${errors}" diagnostic)
        string(JSON code GET "${diagnostic}" code)
        if(NOT code STREQUAL "E1007")
            message(FATAL_ERROR "Reference provider boundary changed: ${errors}")
        endif()
        if(DEFINED NATIVE_WOOD AND NOT NATIVE_WOOD STREQUAL "")
            invoke("example-${example_number}-native" 0 "${NATIVE_WOOD}" check "${SOURCE_DIR}/${example}" --diagnostics=json)
        endif()
    else()
        invoke("example-${example_number}" 0 "${WOOD}" check "${SOURCE_DIR}/${example}" --diagnostics=json)
    endif()
endforeach()

set(case_dir "${TEST_DIR}")
invoke(init 0 "${WOOD}" init "${TEST_DIR}/hello")
invoke(project-check 0 "${WOOD}" check "${TEST_DIR}/hello")
invoke(project-lock 0 "${WOOD}" lock "${TEST_DIR}/hello")
invoke(project-deps 0 "${WOOD}" deps "${TEST_DIR}/hello" --locked)
string(JSON value GET "${output}" format)
invoke(project-inspect 0 "${WOOD}" inspect "${TEST_DIR}/hello" --locked)
string(JSON value GET "${output}" schema_version)
if(NOT DOCS_CHECK_ONLY)
    foreach(package IN ITEMS project catalog archive)
        invoke("package-${package}" 0 "${WOOD}" test "${SOURCE_DIR}/examples/${package}" --locked --report=json ${native_flags})
        string(JSON failed GET "${output}" failed)
        if(NOT failed EQUAL 0)
            message(FATAL_ERROR "Example package ${package} tests failed")
        endif()
    endforeach()
    invoke(project-test 0 "${WOOD}" test "${TEST_DIR}/hello" --locked --report=json ${native_flags})
    string(JSON passed GET "${output}" passed)
    string(JSON failed GET "${output}" failed)
    if(NOT passed EQUAL 1 OR NOT failed EQUAL 0)
        message(FATAL_ERROR "Generated project test report failed")
    endif()
    invoke(project-run 0 "${WOOD}" run "${TEST_DIR}/hello" --locked ${native_flags} -- world)
    set(executable "${TEST_DIR}/hello-app")
    if(WIN32)
        string(APPEND executable ".exe")
    endif()
    invoke(project-build 0 "${WOOD}" build "${TEST_DIR}/hello" --locked ${native_flags} -o "${executable}")
    invoke(project-standalone 0 "${executable}" world)
    string(REPLACE "\r\n" "\n" output "${output}")
    if(NOT output STREQUAL "hello, world\n")
        message(FATAL_ERROR "Generated standalone greeting differs: ${output}")
    endif()
endif()
file(WRITE "${TEST_DIR}/summary.json" "{\n  \"schema_version\":1,\n  \"snippets_checked\":${snippet_count},\n  \"snippets_executed\":${run_count},\n  \"declared_check_only\":${check_count},\n  \"runtime_not_executed\":${unexecuted_count},\n  \"example_sources_checked\":${example_number},\n  \"negative_diagnostics\":4,\n  \"commands_passed\":${command_count},\n  \"check_only\":\"${DOCS_CHECK_ONLY}\",\n  \"sanitize_generated\":\"${DOCS_SANITIZE}\"\n}\n")
message(STATUS "Documentation verified: ${snippet_count} snippets checked, ${run_count} executed, ${check_count} explicitly check-only, ${unexecuted_count} runtime checks not executed; ${example_number} source examples; ${command_count} commands passed")
