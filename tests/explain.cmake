function(invoke expected_status)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${TEST_DIR}/offline"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60 ENCODING UTF-8)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
function(example text label result)
    set(marker "${label}:\n```wood\n")
    string(FIND "${text}" "${marker}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing example label ${label}")
    endif()
    string(LENGTH "${marker}" marker_length)
    math(EXPR start "${start}+${marker_length}")
    string(SUBSTRING "${text}" ${start} -1 remainder)
    string(FIND "${remainder}" "\n```" finish)
    if(finish LESS 0)
        message(FATAL_ERROR "Missing closing example fence")
    endif()
    string(SUBSTRING "${remainder}" 0 ${finish} source)
    set(${result} "${source}\n" PARENT_SCOPE)
endfunction()
function(check_driver_error)
    string(JSON fields LENGTH "${last_error}")
    string(JSON code GET "${last_error}" code)
    string(JSON severity GET "${last_error}" severity)
    string(JSON file GET "${last_error}" file)
    string(JSON line GET "${last_error}" line)
    string(JSON column GET "${last_error}" column)
    if(NOT fields EQUAL 6 OR NOT code STREQUAL "D5001" OR NOT severity STREQUAL "error"
       OR NOT file STREQUAL "" OR NOT line EQUAL 0 OR NOT column EQUAL 0 OR NOT last_output STREQUAL "")
        message(FATAL_ERROR "Explain changed driver diagnostic contracts: ${last_error}")
    endif()
endfunction()
set(codes E3002 E3003 E3005 E3007 E3013 E3014 E3030)
invoke(0 explain --help)
if(NOT last_error STREQUAL "" OR NOT last_output MATCHES "Usage: wood explain CODE"
   OR NOT last_output MATCHES "Available explanations: ")
    message(FATAL_ERROR "Missing explain usage/catalog: ${last_output}${last_error}")
endif()
foreach(code IN LISTS codes)
    if(NOT last_output MATCHES "${code}")
        message(FATAL_ERROR "Explain catalog lacks ${code}: ${last_output}")
    endif()
endforeach()
foreach(code IN LISTS codes)
    invoke(0 explain "${code}")
    if(NOT last_error STREQUAL "" OR NOT last_output MATCHES "^${code} - "
       OR NOT last_output MATCHES "Meaning:\n" OR NOT last_output MATCHES "Why it happens:\n"
       OR NOT last_output MATCHES "How to fix:\n")
        message(FATAL_ERROR "Incomplete explanation ${code}: ${last_output}${last_error}")
    endif()
    set(explanation "${last_output}")
    file(WRITE "${TEST_DIR}/${code}.txt" "${explanation}")
    invoke(0 explain --diagnostics=json "${code}")
    if(NOT last_output STREQUAL explanation OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Diagnostics option changed successful explanation output")
    endif()
    example("${explanation}" "Example that fails" before)
    example("${explanation}" "One correction" after)
    file(WRITE "${TEST_DIR}/examples/${code}-before.wd" "${before}")
    file(WRITE "${TEST_DIR}/examples/${code}-after.wd" "${after}")
    invoke(1 check "${TEST_DIR}/examples/${code}-before.wd" --diagnostics=json --cxx unavailable-cxx)
    string(JSON actual_code GET "${last_error}" code)
    string(JSON fields LENGTH "${last_error}")
    if(NOT actual_code STREQUAL code OR NOT fields EQUAL 6 OR NOT last_output STREQUAL "")
        message(FATAL_ERROR "Explanation example has wrong actual diagnostic: ${last_error}")
    endif()
    invoke(0 "${TEST_DIR}/examples/${code}-after.wd")
    if(NOT last_output STREQUAL "" OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "Correction did not execute quietly: ${last_output}${last_error}")
    endif()
endforeach()

# Missing documentation does not mean a code is invalid. No fallback explanation
# is invented, including for the real but deliberately undocumented E3031.
foreach(code IN ITEMS E9998 E9999 R4999 D5999)
    invoke(2 explain "${code}" --diagnostics=json)
    check_driver_error()
    string(JSON message GET "${last_error}" message)
    if(NOT message MATCHES "No built-in explanation is available"
       OR NOT message MATCHES "does not mean the code is invalid"
       OR NOT message MATCHES "Available explanations:")
        message(FATAL_ERROR "Unhelpful unavailable-code behavior: ${last_error}")
    endif()
endforeach()
