if(NOT format STREQUAL "text on stdout" OR NOT schema EQUAL 1 OR count LESS 7)
    message(FATAL_ERROR "Missing additive explanation metadata")
endif()
set(listed "")
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
    string(JSON actual GET "${last_output}" diagnostics explain codes ${index})
    list(APPEND listed "${actual}")
endforeach()
foreach(code IN LISTS codes)
    if(NOT code IN_LIST listed)
        message(FATAL_ERROR "Explanation metadata/catalog disagree")
    endif()
endforeach()

