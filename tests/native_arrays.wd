import std.num as num
import std.linalg as la
import std.iter as it

values = num.reshape(num.from_list([1,2,3,4,5,6]),(2,3))
assert(len(values) == 6 and num.rank(values) == 2 and num.shape(values) == [2,3])
assert(values[-1,-1] == 6)
snapshot = values
values[0,0] = 100
assert(snapshot[0,0] == 1 and values[0,0] == 100)
view = num.transpose(snapshot)
assert(num.shape(view) == [3,2] and not num.contiguous(view))
assert(num.to_list(view) == [1,4,2,5,3,6])
reshaped = num.reshape(view,(2,3))
view[0,0] = 9
assert(snapshot[0,0] == 1 and reshaped[0,0] == 1)
assert(num.to_list(num.slice(snapshot,1,2,-4,-1)) == [3,2,1,6,5,4])
assert(num.to_list(snapshot[::-1]) == [4,5,6,1,2,3])
assert(num.to_list(num.flatten(snapshot)[::-9223372036854775808]) == [6])
assert(num.shape(num.zeros((9223372036854775807,9223372036854775807,0))[:]) == [9223372036854775807,9223372036854775807,0])
empty = num.zeros((2,0,3))
assert(len(empty) == 0 and num.contiguous(empty) and num.sum(empty) == 0.0)
assert(num.shape(empty / 0.0) == [2,0,3])
assert(num.to_list(num.integers(num.from_list([1.9,-2.9]))) == [1,-2])
assert(num.to_list(num.floats(num.from_list([1,2]))) == [1.0,2.0])
assert(num.to_list((snapshot+2)*3-1) == [8,11,14,17,20,23])
assert(num.to_list(10-num.flatten(snapshot)) == [9,8,7,6,5,4])
assert(num.to_list(-num.from_list([1,-2])) == [-1,2])
assert(num.sum(num.from_list([1e16,1.0,-1e16])) == 1.0)
assert(num.dot(num.from_list([1,2,3]),num.from_list([4,5,6])) == 32)
assert(num.dot(num.from_list([1e16,1.0,-1e16]),num.ones(3)) == 1.0)
assert([item for item in num.transpose(snapshot)] == [1,4,2,5,3,6])
assert(it.collect(it.map(num.transpose(snapshot),fn(x) => x+1)) == [2,5,3,6,4,7])
cursor = iter(num.transpose(snapshot))
assert(step_value(next(cursor)) == 1 and it.collect(cursor) == [4,2,5,3,6])
assert(str(num.zeros(0)) == "array(shape=[0], values=[])")
assert(str(num.from_list([1.0,2.0])) == "array(shape=[2], values=[1.0, 2.0])")
assert(str(("a\0b\n",1.0)) == "(\"a\\0b\\n\", 1.0)")

record Holder:
    values: array[float]
    fn replace(mut self) -> int:
        self.values = num.full(2,9.0)
        return 0
holder = Holder(num.from_list([1.0,2.0]))
assert(holder.values[holder.replace()] == 1.0)
assert(holder.values[0] == 9.0)
fn temporary():
    return (Holder(num.ones(2)),)
assert(temporary()[0].values[0] == 1.0)
fn captured():
    source = num.ones(2)
    fn change[mut source]():
        source[0] += 1.0
        return source
    return change
callback = captured()
other = callback
assert(callback()[0] == 2.0 and callback()[0] == 3.0 and other()[0] == 2.0)
for size in range(1,8):
    coefficients = num.zeros((size,size))
    expected = num.zeros((size,2))
    for row in range(size):
        expected[row,0] = float(row+1)
        expected[row,1] = float(2-row)
        for column in range(size):
            coefficients[row,column] = float((row*7+column*3)%5) * 0.1
        coefficients[row,row] += float(size+1)
    rhs = num.matmul(coefficients,expected)
    solution = la.solve(coefficients,rhs)
    for row in range(size):
        for column in range(2):
            assert(num.close(solution[row,column],expected[row,column]))
    assert(num.matmul(num.transpose(coefficients),num.transpose(coefficients)) == num.matmul(num.copy(num.transpose(coefficients)),num.copy(num.transpose(coefficients))))
points = num.reshape(num.from_list([1.0,2.0,3.0,0.0,0.0,0.0]),(2,3))
assert(la.transform_points(points,la.translation(4.0,5.0,6.0))[0,2] == 9.0)
assert(points[0,2] == 3.0 and num.close(la.Vec3(3.0,4.0,0.0).length(),5.0))
large = 1e308
infinity = large * large
assert(not num.finite(infinity))
for bad in [infinity,-infinity,infinity-infinity,-1.0]:
    try:
        num.sqrt(bad)
        assert(false)
    except err:
        assert(err.code == "R4027")
assert(num.sqrt(-0.0) == 0.0)
print("native numerical arrays passed")
