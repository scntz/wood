# Explicit optional-profile assertions, not corpus exclusions. The qualified
# C++ frontend deliberately lacks the experimental Wood-only Python provider/type.
function(wood_python_provider source output)
    # Signature fixtures also exercise project directories and missing paths.
    # Keep those in the common frontend differential, without reading a directory
    # as text or bypassing the oracle's normal project/input diagnostics.
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    file(READ "${source}" text)
    if(text MATCHES "(^|\n)[ \t]*import[ \t]+python@")
        set(${output} TRUE PARENT_SCOPE)
    else()
        set(${output} FALSE PARENT_SCOPE)
    endif()
endfunction()
function(wood_optional_frontend source stage actual_status actual expected_status expected actual_error expected_error output)
    wood_python_provider("${source}" provider)
    file(RELATIVE_PATH relative "${SOURCE_DIR}" "${source}")
    set(code "")
    if(provider)
        set(code E1007)
    elseif(stage STREQUAL "signatures" AND relative STREQUAL "stdlib/python.wd")
        set(code E2003)
    endif()
    if(code STREQUAL "")
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    if(NOT actual_status STREQUAL "0" OR NOT expected_status STREQUAL "1"
            OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
        message(FATAL_ERROR "${stage} optional profile boundary differs for ${source}: ${actual_status}/${expected_status}: ${actual_error}${expected_error}")
    endif()
    if(stage STREQUAL "signatures")
        string(JSON diagnostic GET "${expected}" diagnostic code)
    else()
        string(JSON diagnostic GET "${expected}" code)
        string(JSON actual_code GET "${actual}" code)
        if(NOT actual_code STREQUAL "")
            message(FATAL_ERROR "Wood ${stage} rejected a supported provider source: ${actual}")
        endif()
    endif()
    string(JSON format GET "${actual}" format)
    if(NOT diagnostic STREQUAL code OR NOT format EQUAL 1)
        message(FATAL_ERROR "${stage} optional profile diagnostic/schema changed: ${expected}")
    endif()
    set(${output} TRUE PARENT_SCOPE)
endfunction()
