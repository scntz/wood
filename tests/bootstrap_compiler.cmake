function(native_build cpp label output)
    set(binary "${TEST_DIR}/${label}")
    if(WIN32)
        string(APPEND binary ".exe")
    endif()
    if(HOST_MSVC)
        set(flags)
        if(SANITIZE_GENERATED)
            set(flags /fsanitize=address /Zi)
        endif()
        execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /O2 /MD /EHsc /utf-8 /permissive- /bigobj
            ${flags} "/Fo:${TEST_DIR}/${label}.obj" "/Fd:${TEST_DIR}/${label}.pdb" "/Fe:${binary}" "${cpp}" ${ARGN}
            /link /INCREMENTAL:NO /STACK:8388608 RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 900)
    else()
        set(flags -O2)
        if(SANITIZE_GENERATED)
            # Line tables retain sanitizer stack locations without the large
            # full-debug type information of the amalgamated compiler source.
            set(flags -O${BOOTSTRAP_SANITIZER_OPTIMIZATION} -g1 -fsanitize=address,undefined -fno-omit-frame-pointer)
        endif()
        execute_process(COMMAND "${HOST_CXX}" -std=c++23 ${flags} "${cpp}" ${ARGN} -pthread -ldl -o "${binary}"
            RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 900)
    endif()
    file(WRITE "${TEST_DIR}/${label}-build.log" "${stdout}${stderr}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Native bootstrap ${label} build failed: ${status}\n${stdout}${stderr}")
    endif()
    set(${output} "${binary}" PARENT_SCOPE)
endfunction()
function(emit compiler input label output)
    set(cpp "${TEST_DIR}/${label}.cpp")
    string(TIMESTAMP started "%s" UTC)
    execute_process(COMMAND "${compiler}" "${STDLIB_BUNDLE}" "${RUNTIME}" "${input}" "${cpp}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 300)
    string(TIMESTAMP ended "%s" UTC)
    math(EXPR seconds "${ended}-${started}")
    file(APPEND "${TEST_DIR}/emission-times.txt" "${label}: ${seconds} seconds\n")
    if(NOT status STREQUAL "0" OR NOT stdout STREQUAL "" OR NOT stderr STREQUAL "")
        message(FATAL_ERROR "Wood-written ${label} emission failed: ${status}\n${stdout}${stderr}")
    endif()
    set(${output} "${cpp}" PARENT_SCOPE)
endfunction()

