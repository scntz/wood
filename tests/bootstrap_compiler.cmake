# The self-compiled compiler must also build the existing lexer and parser.
foreach(component IN ITEMS lexer parser)
    if(component STREQUAL "lexer")
        set(entry "${SOURCE_DIR}/bootstrap/src/main.wd")
        set(reference "${LEXER_ORACLE}")
    else()
        set(entry "${SOURCE_DIR}/bootstrap/src/parse_main.wd")
        set(reference "${PARSER_ORACLE}")
    endif()
    emit("${stage2}" "${entry}" "${component}" component_source)
    native_build("${component_source}" "${component}" component_tool)
    # Generators exercise the production frontend themselves. The MSVC Debug
    # ASan oracle is substantially slower than the Release fixture writer.
    set(fixture_timeout 90)
    if(SANITIZE_GENERATED)
        set(fixture_timeout 300)
    endif()
    execute_process(COMMAND "${reference}" --generate "${TEST_DIR}/${component}-fixtures"
        RESULT_VARIABLE status OUTPUT_VARIABLE count ERROR_VARIABLE stderr TIMEOUT ${fixture_timeout})
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${component} fixture generation failed: status=${status}; output=${count}\n${stderr}")
    endif()
    file(GLOB corpus "${TEST_DIR}/${component}-fixtures/*.wd" "${SOURCE_DIR}/bootstrap/src/*.wd" "${SOURCE_DIR}/bootstrap/tests/*.wd")
    set(case_count 0)
    # Batches keep process overhead low and preserve mixed success/error behavior.
    set(batch)
    foreach(source IN LISTS corpus)
        list(APPEND batch "${source}")
        list(LENGTH batch batch_size)
        if(batch_size GREATER_EQUAL 40)
            # Final short batch is handled below.
            execute_process(COMMAND "${component_tool}" ${batch} RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 300)
            execute_process(COMMAND "${reference}" ${batch} RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 300)
            if(NOT actual_status STREQUAL expected_status OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
                file(WRITE "${TEST_DIR}/${component}-failed-inputs.txt" "${batch}")
                file(WRITE "${TEST_DIR}/${component}-failed-actual.txt" "${actual_error}\n${actual}")
                file(WRITE "${TEST_DIR}/${component}-failed-expected.txt" "${expected_error}\n${expected}")
                message(FATAL_ERROR "Self-compiled ${component} differential failed: actual=${actual_status}; expected=${expected_status}; see retained batch outputs")
            endif()
            math(EXPR case_count "${case_count}+${batch_size}")
            set(batch)
        endif()
    endforeach()
    list(LENGTH batch batch_size)
    if(batch_size GREATER 0)
        execute_process(COMMAND "${component_tool}" ${batch} RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 300)
        execute_process(COMMAND "${reference}" ${batch} RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 300)
        if(NOT actual_status STREQUAL expected_status OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
            file(WRITE "${TEST_DIR}/${component}-failed-inputs.txt" "${batch}")
            file(WRITE "${TEST_DIR}/${component}-failed-actual.txt" "${actual_error}\n${actual}")
            file(WRITE "${TEST_DIR}/${component}-failed-expected.txt" "${expected_error}\n${expected}")
            message(FATAL_ERROR "Self-compiled ${component} final differential failed: actual=${actual_status}; expected=${expected_status}; see retained batch outputs")
        endif()
        math(EXPR case_count "${case_count}+${batch_size}")
    endif()
    file(APPEND "${TEST_DIR}/component-counts.txt" "${component}: ${case_count}\n")
endforeach()

file(WRITE "${TEST_DIR}/bad.wd" "fn f():\n    return missing\n")
emit("${seed}" "${SOURCE_DIR}/tests/bootstrap_compiler_application.wd" seed-application seed_app_source)
file(SHA256 "${seed_app_source}" seed_app_hash)
file(SHA256 "${app_source}" stage2_app_hash)
if(NOT seed_app_hash STREQUAL stage2_app_hash)
    message(FATAL_ERROR "Application emission differs between seed and self-compiled compiler")
endif()
execute_process(COMMAND "${stage2}" "${STDLIB_BUNDLE}" "${RUNTIME}" "${TEST_DIR}/bad.wd" "${TEST_DIR}/bad.cpp"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
if(NOT status STREQUAL "1" OR EXISTS "${TEST_DIR}/bad.cpp" OR NOT stderr MATCHES "E3007")
    message(FATAL_ERROR "Rejected-source output contract failed")
endif()
execute_process(COMMAND "${stage2}" "${STDLIB_BUNDLE}" "${RUNTIME}" "${TEST_DIR}/bad.wd" "${source1}"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
file(SHA256 "${source1}" retained_hash)
if(NOT status STREQUAL "2" OR NOT retained_hash STREQUAL hash1)
    message(FATAL_ERROR "Existing-output protection failed")
endif()
string(STRIP "${query_count}" query_count)
string(STRIP "${filter_count}" filter_count)
set(current_hashes)
foreach(source IN LISTS immutable_sources)
    file(SHA256 "${source}" hash)
    list(APPEND current_hashes "${hash}")
endforeach()
if(NOT source_hashes STREQUAL current_hashes)
    message(FATAL_ERROR "Bootstrap inputs changed during validation; fixed-point evidence is invalid")
endif()
file(WRITE "${TEST_DIR}/validation.txt" "stage1/stage2/stage3 identical: ${hash1}\n${query_count} exact body cases (${filter_count})\nself-compiled units, native application, lexer/parser differentials and output protection passed\n")
message(STATUS "Wood bootstrap fixed point ${hash1}; ${query_count} exact integrated semantic cases; native applications and self-compiled lexer/parser passed")
