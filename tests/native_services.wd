import std.path as path
import std.fs as fs

record Payload:
    name: str
    values: list[int]
    extra: str | None

data = Payload("mesh",[1,2,3],None)
assert(json_dump(data) == "{\"extra\":null,\"name\":\"mesh\",\"values\":[1,2,3]}")
assert(json_dump((1,"x",true)) == "[1,\"x\",true]")
assert(json_dump(json_null()) == "null")
assert(json_parse("1") != json_parse("1.0"))
assert(json_float(json_parse("1")) == 1.0)
assert(json_bool(json_parse("true")))
assert(json_str(json_parse("\"\\ud83d\\ude03\"")) == "😃")
value = json_parse("{\"z\":[1,2],\"a\":null}")
assert(keys(json_dict(value)) == ["a","z"])
copy = json_list(json_dict(value)["z"])
append(copy,json(3))
assert(json_dump(value) == "{\"a\":null,\"z\":[1,2]}")
assert(json_dump(copy) == "[1,2,3]")
for input in ["{\"x\":1,\"x\":2}","[1,]","01","1e309","\"\\ud800x\"","\""+byte_string(255)+"\"","["*66+"0"+"]"*66]:
    rejected = false
    try:
        json_parse(input)
    except err:
        assert(err.code == "R4012" and starts_with(err.message,"JSON at byte "))
        rejected = true
    assert(rejected)
for input in ["","1.",".1","1e","nan"," 1","1e9999","1e-9999"]:
    rejected = false
    try:
        float(input)
    except err:
        assert(err.code == "R4003")
        rejected = true
    assert(rejected)
assert(str(float("0.125")) == "0.125")
assert(str(float("-0.0")) == "-0.0")
assert(str(float("5e-324")) == "5e-324")
assert(path.name("a/b.wd") == "b.wd")
assert(path.parent("a/b.wd") == "a")
assert(path.normalize("a/./b/../c") == path.normalize("a/c"))
assert(path.normalize("a/../") == ".")
root = path.resolve(".")
assert(path.is_absolute(root) and path.within(root,root))
assert(path.identity(root) == path.identity("."))
assert(fs.kind(root) == "directory" and path_exists(root))
assert(not path_exists("missing-native-service-file"))
assert(path.within(path.combine(root,"missing-native-service-file"),root))
assert(not path.within(path.combine(path.parent(root),"outside-native-service-file"),root))
names = fs.entries(root,100000)
assert(len(names) > 0)
for i in range(1,len(names)):
    assert(names[i-1] < names[i])
rejected = false
try:
    fs.entries(root,0)
except err:
    rejected = err.code == "R4008"
assert(rejected)
directory = path.combine(root,"native-fs-service-fixture")
assert(fs.kind(directory) == "missing")
assert(fs.make_dirs(path.combine(directory,"a/../b")))
assert(fs.kind(path.combine(directory,"a")) == "directory")
assert(not fs.make_dirs(path.combine(directory,"b")))
file = path.combine(directory,"binary.txt")
write_text(file,"a\0b\r\n")
assert(fs.size(file) == 5)
for target in [directory,path.combine(directory,"absent"),"bad\0path"]:
    rejected = false
    try:
        fs.size(target)
    except err:
        rejected = err.code == "R4008"
    assert(rejected)
try:
    fs.make_dirs(path.combine(file,"child"))
    assert(false)
except err:
    assert(err.code == "R4008")
try:
    fs.remove(directory)
    assert(false)
except err:
    assert(err.code == "R4008")
assert(fs.remove(file))
assert(not fs.remove(file))
assert(fs.remove(path.combine(directory,"a")))
assert(fs.remove(path.combine(directory,"b")))
assert(fs.remove(directory))
try:
    path.resolve("bad\0path")
    assert(false)
except err:
    assert(err.code == "R4008" and err.message == "path contains a NUL byte")
print("native compiler services passed")
