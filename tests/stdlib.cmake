cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS WOOD SOURCE_DIR TEST_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Supply ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(work "${TEST_DIR}/run-${id}")
file(MAKE_DIRECTORY "${work}")
set(suffix "")
if(WIN32)
    set(suffix .exe)
    set(cxx cl.exe)
else()
    set(cxx /usr/bin/g++)
endif()
set(checks 0)
function(checked label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${case_dir}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300 ENCODING UTF-8)
    file(WRITE "${work}/${label}.stdout" "${out}")
    file(WRITE "${work}/${label}.stderr" "${err}")
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}: ${out}${err}")
    endif()
    math(EXPR count "${checks}+1")
    set(checks ${count} PARENT_SCOPE)
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()
set(backends primary)
if(DEFINED PRODUCTION)
    list(APPEND backends reference)
endif()
set(fixtures binary generic_records csv native_services functional native_computing
            obj_import closures_iterators statistics_edges stdlib_contracts stdlib_numerical_edges
            time utf8 streams json_values native_text environment random task_checkpoint)
list(LENGTH fixtures source_count)
foreach(level IN ITEMS 0 2)
    foreach(case IN LISTS fixtures)
        set(reference_output "")
        foreach(backend IN LISTS backends)
            set(label "${case}-${backend}-O${level}")
            set(case_dir "${work}/${label}")
            file(MAKE_DIRECTORY "${case_dir}")
            set(compiler "${WOOD}")
            set(flags)
            if(backend STREQUAL "reference")
                set(compiler "${PRODUCTION}")
                list(APPEND flags --cxx "${cxx}")
            endif()
            set(program "${case_dir}/app${suffix}")
            checked(${label}-build 0 "${compiler}" build "${SOURCE_DIR}/tests/${case}.wd" -O${level} ${flags} -o "${program}")
            set(arguments)
            if(case STREQUAL "obj_import")
                list(APPEND arguments "${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj")
            endif()
            checked(${label}-run 0 "${CMAKE_COMMAND}" -E env --unset=WOOD_STDLIB_ABSENT_53c69ef0
                "WOOD_STDLIB_EMPTY=" "WOOD_STDLIB_VALUE=hé🌳=value" "WOOD_STDLIB_🌳=unicode-key" "${program}" ${arguments})
            if(NOT err STREQUAL "")
                message(FATAL_ERROR "${label} wrote unexpected stderr: ${err}")
            endif()
            if(backend STREQUAL "primary")
                set(reference_output "${out}")
            elseif(NOT out STREQUAL reference_output)
                message(FATAL_ERROR "${case} O${level} differs between backends: ${reference_output}${out}")
            endif()
        endforeach()
    endforeach()
endforeach()
foreach(backend IN LISTS backends)
    set(case_dir "${work}/application-${backend}")
    file(MAKE_DIRECTORY "${case_dir}")
    set(compiler "${WOOD}")
    set(flags)
    if(backend STREQUAL "reference")
        set(compiler "${PRODUCTION}")
        list(APPEND flags --cxx "${cxx}")
    endif()
    file(WRITE "${case_dir}/input.csv" "name|quantity\napple|2\npear|4\napple|5\n")
    checked(${backend}-application-build 0 "${compiler}" build "${SOURCE_DIR}/examples/configured_report.wd" -O2 ${flags} -o "${case_dir}/report${suffix}")
    checked(${backend}-application-run 0 "${CMAKE_COMMAND}" -E env "WOOD_CSV_DELIMITER=|" "${case_dir}/report${suffix}" "${case_dir}/input.csv" "${case_dir}/report.json")
    file(READ "${case_dir}/report.json" report)
    if(NOT report STREQUAL "{\"apple\":7,\"pear\":4}\n")
        message(FATAL_ERROR "Configured CSV/JSON report differs: ${report}")
    endif()
    checked(${backend}-no-overwrite 70 "${CMAKE_COMMAND}" -E env "WOOD_CSV_DELIMITER=|" "${case_dir}/report${suffix}" "${case_dir}/input.csv" "${case_dir}/report.json")
    file(READ "${case_dir}/report.json" after)
    if(NOT after STREQUAL report)
        message(FATAL_ERROR "Existing report overwritten")
    endif()
    file(WRITE "${case_dir}/bad.csv" "name,quantity\napple,bad\n")
    checked(${backend}-invalid-input 70 "${CMAKE_COMMAND}" -E env --unset=WOOD_CSV_DELIMITER "${case_dir}/report${suffix}" "${case_dir}/bad.csv" "${case_dir}/must-not-exist.json")
    if(EXISTS "${case_dir}/must-not-exist.json")
        message(FATAL_ERROR "Invalid input created output")
    endif()
    foreach(source IN ITEMS "env_get(1)\n" "env_get()\n")
        file(WRITE "${case_dir}/bad.wd" "${source}")
        checked(${backend}-invalid-call 1 "${compiler}" check "${case_dir}/bad.wd" --diagnostics=json)
        if(NOT err MATCHES "E300[23]")
            message(FATAL_ERROR "Missing structured environment type/arity error: ${err}")
        endif()
    endforeach()
endforeach()
if(DEFINED PRODUCTION)
    set(case_dir "${work}/selfhost-cpp")
    file(MAKE_DIRECTORY "${case_dir}")
    # An LLVM-only installation intentionally omits the optional C++ prelude.
    # Exercise the documented opt-in profile in private data, preserving the
    # original installation and proving that normal LLVM needs no C++ assets.
    if(NOT DEFINED CPP_RUNTIME OR CPP_RUNTIME STREQUAL "")
        get_filename_component(reference_bin "${PRODUCTION}" DIRECTORY)
        set(CPP_RUNTIME "${reference_bin}/bootstrap-runtime.hpp")
    endif()
    if(NOT EXISTS "${CPP_RUNTIME}")
        message(FATAL_ERROR "Supply matching CPP_RUNTIME for explicit self-hosted C++ validation")
    endif()
    get_filename_component(native_bin "${WOOD}" DIRECTORY)
    get_filename_component(native_prefix "${native_bin}" DIRECTORY)
    set(cpp_home "${case_dir}/optional-cpp/share/wood")
    file(COPY "${native_prefix}/share/wood/" DESTINATION "${cpp_home}")
    file(COPY_FILE "${CPP_RUNTIME}" "${cpp_home}/runtime.hpp")
    file(MAKE_DIRECTORY "${case_dir}/optional-cpp/bin")
    set(cpp_driver "${case_dir}/optional-cpp/bin/wood${suffix}")
    file(COPY_FILE "${WOOD}" "${cpp_driver}")
    checked(selfhost-cpp-environment-build 0 "${cpp_driver}" build "${SOURCE_DIR}/tests/environment.wd"
        --backend=cpp --cxx "${cxx}" -O2 -o "${case_dir}/app${suffix}")
    checked(selfhost-cpp-environment-run 0 "${CMAKE_COMMAND}" -E env --unset=WOOD_STDLIB_ABSENT_53c69ef0
        "WOOD_STDLIB_EMPTY=" "WOOD_STDLIB_VALUE=hé🌳=value" "WOOD_STDLIB_🌳=unicode-key" "${case_dir}/app${suffix}")
endif()
file(WRITE "${work}/validation.txt" "${checks} commands passed; ${source_count} source fixtures at O0/O2, configured CSV/JSON application, safe output, invalid configuration/calls; backends=${backends}.\n")
message(STATUS "Standard library qualification passed: ${checks} commands; ${work}")
