import native_ffi_alias as other
extern fn wood_saturating_add(left:int,right:int) -> int
fn first(value:int) -> int:
    return value+1
fn second(value:int) -> int:
    return value+1
functions = [first,second,first]
assert(functions[0] != functions[1])
assert(functions[0] == functions[2])
foreign = [wood_saturating_add,other.wood_saturating_add,wood_saturating_add]
assert(foreign[0] != foreign[1])
assert(foreign[0] == foreign[2])
assert(foreign[0](20,22) == 42 and foreign[1](20,22) == 42)
print("function declaration identity passed")
