cmake_minimum_required(VERSION 3.25)

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}/space & á 🌳")
function(invoke expected_status working_directory)
    execute_process(COMMAND "${WOOD}" ${ARGN} WORKING_DIRECTORY "${working_directory}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90 ENCODING UTF-8)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
function(check_manifest project expected_name)
    file(READ "${project}/wood.json" manifest)
    foreach(field IN ITEMS format name version source entry tests dependencies)
        string(JSON value_${field} GET "${manifest}" "${field}")
    endforeach()
    if(NOT value_format EQUAL 1 OR NOT value_name STREQUAL expected_name
       OR NOT value_version STREQUAL "0.1.0" OR NOT value_source STREQUAL "src"
       OR NOT value_entry STREQUAL "main.wd" OR NOT value_tests STREQUAL "tests")
        message(FATAL_ERROR "Invalid initialized manifest: ${manifest}")
    endif()
    string(JSON dependencies LENGTH "${manifest}" dependencies)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${project}" "${project}/*")
    list(SORT files)
    if(NOT dependencies EQUAL 0 OR NOT files STREQUAL "src/greeting.wd;src/main.wd;tests/test_greeting.wd;wood.json")
        message(FATAL_ERROR "Unexpected project scaffold: ${files}")
    endif()
endfunction()
function(check_error)
    string(JSON fields LENGTH "${last_error}")
    string(JSON code GET "${last_error}" code)
    string(JSON severity GET "${last_error}" severity)
    if(NOT fields EQUAL 6 OR NOT code STREQUAL "D5001" OR NOT severity STREQUAL "error"
       OR NOT last_output STREQUAL "")
        message(FATAL_ERROR "Invalid init error: ${last_output}\n${last_error}")
    endif()
endfunction()

# All three invocation forms create, build and execute an actual native project.
foreach(mode IN ITEMS named implicit explicit)
    set(project "${TEST_DIR}/space & á 🌳/${mode}_app")
    if(mode STREQUAL "named")
        invoke(0 "${TEST_DIR}" init "${project}")
    else()
        file(MAKE_DIRECTORY "${project}")
        if(mode STREQUAL "implicit")
            invoke(0 "${project}" init)
        else()
            invoke(0 "${project}" init .)
        endif()
    endif()
    if(NOT last_error STREQUAL "" OR NOT last_output MATCHES "Created wood project in "
       OR NOT last_output MATCHES "wood run\n  wood build\n  wood test\n")
        message(FATAL_ERROR "Missing clean init success/next steps: ${last_output}\n${last_error}")
    endif()
    check_manifest("${project}" "${mode}_app")
    invoke(0 "${project}" check --cxx not-a-real-toolchain)
    invoke(0 "${project}" run)
    if(NOT last_output STREQUAL "hello, wood\n")
        message(FATAL_ERROR "Default initialized application failed: ${last_output}")
    endif()
    invoke(0 "${project}" build)
    if(WIN32)
        set(executable "${project}/build/${mode}_app.exe")
    else()
        set(executable "${project}/build/${mode}_app")
    endif()
    execute_process(COMMAND "${executable}" "project user" RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15 ENCODING UTF-8)
    if(NOT status EQUAL 0 OR NOT output STREQUAL "hello, project user\n" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Generated standalone application failed: ${status}\n${output}\n${error}")
    endif()
    invoke(0 "${project}" test --report=json)
    string(JSON passed GET "${last_output}" passed)
    string(JSON failed GET "${last_output}" failed)
    if(NOT passed EQUAL 1 OR NOT failed EQUAL 0)
        message(FATAL_ERROR "Generated project test failed: ${last_output}")
    endif()
    invoke(0 "${project}" lock)
    invoke(0 "${project}" check --locked)
    # Reinitialization must preserve every existing file, including build/lock data.
    file(GLOB_RECURSE before LIST_DIRECTORIES false RELATIVE "${project}" "${project}/*")
    foreach(file IN LISTS before)
        file(SHA256 "${project}/${file}" hash_${file})
    endforeach()
    invoke(2 "${project}" init --diagnostics=json)
    check_error()
    file(GLOB_RECURSE after LIST_DIRECTORIES false RELATIVE "${project}" "${project}/*")
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Rejected init changed the existing file inventory")
    endif()
    foreach(file IN LISTS after)
        file(SHA256 "${project}/${file}" actual_hash)
        if(NOT actual_hash STREQUAL hash_${file})
            message(FATAL_ERROR "Rejected init changed ${file}")
        endif()
    endforeach()
endforeach()

# Trailing separators must preserve the directory's name, not stage inside it.
file(MAKE_DIRECTORY "${TEST_DIR}/my-app")
invoke(0 "${TEST_DIR}" init "${TEST_DIR}/my-app/")
check_manifest("${TEST_DIR}/my-app" my_app)
foreach(name IN ITEMS std 123app)
    invoke(0 "${TEST_DIR}" init "${name}")
    check_manifest("${TEST_DIR}/${name}" wood_app)
endforeach()

file(WRITE "${TEST_DIR}/occupied-file" "keep file bytes")
file(MAKE_DIRECTORY "${TEST_DIR}/occupied-directory")
file(WRITE "${TEST_DIR}/occupied-directory/.keep" "keep hidden bytes")
foreach(target IN ITEMS occupied-file occupied-directory missing-parent/app occupied-file/child)
    invoke(2 "${TEST_DIR}" init "${target}" --diagnostics=json)
    check_error()
endforeach()
if(WIN32)
    invoke(2 "${TEST_DIR}" init "bad<name" --diagnostics=json)
    check_error()
endif()
file(READ "${TEST_DIR}/occupied-file" preserved_file)
file(READ "${TEST_DIR}/occupied-directory/.keep" preserved_hidden)
if(NOT preserved_file STREQUAL "keep file bytes" OR NOT preserved_hidden STREQUAL "keep hidden bytes"
   OR EXISTS "${TEST_DIR}/missing-parent")
    message(FATAL_ERROR "Rejected init changed user files or created missing parents")
endif()
invoke(2 "${TEST_DIR}" init first second --diagnostics=json)
check_error()
if(EXISTS "${TEST_DIR}/first" OR EXISTS "${TEST_DIR}/second")
    message(FATAL_ERROR "Invalid init arity created a project")
endif()
# Preserve an explicitly empty OS argument rather than expanding it as a CMake list.
file(MAKE_DIRECTORY "${TEST_DIR}/empty-argument")
execute_process(COMMAND "${WOOD}" init "" --diagnostics=json
    WORKING_DIRECTORY "${TEST_DIR}/empty-argument" RESULT_VARIABLE status
    OUTPUT_VARIABLE last_output ERROR_VARIABLE last_error TIMEOUT 15 ENCODING UTF-8)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "Explicitly empty init target was accepted")
endif()
check_error()
file(GLOB contents "${TEST_DIR}/empty-argument/*")
if(contents)
    message(FATAL_ERROR "Empty argument initialized the working directory")
endif()

file(MAKE_DIRECTORY "${TEST_DIR}/link-destination")
if(WIN32)
    file(TO_NATIVE_PATH "${TEST_DIR}/linked" link_path)
    file(TO_NATIVE_PATH "${TEST_DIR}/link-destination" destination_path)
    execute_process(COMMAND cmd /d /c mklink /J "${link_path}" "${destination_path}"
        RESULT_VARIABLE link_status OUTPUT_VARIABLE link_output ERROR_VARIABLE link_error)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink
        "${TEST_DIR}/link-destination" "${TEST_DIR}/linked" RESULT_VARIABLE link_status)
endif()
if(link_status EQUAL 0)
    invoke(2 "${TEST_DIR}" init linked --diagnostics=json)
    check_error()
    if(NOT last_error MATCHES "filesystem link" OR EXISTS "${TEST_DIR}/link-destination/wood.json")
        message(FATAL_ERROR "Init did not safely reject a linked target: ${last_error}")
    endif()
    message(STATUS "Linked init target rejected; destination unchanged")
else()
    message(STATUS "Init link rejection untested: ${link_error}")
endif()
file(GLOB staging "${TEST_DIR}/wood-*" "${TEST_DIR}/space & á 🌳/wood-*")
if(staging)
    message(FATAL_ERROR "Init left staging directories: ${staging}")
endif()
message(STATUS "Named/current-directory init, native builds/runs/tests, naming and no-overwrite failures passed")
