# Shared independent expected totals, not the production compiler's output.
file(WRITE "${TEST_DIR}/sales.csv" "category,quantity,unit_cents\nNorth,2,125\nSouth,4,99\nNorth,3,50\n\"East, coast\",2,1000\nSouth,1,0\n")
execute_process(COMMAND "${sales_report}" "${TEST_DIR}/sales.csv" "${TEST_DIR}/sales.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE stderr TIMEOUT 60)
if(NOT status STREQUAL "0" OR NOT actual STREQUAL "" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Sales application failed: ${status}\n${actual}${stderr}")
endif()
file(READ "${TEST_DIR}/sales.json" report)
string(JSON north GET "${report}" categories 0 total_cents)
string(JSON south GET "${report}" categories 1 total_cents)
string(JSON east GET "${report}" categories 2 total_cents)
string(JSON first_name GET "${report}" categories 0 category)
string(JSON last_name GET "${report}" categories 2 category)
string(JSON north_count GET "${report}" categories 0 entries)
string(JSON south_count GET "${report}" categories 1 entries)
string(JSON total GET "${report}" total_cents)
string(JSON regions LENGTH "${report}" categories)
if(NOT north EQUAL 400 OR NOT south EQUAL 396 OR NOT east EQUAL 2000 OR NOT regions EQUAL 3 OR
   NOT first_name STREQUAL "North" OR NOT last_name STREQUAL "East, coast" OR NOT north_count EQUAL 2 OR
   NOT south_count EQUAL 2 OR NOT total EQUAL 2796)
    message(FATAL_ERROR "Incorrect independent sales totals: ${report}")
endif()
string(REPEAT "North,1000000,1000000000\n" 10000 overflow_rows)
foreach(invalid IN ITEMS "category,quantity,unit_cents\nNorth,-1,100\n" "category,quantity,unit_cents\nNorth,no,100\n" "category,quantity,unit_cents\nNorth,9223372036854775807,2\n" "category,quantity,unit_cents\nNorth,1\n" "category,quantity,unit_cents\n${overflow_rows}")
    file(WRITE "${TEST_DIR}/sales-invalid.csv" "${invalid}")
    execute_process(COMMAND "${sales_report}" "${TEST_DIR}/sales-invalid.csv" "${TEST_DIR}/sales.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE stderr TIMEOUT 60)
    file(READ "${TEST_DIR}/sales.json" preserved)
    if(NOT status STREQUAL "70" OR NOT actual STREQUAL "" OR NOT preserved STREQUAL report)
        message(FATAL_ERROR "Invalid sales input did not fail/preserve report: ${status}\n${actual}${stderr}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/sales-empty.csv" "category,quantity,unit_cents\n")
execute_process(COMMAND "${sales_report}" "${TEST_DIR}/sales-empty.csv" "${TEST_DIR}/sales-empty.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE stderr TIMEOUT 60)
file(READ "${TEST_DIR}/sales-empty.json" empty)
string(JSON empty_total GET "${empty}" total_cents)
string(JSON empty_categories LENGTH "${empty}" categories)
if(NOT status STREQUAL "0" OR NOT actual STREQUAL "" OR NOT empty_total EQUAL 0 OR NOT empty_categories EQUAL 0 OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Empty sales report failed: ${status}\n${actual}${stderr}")
endif()
