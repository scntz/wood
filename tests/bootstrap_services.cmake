# Every frontend/emitter invocation uses the self-compiled stage2 executable.
foreach(item IN ITEMS sqlite tasks streams http bootstrap_resources)
    emit("${stage2}" "${SOURCE_DIR}/tests/${item}.wd" "services-${item}" cpp)
    native_build("${cpp}" "services-${item}" executable)
    if(item STREQUAL "sqlite")
        set(expected "native SQLite passed\n")
    elseif(item STREQUAL "tasks")
        set(expected "native tasks passed\n")
    elseif(item STREQUAL "streams")
        set(expected "native streams passed\n")
    elseif(item STREQUAL "http")
        set(expected "native HTTP passed\n")
    else()
        set(expected "native hosted resource scopes passed\n")
    endif()
    execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        WORKING_DIRECTORY "${TEST_DIR}" TIMEOUT 120)
    if(NOT status STREQUAL "0" OR NOT output STREQUAL expected OR NOT error STREQUAL "")
        message(FATAL_ERROR "Staged native service ${item} failed: ${status}\n${output}${error}")
    endif()
endforeach()
emit("${stage2}" "${SOURCE_DIR}/examples/backend.wd" services-backend cpp)
native_build("${cpp}" services-backend server)
emit("${stage2}" "${SOURCE_DIR}/examples/https_client.wd" services-https-client cpp)
native_build("${cpp}" services-https-client client)
file(MAKE_DIRECTORY "${TEST_DIR}/services-apps")
execute_process(COMMAND "${BACKEND_TEST}" apps "${SOURCE_DIR}/tests/fixtures/tls" "${server}" "${client}" "${TEST_DIR}/services-apps"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 150)
file(WRITE "${TEST_DIR}/services-apps-result.txt" "status=${status}\n${output}${error}")
if(status STREQUAL "77")
    message(STATUS "Staged HTTPS application NOT VALIDATED: optional TLS library unavailable: ${output}")
elseif(NOT status STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Staged HTTPS/SQLite/threaded application failed: ${status}\n${output}${error}")
else()
    message(STATUS "Staged independently checked HTTPS/SQLite/threaded application: ${output}")
endif()
message(STATUS "Staged SQLite, tasks, TCP/HTTP and native resource regression suites passed")
