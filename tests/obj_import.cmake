string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/OBJ á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(fixture "${SOURCE_DIR}/tests/fixtures/obj/tetrahedron.obj")
function(invoke expected)
    set(arguments ${ARGN})
    if(SANITIZE_GENERATED AND (ARGV1 STREQUAL "build" OR ARGV1 MATCHES "[.]wd$"))
        list(FIND arguments "--" boundary)
        if(boundary EQUAL -1)
            list(APPEND arguments --sanitize=address)
        else()
            list(INSERT arguments ${boundary} --sanitize=address)
        endif()
    endif()
    execute_process(COMMAND "${WOOD}" ${arguments} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180 ENCODING UTF-8
        WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${SOURCE_DIR}/tests/obj_import.wd" "${level}" -- "${fixture}")
    if(NOT last_output STREQUAL "OBJ importing passed\n")
        message(FATAL_ERROR "Unexpected OBJ corpus output: ${last_output}")
    endif()
endforeach()
if(WIN32)
    set(executable "${TEST_DIR}/mesh-import.exe")
else()
    set(executable "${TEST_DIR}/mesh-import")
endif()
invoke(0 build "${SOURCE_DIR}/examples/mesh_import.wd" -O2 -o "${executable}")
execute_process(COMMAND "${executable}" "${fixture}" "${TEST_DIR}/output.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Mesh import application failed: ${output}\n${error}")
endif()
# Final line is a structured report; first line demonstrates geometry inspection.
string(REGEX MATCH "[{][^\n]+[}]" report "${output}")
string(JSON vertices GET "${report}" vertices)
string(JSON triangles GET "${report}" triangles)
if(NOT vertices EQUAL 4 OR NOT triangles EQUAL 4)
    message(FATAL_ERROR "Incorrect application report: ${output}")
endif()
invoke(0 "${SOURCE_DIR}/tests/mesh_transform_verify.wd" -- "${fixture}" "${TEST_DIR}/output.obj")
file(WRITE "${TEST_DIR}/malformed.obj" "f 1 2 3\n")
file(WRITE "${TEST_DIR}/preserve.obj" "preserve")
execute_process(COMMAND "${executable}" "${TEST_DIR}/malformed.obj" "${TEST_DIR}/preserve.obj"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
file(READ "${TEST_DIR}/preserve.obj" preserved)
if(NOT status EQUAL 70 OR NOT preserved STREQUAL "preserve")
    message(FATAL_ERROR "Invalid import changed output: ${status}\n${error}")
endif()
message(STATUS "OBJ O0/O2 corpus, standalone load/transform/export and output-preservation checks passed")
