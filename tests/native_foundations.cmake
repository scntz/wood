string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected_status)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 180 ENCODING UTF-8 WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${SOURCE_DIR}/tests/binary.wd" "${level}")
    invoke(0 "${SOURCE_DIR}/tests/utf8.wd" "${level}")
endforeach()
file(COPY "${SOURCE_DIR}/examples/archive" DESTINATION "${TEST_DIR}")
invoke(0 lock "${TEST_DIR}/archive")
invoke(0 test "${TEST_DIR}/archive" --locked --report=json)
string(JSON passed GET "${last_output}" passed)
if(NOT passed EQUAL 1)
    message(FATAL_ERROR "Archive tests were not discovered")
endif()
file(WRITE "${TEST_DIR}/numbers.txt" "1\n-2\n-9223372036854775808\n")
invoke(0 run "${TEST_DIR}/archive" --locked -- pack "${TEST_DIR}/numbers.txt" "${TEST_DIR}/archive.bin")
file(READ "${TEST_DIR}/archive.bin" bytes HEX)
if(NOT bytes STREQUAL "574441540001000000030100000000000000feffffffffffffff0000000000000080")
    message(FATAL_ERROR "Archive byte representation mismatch: ${bytes}")
endif()
if(WIN32)
    set(exe "${TEST_DIR}/archive.exe")
else()
    set(exe "${TEST_DIR}/archive-cli")
endif()
invoke(0 build "${TEST_DIR}/archive" --locked -o "${exe}")
execute_process(COMMAND "${exe}" unpack "${TEST_DIR}/archive.bin" "${TEST_DIR}/numbers.json"
    RESULT_VARIABLE status TIMEOUT 30)
file(READ "${TEST_DIR}/numbers.json" numbers)
if(NOT status EQUAL 0 OR NOT numbers STREQUAL "[1,-2,-9223372036854775808]\n")
    message(FATAL_ERROR "Standalone archive result mismatch: ${numbers}")
endif()
file(WRITE "${TEST_DIR}/unicode.txt" "Aá🌳A")
invoke(0 "${SOURCE_DIR}/examples/unicode_report.wd" -- "${TEST_DIR}/unicode.txt" "${TEST_DIR}/unicode.json")
file(READ "${TEST_DIR}/unicode.json" report)
string(JSON count GET "${report}" codepoints)
string(JSON bytes GET "${report}" bytes)
string(JSON frequency GET "${report}" characters 0 count)
string(JSON scalar GET "${report}" characters 2 codepoint)
if(NOT count EQUAL 4 OR NOT bytes EQUAL 8 OR NOT frequency EQUAL 2 OR NOT scalar EQUAL 127795)
    message(FATAL_ERROR "Unicode application result mismatch: ${report}")
endif()
string(ASCII 255 invalid_utf8)
file(WRITE "${TEST_DIR}/invalid.txt" "${invalid_utf8}")
invoke(1 "${SOURCE_DIR}/examples/unicode_report.wd" -- "${TEST_DIR}/invalid.txt" "${TEST_DIR}/unicode.json")
if(NOT last_error MATCHES "R4010")
    message(FATAL_ERROR "Unicode validation error was not handled")
endif()
file(READ "${TEST_DIR}/unicode.json" preserved)
if(NOT preserved STREQUAL report)
    message(FATAL_ERROR "Invalid input replaced a valid Unicode report")
endif()
message(STATUS "Native binary formats, all Unicode scalars, archive CLI and Unicode report passed")
