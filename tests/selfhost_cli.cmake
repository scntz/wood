cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/CLI á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${WOOD}" "${SOURCE_DIR}/bootstrap/tests/test_driver_cli.wd" -O0
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180 ENCODING UTF-8)
if(NOT status STREQUAL "0" OR NOT out STREQUAL "driver CLI checks passed\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Driver UTF-8/argument/limit units failed: ${status}: ${out}${err}")
endif()
execute_process(COMMAND "${WOOD}" check "${TEST_DIR}/missing-árbol.wd" --diagnostics=json
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60 ENCODING UTF-8)
if(NOT status STREQUAL "2" OR NOT out STREQUAL "")
    message(FATAL_ERROR "Missing Unicode input must be a driver error: ${status}: ${out}${err}")
endif()
string(JSON code GET "${err}" code)
string(JSON count LENGTH "${err}")
if(NOT code STREQUAL "D5001" OR NOT count EQUAL 6)
    message(FATAL_ERROR "Invalid JSON diagnostic contract: ${err}")
endif()
message(STATUS "Driver UTF-8 fallback, numeric limits and argv boundaries passed")
