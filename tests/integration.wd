fn mark(n: int) -> int:
    print(n)
    return n

fn subtract(a: int, b: int) -> int:
    return a - b

fn fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn explode() -> bool:
    assert(false, "short circuit failed")
    return true

fn choose(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

fn widen(n: int) -> float:
    return n

fn accept_float(n: float) -> float:
    return n

fn switch(class: int) -> int:
    return class

assert(fib(10) == 55)
assert(choose(-1) == "negative")
assert(choose(0) == "zero")
assert(choose(1) == "positive")
assert(widen(2) == 2.0)
assert(accept_float(2) == 2.0)
assert(switch(3) == 3)
assert("a" < "b")
assert("ab" + "cd" == "abcd")
assert(len("\"'\\\n\t\r\0") == 7)
assert(not (false and explode()))
assert(true or explode())
assert(-7 // 3 == -3)
assert(-7 % 3 == 2)
assert(7 % -3 == -2)
assert(5 / 2 == 2.5)
assert(0009 == 9)
assert(-9223372036854775808 % -1 == 0)
assert(len("a\0b") == 3)
assert(len("árbol") == 6)
assert(str(true) == "true")
assert(int(-2.9) == -2)
x: float = 1
x = 2
assert(x == 2.0)
total = 0
for i in range(10):
    if i == 3:
        continue
    if i == 7:
        break
    total = total + i
assert(total == 18)
i = 10
for i in range(3, 0, -1):
    assert(i > 0)
assert(i == 10)
count = 0
for j in range(9223372036854775806, 9223372036854775807, 2):
    count = count + 1
for j in range(-9223372036854775807, -9223372036854775808, -2):
    count = count + 1
assert(count == 2)
while count > 0:
    count = count - 1
assert(count == 0)
print(subtract(mark(1), mark(2)))
print(mark(3) + mark(4))
for k in range(mark(0), mark(2), mark(1)):
    pass
print("native ok", fib(10), true, 2.5)
