function(inventory input label)
    execute_process(COMMAND "${BASELINE_COMPILER}" deps "${input}" ${ARGN} RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE err TIMEOUT 90)
    execute_process(COMMAND "${project_tool}" "${STDLIB_BUNDLE}" "${input}" ${ARGN} RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 90)
    if(NOT expected_status STREQUAL "0" OR NOT actual_status STREQUAL "0" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "")
        message(FATAL_ERROR "${label} inventory differs: ${expected_status}/${actual_status}\n${err}${actual_error}\nEXPECTED ${expected}\nACTUAL ${actual}")
    endif()
    file(WRITE "${TEST_DIR}/${label}-inventory.json" "${actual}")
endfunction()
function(failure input label pattern)
    set(output "${TEST_DIR}/${label}.cpp")
    execute_process(COMMAND "${CANDIDATE}" "${STDLIB_BUNDLE}" "${RUNTIME}" "${input}" "${output}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
    if(NOT status STREQUAL "2" OR NOT out STREQUAL "" OR NOT err MATCHES "\"code\":\"D5001\"" OR NOT err MATCHES "${pattern}" OR EXISTS "${output}")
        message(FATAL_ERROR "${label} expected driver rejection/no output; got ${status}: ${out}${err}")
    endif()
endfunction()
