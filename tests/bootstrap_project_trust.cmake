function(native_build cpp label output)
    set(binary "${TEST_DIR}/${label}")
    if(WIN32)
        string(APPEND binary ".exe")
    endif()
    if(HOST_MSVC)
        set(flags)
        if(SANITIZE_GENERATED)
            set(flags /fsanitize=address /Zi)
        endif()
        execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /O2 /MD /EHsc /utf-8 /permissive- /bigobj
            ${flags} "/Fo:${TEST_DIR}/${label}.obj" "/Fd:${TEST_DIR}/${label}.pdb" "/Fe:${binary}" "${cpp}"
            /link /INCREMENTAL:NO /STACK:8388608 RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900)
    else()
        set(flags -O2)
        if(SANITIZE_GENERATED)
            set(flags -O0 -g1 -fsanitize=address,undefined -fno-omit-frame-pointer)
        endif()
        execute_process(COMMAND "${HOST_CXX}" -std=c++23 ${flags} "${cpp}" -pthread -ldl -o "${binary}"
            RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900)
    endif()
    file(WRITE "${TEST_DIR}/${label}-build.log" "${out}${err}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${label} build failed (${status}): ${out}${err}")
    endif()
    set(${output} "${binary}" PARENT_SCOPE)
endfunction()
function(emit compiler input label output)
    set(cpp "${TEST_DIR}/${label}.cpp")
    execute_process(COMMAND "${compiler}" "${STDLIB_BUNDLE}" "${RUNTIME}" "${input}" "${cpp}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
    if(NOT status STREQUAL "0" OR NOT out STREQUAL "" OR NOT err STREQUAL "")
        message(FATAL_ERROR "${label} emission failed (${status}): ${out}${err}")
    endif()
    set(${output} "${cpp}" PARENT_SCOPE)
endfunction()
