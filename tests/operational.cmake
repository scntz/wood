string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected_status)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 120 ENCODING UTF-8 WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
invoke(0 init "${TEST_DIR}/app")
file(REMOVE "${TEST_DIR}/app/tests/test_greeting.wd")
file(WRITE "${TEST_DIR}/app/tests/test_a_flood.wd" "for i in range(10000):\n    print('xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx')\n")
file(WRITE "${TEST_DIR}/app/tests/test_b_ok.wd" "print('continued after output limit')\n")
invoke(1 test "${TEST_DIR}/app" --max-output-bytes 1024 --report=json)
string(JSON passed GET "${last_output}" passed)
string(JSON failed GET "${last_output}" failed)
string(JSON code GET "${last_output}" tests 0 driver_error)
string(JSON second GET "${last_output}" tests 1 output)
if(NOT passed EQUAL 1 OR NOT failed EQUAL 1 OR NOT code STREQUAL "D5004" OR NOT second MATCHES "continued")
    message(FATAL_ERROR "Bounded output/test continuation failed: ${last_output}")
endif()
file(WRITE "${TEST_DIR}/preserved.bin" "unchanged")
invoke(2 build "${SOURCE_DIR}/examples/hello.wd" --timeout-ms 1 --diagnostics=json -o "${TEST_DIR}/preserved.bin")
string(JSON code GET "${last_error}" code)
file(READ "${TEST_DIR}/preserved.bin" preserved)
if(NOT code STREQUAL "D5003" OR NOT preserved STREQUAL "unchanged")
    message(FATAL_ERROR "Compiler timeout/artifact preservation failed: ${last_error}")
endif()
foreach(value IN ITEMS -1 invalid 86400001)
    invoke(2 check "${SOURCE_DIR}/examples/hello.wd" --timeout-ms "${value}" --diagnostics=json)
    string(JSON code GET "${last_error}" code)
    if(NOT code STREQUAL "D5001")
        message(FATAL_ERROR "Invalid timeout was accepted")
    endif()
endforeach()
invoke(2 check "${SOURCE_DIR}/examples/hello.wd" --max-output-bytes 0)
message(STATUS "Real process limits, test continuation, CLI validation and artifact preservation passed")
