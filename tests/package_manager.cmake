# Git tree entries that an ordinary checkout would materialize dangerously.
function(tree_entry name mode object path)
    set(dir "${WORK}/authors/${name}")
    raw_library("${dir}" ${name} 1.0.0)
    publish("${dir}" evil ${name})
    if(NOT mode STREQUAL "160000")
        execute_process(COMMAND "${git}" -C "${dir}" hash-object -w wood.json OUTPUT_VARIABLE object OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    expect(entry-${name} 0 "${git}" -c core.protectNTFS=false -C "${dir}" update-index --add --cacheinfo "${mode},${object},${path}")
    expect(entry-commit-${name} 0 "${git}" -c core.protectNTFS=false -C "${dir}" commit -qm hostile)
    expect(entry-push-${name} 0 "${git}" -C "${dir}" push -q origin main)
    set(count "${count}" PARENT_SCOPE)
endfunction()
