function(hostile name code)
    rejects_json(hostile-${name} "${code}" add github@evil/${name} --project "${victim}")
    file(READ "${victim}/wood.json" current)
    if(NOT current STREQUAL victim_manifest OR EXISTS "${victim}/wood.lock" OR EXISTS "${victim}/vendor/evil/${name}")
        message(FATAL_ERROR "${name}: a rejected package changed the project")
    endif()
    set(count "${count}" PARENT_SCOPE)
endfunction()
