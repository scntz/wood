function(bad_entry label code file text)
    get_filename_component(folder "${file}" DIRECTORY)
    file(MAKE_DIRECTORY "${WORK}/bad-catalog/packages/${folder}")
    file(WRITE "${WORK}/bad-catalog/packages/${file}" "${text}")
    rejects_json("catalog ${label}" "${code}" package catalog validate "${WORK}/bad-catalog")
    file(REMOVE_RECURSE "${WORK}/bad-catalog")
    set(count "${count}" PARENT_SCOPE)
endfunction()
