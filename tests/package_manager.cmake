set(ENV{WOOD_CACHE_DIR} "${WORK}/cache")
set(ENV{GIT_CEILING_DIRECTORIES} "${WORK}")
unset(ENV{WOOD_PACKAGE_INDEX})
file(WRITE "${WORK}/home/gitconfig" "[url \"file:///${WORK}/remotes/\"]\n\tinsteadOf = https://github.com/\n[protocol \"file\"]\n\tallow = always\n[user]\n\tname = fixture\n\temail = fixture@example.invalid\n[init]\n\tdefaultBranch = main\n[core]\n\tautocrlf = false\n")
set(count 0)
function(expect label expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(APPEND "${WORK}/commands.log" "== ${label}: ${ARGN}\nstatus=${status}\n${out}${err}\n")
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${status}\n${out}${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()
function(rejects label code)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 600)
    file(APPEND "${WORK}/commands.log" "== ${label}: wood ${ARGN}\nstatus=${status}\n${out}${err}\n")
    if("${status}" STREQUAL "0" OR NOT "${out}${err}" MATCHES "${code}")
        message(FATAL_ERROR "${label}: expected rejection matching ${code}, got ${status}\n${out}${err}")
    endif()
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()
function(rejects_json label code)
    rejects("${label}" "${code}" ${ARGN} --diagnostics=json)
    set(count "${count}" PARENT_SCOPE)
endfunction()
function(publish directory owner repository)
    file(MAKE_DIRECTORY "${WORK}/remotes/${owner}")
    if(NOT EXISTS "${WORK}/remotes/${owner}/${repository}.git")
        expect(bare-${repository} 0 "${git}" init -q --bare "${WORK}/remotes/${owner}/${repository}.git")
    endif()
    expect(init-${repository} 0 "${git}" -C "${directory}" init -q -b main)
    expect(add-${repository} 0 "${git}" -C "${directory}" add -A)
    expect(commit-${repository} 0 "${git}" -C "${directory}" commit -qm "release")
    expect(remote-${repository} 0 "${git}" -C "${directory}" remote add origin "https://github.com/${owner}/${repository}.git")
    expect(push-${repository} 0 "${git}" -C "${directory}" push -q origin main)
    set(count "${count}" PARENT_SCOPE)
endfunction()
function(tag directory name)
    expect(tag-${name} 0 "${git}" -C "${directory}" tag "${name}")
    expect(push-tag-${name} 0 "${git}" -C "${directory}" push -q -f origin "${name}")
    set(count "${count}" PARENT_SCOPE)
endfunction()
function(head directory output)
    execute_process(COMMAND "${git}" -C "${directory}" rev-parse HEAD OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(raw_library directory name version)
    file(MAKE_DIRECTORY "${directory}/src")
    file(WRITE "${directory}/wood.json" "{\"format\":1,\"name\":\"${name}\",\"version\":\"${version}\",\"source\":\"src\",\"dependencies\":{${ARGN}}}\n")
    file(WRITE "${directory}/src/${name}.wd" "fn value() -> int:\n    return 1\n")
endfunction()

