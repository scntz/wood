# Isolated package-manager qualification with real Git repositories. Git's own
# insteadOf maps https://github.com/ to temporary local bare repositories, so the
# product has no test hook. This is not public-network qualification.
foreach(required IN ITEMS WOOD WORK SOURCE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply -D${required}=<value>")
    endif()
endforeach()
find_program(git NAMES git REQUIRED)
