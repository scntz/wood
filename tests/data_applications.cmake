string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
function(invoke expected_status)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120 ENCODING UTF-8 WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
invoke(0 "${SOURCE_DIR}/tests/compatibility.wd")
foreach(level IN ITEMS -O0 -O2)
    invoke(0 "${SOURCE_DIR}/tests/dictionaries.wd" "${level}")
    if(NOT last_output STREQUAL "key\nvalue\nvalue\nkey\ndictionaries ok\n")
        message(FATAL_ERROR "Dictionary evaluation order mismatch: ${last_output}")
    endif()
    invoke(0 "${SOURCE_DIR}/tests/records.wd" "${level}")
    invoke(0 "${SOURCE_DIR}/tests/json_values.wd" "${level}")
    invoke(0 "${SOURCE_DIR}/tests/csv.wd" "${level}")
endforeach()
set(deep_source "record Box:\n    children: list[Box]\nroot = ")
foreach(i RANGE 1 32)
    string(APPEND deep_source "Box([")
endforeach()
string(APPEND deep_source "Box([])")
foreach(i RANGE 1 32)
    string(APPEND deep_source "])")
endforeach()
string(APPEND deep_source "\ncursor = root\nfor i in range(32):\n    assert(len(cursor.children) == 1)\n    cursor = cursor.children[0]\nassert(cursor.children == [])\n")
file(WRITE "${TEST_DIR}/nested-constructors.wd" "${deep_source}")
invoke(0 "${TEST_DIR}/nested-constructors.wd")
foreach(source IN ITEMS "slice(1, 0, 1)" "slice([1], true, 1)")
    file(WRITE "${TEST_DIR}/bad-slice.wd" "${source}\n")
    invoke(1 check "${TEST_DIR}/bad-slice.wd" --diagnostics=json)
    string(JSON code GET "${last_error}" code)
    if(NOT code STREQUAL "E3002")
        message(FATAL_ERROR "Invalid slice was not rejected: ${last_error}")
    endif()
endforeach()
file(COPY "${SOURCE_DIR}/examples/catalog" "${SOURCE_DIR}/examples/packages" DESTINATION "${TEST_DIR}")
file(REMOVE "${TEST_DIR}/catalog/wood.lock")
invoke(0 lock "${TEST_DIR}/catalog")
invoke(0 test "${TEST_DIR}/catalog" --locked --report=json)
string(JSON passed GET "${last_output}" passed)
if(NOT passed EQUAL 1)
    message(FATAL_ERROR "Catalog tests did not run")
endif()
invoke(0 inspect "${TEST_DIR}/catalog" --locked)
if(NOT last_output MATCHES "StockReport" OR NOT last_output MATCHES "\"fields\"")
    message(FATAL_ERROR "Inspection omitted record fields")
endif()
file(WRITE "${TEST_DIR}/input.json" "[{\"sku\":\"apple\",\"unit_price\":1.5,\"quantity\":4},{\"sku\":\"pear\",\"unit_price\":2,\"quantity\":3}]")
invoke(0 run "${TEST_DIR}/catalog" --locked -- "${TEST_DIR}/input.json" "${TEST_DIR}/report.json")
file(READ "${TEST_DIR}/report.json" report)
string(JSON units GET "${report}" units)
string(JSON value GET "${report}" inventory_value)
string(JSON quantity GET "${report}" products apple quantity)
if(NOT units EQUAL 7 OR NOT value EQUAL 12 OR NOT quantity EQUAL 4)
    message(FATAL_ERROR "Catalog native report mismatch: ${report}")
endif()
if(WIN32)
    set(exe "${TEST_DIR}/catalog.exe")
else()
    set(exe "${TEST_DIR}/catalog-bin")
endif()
invoke(0 build "${TEST_DIR}/catalog" --locked -o "${exe}")
execute_process(COMMAND "${exe}" "${TEST_DIR}/input.json" "${TEST_DIR}/standalone.json" RESULT_VARIABLE status TIMEOUT 30)
file(READ "${TEST_DIR}/standalone.json" standalone)
if(NOT status EQUAL 0 OR NOT standalone STREQUAL report)
    message(FATAL_ERROR "Standalone catalog output mismatch")
endif()
file(WRITE "${TEST_DIR}/invalid.json" "[{\"sku\":\"apple\",\"quantity\":-1,\"unit_price\":1.0}]")
invoke(1 run "${TEST_DIR}/catalog" -- "${TEST_DIR}/invalid.json" "${TEST_DIR}/report.json")
if(NOT last_error MATCHES "R4010")
    message(FATAL_ERROR "Invalid catalog input was not caught")
endif()
file(WRITE "${TEST_DIR}/bad-json.json" "{\"a\":1,\"a\":2}")
invoke(1 run "${TEST_DIR}/catalog" -- "${TEST_DIR}/bad-json.json" "${TEST_DIR}/report.json")
if(NOT last_error MATCHES "R4012")
    message(FATAL_ERROR "Duplicate JSON fields were not rejected")
endif()
message(STATUS "Dictionary/record/JSON native semantics, module exports, inspection and packaged catalog application passed")
