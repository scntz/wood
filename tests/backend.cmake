string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/native á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(extra_flags)
if(SANITIZE_GENERATED)
    list(APPEND extra_flags --sanitize=address)
endif()
function(invoke)
    set(flags)
    if(ARGV0 STREQUAL "build" OR ARGV0 MATCHES "[.]wd$")
        set(flags ${extra_flags})
    endif()
    execute_process(COMMAND "${WOOD}" ${ARGN} ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 150 ENCODING UTF-8 WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "wood ${ARGN}: ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
invoke(--language-info)
string(JSON task_model GET "${last_output}" tasks execution)
string(JSON tls_minimum GET "${last_output}" networking tls_details minimum_version)
if(NOT task_model STREQUAL "joinable native threads" OR NOT tls_minimum STREQUAL "TLS 1.2")
    message(FATAL_ERROR "Missing native backend capability metadata")
endif()
foreach(module IN ITEMS sqlite task tls)
    invoke(inspect "${SOURCE_DIR}/stdlib/${module}.wd")
    string(JSON resource GET "${last_output}" modules 0 exports 0 returns_ref kind)
    if((module STREQUAL "sqlite" AND NOT resource STREQUAL "database") OR
       (module STREQUAL "task" AND NOT resource STREQUAL "task") OR
       (module STREQUAL "tls" AND NOT resource STREQUAL "stream"))
        message(FATAL_ERROR "Inspection lost a native resource type: ${module}: ${resource}")
    endif()
endforeach()
foreach(level IN ITEMS -O0 -O2)
    invoke("${SOURCE_DIR}/tests/sqlite.wd" "${level}")
    if(NOT last_output STREQUAL "native SQLite passed\n")
        message(FATAL_ERROR "SQLite corpus output: ${last_output}")
    endif()
    invoke("${SOURCE_DIR}/tests/tasks.wd" "${level}")
    if(NOT last_output STREQUAL "native tasks passed\n")
        message(FATAL_ERROR "Task corpus output: ${last_output}")
    endif()
endforeach()
if(WIN32)
    set(suffix ".exe")
else()
    set(suffix "")
endif()
invoke(build "${SOURCE_DIR}/examples/backend.wd" -o "${TEST_DIR}/backend${suffix}")
invoke(build "${SOURCE_DIR}/examples/https_client.wd" -o "${TEST_DIR}/client${suffix}")
execute_process(COMMAND "${BACKEND_TEST}" apps "${SOURCE_DIR}/tests/fixtures/tls" "${TEST_DIR}/backend${suffix}"
    "${TEST_DIR}/client${suffix}" "${TEST_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 100)
if(status STREQUAL "77")
    message(STATUS "TLS applications skipped: ${output}")
elseif(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native HTTPS/SQLite application failed: ${status}\n${output}\n${error}")
else()
    message(STATUS "${output}")
    if(PWSH)
        execute_process(COMMAND "${PWSH}" -NoProfile -File "${SOURCE_DIR}/tests/tls_interop.ps1"
            -Server "${TEST_DIR}/backend${suffix}" -Fixtures "${SOURCE_DIR}/tests/fixtures/tls" -Work "${TEST_DIR}/independent"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "Independent TLS interoperability failed: ${output}\n${error}")
        endif()
        message(STATUS "${output}")
    else()
        message(STATUS "Independent .NET TLS test skipped: optional PowerShell 7 not found")
    endif()
endif()
