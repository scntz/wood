# char_count, chars and char_slice work on UTF-8 characters; str, len and indexing stay on bytes.
word = "año"
assert(len(word) == 4 and char_count(word) == 3)
assert(chars(word) == ["a", "ñ", "o"])
assert(char_slice(word, 1, 2) == "ñ" and char_slice(word, 0, 3) == word)
assert(char_slice(word, -2, 10) == "ño" and char_slice(word, -10, 1) == "a")
assert(char_slice(word, 2, 1) == "" and char_slice(word, 5, 9) == "")
assert(char_count("") == 0 and len(chars("")) == 0 and char_slice("", 0, 1) == "")
mixed = "a€😀z"
assert(len(mixed) == 9 and char_count(mixed) == 4)
assert(chars(mixed)[2] == "😀" and char_slice(mixed, 1, 3) == "€😀")
assert(char_slice(mixed, -9223372036854775807 - 1, 9223372036854775807) == mixed)
letters = ""
for character in chars("héllo"):
    letters = character + letters
assert(letters == "olléh")
# Strict UTF-8: a stray continuation byte, a truncated sequence, an overlong form and an encoded surrogate.
for bad in [byte_string(128), "a" + byte_string(195), byte_string(192) + byte_string(128), byte_string(237) + byte_string(160) + byte_string(128)]:
    for operation in range(3):
        try:
            if operation == 0:
                char_count(bad)
            elif operation == 1:
                chars(bad)
            else:
                char_slice(bad, 0, 1)
            assert(false)
        except err:
            assert(err.code == "R4013" and err.message == "text is not valid UTF-8")
print("characters passed")
