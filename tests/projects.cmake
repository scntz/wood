string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
file(COPY "${SOURCE_DIR}/examples/project" "${SOURCE_DIR}/examples/packages" DESTINATION "${TEST_DIR}")
set(app "${TEST_DIR}/project")
file(REMOVE "${app}/wood.lock")
function(invoke expected_status)
    execute_process(COMMAND "${WOOD}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 90 ENCODING UTF-8)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "wood ${ARGN}: expected ${expected_status}, got ${status}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
invoke(0 "${SOURCE_DIR}/tests/recovery.wd")
if(NOT last_output STREQUAL "recovery and standard modules ok\n")
    message(FATAL_ERROR "Recovery result mismatch: ${last_output}")
endif()
invoke(0 "${SOURCE_DIR}/tests/recovery.wd" -O0)
file(WRITE "${TEST_DIR}/exit.wd" "try:\n    exit(17)\nexcept err:\n    print('must not catch exit')\n")
invoke(17 "${TEST_DIR}/exit.wd")
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "Exit was incorrectly caught")
endif()
invoke(0 init "${TEST_DIR}/created")
invoke(2 init "${TEST_DIR}/created")
invoke(0 run "${TEST_DIR}/created" -- "project user")
if(NOT last_output STREQUAL "hello, project user\n")
    message(FATAL_ERROR "Initialized project failed")
endif()
invoke(0 test "${TEST_DIR}/created" --report=json)
string(JSON passed GET "${last_output}" passed)
if(NOT passed EQUAL 1)
    message(FATAL_ERROR "Project test discovery failed")
endif()
file(WRITE "${TEST_DIR}/created/tests/test_bad.wd" "print('captured output')\nraise 'deliberate test failure'\n")
invoke(1 test "${TEST_DIR}/created" --report=json --diagnostics=json)
string(JSON failed GET "${last_output}" failed)
string(JSON passed GET "${last_output}" passed)
if(NOT failed EQUAL 1 OR NOT passed EQUAL 1)
    message(FATAL_ERROR "Test runner failed to aggregate outcomes: ${last_output}")
endif()

invoke(2 check "${app}" --locked)
invoke(0 lock "${app}")
invoke(0 check "${app}" --locked)
file(MAKE_DIRECTORY "${TEST_DIR}/relocated")
file(COPY "${app}" "${TEST_DIR}/packages" DESTINATION "${TEST_DIR}/relocated")
invoke(0 check "${TEST_DIR}/relocated/project" --locked)
invoke(0 deps "${app}")
string(JSON package_count LENGTH "${last_output}" packages)
if(NOT package_count EQUAL 3)
    message(FATAL_ERROR "Transitive packages were not resolved")
endif()
file(READ "${app}/wood.lock" lock)
file(SHA256 "${TEST_DIR}/packages/rules/src/bounds.wd" expected_hash)
if(NOT lock MATCHES "${expected_hash}")
    message(FATAL_ERROR "Lock hash differs from independent CMake SHA-256")
endif()
invoke(0 inspect "${app}" --locked)
string(JSON module_count LENGTH "${last_output}" modules)
if(module_count LESS 5)
    message(FATAL_ERROR "Typed module inspection omitted dependencies")
endif()
file(WRITE "${TEST_DIR}/input.txt" "3\n1\n2\n")
invoke(0 run "${app}" --locked -- "${TEST_DIR}/input.txt" "${TEST_DIR}/output.txt")
file(READ "${TEST_DIR}/output.txt" report)
if(NOT report STREQUAL "count: 3\nsum: 6\nsorted: [1, 2, 3]\n")
    message(FATAL_ERROR "Multi-package native application result mismatch")
endif()
invoke(0 test "${app}" --locked --report=json)
string(JSON passed GET "${last_output}" passed)
if(NOT passed EQUAL 1)
    message(FATAL_ERROR "Package tests failed")
endif()
invoke(2 run "${app}")
if(NOT last_error MATCHES "usage:")
    message(FATAL_ERROR "Application exit/eprint did not work")
endif()
file(WRITE "${TEST_DIR}/bad.txt" "-1\n")
invoke(1 run "${app}" -- "${TEST_DIR}/bad.txt" "${TEST_DIR}/output.txt")
if(NOT last_error MATCHES "R4010")
    message(FATAL_ERROR "Recoverable error did not reach application handler")
endif()
# Dependency changes are rejected; root application edits are intentionally editable.
file(APPEND "${app}/src/main.wd" "\n# editable application\n")
invoke(0 check "${app}" --locked)
file(APPEND "${TEST_DIR}/packages/rules/src/bounds.wd" "\n# changed dependency\n")
invoke(2 check "${app}" --locked --diagnostics=json)
string(JSON code GET "${last_error}" code)
if(NOT code STREQUAL "D5001" OR NOT last_error MATCHES "wood.lock")
    message(FATAL_ERROR "Dependency content change was not rejected")
endif()
invoke(0 lock "${app}")
invoke(0 check "${app}" --locked)
file(WRITE "${TEST_DIR}/packages/rules/src/unused.wd" "fn unused():\n    pass\n")
invoke(2 check "${app}" --locked)
file(REMOVE "${TEST_DIR}/packages/rules/src/unused.wd")
invoke(0 check "${app}" --locked)
invoke(2 build "${app}" -o "${app}/wood.json")
invoke(2 emit-cpp "${app}" -o "${app}/src/report.wd")

file(MAKE_DIRECTORY "${TEST_DIR}/modules/sub")
file(WRITE "${TEST_DIR}/modules/helpers.wd" "fn identity(n: int) -> int:\n    return n\nfn _private():\n    pass\n")
file(WRITE "${TEST_DIR}/modules/sub/util.wd" "from ..helpers import identity\nfn value() -> int:\n    return identity(7)\n")
file(WRITE "${TEST_DIR}/modules/main.wd" "import sub.util as tools\nfrom helpers import identity as same\nassert(tools.value() == same(7))\n")
invoke(0 "${TEST_DIR}/modules/main.wd")
foreach(case IN ITEMS cycle missing private collision semantic side_effect escape)
    if(case STREQUAL "cycle")
        file(WRITE "${TEST_DIR}/modules/a.wd" "import b\n")
        file(WRITE "${TEST_DIR}/modules/b.wd" "import a\n")
        set(source "import a\n")
        set(code E3102)
    elseif(case STREQUAL "missing")
        set(source "import nonexistent\n")
        set(code E3101)
    elseif(case STREQUAL "private")
        set(source "from helpers import _private\n")
        set(code E3104)
    elseif(case STREQUAL "collision")
        set(source "from helpers import identity as print\n")
        set(code E3105)
    elseif(case STREQUAL "semantic")
        file(WRITE "${TEST_DIR}/modules/bad.wd" "fn value() -> int:\n    return missing\n")
        set(source "import bad\n")
        set(code E3007)
    elseif(case STREQUAL "side_effect")
        file(WRITE "${TEST_DIR}/modules/effects.wd" "print('must not run')\n")
        set(source "import effects\n")
        set(code E3103)
    else()
        file(WRITE "${TEST_DIR}/outside.wd" "fn outside():\n    pass\n")
        set(source "from ..outside import outside\n")
        set(code E3106)
    endif()
    file(WRITE "${TEST_DIR}/modules/check.wd" "${source}")
    invoke(1 check "${TEST_DIR}/modules/check.wd" --diagnostics=json)
    string(JSON actual GET "${last_error}" code)
    if(NOT actual STREQUAL code)
        message(FATAL_ERROR "Expected ${code} for ${case}, got ${last_error}")
    endif()
    if(case STREQUAL "semantic")
        string(JSON file GET "${last_error}" file)
        string(JSON line GET "${last_error}" line)
        if(NOT file MATCHES "bad.wd$" OR NOT line EQUAL 2)
            message(FATAL_ERROR "Diagnostic lost imported source position")
        endif()
    endif()
endforeach()
if(WIN32)
    # Junctions do not require the symbolic-link privilege on Windows. They must
    # obey the same boundaries even when GetFinalPathNameByHandle is denied.
    file(TO_NATIVE_PATH "${TEST_DIR}/modules/junction" junction_path)
    file(TO_NATIVE_PATH "${TEST_DIR}" junction_target)
    execute_process(COMMAND cmd.exe /d /c mklink /J "${junction_path}" "${junction_target}"
        RESULT_VARIABLE link_status OUTPUT_QUIET ERROR_VARIABLE link_error)
    if(link_status EQUAL 0)
        file(WRITE "${TEST_DIR}/modules/check.wd" "import junction.outside\n")
        invoke(1 check "${TEST_DIR}/modules/check.wd" --diagnostics=json)
        string(JSON code GET "${last_error}" code)
        if(NOT code STREQUAL "E3106")
            message(FATAL_ERROR "Junction escaped source root: ${last_error}")
        endif()
        file(TO_NATIVE_PATH "${TEST_DIR}/packages/rules/src/junction" snapshot_path)
        file(TO_NATIVE_PATH "${TEST_DIR}/modules" snapshot_target)
        execute_process(COMMAND cmd.exe /d /c mklink /J "${snapshot_path}" "${snapshot_target}"
            RESULT_VARIABLE snapshot_link_status OUTPUT_QUIET ERROR_VARIABLE link_error)
        if(NOT snapshot_link_status EQUAL 0)
            message(FATAL_ERROR "Cannot create snapshot junction: ${link_error}")
        endif()
        invoke(2 lock "${app}" --diagnostics=json)
        if(NOT last_error MATCHES "filesystem links")
            message(FATAL_ERROR "Dependency junction was accepted into lock: ${last_error}")
        endif()
    else()
        message(STATUS "Junction tests unavailable: ${link_error}")
    endif()
endif()
file(WRITE "${TEST_DIR}/created/wood.json" "{\"format\":1,\"format\":1}")
invoke(2 check "${TEST_DIR}/created" --diagnostics=json)
if(NOT last_error MATCHES "duplicate")
    message(FATAL_ERROR "Duplicate manifest keys accepted")
endif()

# Validate package metadata failures independently of frontend module failures.
file(MAKE_DIRECTORY "${TEST_DIR}/metadata/src" "${TEST_DIR}/metadata/lib/src")
set(manifest "${TEST_DIR}/metadata/wood.json")
set(valid "\"format\":1,\"name\":\"metadata\",\"version\":\"1.0.0\",\"source\":\"src\"")
foreach(case IN ITEMS unknown_field invalid_version missing_source escaping_source version_mismatch package_cycle)
    file(WRITE "${TEST_DIR}/metadata/lib/wood.json" "{\"format\":1,\"name\":\"lib\",\"version\":\"1.0.0\",\"source\":\"src\"}")
    if(case STREQUAL "unknown_field")
        set(content "{${valid},\"build_hook\":\"no hooks allowed\"}")
        set(reason "unknown manifest field")
    elseif(case STREQUAL "invalid_version")
        set(content "{\"format\":1,\"name\":\"metadata\",\"version\":\"01.0.0\",\"source\":\"src\"}")
        set(reason "MAJOR.MINOR.PATCH")
    elseif(case STREQUAL "missing_source")
        set(content "{\"format\":1,\"name\":\"metadata\",\"version\":\"1.0.0\",\"source\":\"absent\"}")
        set(reason "source directory does not exist")
    elseif(case STREQUAL "escaping_source")
        set(content "{\"format\":1,\"name\":\"metadata\",\"version\":\"1.0.0\",\"source\":\"..\"}")
        set(reason "escapes package")
    elseif(case STREQUAL "version_mismatch")
        set(content "{${valid},\"dependencies\":{\"lib\":{\"path\":\"lib\",\"version\":\"2.0.0\"}}}")
        set(reason "version mismatch")
    else()
        set(content "{${valid},\"dependencies\":{\"lib\":{\"path\":\"lib\",\"version\":\"1.0.0\"}}}")
        file(WRITE "${TEST_DIR}/metadata/lib/wood.json" "{\"format\":1,\"name\":\"lib\",\"version\":\"1.0.0\",\"source\":\"src\",\"dependencies\":{\"app\":{\"path\":\"..\",\"version\":\"1.0.0\"}}}")
        set(reason "cyclic package dependency")
    endif()
    file(WRITE "${manifest}" "${content}")
    invoke(2 deps "${TEST_DIR}/metadata" --diagnostics=json)
    string(JSON code GET "${last_error}" code)
    if(NOT code STREQUAL "D5001" OR NOT last_error MATCHES "${reason}")
        message(FATAL_ERROR "Unexpected ${case} manifest result: ${last_error}")
    endif()
endforeach()
message(STATUS "Modules, transitive packages, locks, project tests, recovery, stdlib, metadata and source boundaries passed")
