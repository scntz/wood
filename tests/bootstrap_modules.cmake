cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}/native á 🌳")
file(MAKE_DIRECTORY "${TEST_DIR}")
if(WIN32)
    set(executable "${TEST_DIR}/wood-bootstrap-modules.exe")
else()
    set(executable "${TEST_DIR}/wood-bootstrap-modules")
endif()
# This frontend nests bounded module DFS and parser calls. Use the same explicit
# MSVC stack budget as wood_compiler; Linux keeps its normal host stack.
execute_process(COMMAND "${WOOD}" emit-cpp "${SOURCE_DIR}/bootstrap/src/module_main.wd"
    -o "${TEST_DIR}/modules.cpp" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 240)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Module frontend emission failed: ${status}\n${error}")
endif()
set(flags)
if(HOST_MSVC)
    if(SANITIZE_GENERATED)
        list(APPEND flags /fsanitize=address /Zi)
    endif()
    execute_process(COMMAND "${HOST_CXX}" /nologo /std:c++latest /O2 /EHsc /utf-8 /permissive-
        ${flags} "/Fo:${TEST_DIR}/modules.obj" "/Fd:${TEST_DIR}/modules.pdb"
        "/Fe:${executable}" "${TEST_DIR}/modules.cpp" /link /INCREMENTAL:NO /STACK:8388608
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 360)
else()
    if(SANITIZE_GENERATED)
        list(APPEND flags -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer)
    else()
        list(APPEND flags -O2)
    endif()
    execute_process(COMMAND "${HOST_CXX}" -std=c++23 ${flags} "${TEST_DIR}/modules.cpp" -pthread -ldl -o "${executable}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 420)
endif()
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Module frontend native build failed: ${status}\n${output}\n${error}")
endif()
set(unit_flags)
if(SANITIZE_GENERATED)
    list(APPEND unit_flags --sanitize=address)
endif()
execute_process(COMMAND "${WOOD}" "${SOURCE_DIR}/bootstrap/tests/test_modules.wd" ${unit_flags} -- "${TEST_DIR}/unit"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
if(NOT status STREQUAL "0" OR NOT output STREQUAL "bootstrap module unit checks passed\n")
    message(FATAL_ERROR "Module native unit checks failed: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${ORACLE}" --verify-stdlib "${STDLIB_BUNDLE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Configured source bundle does not match the compiler: ${error}")
endif()
configure_file("${STDLIB_BUNDLE}" "${TEST_DIR}/stdlib.json" COPYONLY)
# New filesystem primitives retain normal static argument checking.
foreach(sample IN ITEMS "path.resolve(1)" "path.resolve(\".\",1)" "path.identity(false)" "path.within(\".\",1)" "path.is_absolute(0)")
    file(WRITE "${TEST_DIR}/bad-path.wd" "import std.path as path\n${sample}\n")
    execute_process(COMMAND "${WOOD}" check "${TEST_DIR}/bad-path.wd" --diagnostics=json
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT status STREQUAL "1" OR NOT error MATCHES "E3002")
        message(FATAL_ERROR "Path primitive type contract failed: ${sample}\n${error}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/bad-path.wd" "import std.path as path\npath.within(\".\")\n")
execute_process(COMMAND "${WOOD}" check "${TEST_DIR}/bad-path.wd" --diagnostics=json
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT status STREQUAL "1" OR NOT error MATCHES "E3003")
    message(FATAL_ERROR "Path primitive arity contract failed: ${error}")
endif()
execute_process(COMMAND "${ORACLE}" --generate "${TEST_DIR}/fixtures"
    RESULT_VARIABLE status OUTPUT_VARIABLE count ERROR_VARIABLE error TIMEOUT 90)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Module fixture generation failed: ${status}\n${error}")
endif()
if(WIN32)
    find_program(powershell NAMES pwsh powershell REQUIRED)
    execute_process(COMMAND "${powershell}" -NoProfile -File "${SOURCE_DIR}/tests/bootstrap_modules_links.ps1" -FixtureRoot "${TEST_DIR}/fixtures"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Junction fixture creation failed: ${error}")
    endif()
endif()
file(READ "${TEST_DIR}/fixtures/entries.json" entries)
string(JSON count LENGTH "${entries}")
math(EXPR last "${count}-1")
set(inputs)
foreach(index RANGE 0 ${last})
    string(JSON entry GET "${entries}" ${index})
    list(APPEND inputs "${entry}")
endforeach()
list(APPEND inputs "${SOURCE_DIR}/bootstrap/src/module_main.wd"
    "${SOURCE_DIR}/examples/project" "${SOURCE_DIR}/examples/catalog" "${SOURCE_DIR}/examples/archive"
    "${SOURCE_DIR}/examples/mesh_import.wd" "${SOURCE_DIR}/bootstrap/tests/test_modules.wd")
set(count 0)
foreach(entry IN LISTS inputs)
    execute_process(COMMAND "${executable}" "${TEST_DIR}/stdlib.json" "${entry}"
        RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 120)
    execute_process(COMMAND "${ORACLE}" "${entry}"
        RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 120)
    if(NOT "${actual_status}" STREQUAL "${expected_status}" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
        file(WRITE "${TEST_DIR}/actual.json" "${actual}")
        file(WRITE "${TEST_DIR}/expected.json" "${expected}")
        message(FATAL_ERROR "Module differential failed: ${entry}\nWood: ${actual_status}; C++: ${expected_status}\n${actual_error}${expected_error}\nSee ${TEST_DIR}/actual.json and expected.json")
    endif()
    math(EXPR count "${count}+1")
endforeach()
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT status STREQUAL "2" OR NOT output MATCHES "^usage: wood-bootstrap-modules" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Module CLI usage contract failed")
endif()
list(GET inputs 0 good)
list(GET inputs 4 bad)
execute_process(COMMAND "${executable}" "${TEST_DIR}/stdlib.json" "${good}" "${bad}"
    RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE actual_error TIMEOUT 30)
execute_process(COMMAND "${ORACLE}" "${good}" "${bad}"
    RESULT_VARIABLE expected_status OUTPUT_VARIABLE expected ERROR_VARIABLE expected_error TIMEOUT 30)
if(NOT actual_status STREQUAL "1" OR NOT expected_status STREQUAL "1" OR NOT actual STREQUAL expected OR NOT actual_error STREQUAL "" OR NOT expected_error STREQUAL "")
    message(FATAL_ERROR "Module CLI batch contract failed")
endif()
file(WRITE "${TEST_DIR}/validation.txt" "${count} exact module graph/binding/diagnostic comparisons passed\n")
message(STATUS "Bootstrap modules: native units and ${count} exact module graph/binding/diagnostic comparisons passed")
