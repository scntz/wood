from std.collections import Stack, Queue, Heap, heap, sorted_int, binary_search

assert(sorted_int([3,1,2,1]) == [1,1,2,3])
assert(binary_search([1,1,2,3],1) == 0)
assert(binary_search([1,1,2,3],4) == -1)

record Box[T]:
    value: T
    fn get(self) -> T:
        return self.value
    fn set(mut self, value: T):
        self.value = value
    fn map[U](self, convert: fn(T) -> U) -> Box[U]:
        return Box[U](convert(self.value))
    fn pair[U](self, other: U) -> tuple[T,U]:
        return (self.value, other)

fn stringify(value: int) -> str:
    return str(value)
fn extract[T](item: Box[T]) -> T:
    return item.get()
fn by_value(item: Box[list[int]]) -> Box[list[int]]:
    append(item.value, 9)
    return item

number = Box(5)
assert(extract(number) == 5)
assert(number.map(stringify).get() == "5")
assert(number.pair("item") == (5, "item"))
number.set(value=6)
assert(number.get() == 6)
wide = Box[float](7)
assert(wide.get() == 7.0)
optional = Box[int | None](None)
assert(optional.get() is None)
optional.set(8)
assert(unwrap(optional.get()) == 8)
collection: Box[list[int]] = Box([])
append(collection.value, 1)
copied = collection
append(copied.value, 2)
assert(collection.get() == [1] and copied.get() == [1,2])
assert(by_value(collection).get() == [1,9])
assert(collection.get() == [1])
assert(Box((1,"a")) == Box[tuple[int,str]]((1,"a")))
assert(json_dump(Box(2)) == '{"value":2}')

record Node[T]:
    value: T
    children: list[Node[T]]
    fn count(self) -> int:
        result = 1
        for child in self.children:
            result += child.count()
        return result
root = Node("root", [Node("left", []), Node("right", [Node("leaf", [])])])
assert(root.count() == 4)
assert(json_str(json_dict(json_parse(json_dump(root)))["value"]) == "root")
assert(root == Node("root", [Node("left", []), Node("right", [Node("leaf", [])])]))

record Counter:
    value: int
    fn add(mut self, amount: int = 1, *, twice: bool = false) -> int:
        self.value += amount * (2 if twice else 1)
        return self.value
    fn read(self, ignored: int = 0) -> int:
        return self.value
    fn fail(mut self):
        self.value += 1
        raise "changed before failure"

record Text:
    value: str
    fn index(mut self) -> int:
        self.value = "after"
        return 0
    fn prefix(mut self) -> str:
        self.value = "after"
        return "b"
text = Text("before")
assert((text.value, text.index()) == ("before", 0))
text.value = "before"
assert(text.value[text.index()] == "b")
text.value = "before"
assert(starts_with(text.value, text.prefix()))
text.value = "before"
assert([text.value, text.prefix()] == ["before", "b"])

record Store:
    items: list[Counter]
    fn clear(mut self) -> int:
        self.items = []
        return 1
    fn replace(mut self) -> int:
        self.items[0] = Counter(40)
        return 2

counter = Counter(0)
assert(counter.add(twice=true, amount=3) == 6)
assert(Counter(12).read() == 12)
try:
    counter.fail()
except err:
    assert(err.message == "changed before failure")
assert(counter.value == 7)
store = Store([Counter(10)])
assert(store.items[0].read(store.replace()) == 10)
assert(store.items[0].add(store.replace()) == 42)
trace = Counter(-1)
assert(store.items[trace.add()].add(trace.add()) == 43)
assert(trace.value == 1)
try:
    store.items[4].add(trace.add())
except err:
    assert(err.code == "R4006")
assert(trace.value == 1)
try:
    store.items[0].add(store.clear())
except err:
    assert(err.code == "R4006")
assert(store.items == [])
slots: dict[str,Counter] = {"a": Counter(0)}
assert(slots["a"].add(3) == 3)
slots_copy = slots
slots_copy["a"].add(2)
assert(slots["a"].value == 3 and slots_copy["a"].value == 5)

fn identity(value: int) -> int:
    return value
functions = [identity]
index = 0
assert(functions[index](11) == 11)
callbacks = Box(identity)
assert(callbacks.value(13) == 13)

fn less(left: int, right: int) -> bool:
    return left < right
fn greater(left: int, right: int) -> bool:
    return left > right

stack = Stack[int]([])
queue = Queue[int]([], [])
priority = heap([4,1,3,1,-2], less)
assert(priority.pop() == -2)
assert(priority.pop() == 1)
assert(priority.pop() == 1)
assert(priority.pop() == 3)
assert(priority.pop() == 4)
assert(priority.peek() is None)
model: list[int] = []
stack_model: list[int] = []
histogram: dict[int,int] = {}
seed = 137
for step in range(2000):
    seed = (seed * 48271) % 2147483647
    value = seed % 1000 - 500
    if seed % 3 != 0 or len(model) == 0:
        stack.push(value)
        queue.push(value)
        priority.push(value)
        append(model, value)
        append(stack_model, value)
        histogram[value] = get(histogram, value, 0) + 1
    else:
        assert(queue.pop() == model[0])
        model = model[1:]
    assert(queue.size() == len(model))
    if len(model) != 0:
        assert(unwrap(queue.peek()) == model[0])
queue_copy = queue
queue_copy.push(999)
assert(queue_copy.size() == queue.size() + 1)
while len(model) != 0:
    assert(queue.pop() == model[0])
    model = model[1:]
assert(queue.peek() is None)
for step in range(2):
    try:
        queue.pop()
    except err:
        assert(err.code == "R4007")
assert(queue.size() == 0)
stack_copy = stack
priority_copy = priority
last = -501
while priority.size() != 0:
    value = priority.pop()
    assert(last <= value)
    assert(get(histogram, value, 0) > 0)
    histogram[value] -= 1
    last = value
for value in histogram:
    assert(histogram[value] == 0)
assert(priority_copy.size() == stack.size())
assert(priority_copy.size() != 0)
while stack.size() != 0:
    assert(stack.pop() == pop(stack_model))
assert(stack.peek() is None and stack_copy.size() != 0)
maximum = heap([1,5,3,5], greater)
assert(maximum.pop() == 5 and maximum.pop() == 5)
assert(maximum.pop() == 3 and maximum.pop() == 1)
stack_copy.clear()
priority_copy.clear()
queue_copy.clear()
assert(stack_copy.size() == 0 and priority_copy.size() == 0 and queue_copy.size() == 0)

record Work:
    name: str
    priority: int
fn earlier(a: Work, b: Work) -> bool:
    return a.priority < b.priority or (a.priority == b.priority and a.name < b.name)
work = heap([Work("b",2), Work("a",2), Work("first",1)], earlier)
work_copy = work
assert(work.pop().name == "first")
assert(work.pop().name == "a" and work.pop().name == "b")
assert(work_copy.size() == 3)
print("native generic records and collections passed")
