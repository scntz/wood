string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/run-${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(level IN ITEMS -O0 -O2)
    execute_process(COMMAND "${WOOD}" "${SOURCE_DIR}/tests/time.wd" "${level}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        TIMEOUT 120 ENCODING UTF-8 WORKING_DIRECTORY "${TEST_DIR}")
    if(NOT "${status}" STREQUAL "0" OR NOT output STREQUAL "native time passed\n")
        message(FATAL_ERROR "Native time ${level} failed: ${status}\n${output}\n${error}")
    endif()
endforeach()
if(WIN32)
    set(exe "${TEST_DIR}/timing.exe")
else()
    set(exe "${TEST_DIR}/timing")
endif()
execute_process(COMMAND "${WOOD}" build "${SOURCE_DIR}/examples/timing.wd" -o "${exe}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Timing example build failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${exe}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
string(REGEX MATCH "^[^\n]+" measurement "${output}")
string(JSON checksum GET "${measurement}" checksum)
string(JSON elapsed GET "${measurement}" elapsed_ns)
if(NOT "${status}" STREQUAL "0" OR NOT checksum STREQUAL "5000050000" OR elapsed LESS 0)
    message(FATAL_ERROR "Standalone timing example failed: ${output}\n${error}")
endif()
file(WRITE "${TEST_DIR}/bad.wd" "import std.time as time\ntime.sleep(\"bad\")\n")
execute_process(COMMAND "${WOOD}" check "${TEST_DIR}/bad.wd" --diagnostics=json
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT "${status}" STREQUAL "1" OR NOT error MATCHES "E3002")
    message(FATAL_ERROR "Invalid module sleep argument was accepted: ${status} ${error}")
endif()
message(STATUS "Native steady counters, sleep errors, O0/O2 and standalone timing example passed")
