# Shared independent Floyd-Warshall and output-preservation checks.
# Caller supplies the built executable and a fresh TEST_DIR.
function(run_planner expected)
    execute_process(COMMAND "${executable}" "${TEST_DIR}/input.json" "${TEST_DIR}/output.json"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Route planner expected ${expected}, got ${status}: ${error}")
    endif()
endfunction()
# Compare shortest-path results with an independent Floyd-Warshall oracle.
foreach(seed RANGE 0 11)
    set(graph "{")
    foreach(i RANGE 0 7)
        if(i GREATER 0)
            string(APPEND graph ",")
        endif()
        string(APPEND graph "\"n${i}\":[")
        set(separator "")
        foreach(j RANGE 0 7)
            set(distance_${i}_${j} 1000000)
            set(edge_${i}_${j} 1000000)
            if(i EQUAL j)
                set(distance_${i}_${j} 0)
            else()
                math(EXPR include "(${i} * 17 + ${j} * 13 + ${seed} * 7) % 5")
                if(include LESS 2)
                    math(EXPR weight "(${i} * 11 + ${j} * 3 + ${seed}) % 19")
                    set(distance_${i}_${j} ${weight})
                    set(edge_${i}_${j} ${weight})
                    string(APPEND graph "${separator}{\"to\":\"n${j}\",\"cost\":${weight}}")
                    set(separator ",")
                endif()
            endif()
        endforeach()
        string(APPEND graph "]")
    endforeach()
    string(APPEND graph "}")
    foreach(k RANGE 0 7)
        foreach(i RANGE 0 7)
            foreach(j RANGE 0 7)
                math(EXPR candidate "${distance_${i}_${k}} + ${distance_${k}_${j}}")
                if(candidate LESS distance_${i}_${j})
                    set(distance_${i}_${j} ${candidate})
                endif()
            endforeach()
        endforeach()
    endforeach()
    file(WRITE "${TEST_DIR}/input.json" "{\"start\":\"n0\",\"graph\":${graph}}")
    run_planner(0)
    file(READ "${TEST_DIR}/output.json" report)
    set(expected_count 0)
    foreach(j RANGE 0 7)
        if(distance_0_${j} LESS 1000000)
            math(EXPR expected_count "${expected_count} + 1")
        endif()
    endforeach()
    string(JSON count LENGTH "${report}" routes)
    string(JSON reachable GET "${report}" reachable)
    if(NOT count EQUAL expected_count OR NOT reachable EQUAL count)
        message(FATAL_ERROR "Reachability differs from oracle: ${report}")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON place GET "${report}" routes ${index} place)
        string(SUBSTRING "${place}" 1 -1 destination)
        string(JSON cost GET "${report}" routes ${index} cost)
        if(NOT cost EQUAL distance_0_${destination})
            message(FATAL_ERROR "Shortest path differs from oracle: ${report}")
        endif()
        string(JSON length LENGTH "${report}" routes ${index} path)
        math(EXPR final "${length} - 1")
        set(previous 0)
        set(path_cost 0)
        foreach(step RANGE 0 ${final})
            string(JSON node GET "${report}" routes ${index} path ${step})
            string(SUBSTRING "${node}" 1 -1 current)
            if(step EQUAL 0)
                if(NOT current EQUAL 0)
                    message(FATAL_ERROR "Route does not begin at source")
                endif()
            else()
                math(EXPR path_cost "${path_cost} + ${edge_${previous}_${current}}")
            endif()
            set(previous ${current})
        endforeach()
        if(NOT previous EQUAL destination OR NOT path_cost EQUAL cost)
            message(FATAL_ERROR "Invalid route path: ${report}")
        endif()
    endforeach()
endforeach()
file(READ "${TEST_DIR}/output.json" preserved)
foreach(invalid IN ITEMS
    "{\"start\":\"missing\",\"graph\":{\"a\":[]}}"
    "{\"start\":\"a\",\"graph\":{\"a\":[{\"to\":\"b\",\"cost\":1}]}}"
    "{\"start\":\"a\",\"graph\":{\"a\":[{\"to\":\"a\",\"cost\":-1}]}}"
    "{\"start\":\"a\",\"graph\":{\"a\":[{\"to\":\"b\",\"cost\":9223372036854775807}],\"b\":[{\"to\":\"a\",\"cost\":1}]}}")
    file(WRITE "${TEST_DIR}/input.json" "${invalid}")
    run_planner(70)
    file(READ "${TEST_DIR}/output.json" actual)
    if(NOT actual STREQUAL preserved)
        message(FATAL_ERROR "Invalid routes changed existing output")
    endif()
endforeach()
