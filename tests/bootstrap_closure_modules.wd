import bootstrap_closure_models as models
import std.iter as it

fn prefix(value:str)->str:
    return "caller:"+value

assert(models.factory((1,"x"))()==(1,"x"))
assert(models.labels(range(3))[1].value=="library:1")
offset=4
assert(models.apply([1,2],fn(value)=>value+offset)==[5,6])
assert(models.apply(models.Sequence(3),fn(value)=>value+offset)==[4,5,6])
assert(it.collect(models.Sequence(3))==[0,1,2])
print("native hosted closure modules passed")
