# Read borrowing must preserve source-before-index/bounds value semantics.
record Buffer:
    text: str
    trace: str

    fn index(mut self) -> int:
        self.text = "changed"
        self.trace += "i"
        return 0

    fn stride(mut self) -> int:
        self.text = "changed"
        self.trace += "s"
        return 2

    fn owned(mut self) -> str:
        self.trace += "b"
        return self.text

fn made() -> Buffer:
    return Buffer("temporary member with enough bytes for heap storage","")

buffer = Buffer("before","")
assert(buffer.text[buffer.index()] == "b")
assert(buffer.text == "changed" and buffer.trace == "i")
buffer.text = "before"
assert(buffer.text[[buffer.index()][0]] == "b")
buffer.text = "before"
assert(buffer.text[0 if buffer.index()==0 else 1] == "b")
buffer.text = "before"
assert(slice(buffer.text,buffer.index(),3) == "bef")
buffer.text = "before"
assert(buffer.text[buffer.index():3] == "bef")
buffer.text = "before"
assert(buffer.text[::buffer.stride()] == "bfr")
buffer.text = "before"
assert(slice(buffer.text,0,buffer.index()+3) == "bef")

# Pure calculations borrow only for the duration of the checked read.
index = 1
assert(buffer.text[index] == "h")
assert(buffer.text[index+1] == "a")
assert(buffer.text[[0,index][index]] == "h")
assert(buffer.text[1 if index==1 else 2] == "h")
assert(buffer.text[1:5:2] == "hn")
assert(slice(buffer.text,index,index+2) == "ha")
assert(len(buffer.text) == 7)

# The base can be an owned temporary or a member of a temporary record.
assert(buffer.owned()[index] == "h")
assert(len(buffer.owned()) == 7)
assert(slice(buffer.owned(),index,index+2) == "ha")
for i in range(100):
    offset = i % 10
    assert(made().text[offset] == "temporary "[offset])
    assert(made().text[:9] == "temporary")
assert(("abcd" if true else "efgh")[index] == "b")

raw = "ab\0é"
assert([byte_value(raw[i]) for i in range(len(raw))] == [97,98,0,195,169])
assert(raw[::-1][0] == raw[4])
try:
    raw[len(raw)]
    assert(false)
except err:
    assert(err.code == "R4006")
try:
    raw[::0]
    assert(false)
except err:
    assert(err.code == "R4005")
maximum = 9223372036854775807
try:
    raw[maximum+1]
    assert(false)
except err:
    assert(err.code == "R4001")
assert(raw == "ab\0é")
print("native string read borrowing passed")
