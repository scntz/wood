# One package experience across providers. Commands choose a provider by the source's
# identity: python@name, owner@name, github@owner/repo, or an existing dependency alias.
import package_manager as manager
import package_python as provider

fn usage() -> str:
    return "Usage: wood add SOURCE [--as ALIAS] [--update] [--offline] [--index FILE] [--project PATH]\n       wood remove ALIAS|python@name [--project PATH]\n       wood update [ALIAS|python@name] [--offline] [--index FILE] [--project PATH]\n       wood list [--project PATH]\n       wood info owner@package [--offline] [--index FILE]\n       wood install [--locked] [--offline] [--project PATH]\nSOURCE: owner@package[#version], python@name[#version] or github@owner/repository[#ref]"

fn add(input: str, options: manager.Options, standards: dict[str,str], assets: str) -> int:
    if provider.is_python(input):
        if options.alias != "" or options.update:
            raise manager.problem("D5101", "--as and --update apply to wood packages; Python packages use their import name, and 'wood update' moves them")
        return provider.add_package(input, options.start, options.offline, standards, assets)
    return manager.add_package(input, options, standards, assets)

fn install(arguments: list[str], standards: dict[str,str], assets: str) -> int:
    if arguments == ["--help"]:
        print(usage())
        return 0
    options = manager.parse_options(arguments, usage())
    if len(options.positional) == 0:
        if options.alias != "" or options.update:
            raise manager.problem("D5101", "--as and --update require a package to add")
        status = manager.restore(options, standards, assets)
        return status if status != 0 else provider.restore(options.start, options.offline, options.locked, assets)
    if options.positional[0] != "dependency" or len(options.positional) != 2:
        if len(options.positional) == 1:
            raise manager.problem("D5101", "'wood install' restores what wood.lock records. To add a package, use: wood add "+options.positional[0])
        raise manager.problem("D5101", usage())
    return add(options.positional[1], options, standards, assets)

fn dispatch(verb: str, arguments: list[str], standards: dict[str,str], assets: str) -> int:
    if arguments == ["--help"]:
        print(usage())
        return 0
    options = manager.parse_options(arguments, usage())
    count = len(options.positional)
    if verb == "add" and count == 1:
        return add(options.positional[0], options, standards, assets)
    if verb == "remove" and count == 1:
        if provider.is_python(options.positional[0]):
            return provider.remove_package(options.positional[0], options.start, options.offline, standards, assets)
        return manager.remove_package(options.positional[0], options, standards)
    if verb == "update" and count <= 1:
        target = options.positional[0] if count == 1 else ""
        if provider.is_python(target):
            return provider.update_packages(provider.parse_request(target).name, options.start, options.offline, standards, assets)
        status = manager.update(target, options, standards, assets)
        return status if status != 0 or target != "" else provider.update_packages("", options.start, options.offline, standards, assets)
    if verb == "list" and count == 0:
        lines = manager.report_lines(options.start)+provider.report_lines(options.start)
        if len(lines) == 0:
            print("No external packages. Add one with: wood add wood@image")
        for line in lines:
            print(line)
        return 0
    if verb == "info" and count == 1:
        return manager.info(options.positional[0], options, assets)
    raise manager.problem("D5101", usage())
