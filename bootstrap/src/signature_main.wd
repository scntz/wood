import signature_wire as wire
import project as project
import sources as src

arguments = args()
if len(arguments) < 2:
    print("usage: wood-bootstrap-signatures STDLIB.json ENTRY [ENTRY ...]")
    exit(2)
standards: dict[str,str] = {}
bundle = project.object(json_parse(src.read(arguments[0],16777216)))
for name in bundle:
    standards[name] = project.string(bundle[name])
status = 0
for entry in arguments[1:]:
    reply = wire.inspect(entry,standards)
    print(json_dump(reply))
    if reply.diagnostic.code != "":
        status = 1
exit(status)
