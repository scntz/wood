            return result
        if name == "slice":
            operands = ["i64 "+arguments[1].text,"i64 "+arguments[2].text,"i64 1","i64 1","i64 1"]
            if self.program.signatures.pool.types[arguments[0].type].kind == "Str":
                return self.runtime_value(target,"wd_m_str_slice",["ptr "+self.spill(arguments[0])]+operands)
            result = self.instruction("call ptr @wd_m_seq_slice(ptr %ctx, ptr "+arguments[0].text+", "+join(operands,", ")+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "str":
            return self.stringify(arguments[0],false,module,token)
        if name in ["find","starts_with","ends_with"]:
            left = arguments[0]
            right = arguments[1]
            if name == "find":
                return Value(target,self.instruction("call i64 @wd_m_find(ptr "+self.spill(left)+", ptr "+self.spill(right)+")"))
            a = self.instruction("extractvalue %wd.str "+left.text+", 1")
            b = self.instruction("extractvalue %wd.str "+right.text+", 1")
            enough = self.instruction("icmp sge i64 "+a+", "+b)
            result = self.temporary("i1")
            yes = self.label()
            end = self.label()
            self.line("store i1 false, ptr "+result)
            self.branch(enough,yes,end)
            self.open(yes)
            offset = "0" if name == "starts_with" else self.instruction("sub i64 "+a+", "+b)
            view = self.instruction("extractvalue %wd.str "+left.text+", 0")
            view = self.instruction("getelementptr i8, ptr "+view+", i64 "+offset)
            partial = self.instruction("insertvalue %wd.str "+left.text+", ptr "+view+", 0")
            partial = self.instruction("insertvalue %wd.str "+partial+", i64 "+b+", 1")
            same = self.compare("==",Value(left.type,partial),right,module,token)
            self.line("store i1 "+same+", ptr "+result)
            self.jump(end)
            self.open(end)
            return Value(target,self.instruction("load i1, ptr "+result))
        if name in ["replace","join","strip","byte_string","byte_value","split"]:
            if name == "replace":
                return self.runtime_value(target,"wd_m_str_replace",["ptr "+self.spill(item) for item in arguments])
            if name == "join":
                return self.runtime_value(target,"wd_m_str_join",["ptr "+arguments[0].text,"ptr "+self.spill(arguments[1])])
            if name == "strip":
                out = self.owned_slot(target)
                self.line("call void @wd_m_str_strip(ptr "+out+", ptr "+self.spill(arguments[0])+")")
                return Value(target,self.instruction("load %wd.str, ptr "+out))
            if name == "byte_string":
                return self.runtime_value(target,"wd_m_byte_str",["i64 "+arguments[0].text])
            if name == "byte_value":
                result = self.instruction("call i64 @wd_m_byte_value(ptr %ctx, ptr "+self.spill(arguments[0])+")")
                self.propagate()
                return Value(target,result)
            if name == "split":
                result = self.instruction("call ptr @wd_m_str_split(ptr %ctx, ptr "+self.spill(arguments[0])+", ptr "+self.spill(arguments[1])+")")
                self.propagate()
                return self.hold(Value(target,result),true)
        if name == "range":
            values = ["0",arguments[0].text,"1"] if len(arguments) == 1 else [arguments[0].text,arguments[1].text,"1"]
            if len(arguments) == 3:
                values[2] = arguments[2].text
            bad = self.instruction("icmp eq i64 "+values[2]+", 0")
            self.guard(bad,module,token,"R4005","range step cannot be zero")
            result = "zeroinitializer"
            for i in range(3):
                result = self.instruction("insertvalue "+self.type(target)+" "+result+", i64 "+values[i]+", "+str(i))
            return Value(target,result)
        if name == "unwrap":
            value = arguments[0]
            present = self.instruction("extractvalue "+self.type(value.type)+" "+value.text+", 0")
            bad = self.instruction("xor i1 "+present+", true")
            self.guard(bad,module,token,"R4023","cannot unwrap None")
            return Value(target,self.instruction("extractvalue "+self.type(value.type)+" "+value.text+", 1"))
        if name in ["float","int"]:
            value = arguments[0]
            kind = self.program.signatures.pool.types[value.type].kind
            if name == "float" and kind == "Int":
                return self.convert(value,target)
            if (name == "float" and kind == "Float") or (name == "int" and kind == "Int"):
                return Value(target,value.text)
            if name == "int" and kind == "Float":
                low = self.instruction("fcmp uge double "+value.text+", 0x43E0000000000000")
                high = self.instruction("fcmp ult double "+value.text+", 0xC3E0000000000000")
                bad = self.instruction("or i1 "+low+", "+high)
                self.guard(bad,module,token,"R4003","float is outside the signed 64-bit range")
                return Value(target,self.instruction("fptosi double "+value.text+" to i64"))
            if name == "int" and kind == "Str":
                result = self.instruction("call i64 @wd_m_str_int(ptr %ctx, ptr "+self.spill(value)+")")
                self.propagate()
                return Value(target,result)
            if name == "float" and kind == "Str":
                result = self.instruction("call double @wd_m_str_float(ptr %ctx, ptr "+self.spill(value)+")")
                self.propagate()
                return Value(target,result)
        if name in ["char_count","chars","char_slice"]:
            self.site(module,token)
            text = "ptr "+self.spill(arguments[0])
            if name == "char_slice":
                return self.runtime_value(target,"wd_m_char_slice",[text,"i64 "+arguments[1].text,"i64 "+arguments[2].text])
            if name == "char_count":
                result = self.instruction("call i64 @wd_m_char_count(ptr %ctx, "+text+")")
                self.propagate()
                return Value(target,result)
            result = self.instruction("call ptr @wd_m_chars(ptr %ctx, "+text+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "error":
            self.site(module,token)
            self.line("call void @wd_m_error_code(ptr %ctx, ptr "+self.spill(arguments[0])+")")
            self.propagate()
            file = self.string(self.program.signatures.compilation.modules[module].file)
            self.line("call void @wd.fail(ptr %ctx, %wd.str "+arguments[0].text+", %wd.str "+arguments[1].text+", %wd.str "+file+", i64 "+str(token.line)+", i64 "+str(token.column)+")")
            failure = self.load(target,self.instruction("getelementptr %wd.ctx, ptr %ctx, i32 0, i32 1"))
            self.line("call void @wd.clear(ptr %ctx)")
            return failure
        if name == "exit":
            value = arguments[0].text
            low = self.instruction("icmp slt i64 "+value+", 0")
            high = self.instruction("icmp sgt i64 "+value+", 255")
            bad = self.instruction("or i1 "+low+", "+high)
            self.guard(bad,module,token,"R4003","exit code must be in 0..255")
            narrow = self.instruction("trunc i64 "+value+" to i32")
            self.line("call void @wd.request_exit(ptr %ctx, i32 "+narrow+")")
            self.jump("unwind")
            return Value(target,"")
        self.unsupported(module,token,"builtin "+name)
        return Value(target,"")

    fn invocation(mut self, module: int, expression: int) -> Value:
        call = self.program.facts[module].calls[expression]
        reference = call.arguments[0]
        type = self.program.facts[reference.module].types[reference.expression]
        function = self.program.signatures.pool.types[type]
        token = self.program.signatures.compilation.modules[module].tree.expressions[expression].token
        mutable = function.kind == "Callable"
        if function.kind == "Closure":
            declaration = self.program.signatures.declarations[self.declarations[function.declaration]]
            mutable = len(self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement].mutable_captures) > 0
        place = Place("",[])
        pointer = ""
        if mutable and self.rooted(reference.module,reference.expression):
            place = self.place(reference.module,reference.expression)
            self.address(place,false)
        else:
            # Pure calls snapshot before argument effects. Stateful temporaries
            # also need a home whose state survives for the complete call.
            value = self.expression(reference.module,reference.expression)
            pointer = self.owned_slot(type)
            self.store(value,pointer)
        arguments = [Value(item,"") for item in function.parameters]
        for i in range(1,len(call.arguments)):
            item = call.arguments[i]
            position = call.order[i-1] if call.kind == "closure" else i-1
            arguments[position] = self.convert(self.expression(item.module,item.expression),function.parameters[position])
        if pointer == "":
            pointer = self.address(place,true)
        self.site(module,token)
        code = "@wd.f"+str(function.declaration)
        environment = pointer
        if function.kind == "Callable":
            owner = self.instruction("call ptr @wd_m_callable_unique(ptr %ctx, ptr "+pointer+")")
            self.propagate()
            environment = self.instruction("call ptr @wd_m_callable_data(ptr "+owner+")")
            code = self.instruction("call ptr @wd_m_callable_code(ptr "+owner+")")
        operands = ["ptr %ctx","ptr "+environment]+[self.type(item.type)+" "+item.text for item in arguments]
        target = self.program.facts[module].types[expression]
        command = "call "+self.type(target)+" "+code+"("+join(operands,", ")+")"
        result = ""
        if self.program.signatures.pool.types[target].kind == "Void":
            self.line(command)
        else:
            result = self.instruction(command)
        self.propagate()
        return self.hold(Value(target,result),true)

    fn make_cursor(mut self, source: Value, target: int) -> Value:
        node = self.program.signatures.pool.types[source.type]
        field = self.type(source.type)+" "+source.text
        transfer = false
        if node.kind == "Dict":
            # Dictionary cursors own keys only, never keep value resources alive.
            owner = self.instruction("call ptr @wd_m_map_keys(ptr %ctx, ptr "+source.text+", "+self.callbacks(node.key)+")")
            self.propagate()
            field = "ptr "+owner
            transfer = true
        aggregate = self.instruction("insertvalue "+self.type(target)+" zeroinitializer, "+field+", 0")
        return self.hold(Value(target,aggregate),transfer)

    fn native_step(mut self, pointer: str, cursor: int, element: int, module: int, token: lx.Token) -> tuple[str,Value]:
        node = self.program.signatures.pool.types[cursor]
        kind = node.kind
        state = pointer
        position = ""
        if kind == "Cursor":
            source = self.program.signatures.pool.types[node.element]
            kind = source.kind
            state = self.instruction("getelementptr "+self.type(cursor)+", ptr "+pointer+", i32 0, i32 0")
            position = self.instruction("getelementptr "+self.type(cursor)+", ptr "+pointer+", i32 0, i32 1")
        result = self.owned_slot(element)
        self.store(Value(element,"zeroinitializer"),result)
        available = self.temporary("i1")
        self.line("store i1 false, ptr "+available)
        current = ""
        limit = ""
        stride = "1"
        value = ""
        valid = ""
        if kind == "Range":
            type = self.type(self.kind_id("Range"))
            range_state = self.instruction("load "+type+", ptr "+state)
            current = self.instruction("extractvalue "+type+" "+range_state+", 0")
            limit = self.instruction("extractvalue "+type+" "+range_state+", 1")
            stride = self.instruction("extractvalue "+type+" "+range_state+", 2")
            below = self.instruction("icmp slt i64 "+current+", "+limit)
            above = self.instruction("icmp sgt i64 "+current+", "+limit)
            positive = self.instruction("icmp sgt i64 "+stride+", 0")
            valid = self.instruction("select i1 "+positive+", i1 "+below+", i1 "+above)
        else:
            current = self.instruction("load i64, ptr "+position)
            value_type = "%wd.str" if kind == "Str" else "ptr"
            value = self.instruction("load "+value_type+", ptr "+state)
            limit = self.instruction("extractvalue %wd.str "+value+", 1") if kind == "Str" else self.instruction("call i64 @"+("wd_m_array_len" if kind == "Array" else "wd_m_seq_len")+"(ptr "+value+")")
            valid = self.instruction("icmp slt i64 "+current+", "+limit)
        body = self.label()
        end = self.label()
        self.branch(valid,body,end)
        self.open(body)
        item = Value(element,current)
        next_value = ""
        if kind == "Range":
            pair = self.instruction("call {i64, i1} @llvm.sadd.with.overflow.i64(i64 "+current+", i64 "+stride+")")
            next_value = self.instruction("extractvalue {i64, i1} "+pair+", 0")
            overflow = self.instruction("extractvalue {i64, i1} "+pair+", 1")
            next_value = self.instruction("select i1 "+overflow+", i64 "+limit+", i64 "+next_value)
            position = self.instruction("getelementptr "+self.type(self.kind_id("Range"))+", ptr "+state+", i32 0, i32 0")
        else:
            next_value = self.instruction("add i64 "+current+", 1")
            if kind == "Str":
                bytes = self.instruction("extractvalue %wd.str "+value+", 0")
                bytes = self.instruction("getelementptr i8, ptr "+bytes+", i64 "+current)
                text = self.instruction("insertvalue %wd.str "+value+", ptr "+bytes+", 0")
                item = Value(element,self.instruction("insertvalue %wd.str "+text+", i64 1, 1"))
            else:
                address = self.instruction("call ptr @"+("wd_m_array_flat" if kind == "Array" else "wd_m_seq_read")+"(ptr "+value+", i64 "+current+")")
                item = Value(element,self.instruction("load "+self.type(element)+", ptr "+address))
        self.store(item,result)
        self.line("store i64 "+next_value+", ptr "+position)
        self.line("store i1 true, ptr "+available)
        self.jump(end)
        self.open(end)
        return (self.instruction("load i1, ptr "+available),self.load(element,result))

    fn iteration_source(mut self, source: Value, module: int, expression: int) -> tuple[Root,int]:
        protocol = self.program.facts[module].protocols[expression]
        if protocol.make >= 0:
            declaration = self.program.signatures.declarations[protocol.make]
            result = self.instruction("call "+self.type(declaration.result)+" @wd.f"+str(declaration.symbol)+"(ptr %ctx, ptr "+self.spill(source)+")")
            self.propagate()
            source = self.hold(Value(declaration.result,result),true)
        snapshot = self.owned_slot(source.type,false)
        self.store(source,snapshot)
        return (Root(source.type,snapshot),protocol.next)

    fn iteration_next(mut self, cursor: Root, next: int, element: int, module: int, token: lx.Token) -> tuple[str,Value]:
        if next < 0:
            return self.native_step(cursor.pointer,cursor.type,element,module,token)
        declaration = self.program.signatures.declarations[next]
        type = self.type(declaration.result)
        self.site(module,token)
        value = self.instruction("call "+type+" @wd.f"+str(declaration.symbol)+"(ptr %ctx, ptr "+cursor.pointer+")")
        self.propagate()
        self.hold(Value(declaration.result,value),true)
        return (self.instruction("extractvalue "+type+" "+value+", 0"),Value(element,self.instruction("extractvalue "+type+" "+value+", 1")))

    fn comprehension_clause(mut self, module: int, index: int, position: int, output: str):
        expr = self.program.signatures.compilation.modules[module].tree.expressions[index]
        type = self.program.facts[module].types[index]
        node = self.program.signatures.pool.types[type]
        dictionary = expr.kind == "DictComprehension"
        head = 2 if dictionary else 1
        if position == len(expr.clauses):
            key = Value(-1,"")
            if dictionary:
                key = self.expression(module,expr.children[0])
            value = self.convert(self.expression(module,expr.children[head-1]),node.element)
            self.site(module,expr.token)
            if dictionary:
                pointer = self.instruction("call ptr @wd_m_map_edit(ptr %ctx, ptr "+output+", ptr "+self.spill(key)+", i64 1)")
                self.propagate()
                self.store(value,pointer)
            else:
                self.line("call void @wd_m_seq_append(ptr %ctx, ptr "+output+", ptr "+self.spill(value)+")")
                self.propagate()
            self.drain()
            return
        child = expr.children[head+position]
        clause = expr.clauses[position]
        if clause.name == "":
            condition = self.expression(module,child)
            self.drain()
            yes = self.label()
            end = self.label()
            self.branch(condition.text,yes,end)
            self.open(yes)
            self.comprehension_clause(module,index,position+1,output)
            self.jump(end)
            self.open(end)
            return
        source = self.expression(module,child)
        kind = self.program.signatures.pool.types[source.type].kind
        if kind in ["Record","Cursor"]:
            prepared = self.iteration_source(source,module,child)
            self.drain()
            test = self.label()
            body = self.label()
            end = self.label()
            self.jump(test)
            self.open(test)
            iteration = self.program.facts[module].iterations[index][position]
            item = self.iteration_next(prepared[0],prepared[1],iteration.type,module,clause.token)
            self.branch(item[0],body,end)
            self.open(body)
            local_start = len(self.locals)
            self.store(item[1],self.slot(iteration.symbol,iteration.type))
            self.drain()
            self.comprehension_clause(module,index,position+1,output)
            self.clean(self.locals[local_start:])
            self.jump(test)
            self.open(end)
            self.release_root(prepared[0])
            return
        start = "0"
        stop = ""
        step = "1"
        positive = "true"
        snapshot = ""
        if kind == "Range":
            start = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 0")
            stop = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 1")
            step = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 2")
            positive = self.instruction("icmp sgt i64 "+step+", 0")
        elif kind in ["List","Dict","Str","Array"]:
            snapshot = self.owned_slot(source.type,false)
            self.store(source,snapshot)
            stop = self.instruction("extractvalue %wd.str "+source.text+", 1") if kind == "Str" else self.instruction("call i64 @"+{"List":"wd_m_seq_len","Dict":"wd_m_map_len","Array":"wd_m_array_len"}[kind]+"(ptr "+source.text+")")
        else:
            self.unsupported(module,clause.token,"comprehension iterator "+kind)
        current = self.temporary("i64")
        self.line("store i64 "+start+", ptr "+current)
        self.drain()
        test = self.label()
        body = self.label()
        end = self.label()
        self.jump(test)
        self.open(test)
        item = self.instruction("load i64, ptr "+current)
        below = self.instruction("icmp slt i64 "+item+", "+stop)
        condition = below
        if kind == "Range":
            above = self.instruction("icmp sgt i64 "+item+", "+stop)
            condition = self.instruction("select i1 "+positive+", i1 "+below+", i1 "+above)
        self.branch(condition,body,end)
        self.open(body)
        local_start = len(self.locals)
        iteration = self.program.facts[module].iterations[index][position]
        value = Value(iteration.type,item)
        if kind in ["List","Dict","Array"]:
            pointer = self.instruction("call ptr @"+("wd_m_array_flat" if kind == "Array" else "wd_m_seq_read")+"(ptr "+source.text+", i64 "+item+")") if kind != "Dict" else self.instruction("call ptr @wd_m_map_entry(ptr "+source.text+", i64 "+item+", i64 0)")
            value = Value(iteration.type,self.instruction("load "+self.type(iteration.type)+", ptr "+pointer))
        elif kind == "Str":
            pointer = self.instruction("extractvalue %wd.str "+source.text+", 0")
            pointer = self.instruction("getelementptr i8, ptr "+pointer+", i64 "+item)
            part = self.instruction("insertvalue %wd.str "+source.text+", ptr "+pointer+", 0")
            value = Value(source.type,self.instruction("insertvalue %wd.str "+part+", i64 1, 1"))
        self.store(value,self.slot(iteration.symbol,iteration.type))
        self.comprehension_clause(module,index,position+1,output)
        self.clean(self.locals[local_start:])
        old = self.instruction("load i64, ptr "+current)
        pair = self.instruction("call {i64, i1} @llvm.sadd.with.overflow.i64(i64 "+old+", i64 "+step+")")
        next = self.instruction("extractvalue {i64, i1} "+pair+", 0")
        overflow = self.instruction("extractvalue {i64, i1} "+pair+", 1")
        self.line("store i64 "+next+", ptr "+current)
        self.branch(overflow,end,test)
        self.open(end)
        if snapshot != "":
            self.release_root(Root(source.type,snapshot))

    fn comprehension(mut self, module: int, index: int) -> Value:
        # A nested full expression owns its own temporary roots; do not drain
        # the parent call's arguments while evaluating comprehension clauses.
        parent = self.pending
        self.pending = []
        start = len(self.locals)
        type = self.program.facts[module].types[index]
        node = self.program.signatures.pool.types[type]
        output = self.owned_slot(type,false)
        if node.kind == "List":
            self.store(Value(type,"@wd.empty."+str(type)),output)
        else:
            slot = self.map_slot(type,module,self.program.signatures.compilation.modules[module].tree.expressions[index].token)
            self.store(Value(type,self.instruction("load ptr, ptr "+slot)),output)
            self.drain()
        self.comprehension_clause(module,index,0,output)
        result = self.hold(Value(type,self.instruction("load ptr, ptr "+output)))
        self.clean(self.locals[start:])
        self.pending = parent+self.pending
        return result

    fn expression(mut self, module: int, index: int) -> Value:
        facts = self.program.facts[module]
        expr = self.program.signatures.compilation.modules[module].tree.expressions[index]
        target = facts.types[index]
        self.require_type(target,module,expr.token)
        if index in facts.calls:
            return self.call(module,index)
        kind = expr.kind
        text = expr.token.text
        if kind == "Name":
            return self.load(target,self.slots[facts.symbols[index]])
        if kind == "Closure":
            aggregate = "zeroinitializer"
            captures = self.program.closures[self.declarations[self.program.signatures.pool.types[target].declaration]].captures
            for i in range(len(captures)):
                capture = captures[i]
                value = self.load(capture.type,self.slots[capture.symbol])
                aggregate = self.instruction("insertvalue "+self.type(target)+" "+aggregate+", "+self.type(value.type)+" "+value.text+", "+str(i))
            return Value(target,aggregate)
        if kind in ["Integer","Bool"]:
            return Value(target,text)
        if kind == "Float":
            if "e" in text or "E" in text:
                parts = split(replace(text,"E","e"),"e")
                text = parts[0]+("" if "." in parts[0] else ".0")+"e"+parts[1]
            elif "." not in text:
                text += ".0"
            return Value(target,text)
        if kind == "String":
            return Value(target,self.string(text))
        if kind == "None":
            return Value(target,"0")
        if kind in ["ListComprehension","DictComprehension"]:
            return self.comprehension(module,index)
        if kind == "List":
            element = self.program.signatures.pool.types[target].element
            if len(expr.children) == 0:
                return Value(target,"@wd.empty."+str(target))
            size = self.stride(element)
            count = str(len(expr.children))
            self.site(module,expr.token)
            owner = self.instruction("call ptr @wd_m_seq_new(ptr %ctx, i64 "+size+", i64 "+count+", i64 "+count+", "+self.callbacks(element)+")")
            self.propagate()
            result = self.hold(Value(target,owner),true)
            for i in range(len(expr.children)):
                child = self.convert(self.expression(module,expr.children[i]),element)
                pointer = self.instruction("call ptr @wd_m_seq_read(ptr "+owner+", i64 "+str(i)+")")
                self.store(child,pointer)
            return result
        if kind == "Dict":
            node = self.program.signatures.pool.types[target]
            slot = self.map_slot(target,module,expr.token)
            for i in range(0,len(expr.children),2):
                key = self.expression(module,expr.children[i])
                value = self.convert(self.expression(module,expr.children[i+1]),node.element)
                self.site(module,expr.token)
                pointer = self.instruction("call ptr @wd_m_map_edit(ptr %ctx, ptr "+slot+", ptr "+self.spill(key)+", i64 1)")
                self.propagate()
                self.store(value,pointer)
            return Value(target,self.instruction("load ptr, ptr "+slot))
        if kind == "Member":
            pointer = self.projection(module,index)
            if pointer != "":
                return self.load(target,pointer)
            base = self.expression(module,expr.children[0])
            field = facts.symbols[index]
            if self.program.signatures.pool.types[base.type].kind == "Error":
                field = {"code":0,"message":1,"file":2,"line":3,"column":4}[text]
            return Value(target,self.instruction("extractvalue "+self.type(base.type)+" "+base.text+", "+str(field)))
        if kind == "Unary":
            if facts.symbols[index] == 1:
                return Value(target,"-9223372036854775808")
            child = self.expression(module,expr.children[0])
            if text == "+":
                return child
            if text == "not":
                return Value(target,self.instruction("xor i1 "+child.text+", true"))
            if text == "~":
                return Value(target,self.instruction("xor i64 "+child.text+", -1"))
            if text == "-":
                if self.program.signatures.pool.types[target].kind == "Array":
                    return self.operation("*",child,Value(self.kind_id("Int"),"-1"),target,module,expr.token)
                if self.program.signatures.pool.types[target].kind == "Float":
                    return Value(target,self.instruction("fneg double "+child.text))
                bad = self.instruction("icmp eq i64 "+child.text+", -9223372036854775808")
                self.guard(bad,module,expr.token,"R4001","integer overflow in negation")
                return Value(target,self.instruction("sub i64 0, "+child.text))
        if kind == "Tuple":
            aggregate = "zeroinitializer"
            types = self.program.signatures.pool.types[target].parameters
            for i in range(len(expr.children)):
                child = self.convert(self.expression(module,expr.children[i]),types[i])
                aggregate = self.instruction("insertvalue "+self.type(target)+" "+aggregate+", "+self.type(child.type)+" "+child.text+", "+str(i))
            return Value(target,aggregate)
        if kind in ["Conditional","Binary"] and (kind == "Conditional" or text in ["and","or"]):
            result = self.owned_slot(target)
            condition = self.expression(module,expr.children[1] if kind == "Conditional" else expr.children[0])
            yes = self.label()
            no = self.label()
            end = self.label()
            self.branch(condition.text,yes,no)
            self.open(yes)
            value = self.convert(self.expression(module,expr.children[0]),target) if kind == "Conditional" else (self.expression(module,expr.children[1]) if text == "and" else condition)
            self.store(value,result)
            self.jump(end)
            self.open(no)
            value = self.convert(self.expression(module,expr.children[2]),target) if kind == "Conditional" else (condition if text == "and" else self.expression(module,expr.children[1]))
            self.store(value,result)
            self.jump(end)
            self.open(end)
            return self.load(target,result)
        if kind in ["Binary","CompareChain"]:
            left = self.expression(module,expr.children[0])
            if kind == "Binary":
                right = self.expression(module,expr.children[1])
                return self.operation(text,left,right,target,module,expr.token)
            result = self.temporary("i1")
            self.line("store i1 false, ptr "+result)
            end = self.label()
            for i in range(len(expr.operators)):
                right = self.expression(module,expr.children[i+1])
                condition = self.compare(expr.operators[i],left,right,module,expr.token)
                valid = self.label()
                self.branch(condition,valid,end)
                self.open(valid)
                left = right
            self.line("store i1 true, ptr "+result)
            self.jump(end)
            self.open(end)
            return self.load(target,result)
        if kind == "Index":
            projected = self.projection(module,index)
            if projected != "":
                return self.load(target,projected)
            local = self.local_element(module,index,target)
            if local != "":
                return self.load(target,local)
            base = self.expression(module,expr.children[0])
            if self.program.signatures.pool.types[base.type].kind == "Array":
                coordinate = self.expression(module,expr.children[1])
                if self.fixed_rank(coordinate):
                    return self.load(target,self.array_element(base.text,coordinate,module,expr.token))
                self.site(module,expr.token)
                pointer = self.instruction("call ptr @wd_m_array_at(ptr %ctx, ptr "+base.text+", "+self.integer_span(coordinate)+")")
                self.propagate()
                return self.load(target,pointer)
            node = self.program.signatures.pool.types[base.type]
            if node.kind == "Tuple":
                return Value(target,self.instruction("extractvalue "+self.type(base.type)+" "+base.text+", "+str(facts.symbols[index])))
            if node.kind == "Str":
                position = self.expression(module,expr.children[1]).text
                length = self.instruction("extractvalue %wd.str "+base.text+", 1")
                negative = self.instruction("icmp slt i64 "+position+", 0")
                adjusted = self.instruction("add i64 "+position+", "+length)
                position = self.instruction("select i1 "+negative+", i64 "+adjusted+", i64 "+position)
                bad = self.instruction("icmp uge i64 "+position+", "+length)
                self.guard(bad,module,expr.token,"R4006","index out of bounds")
                data = self.instruction("extractvalue %wd.str "+base.text+", 0")
                pointer = self.instruction("getelementptr i8, ptr "+data+", i64 "+position)
                result = self.instruction("insertvalue %wd.str zeroinitializer, ptr "+pointer+", 0")
                result = self.instruction("insertvalue %wd.str "+result+", i64 1, 1")
                owner = self.instruction("extractvalue %wd.str "+base.text+", 2")
                return Value(target,self.instruction("insertvalue %wd.str "+result+", ptr "+owner+", 2"))
            if node.kind == "List":
                position = self.expression(module,expr.children[1])
                return self.load(target,self.element(base.text,self.position(base.text,position.text,module,expr.token),target))
            if node.kind == "Dict":
                key = self.expression(module,expr.children[1])
                self.site(module,expr.token)
                pointer = self.instruction("call ptr @wd_m_map_at(ptr %ctx, ptr "+base.text+", ptr "+self.spill(key)+")")
                self.propagate()
                return self.load(target,pointer)
        if kind == "Slice":
            base = self.expression(module,expr.children[0])
            bounds = ["0","0","1"]
            present = ["0","0"]
            for i in range(3):
                if expr.children[i+1] >= 0:
                    bounds[i] = self.expression(module,expr.children[i+1]).text
                    if i < 2:
                        present[i] = "1"
            self.site(module,expr.token)
            operands = ["i64 "+x for x in bounds+present]
            if self.program.signatures.pool.types[base.type].kind == "Str":
                return self.runtime_value(target,"wd_m_str_slice",["ptr "+self.spill(base)]+operands)
            if self.program.signatures.pool.types[base.type].kind == "Array":
                result = self.instruction("call ptr @wd_m_array_slice(ptr %ctx, ptr "+base.text+", i64 0, "+join(operands,", ")+")")
                self.propagate()
                return self.hold(Value(target,result),true)
            result = self.instruction("call ptr @wd_m_seq_slice(ptr %ctx, ptr "+base.text+", "+join(operands,", ")+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        self.unsupported(module,expr.token,"expression "+kind)
        return Value(target,"")

    fn block(mut self, module: int, body: list[int]):
        tree = self.program.signatures.compilation.modules[module].tree
        facts = self.program.facts[module]
        scope_start = len(self.locals)
        for index in body:
            if self.ended:
                break
            stmt = tree.statements[index]
            kind = stmt.kind
            if kind in ["Function","Record","Import","Pass"]:
                continue
            if kind == "Assign":
                type = facts.annotations[index]
                self.require_type(type,module,stmt.token)
                value = self.convert(self.expression(module,stmt.expressions[0]),type)
                self.store(value,self.slot(facts.statements[index],type))
            elif kind == "IndexAssign":
                pins = len(self.pending)
                value = self.convert(self.expression(module,stmt.expressions[1]),facts.annotations[index])
                place = self.place(module,stmt.expressions[0])
                self.settle(pins,[value]+self.path_values(place))
                self.store(value,self.address(place,true,true))
            elif kind == "AugAssign":
                type = facts.annotations[index]
                pins = len(self.pending)
                place = self.place(module,stmt.expressions[0])
                old = self.load(type,self.address(place,false))
                right = self.expression(module,stmt.expressions[1])
                value = self.operation(stmt.name,old,right,type,module,stmt.token)
                self.settle(pins,[value]+self.path_values(place))
                self.store(value,self.address(place,true))
            elif kind == "Expression":
                self.statement_call = stmt.expressions[0]
                self.statement_module = module
                self.statement_pins = len(self.pending)
                self.expression(module,stmt.expressions[0])
                self.statement_call = -1
            elif kind == "Return":
                if len(stmt.expressions) > 0:
                    value = self.convert(self.expression(module,stmt.expressions[0]),facts.annotations[index])
                    self.store(value,self.return_slot)
                if len(self.finals) > 0:
                    self.leave(1)
                else:
                    self.jump("return")
            elif kind == "Raise":
                value = self.expression(module,stmt.expressions[0])
                if self.program.signatures.pool.types[value.type].kind == "Error":
                    self.line("call void @wd.set_error(ptr %ctx, %wd.error "+value.text+")")
                    self.jump(self.handler)
                else:
                    self.failure(module,stmt.token,"R4010",value.text)
            elif kind == "If":
                condition = self.expression(module,stmt.expressions[0])
                self.drain()
                yes = self.label()
                no = self.label()
                end = self.label()
                self.branch(condition.text,yes,no)
                self.open(yes)
                self.block(module,stmt.body)
                yes_ended = self.ended
                if not self.ended:
                    self.jump(end)
                self.open(no)
                self.block(module,stmt.otherwise)
                no_ended = self.ended
                if not self.ended:
                    self.jump(end)
                if not (yes_ended and no_ended):
                    self.open(end)
            elif kind in ["While","For"]:
                test = self.label()
                inside = self.label()
                advance = self.label()
                end = self.label()
                current = ""
                stop = ""
                step = ""
                positive = ""
                source = Value(-1,"")
                source_kind = "Range"
                snapshot = ""
                protocol_cursor = Root(-1,"")
                protocol_next = -1
                yielded_value = Value(-1,"")
                if kind == "For":
                    source = self.expression(module,stmt.expressions[0])
                    source_kind = self.program.signatures.pool.types[source.type].kind
                    start = "0"
                    if source_kind == "Range":
                        start = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 0")
                        stop = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 1")
                        step = self.instruction("extractvalue "+self.type(source.type)+" "+source.text+", 2")
                        positive = self.instruction("icmp sgt i64 "+step+", 0")
                    elif source_kind in ["List","Str","Dict","Array"]:
                        snapshot = self.owned_slot(source.type,false)
                        self.store(source,snapshot)
                        if source_kind in ["List","Dict","Array"]:
                            stop = self.instruction("call i64 @"+{"List":"wd_m_seq_len","Dict":"wd_m_map_len","Array":"wd_m_array_len"}[source_kind]+"(ptr "+source.text+")")
                        else:
                            stop = self.instruction("extractvalue %wd.str "+source.text+", 1")
                    elif source_kind in ["Record","Cursor"]:
                        prepared = self.iteration_source(source,module,stmt.expressions[0])
                        protocol_cursor = prepared[0]
                        protocol_next = prepared[1]
                        source_kind = "Protocol"
                        source = Value(protocol_cursor.type,"")
                        snapshot = protocol_cursor.pointer
                    else:
                        self.unsupported(module,stmt.token,"iterator kind "+source_kind)
                    if source_kind != "Protocol":
                        current = self.temporary("i64")
                        self.line("store i64 "+start+", ptr "+current)
                    self.drain()
                loop_start = len(self.locals)
                self.jump(test)
                self.open(test)
                condition = ""
                item = ""
                if kind == "While":
                    condition = self.expression(module,stmt.expressions[0]).text
                    self.drain()
                elif source_kind == "Protocol":
                    advance_value = self.iteration_next(protocol_cursor,protocol_next,facts.annotations[index],module,stmt.token)
                    condition = advance_value[0]
                    yielded_value = advance_value[1]
                else:
                    item = self.instruction("load i64, ptr "+current)
                    below = self.instruction("icmp slt i64 "+item+", "+stop)
                    condition = below
                    if source_kind == "Range":
                        above = self.instruction("icmp sgt i64 "+item+", "+stop)
                        condition = self.instruction("select i1 "+positive+", i1 "+below+", i1 "+above)
                self.branch(condition,inside,end)
                self.open(inside)
                if kind == "For":
                    value = yielded_value if source_kind == "Protocol" else Value(facts.annotations[index],item)
                    if source_kind in ["List","Array"]:
                        pointer = self.instruction("call ptr @"+("wd_m_array_flat" if source_kind == "Array" else "wd_m_seq_read")+"(ptr "+source.text+", i64 "+item+")")
                        value = Value(facts.annotations[index],self.instruction("load "+self.type(facts.annotations[index])+", ptr "+pointer))
                    elif source_kind == "Dict":
                        pointer = self.instruction("call ptr @wd_m_map_entry(ptr "+source.text+", i64 "+item+", i64 0)")
                        value = Value(facts.annotations[index],self.instruction("load "+self.type(facts.annotations[index])+", ptr "+pointer))
                    elif source_kind == "Str":
                        pointer = self.instruction("extractvalue %wd.str "+source.text+", 0")
                        pointer = self.instruction("getelementptr i8, ptr "+pointer+", i64 "+item)
                        part = self.instruction("insertvalue %wd.str "+source.text+", ptr "+pointer+", 0")
                        value = Value(source.type,self.instruction("insertvalue %wd.str "+part+", i64 1, 1"))
                    self.store(value,self.slot(facts.statements[index],facts.annotations[index]))
                    if source_kind == "Protocol":
                        self.drain()
                append(self.loops,(advance,end))
                append(self.loop_roots,loop_start)
                self.block(module,stmt.body)
                pop(self.loop_roots)
                pop(self.loops)
                if not self.ended:
                    self.jump(advance)
                self.open(advance)
                if kind == "For" and source_kind != "Protocol":
                    old = self.instruction("load i64, ptr "+current)
                    next = ""
                    overflow = "false"
                    if source_kind == "Range":
                        pair = self.instruction("call {i64, i1} @llvm.sadd.with.overflow.i64(i64 "+old+", i64 "+step+")")
                        next = self.instruction("extractvalue {i64, i1} "+pair+", 0")
                        overflow = self.instruction("extractvalue {i64, i1} "+pair+", 1")
                    else:
                        next = self.instruction("add i64 "+old+", 1")
                    self.line("store i64 "+next+", ptr "+current)
                    self.branch(overflow,end,test)
                else:
                    self.jump(test)
                self.open(end)
                self.clean(self.locals[loop_start:])
                if snapshot != "":
                    self.release_root(Root(source.type,snapshot))
            elif kind in ["Break","Continue"]:
                if len(self.finals) > 0 and self.finals[-1].loops == len(self.loops):
                    self.leave(2 if kind == "Break" else 3)
                else:
                    self.exit_loop(kind == "Break")
            elif kind == "With":
                value = self.expression(module,stmt.expressions[0])
                resource = self.program.signatures.pool.types[value.type].kind
                if resource not in ["Stream","Task","Database","Statement","Transaction","TlsContext","PythonObject"]:
                    self.unsupported(module,stmt.token,"resource scope type "+self.type(value.type))
                self.site(module,stmt.token)
                resource_name = "py" if resource == "PythonObject" else "task" if resource == "Task" else "db" if resource == "Database" else "stmt" if resource == "Statement" else "transaction" if resource == "Transaction" else "tls_context" if resource == "TlsContext" else "stream"
                self.line("call void @wd_m_"+resource_name+"_check(ptr %ctx, ptr "+value.text+")")
                self.propagate()
                pin = self.owned_slot(value.type,false)
                self.store(value,pin)
                self.scopes[pin] = (module,stmt.token)
                binding = self.slot(facts.statements[index],value.type)
                self.store(value,binding)
                self.drain()
                self.block(module,stmt.body)
                if not self.ended:
                    self.release_root(Root(value.type,binding))
                    self.release_root(Root(value.type,pin))
                    self.propagate()
            elif kind == "Finally":
                cleanup = self.label()
                failed = self.label()
                flow = self.temporary("i32")
                self.line("store i32 0, ptr "+flow)
                error_type = self.kind_id("Error")
                saved = self.owned_slot(error_type,false)
                previous = self.handler
                self.handler = failed
                append(self.finals,Final(cleanup,flow,len(self.loops),len(self.locals),0))
                self.block(module,stmt.body)
                region = self.finals[-1]
                pop(self.finals)
                if not self.ended:
                    self.jump(cleanup)
                # An error leaving the try block waits in saved while the finally block runs.
                self.open(failed)
                self.handler = previous
                self.line(";wd.cleanup.temps")
                self.pending = []
                self.clean(self.locals[region.roots:])
                pointer = self.instruction("getelementptr %wd.ctx, ptr %ctx, i32 0, i32 1")
                self.store(self.load(error_type,pointer),saved)
                self.line("call void @wd.clear(ptr %ctx)")
                self.drain()
                self.line("store i32 4, ptr "+flow)
                self.jump(cleanup)
                self.open(cleanup)
                self.block(module,stmt.otherwise)
                if not self.ended:
                    self.resume(flow,saved,region.uses)
            elif kind == "Try":
                caught = self.label()
                end = self.label()
                previous = self.handler
                self.handler = caught
                try_start = len(self.locals)
                self.block(module,stmt.body)
                try_roots = self.locals[try_start:]
                if not self.ended:
                    self.jump(end)
                self.open(caught)
                self.handler = previous
                self.line(";wd.cleanup.temps")
                self.pending = []
                self.clean(try_roots)
                pointer = self.instruction("getelementptr %wd.ctx, ptr %ctx, i32 0, i32 1")
                failure = self.load(self.kind_id("Error"),pointer)
                binding = self.slot(facts.statements[index],failure.type)
                self.store(failure,binding)
                self.line("call void @wd.clear(ptr %ctx)")
                self.drain()
                self.block(module,stmt.otherwise)
                if not self.ended:
                    self.release_root(Root(failure.type,binding))
                    self.jump(end)
                self.open(end)
            else:
                self.unsupported(module,stmt.token,"statement "+kind)
            if not self.ended:
                self.drain()
        if not self.ended:
            self.clean(self.locals[scope_start:])
            if len(self.scopes) > 0:
                self.propagate()

    # Leaves the try block of the innermost finally block, closing its locals first as the block would.
    fn leave(mut self, how: int):
        self.drain()
        self.clean(self.locals[self.finals[-1].roots:])
        if len(self.scopes) > 0:
            self.propagate()
        self.finals[-1].uses = self.finals[-1].uses | (1 << how)
        self.line("store i32 "+str(how)+", ptr "+self.finals[-1].flow)
        self.jump(self.finals[-1].label)

    fn exit_loop(mut self, breaking: bool):
        self.clean(self.locals[self.loop_roots[-1]:])
        self.drain()
        if len(self.scopes) > 0:
            self.propagate()
        self.jump(self.loops[-1][1] if breaking else self.loops[-1][0])

    # After a finally block: continues the return, break, continue or error that led into it.
    fn resume(mut self, flow: str, saved: str, uses: int):
        how_left = self.instruction("load i32, ptr "+flow)
        for how in [1,2,3,4]:
            if how < 4 and (uses & (1 << how)) == 0:
                continue
            taken = self.label()
            rest = self.label()
            self.branch(self.instruction("icmp eq i32 "+how_left+", "+str(how)),taken,rest)
            self.open(taken)
            if how == 1:
                if len(self.finals) > 0:
                    self.leave(1)
                else:
                    self.jump("return")
            elif how < 4:
                if len(self.finals) > 0 and self.finals[-1].loops == len(self.loops):
                    self.leave(how)
                else:
                    self.exit_loop(how == 2)
            else:
                error_type = self.kind_id("Error")
                failure = self.load(error_type,saved)
                self.line("call void @wd.set_error(ptr %ctx, %wd.error "+failure.text+")")
                self.release_root(Root(error_type,saved))
                self.drain()
                self.jump(self.handler)
            self.open(rest)

    fn begin(mut self):
        self.lines = []
        self.frame = []
        self.slots = {}
        self.counter = 0
        self.current = "entry"
        self.ended = false
        self.handler = "unwind"
        self.finals = []
        self.loops = []
        self.loop_roots = []
        self.locals = []
        self.temporaries = []
        self.pending = []
        self.return_slot = ""
        self.scopes = {}

    fn rendered(mut self) -> str:
        all: list[str] = []
        for root in (self.locals+self.temporaries)[::-1]:
            all += self.cleanup(root)
        temps = ["call void @wd.clean."+str(root.type)+"(ptr "+root.pointer+")" for root in self.temporaries]
        text = join(self.frame+self.lines,"\n")
        text = replace(text,";wd.cleanup.all",join(all,"\n  "))
        return replace(text,";wd.cleanup.temps",join(temps,"\n  "))

    fn foreign_callback(mut self, name: str, type: int):
        # Each registered native thread owns an explicit borrowed scope stack.
        # No mutable global callback target and no hosted TLS initialization.
        signature = self.program.signatures.pool.types[type]
        result = self.type(signature.element)
        parameters: list[str] = []
        arguments = ["ptr %ctx"]
        for i in range(len(signature.parameters)):
            parameter = self.type(signature.parameters[i])+" %a"+str(i)
            append(parameters,parameter)
            append(arguments,parameter)
        fallback = "ret void" if result == "void" else "ret "+result+" zeroinitializer"
        lines = ["entry:","  %scope = call ptr @wd_m_callback_find(ptr "+name+")","  %absent = icmp eq ptr %scope, null","  br i1 %absent, label %skip, label %check","check:","  %cp = getelementptr {ptr,ptr,ptr,ptr},ptr %scope,i32 0,i32 1","  %ctx = load ptr,ptr %cp","  %busy = call i64 @wd_rt_unwinding(ptr %ctx)","  %failed = icmp ne i64 %busy, 0","  br i1 %failed, label %skip, label %invoke","invoke:","  %fp = getelementptr {ptr,ptr,ptr,ptr},ptr %scope,i32 0,i32 2","  %function = load ptr,ptr %fp"]
        command = "call "+result+" %function("+join(arguments,", ")+")"
        append(lines,"  "+(command if result == "void" else "%value = "+command))
        append(lines,"  %after = call i64 @wd_rt_unwinding(ptr %ctx)")
        append(lines,"  %ok = icmp eq i64 %after, 0")
        if result == "void":
            append(lines,"  ret void")
        else:
            append(lines,"  %answer = select i1 %ok, "+result+" %value, "+result+" zeroinitializer")
            append(lines,"  ret "+result+" %answer")
        lines += ["skip:","  "+fallback]
        append(self.globals,name+" = private constant i8 0")
        append(self.globals,"define private "+result+" "+name+".invoke("+join(parameters,", ")+") {\n"+join(lines,"\n")+"\n}")

    fn foreign_body(mut self, index: int):
        declaration = self.program.signatures.declarations[index]
        stmt = self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement]
        symbols = self.program.facts[declaration.module].parameters[declaration.statement]
        arguments: list[str] = []
        parameters: list[str] = []
        guards: list[tuple[str,str]] = []
        self.site(declaration.module,stmt.token)
        for i in range(len(declaration.parameters)):
            actual = declaration.parameters[i].type
            node = self.program.signatures.pool.types[actual]
            value = "%p"+str(i)
            if node.kind == "Str":
                pointer = self.instruction("extractvalue %wd.str "+value+", 0")
                count = self.instruction("extractvalue %wd.str "+value+", 1")
                parameters += ["ptr","i64"]
                arguments += ["ptr "+pointer,"i64 "+count]
            elif node.kind == "Array":
                slot = self.slots[symbols[i]]
                pointer = self.instruction("call ptr @wd_m_array_borrow(ptr %ctx, ptr "+slot+", i64 "+("1" if stmt.parameters[i].mutable_borrow else "0")+")")
                self.propagate()
                owner = self.instruction("load ptr, ptr "+slot)
                count = self.instruction("call i64 @wd_m_array_len(ptr "+owner+")")
                parameters += ["ptr","i64"]
                arguments += ["ptr "+pointer,"i64 "+count]
            elif node.kind == "Function":
                name = "@wd.cb."+str(declaration.symbol)+"."+str(i)
                self.foreign_callback(name,actual)
                append(guards,(name,value))
                append(parameters,"ptr")
                append(arguments,"ptr "+name+".invoke")
            else:
                append(parameters,self.type(actual))
                append(arguments,self.type(actual)+" "+value)
        result = self.type(declaration.result)
        if stmt.name not in self.externals:
            self.externals[stmt.name] = true
            append(self.globals,"declare "+result+" @"+stmt.name+"("+join(parameters,", ")+")")
        previous: list[str] = []
        # Install callbacks only after every fallible buffer preflight succeeds.
        for guard in guards:
            scope = self.temporary("{ptr,ptr,ptr,ptr}")
            append(previous,scope)
            self.line("call void @wd_m_callback_push(ptr "+scope+", ptr "+guard[0]+", ptr %ctx, ptr "+guard[1]+")")
        command = "call "+result+" @"+stmt.name+"("+join(arguments,", ")+")"
        value = ""
        if result == "void":
            self.line(command)
        else:
            value = self.instruction(command)
        for guard in previous[::-1]:
            self.line("call void @wd_m_callback_pop(ptr "+guard+")")
        self.propagate()
        if result != "void":
            self.line("store "+result+" "+value+", ptr "+self.return_slot)

    fn function(mut self, index: int):
        declaration = self.program.signatures.declarations[index]
        unit = self.program.signatures.compilation.modules[declaration.module]
        stmt = unit.tree.statements[declaration.statement]
        self.require_type(declaration.result,declaration.module,stmt.token)
        self.begin()
        type = self.type(declaration.result)
        if type != "void":
            self.return_slot = self.temporary(type)
        parameters = ["ptr %ctx"]
        if index in self.program.closures:
            append(parameters,"ptr %env")
            for position in range(len(self.program.closures[index].captures)):
                capture = self.program.closures[index].captures[position]
                self.require_type(capture.type,declaration.module,stmt.token)
                pointer = self.instruction("getelementptr %wd.c"+str(declaration.symbol)+", ptr %env, i32 0, i32 "+str(position))
                self.slots[capture.symbol] = pointer
        symbols = self.program.facts[declaration.module].parameters[declaration.statement]
        for i in range(len(declaration.parameters)):
            parameter = declaration.parameters[i]
            self.require_type(parameter.type,declaration.module,stmt.token)
            name = "%p"+str(i)
            borrowed = (stmt.method and i == 0) or stmt.parameters[i].mutable_borrow
            append(parameters,("ptr" if borrowed else self.type(parameter.type))+" "+name)
            if borrowed:
                self.slots[symbols[i]] = name
            else:
                # An incoming value initializes its home exactly once. There
                # is no old value to drop. LLVM ASan can hoist argument stores
                # to the entry, so a preceding zero store must not follow it.
                pointer = self.slot(symbols[i],parameter.type,false)
                self.retain(Value(parameter.type,name))
                self.line("store "+self.type(parameter.type)+" "+name+", ptr "+pointer)
        if stmt.external:
            self.foreign_body(index)
        else:
            self.block(declaration.module,stmt.body)
        if not self.ended:
            self.jump("return")
        self.open("unwind")
        self.line(";wd.cleanup.all")
        if type != "void" and self.managed(declaration.result):
            self.release_root(Root(declaration.result,self.return_slot))
        self.line("ret void" if type == "void" else "ret "+type+" zeroinitializer")
        self.ended = true
        self.open("return")
        self.line(";wd.cleanup.all")
        if len(self.scopes) > 0:
            self.propagate()
        if type == "void":
            self.line("ret void")
        else:
            result = self.instruction("load "+type+", ptr "+self.return_slot)
            self.line("ret "+type+" "+result)
        self.ended = true
        append(self.output,"define "+type+" @wd.f"+str(declaration.symbol)+"("+join(parameters,", ")+") {\nentry:\n"+self.rendered()+"\n}")

    fn ownership(mut self) -> list[str]:
        result: list[str] = []
        for id in self.used_types:
            if not self.managed(id):
                continue
            type = self.type(id)
            node = self.program.signatures.pool.types[id]
            if node.kind == "List":
                stride = "1" if self.zero_size(node.element) else "ptrtoint (ptr getelementptr ("+self.type(node.element)+", ptr null, i64 1) to i64)"
                append(result,"@wd.empty."+str(id)+" = private constant %wd.seq { { i64, i64, ptr } { i64 -1, i64 0, ptr null }, i64 0, i64 0, i64 "+stride+", "+self.callbacks(node.element)+" }")
            for mode in ["retain","drop"]:
                lines: list[str] = []
                if node.kind in ["Str","List","Dict","Stream","Json","Callable","Array","Task","Database","Statement","Transaction","TlsContext","PythonObject"]:
                    owner = "%v"
                    if node.kind == "Str":
                        append(lines,"  %o = extractvalue %wd.str %v, 2")
                        owner = "%o"
                    append(lines,"  call void @wd_m_"+("retain" if mode == "retain" else "release")+"(ptr "+owner+")")
                else:
                    fields: list[int] = []
                    if node.kind in ["Optional","Step"]:
                        # Absent payloads are always zero-initialized by this ABI.
                        fields = [node.element]
                    elif node.kind == "Tuple":
                        fields = node.parameters
                    elif node.kind == "Record":
                        fields = [p.type for p in self.program.signatures.declarations[self.declarations[node.declaration]].parameters]
                    elif node.kind == "Closure":
                        fields = [p.type for p in self.program.closures[self.declarations[node.declaration]].captures]
                    elif node.kind == "Cursor":
                        fields = [node.element]
                    elif node.kind == "Error":
                        fields = [self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Str")]
                    for i in range(len(fields)):
                        if self.managed(fields[i]):
                            position = 1 if node.kind in ["Optional","Step"] else i
                            append(lines,"  %f"+str(i)+" = extractvalue "+type+" %v, "+str(position))
                            append(lines,"  call void @wd."+mode+"."+str(fields[i])+"("+self.type(fields[i])+" %f"+str(i)+")")
                append(result,"define void @wd."+mode+"."+str(id)+"("+type+" %v) {\n"+join(lines,"\n")+"\n  ret void\n}")
                append(result,"define void @wd."+mode+".slot."+str(id)+"(ptr %p) {\n  %v = load "+type+", ptr %p\n  call void @wd."+mode+"."+str(id)+"("+type+" %v)\n  ret void\n}")
            append(result,"define void @wd.clean."+str(id)+"(ptr %p) {\n  %v = load "+type+", ptr %p\n  store "+type+" zeroinitializer, ptr %p\n  call void @wd.drop."+str(id)+"("+type+" %v)\n  ret void\n}")
            if node.kind == "Dict":
                pair = "{ "+self.type(node.key)+", "+self.type(node.element)+" }"
                fields = [node.key,node.element]
                for mode in ["retain","drop"]:
                    lines = ["  %entry = load "+pair+", ptr %p"]
                    for i in range(2):
                        if self.managed(fields[i]):
                            append(lines,"  %f"+str(i)+" = extractvalue "+pair+" %entry, "+str(i))
                            append(lines,"  call void @wd."+mode+"."+str(fields[i])+"("+self.type(fields[i])+" %f"+str(i)+")")
                    append(result,"define void @wd.map."+mode+"."+str(id)+"(ptr %p) {\n"+join(lines,"\n")+"\n  ret void\n}")
                key_type = self.type(node.key)
                lines = ["  %a = load "+key_type+", ptr %ap","  %b = load "+key_type+", ptr %bp"]
                if self.program.signatures.pool.types[node.key].kind == "Str":
                    append(lines,"  %order = call i32 @wd.compare(%wd.str %a, %wd.str %b)")
                else:
                    append(lines,"  %same = icmp eq "+key_type+" %a, %b")
                    append(lines,"  %less = icmp "+("ult" if key_type == "i1" else "slt")+" "+key_type+" %a, %b")
                    append(lines,"  %different = select i1 %less, i32 -1, i32 1")
                    append(lines,"  %order = select i1 %same, i32 0, i32 %different")
                append(result,"define i32 @wd.key."+str(id)+"(ptr %ap, ptr %bp) {\n"+join(lines,"\n")+"\n  ret i32 %order\n}")
        return result

    fn erased_invocations(mut self) -> list[str]:
        result: list[str] = []
        for id in self.erasures:
            node = self.program.signatures.pool.types[id]
            parameters = ["ptr %ctx","ptr %data"]
            arguments = ["ptr %ctx"]
            if node.kind == "Closure":
                append(arguments,"ptr %data")
            for i in range(len(node.parameters)):
                parameter = self.type(node.parameters[i])+" %a"+str(i)
                append(parameters,parameter)
                append(arguments,parameter)
            code = "@wd.f"+str(node.declaration)
            lines: list[str] = []
            if node.kind == "Function":
                append(lines,"  %fn = load ptr, ptr %data")
                code = "%fn"
            type = self.type(node.element)
            prefix = "" if type == "void" else "%result = "
            append(lines,"  "+prefix+"call "+type+" "+code+"("+join(arguments,", ")+")")
            append(lines,"  ret void" if type == "void" else "  ret "+type+" %result")
            append(result,"define "+type+" @wd.invoke."+str(id)+"("+join(parameters,", ")+") {\n"+join(lines,"\n")+"\n}")
        return result

    fn format_fields(self, id: int) -> list[int]:
        node = self.program.signatures.pool.types[id]
        if node.kind in ["List","Optional","Step"]:
            return [node.element]
        if node.kind == "Dict":
            return [node.key,node.element]
        if node.kind == "Tuple":
            return node.parameters
        if node.kind == "Record":
            return [p.type for p in self.program.signatures.declarations[self.declarations[node.declaration]].parameters]
        if node.kind == "Error":
            return [self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Int"),self.kind_id("Int")]
        return []

    fn require_format(mut self, id: int, module: int, token: lx.Token):
        if id in self.format_types:
            return
        self.format_types[id] = true
        kind = self.program.signatures.pool.types[id].kind
        if kind not in ["None","Bool","Int","Float","Str","List","Dict","Json","Optional","Tuple","Record","Error","Array","Function","Callable","Closure","Cursor","Range","Stream","Step","Task","Database","Statement","Transaction","TlsContext","PythonObject"]:
            self.unsupported(module,token,"formatting "+kind)
        for child in self.format_fields(id):
            self.require_format(child,module,token)

    fn format_descriptors(mut self) -> list[str]:
        result: list[str] = []
        kinds = {"None":0,"Bool":1,"Int":2,"Float":3,"Str":4,"List":5,"Dict":6,"Json":7,"Optional":8,"Tuple":9,"Record":10,"Error":11,"Array":12,"Function":13,"Callable":14,"Closure":15,"Cursor":16,"Range":17,"Stream":18,"Step":19,"Task":20,"Database":21,"Statement":22,"Transaction":23,"TlsContext":24,"PythonObject":25}
        for id in self.format_types:
            node = self.program.signatures.pool.types[id]
            fields = self.format_fields(id)
            names: list[str] = []
            name = "zeroinitializer"
            if node.kind == "Record":
                declaration = self.program.signatures.declarations[self.declarations[node.declaration]]
                names = [p.name for p in declaration.parameters]
                name = self.string(self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement].name)
            entries: list[str] = []
            for i in range(len(fields)):
                offset = "0"
                if node.kind in ["Optional","Step","Tuple","Record","Error"]:
                    offset = "ptrtoint (ptr getelementptr ("+self.type(id)+", ptr null, i32 0, i32 "+str(1 if node.kind in ["Optional","Step"] else i)+") to i64)"
                label = self.string(names[i]) if len(names)>0 else "zeroinitializer"
                append(entries,"{ %wd.str, i64, ptr } { %wd.str "+label+", i64 "+offset+", ptr @wd.format.type."+str(fields[i])+" }")
            array = "@wd.format.fields."+str(id)
            append(result,array+" = private constant ["+str(len(entries))+" x { %wd.str, i64, ptr }] ["+join(entries,", ")+"]")
            append(result,"@wd.format.type."+str(id)+" = private constant { i64, i64, ptr, %wd.str } { i64 "+str(kinds[node.kind])+", i64 "+str(len(fields))+", ptr "+array+", %wd.str "+name+" }")
        return result

    fn json_descriptors(mut self) -> list[str]:
        result: list[str] = []
        kinds = {"None":0,"Bool":1,"Int":2,"Float":3,"Str":4,"List":5,"Dict":6,"Json":7,"Optional":8,"Tuple":9,"Record":10,"Error":11}
        for id in self.used_types:
            node = self.program.signatures.pool.types[id]
            fields: list[int] = []
            names: list[str] = []
            if node.kind in ["List","Dict","Optional"]:
                fields = [node.element]
            elif node.kind == "Tuple":
                fields = node.parameters
            elif node.kind == "Record":
                parameters = self.program.signatures.declarations[self.declarations[node.declaration]].parameters
                fields = [p.type for p in parameters]
                names = [p.name for p in parameters]
            elif node.kind == "Error":
                fields = [self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Int"),self.kind_id("Int")]
                names = ["code","message","file","line","column"]
            entries: list[str] = []
            for i in range(len(fields)):
                name = self.string(names[i]) if len(names) > 0 else "zeroinitializer"
                offset = "0"
                if node.kind in ["Record","Tuple","Error","Optional"]:
                    position = 1 if node.kind == "Optional" else i
                    offset = "ptrtoint (ptr getelementptr ("+self.type(id)+", ptr null, i32 0, i32 "+str(position)+") to i64)"
                append(entries,"{ %wd.str, i64, ptr } { %wd.str "+name+", i64 "+offset+", ptr @wd.json.type."+str(fields[i])+" }")
            array = "@wd.json.fields."+str(id)
            append(result,array+" = private constant ["+str(len(entries))+" x { %wd.str, i64, ptr }] ["+join(entries,", ")+"]")
            append(result,"@wd.json.type."+str(id)+" = private constant { i64, i64, i64, ptr } { i64 "+str(get(kinds,node.kind,-1))+", i64 "+str(len(fields))+", i64 0, ptr "+array+" }")
        return result

    fn equal_lists(mut self):
        index = 0
        while index < len(self.equal_types):
            request = self.equal_types[index]
            index += 1
            type = request[0]
            node = self.program.signatures.pool.types[type]
            element = node.element
            dictionary = node.kind == "Dict"
            self.begin()
            length_function = "wd_m_map_len" if dictionary else "wd_m_seq_len"
            length = self.instruction("call i64 @"+length_function+"(ptr %a)")
            other = self.instruction("call i64 @"+length_function+"(ptr %b)")
            same = self.instruction("icmp eq i64 "+length+", "+other)
            self.branch(same,"test","different")
            self.open("test")
            current = self.instruction("phi i64 [ 0, %entry ], [ %next, %advance ]")
            done = self.instruction("icmp eq i64 "+current+", "+length)
            self.branch(done,"equal","item")
            self.open("item")
            a = ""
            b = ""
            if dictionary:
                key = self.instruction("call ptr @wd_m_map_entry(ptr %a, i64 "+current+", i64 0)")
                found = self.instruction("call i64 @wd_m_map_find(ptr %b, ptr "+key+")")
                present = self.instruction("icmp sge i64 "+found+", 0")
                self.branch(present,"values","different")
                self.open("values")
                a = self.instruction("call ptr @wd_m_map_entry(ptr %a, i64 "+current+", i64 1)")
                b = self.instruction("call ptr @wd_m_map_entry(ptr %b, i64 "+found+", i64 1)")
            else:
                a = self.instruction("call ptr @wd_m_seq_read(ptr %a, i64 "+current+")")
                b = self.instruction("call ptr @wd_m_seq_read(ptr %b, i64 "+current+")")
            av = Value(element,self.instruction("load "+self.type(element)+", ptr "+a))
            bv = Value(element,self.instruction("load "+self.type(element)+", ptr "+b))
            value = self.compare("==",av,bv,request[1],request[2])
            self.branch(value,"advance","different")
            self.open("advance")
            self.line("%next = add i64 "+current+", 1")
            self.jump("test")
            self.open("different")
            self.line("ret i1 false")
            self.ended = true
            self.open("equal")
            self.line("ret i1 true")
            self.ended = true
            append(self.output,"define i1 @wd.equal."+str(type)+"(ptr %a, ptr %b) {\nentry:\n"+self.rendered()+"\n}")

    fn run(mut self, runtime: str) -> str:
        entry = self.program.signatures.compilation.entry
        self.collect_block(entry,self.program.signatures.compilation.modules[entry].tree.roots)
        cursor = 0
        while cursor < len(self.needed):
            index = self.needed[cursor]
            declaration = self.program.signatures.declarations[index]
            stmt = self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement]
            self.collect_block(declaration.module,stmt.body)
            cursor += 1
        for index in self.needed:
            self.function(index)
        self.begin()
        append(self.frame,"  %ctx = alloca %wd.ctx")
        self.line("store %wd.ctx zeroinitializer, ptr %ctx")
        self.line("call void @wd_m_threads_init()")
        self.block(entry,self.program.signatures.compilation.modules[entry].tree.roots)
        if not self.ended:
            self.jump("return")
        self.open("unwind")
        self.line(";wd.cleanup.all")
        if self.python_used:
            self.line("call void @wd_m_py_finish(ptr %ctx)")
        exited = self.instruction("call i1 @wd.exited(ptr %ctx)")
        self.branch(exited,"exit","report")
        self.open("report")
        self.line("call void @wd.report(ptr %ctx)")
        self.line("call void @wd.clear(ptr %ctx)")
        self.line("call void @wd.check_memory()")
        self.line("ret i32 70")
        self.ended = true
        self.open("exit")
        code = self.instruction("getelementptr %wd.ctx, ptr %ctx, i32 0, i32 6")
        code = self.instruction("load i32, ptr "+code)
        self.line("call void @wd.clear(ptr %ctx)")
        self.line("call void @wd.check_memory()")
        self.line("ret i32 "+code)
        self.ended = true
        self.open("return")
        self.line(";wd.cleanup.all")
        if self.python_used:
            self.line("call void @wd_m_py_finish(ptr %ctx)")
        if len(self.scopes) > 0 or self.python_used:
            self.propagate()
        self.line("call void @wd.clear(ptr %ctx)")
        self.line("call void @wd.check_memory()")
        self.line("ret i32 0")
        self.ended = true
        append(self.output,"define i32 @wd_main() {\nentry:\n"+self.rendered()+"\n}")
        self.equal_lists()
        records: list[str] = []
        emitted: dict[int,bool] = {}
        for type in self.used_types:
            node = self.program.signatures.pool.types[type]
            if node.kind == "Record" and node.declaration not in emitted:
                emitted[node.declaration] = true
                declaration = self.program.signatures.declarations[self.declarations[node.declaration]]
                fields = [self.type(field.type) for field in declaration.parameters]
                append(records,"%wd.r"+str(node.declaration)+" = type { "+join(fields,", ")+" }")
            if node.kind == "Closure" and -node.declaration not in emitted:
                emitted[-node.declaration] = true
                fields = [self.type(field.type) for field in self.program.closures[self.declarations[node.declaration]].captures]
                append(records,"%wd.c"+str(node.declaration)+" = type { "+join(fields,", ")+" }")
        descriptors = self.json_descriptors()+self.format_descriptors()
        optional: list[str] = []
        if self.python_used:
            append(optional,"define void @wd.python_scope_close(ptr %ctx,ptr %slot,%wd.str %file,i64 %line,i64 %column) {\n  %value = load ptr,ptr %slot\n  call void @wd.site(ptr %ctx,%wd.str %file,i64 %line,i64 %column)\n  call void @wd_m_py_close(ptr %ctx,ptr %value)\n  ret void\n}")
        if self.system_libraries:
            append(optional,"@wd.native.system_libraries = private constant i8 1")
            append(optional,"define void @wd.tls_scope_close(ptr %ctx,ptr %slot,%wd.str %file,i64 %line,i64 %column) {\n  %value = load ptr,ptr %slot\n  call void @wd.site(ptr %ctx,%wd.str %file,i64 %line,i64 %column)\n  call void @wd_m_tls_context_close(ptr %ctx,ptr %value)\n  ret void\n}")
            for kind in range(3):
                name = ["database","statement","transaction"][kind]
                append(optional,"define void @wd."+name+"_scope_close(ptr %ctx,ptr %slot,%wd.str %file,i64 %line,i64 %column) {\n  %value = load ptr,ptr %slot\n  call void @wd.site(ptr %ctx,%wd.str %file,i64 %line,i64 %column)\n  call void @wd_m_sqlite_scope_close(ptr %ctx,ptr %value,i64 "+str(kind)+")\n  ret void\n}")
        return runtime+"\n"+join(optional+self.globals+records+descriptors+self.ownership()+self.erased_invocations()+self.output,"\n")+"\n"

record Result:
    text: str
    diagnostic: src.Diagnostic

fn emit(program: ir.Result, runtime: str) -> Result:
    if program.diagnostic.code != "":
        return Result("",program.diagnostic)
    declarations: dict[int,int] = {}
    for index in range(len(program.signatures.declarations)):
        declarations[program.signatures.declarations[index].symbol] = index
    generator = Generator(program,{},[],[],[],[],{},0,"entry",false,"unwind",[],declarations,src.success(),[],{},{},{},[],[],[],-1,-1,0,[],"",[],{},{},{},{},false,false,{"Void":"void","Int":"i64","Float":"double","Bool":"i1","None":"i8","Str":"%wd.str","Error":"%wd.error","Range":"{ i64, i64, i64 }","Function":"ptr","Callable":"ptr","List":"ptr","Dict":"ptr","Stream":"ptr","Json":"ptr","Array":"ptr","Task":"ptr","Database":"ptr","Statement":"ptr","Transaction":"ptr","TlsContext":"ptr","PythonObject":"ptr"},[])
    try:
        return Result(generator.run(runtime),src.success())
    except err:
        if generator.problem.code != "":
            return Result("",generator.problem)
        raise err
