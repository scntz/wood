            item = Value(node.element,self.instruction("load "+self.type(node.element)+", ptr "+source))
            destination = self.instruction("call ptr @wd_m_seq_read(ptr "+owner+", i64 "+current+")")
            self.store(item,destination)
            next = self.instruction("add i64 "+current+", 1")
            self.line("store i64 "+next+", ptr "+position)
