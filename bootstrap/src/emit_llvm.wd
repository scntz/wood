            return self.runtime_value(target,"wd_m_json_dump",["ptr "+result.text])
        if name == "json_parse":
            result = self.instruction("call ptr @wd_m_json_parse(ptr %ctx, ptr "+self.spill(arguments[0])+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name in ["json_kind","json_str"]:
            return self.runtime_value(target,"wd_m_"+name,["ptr "+arguments[0].text])
        if name in ["json_list","json_dict","json_int","json_float","json_bool"]:
            type = "ptr" if name in ["json_list","json_dict"] else ("double" if name == "json_float" else "i64")
            result = self.instruction("call "+type+" @wd_m_"+name+"(ptr %ctx, ptr "+arguments[0].text+")")
            self.propagate()
            if name == "json_bool":
                result = self.instruction("icmp ne i64 "+result+", 0")
            return self.hold(Value(target,result),true)
        if name in ["print","eprint"]:
            self.site(module,token)
            fd = "1" if name == "print" else "2"
            for i in range(len(arguments)):
                if i > 0:
                    space = self.string(" ")
                    self.output_text(space,fd)
                self.print_value(arguments[i],fd,module,token)
            newline = self.string("\n")
            self.output_text(newline,fd)
            return Value(target,"")
        if name == "assert":
            bad = self.instruction("xor i1 "+arguments[0].text+", true")
            message = self.string("assertion failed") if len(arguments) == 1 else arguments[1].text
            rejected = self.label()
            valid = self.label()
            self.branch(bad,rejected,valid)
            self.open(rejected)
            self.failure(module,token,"R4004",message)
            self.open(valid)
            return Value(target,"")
        if name == "stream_open":
            result = self.instruction("call ptr @wd_m_stream_open(ptr %ctx, ptr "+self.spill(arguments[0])+", ptr "+self.spill(arguments[1])+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "tls_version":
            self.system_libraries = true
            return self.runtime_value(target,"wd_m_tls_version",[])
        if name in ["tcp_connect","tcp_listen","tcp_accept","tcp_port","tcp_shutdown_write","stream_timeout","tls_context_new","tls_context_close","tls_accept","tls_connect"]:
            self.system_libraries = true
            operands = ["ptr %ctx"]
            for item in arguments:
                append(operands,("ptr "+self.spill(item)) if self.program.signatures.pool.types[item.type].kind == "Str" else (self.type(item.type)+" "+item.text))
            command = "call "+self.type(target)+" @wd_m_"+name+"("+join(operands,", ")+")"
            value = ""
            if self.program.signatures.pool.types[target].kind == "Void":
                self.line(command)
            else:
                value = self.instruction(command)
            self.propagate()
            return self.hold(Value(target,value),true)
        if name == "stream_closed":
            closed = self.instruction("call i64 @wd_m_stream_closed(ptr "+arguments[0].text+")")
            return Value(target,self.instruction("icmp ne i64 "+closed+", 0"))
        if name in ["stream_read","stream_read_line"]:
            return self.runtime_value(target,"wd_m_stream_line" if name == "stream_read_line" else "wd_m_stream_read",["ptr "+arguments[0].text,"i64 "+arguments[1].text])
        if name in ["stream_write","stream_close","stream_flush","stream_seek","stream_tell"]:
            operands = ["ptr %ctx","ptr "+arguments[0].text]
            if name == "stream_write":
                append(operands,"ptr "+self.spill(arguments[1]))
            if name == "stream_close":
                append(operands,"i64 1")
            if name == "stream_seek":
                append(operands,"i64 "+arguments[1].text)
            command = "call "+self.type(target)+" @wd_m_"+name+"("+join(operands,", ")+")"
