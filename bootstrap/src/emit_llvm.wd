# Native lowering consumes the same checked facts as emit_cpp. No C++ text or
# runtime is used in its output. Unsupported ownership families fail explicitly.
import checked_program as ir
import lexer as lx
import sources as src

record Value:
    type: int
    text: str

record Root:
    type: int
    pointer: str

record Access:
    type: int
    parent: int
    kind: str
    index: Value
    module: int
    token: lx.Token

record Place:
    pointer: str
    steps: list[Access]

# A finally block around the statement being emitted. Return, break and continue that leave its
# try block store how they left in flow (1, 2, 3) and jump to label, where the finally block runs
# and then leaves the same way; an error stores 4. roots is where the try block's locals start.
record Final:
    label: str
    flow: str
    loops: int
    roots: int
    uses: int

record Generator:
    program: ir.Result
    constants: dict[str,str]
    globals: list[str]
    output: list[str]
    lines: list[str]
    frame: list[str]
    slots: dict[int,str]
    counter: int
    current: str
    ended: bool
    handler: str
    loops: list[tuple[str,str]]
    declarations: dict[int,int]
    problem: src.Diagnostic
    needed: list[int]
    visited: dict[int,bool]
    used_types: dict[int,bool]
    managed_types: dict[int,bool]
    locals: list[Root]
    temporaries: list[Root]
    pending: list[Root]
    statement_call: int
    statement_module: int
    statement_pins: int
    loop_roots: list[int]
    return_slot: str
    equal_types: list[tuple[int,int,lx.Token]]
    scopes: dict[str,tuple[int,lx.Token]]
    erasures: dict[int,bool]
    externals: dict[str,bool]
    format_types: dict[int,bool]
    python_used: bool
    system_libraries: bool
    # Fixed for one emission; never rebuild this dictionary in type() queries.
    type_names: dict[str,str]
    finals: list[Final]

    fn unsupported(mut self, module: int, token: lx.Token, detail: str):
        self.problem = src.located("B3501","native LLVM backend does not yet support "+detail,self.program.signatures.compilation.modules[module].file,module,token)
        raise "native lowering rejected"

    fn type(self, value: int) -> str:
        node = self.program.signatures.pool.types[value]
        if node.kind in self.type_names:
            return self.type_names[node.kind]
        if node.kind == "Record":
            return "%wd.r"+str(node.declaration)
        if node.kind == "Closure":
            return "%wd.c"+str(node.declaration)
        if node.kind in ["Optional","Step"]:
            return "{ i1, "+self.type(node.element)+" }"
        if node.kind == "Cursor":
            source = self.program.signatures.pool.types[node.element]
            return "{ "+("ptr" if source.kind == "Dict" else self.type(node.element))+", i64 }"
        if node.kind == "Tuple":
            return "{ "+join([self.type(item) for item in node.parameters],", ")+" }"
        raise "unsupported native value type: "+node.kind

    fn require_type(mut self, value: int, module: int, token: lx.Token):
        if value in self.used_types:
            return
        self.used_types[value] = true
        node = self.program.signatures.pool.types[value]
        if node.kind == "PythonObject":
            # Optional/record-held resources can need scope helpers without an
            # executed Python builtin (for example a None-only caller).
            self.python_used = true
        if node.kind in ["Database","Statement","Transaction","TlsContext","PythonObject"]:
            self.system_libraries = true
        if node.kind not in ["Void","Int","Float","Bool","None","Str","Error","Range","Function","Record","Tuple","Optional","List","Dict","Stream","Json","Closure","Callable","Step","Cursor","Array","Task","Database","Statement","Transaction","TlsContext","PythonObject"]:
            self.unsupported(module,token,"type "+self.program.signatures.pool.display(value))
        if node.kind in ["Optional","Function","List","Dict","Callable","Closure","Step","Cursor","Array"]:
            self.require_type(node.element,module,token)
        if node.kind == "Dict":
            self.require_type(node.key,module,token)
        if node.kind == "Error":
            self.require_type(self.kind_id("Str"),module,token)
            self.require_type(self.kind_id("Int"),module,token)
        for child in node.parameters:
            self.require_type(child,module,token)
        if node.kind == "Record":
            for field in self.program.signatures.declarations[self.declarations[node.declaration]].parameters:
                self.require_type(field.type,module,token)
        if node.kind == "Closure":
            for capture in self.program.closures[self.declarations[node.declaration]].captures:
                self.require_type(capture.type,module,token)

    fn need(mut self, index: int):
        if index >= 0 and index not in self.visited:
            self.visited[index] = true
            append(self.needed,index)

    fn collect_expression(mut self, module: int, index: int):
        if index < 0:
            return
        facts = self.program.facts[module]
        expr = self.program.signatures.compilation.modules[module].tree.expressions[index]
        if expr.kind == "Closure":
            self.need(self.declarations[self.program.signatures.pool.types[facts.types[index]].declaration])
        if index in facts.protocols:
            self.need(facts.protocols[index].make)
            self.need(facts.protocols[index].next)
        if index in facts.calls:
            call = facts.calls[index]
            if call.kind in ["declared","function","closure"]:
                self.need(call.target)
            for argument in call.arguments:
                self.collect_expression(argument.module,argument.expression)
        else:
            for child in self.program.signatures.compilation.modules[module].tree.expressions[index].children:
                self.collect_expression(module,child)

    fn collect_block(mut self, module: int, body: list[int]):
        for index in body:
            stmt = self.program.signatures.compilation.modules[module].tree.statements[index]
            if stmt.kind in ["Function","Record","Import"]:
                continue
            for expression in stmt.expressions:
                self.collect_expression(module,expression)
            self.collect_block(module,stmt.body)
            self.collect_block(module,stmt.otherwise)

    fn fresh(mut self) -> str:
        self.counter += 1
        return "%n"+str(self.counter)

    fn label(mut self) -> str:
        self.counter += 1
        return "b"+str(self.counter)

    fn line(mut self, text: str):
        if self.ended:
            raise "instruction after native terminator"
        append(self.lines,"  "+text)

    fn instruction(mut self, text: str) -> str:
        name = self.fresh()
        self.line(name+" = "+text)
        return name

    fn open(mut self, label: str):
        append(self.lines,label+":")
        self.current = label
        self.ended = false

    fn jump(mut self, label: str):
        self.line("br label %"+label)
        self.ended = true

    fn branch(mut self, condition: str, yes: str, no: str):
        self.line("br i1 "+condition+", label %"+yes+", label %"+no)
        self.ended = true

    fn string(mut self, text: str) -> str:
        if text not in self.constants:
            name = "@wd.s"+str(len(self.constants))
            hexadecimal = "0123456789ABCDEF"
            encoded: list[str] = []
            for byte in text:
                number = byte_value(byte)
                append(encoded,"\\"+hexadecimal[number//16]+hexadecimal[number%16])
            append(self.globals,name+" = private constant ["+str(len(text))+" x i8] c\""+join(encoded,"")+"\"")
            self.constants[text] = "{ ptr "+name+", i64 "+str(len(text))+", ptr null }"
        return self.constants[text]

    fn managed(mut self, type: int) -> bool:
        if type in self.managed_types:
            return self.managed_types[type]
        node = self.program.signatures.pool.types[type]
        result = node.kind in ["Str","List","Dict","Error","Stream","Json","Callable","Array","Task","Database","Statement","Transaction","TlsContext","PythonObject"]
        if node.kind in ["Optional","Step","Cursor"]:
            result = self.managed(node.element)
        if node.kind == "Tuple":
            for child in node.parameters:
                result = self.managed(child) or result
        if node.kind == "Record":
            for field in self.program.signatures.declarations[self.declarations[node.declaration]].parameters:
                result = self.managed(field.type) or result
        if node.kind == "Closure":
            for capture in self.program.closures[self.declarations[node.declaration]].captures:
                result = self.managed(capture.type) or result
        self.managed_types[type] = result
        return result

    fn retain(mut self, value: Value):
        if self.managed(value.type):
            self.line("call void @wd.retain."+str(value.type)+"("+self.type(value.type)+" "+value.text+")")

    fn cleanup(mut self, root: Root) -> list[str]:
        lines: list[str] = []
        if not self.managed(root.type):
            return lines
        if root.pointer in self.scopes:
            site = self.scopes[root.pointer]
            file = self.string(self.program.signatures.compilation.modules[site[0]].file)
            helper = "wd.task_scope_close" if self.program.signatures.pool.types[root.type].kind == "Task" else "wd.scope_close"
            if self.program.signatures.pool.types[root.type].kind in ["Database","Statement","Transaction"]:
                helper = {"Database":"wd.database_scope_close","Statement":"wd.statement_scope_close","Transaction":"wd.transaction_scope_close"}[self.program.signatures.pool.types[root.type].kind]
            if self.program.signatures.pool.types[root.type].kind == "PythonObject":
                helper = "wd.python_scope_close"
            if self.program.signatures.pool.types[root.type].kind == "TlsContext":
                helper = "wd.tls_scope_close"
            append(lines,"call void @"+helper+"(ptr %ctx, ptr "+root.pointer+", %wd.str "+file+", i64 "+str(site[1].line)+", i64 "+str(site[1].column)+")")
        append(lines,"call void @wd.clean."+str(root.type)+"(ptr "+root.pointer+")")
        return lines

    fn release_root(mut self, root: Root):
        for line in self.cleanup(root):
            self.line(line)

    fn clean(mut self, roots: list[Root]):
        for i in range(len(roots)-1,-1,-1):
            self.release_root(roots[i])

    fn drain(mut self):
        self.clean(self.pending)
        self.pending = []

    # Ends the pins a statement took while evaluating, just before it writes. Otherwise a value read
    # from the collection being written, as in x[i] = x[i] + 1, makes the write copy all of x, because
    # the pin looks like a second owner. Kept values may have no other owner, so they get their own
    # first. Only a statement may do this: inside an expression, earlier operands still need their pins.
    # A string cannot be a second owner of a collection, so its pin stays. With nothing to release, as in
    # append(parts, str(i)), this adds no code to the loop.
    fn settle(mut self, start: int, kept: list[Value]):
        released: list[Root] = []
        remaining = self.pending[:start]
        for root in self.pending[start:]:
            if self.managed(root.type) and self.program.signatures.pool.types[root.type].kind != "Str":
                append(released,root)
            else:
                append(remaining,root)
        self.pending = remaining
        if len(released) == 0:
            return
        for value in kept:
            if value.text != "":
                self.hold(value)
        self.clean(released)

    fn path_values(self, place: Place) -> list[Value]:
        return [step.index for step in place.steps]

    fn owned_slot(mut self, type: int, transient: bool = true) -> str:
        self.require_type(type,0,src.origin())
        pointer = self.temporary(self.type(type))
        if self.managed(type):
            root = Root(type,pointer)
            if transient:
                append(self.temporaries,root)
                append(self.pending,root)
            else:
                append(self.locals,root)
        return pointer

    fn hold(mut self, value: Value, transfer: bool = false) -> Value:
        if self.managed(value.type):
            pointer = self.owned_slot(value.type)
            if transfer:
                # The root may have held a value in an earlier loop iteration.
                old = self.instruction("load "+self.type(value.type)+", ptr "+pointer)
                self.line("call void @wd.drop."+str(value.type)+"("+self.type(value.type)+" "+old+")")
                self.line("store "+self.type(value.type)+" "+value.text+", ptr "+pointer)
            else:
                self.store(value,pointer)
        return value

    fn spill(mut self, value: Value) -> str:
        pointer = self.temporary(self.type(value.type))
        self.line("store "+self.type(value.type)+" "+value.text+", ptr "+pointer)
        return pointer

    fn site(mut self, module: int, token: lx.Token):
        file = self.string(self.program.signatures.compilation.modules[module].file)
        self.line("call void @wd.site(ptr %ctx, %wd.str "+file+", i64 "+str(token.line)+", i64 "+str(token.column)+")")

    fn callbacks(mut self, type: int) -> str:
        if not self.managed(type):
            return "ptr null, ptr null"
        return "ptr @wd.retain.slot."+str(type)+", ptr @wd.drop.slot."+str(type)

    fn stride(mut self, type: int) -> str:
        end = self.instruction("getelementptr "+self.type(type)+", ptr null, i64 1")
        size = self.instruction("ptrtoint ptr "+end+" to i64")
        # Empty nominal records/tuples still occupy a distinct sequence slot.
        zero = self.instruction("icmp eq i64 "+size+", 0")
        return self.instruction("select i1 "+zero+", i64 1, i64 "+size)

    fn zero_size(self, type: int) -> bool:
        node = self.program.signatures.pool.types[type]
        if node.kind == "Tuple":
            for child in node.parameters:
                if not self.zero_size(child):
                    return false
            return true
        if node.kind == "Record":
            for field in self.program.signatures.declarations[self.declarations[node.declaration]].parameters:
                if not self.zero_size(field.type):
                    return false
            return true
        if node.kind == "Closure":
            for capture in self.program.closures[self.declarations[node.declaration]].captures:
                if not self.zero_size(capture.type):
                    return false
            return true
        return false

    fn runtime_value(mut self, type: int, name: str, operands: list[str]) -> Value:
        pointer = self.owned_slot(type)
        self.line("call void @"+name+"(ptr %ctx, ptr "+pointer+(", " if len(operands) > 0 else "")+join(operands,", ")+")")
        self.propagate()
        return Value(type,self.instruction("load "+self.type(type)+", ptr "+pointer))

    fn map_slot(mut self, type: int, module: int, token: lx.Token) -> str:
        node = self.program.signatures.pool.types[type]
        pair = "{ "+self.type(node.key)+", "+self.type(node.element)+" }"
        end = self.instruction("getelementptr "+pair+", ptr null, i64 1")
        stride = self.instruction("ptrtoint ptr "+end+" to i64")
        member = self.instruction("getelementptr "+pair+", ptr null, i32 0, i32 1")
        offset = self.instruction("ptrtoint ptr "+member+" to i64")
        key_size = self.stride(node.key)
        key_copy = "ptr @wd.retain.slot."+str(node.key) if self.managed(node.key) else "ptr null"
        pointer = self.owned_slot(type)
        self.site(module,token)
        entry_copy = "ptr @wd.map.retain."+str(type)+", ptr @wd.map.drop."+str(type) if self.managed(node.key) or self.managed(node.element) else "ptr null, ptr null"
        value = self.instruction("call ptr @wd_m_map_new(ptr %ctx, i64 "+stride+", i64 "+offset+", i64 "+key_size+", "+entry_copy+", "+key_copy+", ptr @wd.key."+str(type)+")")
        self.line("store ptr "+value+", ptr "+pointer)
        self.propagate()
        return pointer

    fn integer_span(mut self, value: Value) -> str:
        node = self.program.signatures.pool.types[value.type]
        if node.kind == "Int":
            return "ptr "+self.spill(value)+", i64 1"
        if node.kind == "List":
            pointer = self.instruction("call ptr @wd_m_seq_read(ptr "+value.text+", i64 0)")
            size = self.instruction("call i64 @wd_m_seq_len(ptr "+value.text+")")
            return "ptr "+pointer+", i64 "+size
        size = len(node.parameters)
        type = "["+str(size)+" x i64]"
        pointer = self.temporary(type)
        for i in range(size):
            item = self.instruction("extractvalue "+self.type(value.type)+" "+value.text+", "+str(i))
            at = self.instruction("getelementptr "+type+", ptr "+pointer+", i32 0, i32 "+str(i))
            self.line("store i64 "+item+", ptr "+at)
        return "ptr "+pointer+", i64 "+str(size)

    fn array_operand(mut self, value: Value) -> str:
        node = self.program.signatures.pool.types[value.type]
        array = node.kind == "Array"
        floating = self.program.signatures.pool.types[node.element].kind == "Float" if array else node.kind == "Float"
        return "ptr "+(value.text if array else self.spill(value))+", i64 "+str((2 if array else 0)+(1 if floating else 0))

    fn kind_id(self, kind: str) -> int:
        for index in range(len(self.program.signatures.pool.types)):
            if self.program.signatures.pool.types[index].kind == kind:
                return index
        raise "missing native semantic type"

    fn slot(mut self, symbol: int, type: int, initialize: bool = true) -> str:
        self.require_type(type,0,src.origin())
        if symbol not in self.slots:
            pointer = "%v"+str(symbol)
            append(self.frame,"  "+pointer+" = alloca "+self.type(type))
            if initialize:
                append(self.frame,"  store "+self.type(type)+" zeroinitializer, ptr "+pointer)
            self.slots[symbol] = pointer
            if self.managed(type):
                append(self.locals,Root(type,pointer))
        return self.slots[symbol]

    fn temporary(mut self, type: str) -> str:
        pointer = self.fresh()
        append(self.frame,"  "+pointer+" = alloca "+type)
        append(self.frame,"  store "+type+" zeroinitializer, ptr "+pointer)
        return pointer

    fn load(mut self, type: int, pointer: str) -> Value:
        return self.hold(Value(type,self.instruction("load "+self.type(type)+", ptr "+pointer)))

    fn store(mut self, value: Value, pointer: str):
        if self.managed(value.type):
            self.retain(value)
            old = self.instruction("load "+self.type(value.type)+", ptr "+pointer)
            self.line("call void @wd.drop."+str(value.type)+"("+self.type(value.type)+" "+old+")")
        self.line("store "+self.type(value.type)+" "+value.text+", ptr "+pointer)

    fn convert(mut self, value: Value, target: int) -> Value:
        if value.type == target:
            return value
        source = self.program.signatures.pool.types[value.type]
        result = self.program.signatures.pool.types[target]
        if result.kind == "Optional":
            if source.kind == "None":
                return Value(target,"zeroinitializer")
            item = self.convert(value,result.element)
            first = self.instruction("insertvalue "+self.type(target)+" zeroinitializer, i1 true, 0")
            return Value(target,self.instruction("insertvalue "+self.type(target)+" "+first+", "+self.type(item.type)+" "+item.text+", 1"))
        if result.kind == "Callable":
            self.require_type(target,0,src.origin())
            self.erasures[value.type] = true
            size = "0" if self.zero_size(value.type) else self.stride(value.type)
            owner = self.instruction("call ptr @wd_m_callable_new(ptr %ctx, i64 "+size+", "+self.callbacks(value.type)+", ptr @wd.invoke."+str(value.type)+", ptr "+self.spill(value)+")")
            self.propagate()
            return self.hold(Value(target,owner),true)
        if result.kind == "Float" and source.kind == "Int":
            return Value(target,self.instruction("sitofp i64 "+value.text+" to double"))
        raise "invalid checked native conversion"

    fn failure(mut self, module: int, token: lx.Token, code: str, message: str):
        file = self.string(self.program.signatures.compilation.modules[module].file)
        code_value = self.string(code)
        self.line("call void @wd.fail(ptr %ctx, %wd.str "+code_value+", %wd.str "+message+", %wd.str "+file+", i64 "+str(token.line)+", i64 "+str(token.column)+")")
        self.jump(self.handler)

    fn guard(mut self, bad: str, module: int, token: lx.Token, code: str, message: str):
        rejected = self.label()
        valid = self.label()
        self.branch(bad,rejected,valid)
        self.open(rejected)
        self.failure(module,token,code,self.string(message))
        self.open(valid)

    fn propagate(mut self):
        exited = self.instruction("call i1 @wd.exited(ptr %ctx)")
        running = self.label()
        self.branch(exited,"unwind",running)
        self.open(running)
        bad = self.instruction("call i1 @wd.failed(ptr %ctx)")
        valid = self.label()
        self.branch(bad,self.handler,valid)
        self.open(valid)

    fn checked(mut self, op: str, a: str, b: str, module: int, token: lx.Token) -> str:
        names = {"+":"sadd","-":"ssub","*":"smul"}
        messages = {"+":"addition","-":"subtraction","*":"multiplication"}
        pair = self.instruction("call {i64, i1} @llvm."+names[op]+".with.overflow.i64(i64 "+a+", i64 "+b+")")
        value = self.instruction("extractvalue {i64, i1} "+pair+", 0")
        overflow = self.instruction("extractvalue {i64, i1} "+pair+", 1")
        self.guard(overflow,module,token,"R4001","integer overflow in "+messages[op])
        return value

    fn compare(mut self, op: str, left: Value, right: Value, module: int, token: lx.Token) -> str:
        if op in ["in","not in"]:
            return self.operation(op,left,right,self.kind_id("Bool"),module,token).text
        a = self.program.signatures.pool.types[left.type]
        b = self.program.signatures.pool.types[right.type]
        equal = op in ["==","is","!=","is not"]
        negate = op in ["!=","is not"]
        if a.kind == "Array" and b.kind == "Array":
            result = self.instruction("call i64 @wd_m_array_equal(ptr "+left.text+", ptr "+right.text+")")
            return self.instruction("icmp "+("eq" if negate else "ne")+" i64 "+result+", 0")
        if a.kind == "Json" and b.kind == "Json":
            result = self.instruction("call i64 @wd_m_json_equal(ptr "+left.text+", ptr "+right.text+")")
            return self.instruction("icmp "+("eq" if negate else "ne")+" i64 "+result+", 0")
        if a.kind == "None" or b.kind == "None":
            other = right if a.kind == "None" else left
            other_type = b if a.kind == "None" else a
            present = "false"
            if other_type.kind == "Optional":
                present = self.instruction("extractvalue "+self.type(other.type)+" "+other.text+", 0")
            return present if negate else self.instruction("xor i1 "+present+", true")
        if a.kind in ["Optional","Step"] or b.kind in ["Optional","Step"]:
            target = left.type if a.kind == "Optional" else (right.type if b.kind == "Optional" else left.type)
            left = self.convert(left,target)
            right = self.convert(right,target)
            ty = self.type(target)
            pa = self.instruction("extractvalue "+ty+" "+left.text+", 0")
            pb = self.instruction("extractvalue "+ty+" "+right.text+", 0")
            same = self.instruction("icmp eq i1 "+pa+", "+pb)
            element = self.program.signatures.pool.types[target].element
            av = self.instruction("extractvalue "+ty+" "+left.text+", 1")
            bv = self.instruction("extractvalue "+ty+" "+right.text+", 1")
            contents = self.compare("==",Value(element,av),Value(element,bv),module,token)
            absent = self.instruction("xor i1 "+pa+", true")
            contents = self.instruction("or i1 "+absent+", "+contents)
            result = self.instruction("and i1 "+same+", "+contents)
            return self.instruction("xor i1 "+result+", true") if negate else result
        if a.kind in ["Tuple","Record","Error"]:
            if not equal:
                self.unsupported(module,token,"aggregate ordering")
            fields = a.parameters
            if a.kind == "Record":
                fields = [p.type for p in self.program.signatures.declarations[self.declarations[a.declaration]].parameters]
            elif a.kind == "Error":
                fields = [self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Str"),self.kind_id("Int"),self.kind_id("Int")]
            result = "true"
            for i in range(len(fields)):
                av = self.instruction("extractvalue "+self.type(left.type)+" "+left.text+", "+str(i))
                bv = self.instruction("extractvalue "+self.type(right.type)+" "+right.text+", "+str(i))
                same = self.compare("==",Value(fields[i],av),Value(fields[i],bv),module,token)
                result = self.instruction("and i1 "+result+", "+same)
            return self.instruction("xor i1 "+result+", true") if negate else result
        if a.kind in ["List","Dict"]:
            if not equal:
                self.unsupported(module,token,"container ordering")
            known = false
            for entry in self.equal_types:
                known = known or entry[0] == left.type
            if not known:
                append(self.equal_types,(left.type,module,token))
            same = self.instruction("call i1 @wd.equal."+str(left.type)+"(ptr "+left.text+", ptr "+right.text+")")
            return self.instruction("xor i1 "+same+", true") if negate else same
        conditions = {"==":"eq","!=":"ne","is":"eq","is not":"ne","<":"slt","<=":"sle",">":"sgt",">=":"sge"}
        if op not in conditions:
            self.unsupported(module,token,"comparison "+op)
        if a.kind == "Str":
            ordering = self.instruction("call i32 @wd.compare(%wd.str "+left.text+", %wd.str "+right.text+")")
            return self.instruction("icmp "+conditions[op]+" i32 "+ordering+", 0")
        if a.kind == "Float" or b.kind == "Float":
            left = self.convert(left,self.kind_id("Float"))
            right = self.convert(right,self.kind_id("Float"))
            floating = {"==":"oeq","!=":"une","<":"olt","<=":"ole",">":"ogt",">=":"oge"}
            if op not in floating:
                self.unsupported(module,token,"float identity")
            return self.instruction("fcmp "+floating[op]+" double "+left.text+", "+right.text)
        return self.instruction("icmp "+conditions[op]+" "+self.type(left.type)+" "+left.text+", "+right.text)

    fn operation(mut self, op: str, left: Value, right: Value, target: int, module: int, token: lx.Token) -> Value:
        node = self.program.signatures.pool.types[target]
        if op in ["==","!=","is","is not","<","<=",">",">="]:
            return Value(target,self.compare(op,left,right,module,token))
        if op in ["in","not in"]:
            kind = self.program.signatures.pool.types[right.type].kind
            if kind == "Dict":
                found = self.instruction("call i64 @wd_m_map_find(ptr "+right.text+", ptr "+self.spill(left)+")")
                return Value(target,self.instruction("icmp "+("sge" if op == "in" else "slt")+" i64 "+found+", 0"))
            if kind == "Str":
                found = self.instruction("call i64 @wd_m_find(ptr "+self.spill(right)+", ptr "+self.spill(left)+")")
                return Value(target,self.instruction("icmp "+("sge" if op == "in" else "slt")+" i64 "+found+", 0"))
            if kind == "List":
                index = self.temporary("i64")
                result = self.temporary("i1")
                test = self.label()
                body = self.label()
                advance = self.label()
                yes = self.label()
                end = self.label()
                self.line("store i64 0, ptr "+index)
                self.line("store i1 false, ptr "+result)
                size = self.instruction("call i64 @wd_m_seq_len(ptr "+right.text+")")
                self.jump(test)
                self.open(test)
                current = self.instruction("load i64, ptr "+index)
                more = self.instruction("icmp slt i64 "+current+", "+size)
                self.branch(more,body,end)
                self.open(body)
                pointer = self.instruction("call ptr @wd_m_seq_read(ptr "+right.text+", i64 "+current+")")
                element = self.program.signatures.pool.types[right.type].element
                item = Value(element,self.instruction("load "+self.type(element)+", ptr "+pointer))
                found = self.compare("==",self.convert(left,element),item,module,token)
                self.branch(found,yes,advance)
                self.open(advance)
                following = self.instruction("add i64 "+current+", 1")
                self.line("store i64 "+following+", ptr "+index)
                self.jump(test)
                self.open(yes)
                self.line("store i1 true, ptr "+result)
                self.jump(end)
                self.open(end)
                found = self.instruction("load i1, ptr "+result)
                return Value(target,self.instruction("xor i1 "+found+", true") if op == "not in" else found)
            self.unsupported(module,token,"membership on "+kind)
        if node.kind == "Array":
            self.site(module,token)
            result = self.instruction("call ptr @wd_m_array_binary(ptr %ctx, "+self.array_operand(left)+", "+self.array_operand(right)+", i64 "+str({"+":0,"-":1,"*":2,"/":3}[op])+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if node.kind in ["Str","List"] and op in ["+","*"]:
            self.site(module,token)
            if node.kind == "Str":
                if op == "+":
                    return self.runtime_value(target,"wd_m_str_concat",["ptr "+self.spill(left),"ptr "+self.spill(right)])
                sequence = left if self.program.signatures.pool.types[left.type].kind == "Str" else right
                count = right if sequence.type == left.type else left
                return self.runtime_value(target,"wd_m_str_repeat",["ptr "+self.spill(sequence),"i64 "+count.text])
            result = ""
            if op == "+":
                result = self.instruction("call ptr @wd_m_seq_concat(ptr %ctx, ptr "+left.text+", ptr "+right.text+")")
            else:
                sequence = left if self.program.signatures.pool.types[left.type].kind == "List" else right
                count = right if sequence.type == left.type else left
                result = self.instruction("call ptr @wd_m_seq_repeat(ptr %ctx, ptr "+sequence.text+", i64 "+count.text+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if node.kind == "Float":
            left = self.convert(left,target)
            right = self.convert(right,target)
            if op == "/":
                bad = self.instruction("fcmp oeq double "+right.text+", 0.0")
                self.guard(bad,module,token,"R4002","division by zero")
            operations = {"+":"fadd","-":"fsub","*":"fmul","/":"fdiv"}
            if op not in operations:
                self.unsupported(module,token,"floating operator "+op)
            return Value(target,self.instruction(operations[op]+" double "+left.text+", "+right.text))
        if node.kind != "Int":
            self.unsupported(module,token,"operator "+op+" on "+node.kind)
        a = left.text
        b = right.text
        if op in ["+","-","*"]:
            return Value(target,self.checked(op,a,b,module,token))
        if op in ["&","|","^"]:
            return Value(target,self.instruction({"&":"and","|":"or","^":"xor"}[op]+" i64 "+a+", "+b))
        if op in ["<<",">>"]:
            low = self.instruction("icmp slt i64 "+b+", 0")
            high = self.instruction("icmp sgt i64 "+b+", 63")
            bad = self.instruction("or i1 "+low+", "+high)
            self.guard(bad,module,token,"R4014","shift count must be in 0..63")
            if op == ">>":
                return Value(target,self.instruction("ashr i64 "+a+", "+b))
            wide = self.instruction("sext i64 "+a+" to i128")
            count = self.instruction("zext i64 "+b+" to i128")
            product = self.instruction("shl i128 "+wide+", "+count)
            narrow = self.instruction("trunc i128 "+product+" to i64")
            restored = self.instruction("sext i64 "+narrow+" to i128")
            overflow = self.instruction("icmp ne i128 "+product+", "+restored)
            self.guard(overflow,module,token,"R4001","integer overflow in left shift")
            return Value(target,narrow)
        if op in ["//","%"]:
            zero = self.instruction("icmp eq i64 "+b+", 0")
            self.guard(zero,module,token,"R4002","division by zero")
            minimum = self.instruction("icmp eq i64 "+a+", -9223372036854775808")
            minus = self.instruction("icmp eq i64 "+b+", -1")
            edge = self.instruction("and i1 "+minimum+", "+minus)
            if op == "//":
                self.guard(edge,module,token,"R4001","integer overflow in division")
            else:
                b = self.instruction("select i1 "+edge+", i64 1, i64 "+b)
            remainder = self.instruction("srem i64 "+a+", "+b)
            nonzero = self.instruction("icmp ne i64 "+remainder+", 0")
            rnegative = self.instruction("icmp slt i64 "+remainder+", 0")
            bnegative = self.instruction("icmp slt i64 "+b+", 0")
            opposite = self.instruction("xor i1 "+rnegative+", "+bnegative)
            adjust = self.instruction("and i1 "+nonzero+", "+opposite)
            if op == "//":
                quotient = self.instruction("sdiv i64 "+a+", "+b)
                amount = self.instruction("zext i1 "+adjust+" to i64")
                return Value(target,self.instruction("sub i64 "+quotient+", "+amount))
            amount = self.instruction("select i1 "+adjust+", i64 "+b+", i64 0")
            return Value(target,self.instruction("add i64 "+remainder+", "+amount))
        self.unsupported(module,token,"integer operator "+op)
        return Value(target,"")

    fn place(mut self, module: int, expression: int, validate: bool = true) -> Place:
        facts = self.program.facts[module]
        node = self.program.signatures.compilation.modules[module].tree.expressions[expression]
        if node.kind == "Name":
            return Place(self.slots[facts.symbols[expression]],[])
        if node.kind in ["Member","Index"]:
            base = node.children[0]
            base_kind = self.program.signatures.pool.types[facts.types[base]].kind
            if (node.kind == "Index" and base_kind not in ["Tuple","List","Dict","Array"]) or (node.kind == "Member" and base_kind not in ["Record","Error"]):
                self.unsupported(module,node.token,"mutable indexed storage")
            place = self.place(module,base,validate)
            # Validate outer indexes before executing a deeper index expression.
            if validate:
                self.address(place,false)
            field = facts.symbols[expression]
            if base_kind == "Error":
                field = {"code":0,"message":1,"file":2,"line":3,"column":4}[node.token.text]
            key = Value(self.kind_id("Int"),str(field))
            if base_kind in ["List","Dict","Array"]:
                key = self.expression(module,node.children[1])
            access = {"List":"list","Dict":"dict","Array":"array"}[base_kind] if base_kind in ["List","Dict","Array"] else "field"
            append(place.steps,Access(facts.types[expression],facts.types[base],access,key,module,node.token))
            return place
        self.unsupported(module,node.token,"mutable path "+node.kind)
        return Place("",[])

    fn address(mut self, place: Place, mutate: bool, insert: bool = false) -> str:
        pointer = place.pointer
        for i in range(len(place.steps)):
            step = place.steps[i]
            if step.kind == "field":
                pointer = self.instruction("getelementptr "+self.type(step.parent)+", ptr "+pointer+", i32 0, i32 "+step.index.text)
            elif step.kind == "array" and self.fixed_rank(step.index):
                source = self.instruction("load ptr, ptr "+pointer)
                element = self.array_element(source,step.index,step.module,step.token)
                if mutate:
                    element = self.own_array(pointer,source,element,step.index,step.module,step.token)
                pointer = element
            elif step.kind == "array":
                self.site(step.module,step.token)
                span = self.integer_span(step.index)
                source = pointer if mutate else self.instruction("load ptr, ptr "+pointer)
                pointer = self.instruction("call ptr @wd_m_array_"+("edit" if mutate else "at")+"(ptr %ctx, ptr "+source+", "+span+")")
                self.propagate()
            elif step.kind == "dict":
                self.site(step.module,step.token)
                key = self.spill(step.index)
                if mutate:
                    pointer = self.instruction("call ptr @wd_m_map_edit(ptr %ctx, ptr "+pointer+", ptr "+key+", i64 "+("1" if insert and i == len(place.steps)-1 else "0")+")")
                else:
                    source = self.instruction("load ptr, ptr "+pointer)
                    pointer = self.instruction("call ptr @wd_m_map_at(ptr %ctx, ptr "+source+", ptr "+key+")")
                self.propagate()
            else:
                source = self.instruction("load ptr, ptr "+pointer)
                position = self.position(source,step.index.text,step.module,step.token)
                if mutate:
                    self.own_list(pointer,source,step.module,step.token)
                    source = self.instruction("load ptr, ptr "+pointer)
                pointer = self.element(source,position,step.type)
        return pointer

    # Lists and arrays are indexed inline, so a loop over their elements makes no runtime call
    # unless a value it changes is shared and has to be copied first.

    # A list index checked against the length, with a negative one counted from the end.
    fn position(mut self, sequence: str, index: str, module: int, token: lx.Token) -> str:
        length = self.instruction("call i64 @wd.list_length(ptr "+sequence+")")
        negative = self.instruction("icmp slt i64 "+index+", 0")
        adjusted = self.instruction("add i64 "+index+", "+length)
        position = self.instruction("select i1 "+negative+", i64 "+adjusted+", i64 "+index)
        bad = self.instruction("icmp uge i64 "+position+", "+length)
        self.guard(bad,module,token,"R4006","index out of bounds")
        return position

    # Elements follow the 64-byte list header; empty records and tuples take one byte each.
    fn element(mut self, sequence: str, position: str, type: int) -> str:
        start = self.instruction("getelementptr i8, ptr "+sequence+", i64 64")
        if self.zero_size(type):
            return self.instruction("getelementptr i8, ptr "+start+", i64 "+position)
        return self.instruction("getelementptr "+self.type(type)+", ptr "+start+", i64 "+position)

    # Copy on write: a list that another value shares is copied before this one changes it.
    fn own_list(mut self, slot: str, sequence: str, module: int, token: lx.Token):
        shared = self.label()
        owned = self.label()
        self.branch(self.instruction("call i1 @wd.exclusive(ptr "+sequence+")"),owned,shared)
        self.open(shared)
        self.site(module,token)
        length = self.instruction("call i64 @wd.list_length(ptr "+sequence+")")
        self.instruction("call ptr @wd_m_seq_unique(ptr %ctx, ptr "+slot+", i64 "+length+")")
        self.propagate()
        self.jump(owned)
        self.open(owned)

    # An int, or a tuple of ints, names one element of an array with that many axes.
    fn fixed_rank(self, coordinate: Value) -> bool:
        node = self.program.signatures.pool.types[coordinate.type]
        return node.kind == "Int" or node.kind == "Tuple"

    fn array_element(mut self, array: str, coordinate: Value, module: int, token: lx.Token) -> str:
        node = self.program.signatures.pool.types[coordinate.type]
        indices: list[str] = []
        if node.kind == "Int":
            indices = [coordinate.text]
        else:
            for i in range(len(node.parameters)):
                append(indices,self.instruction("extractvalue "+self.type(coordinate.type)+" "+coordinate.text+", "+str(i)))
        rank = self.instruction("load i64, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 32"))
        wrong = self.instruction("icmp ne i64 "+rank+", "+str(len(indices)))
        self.guard(wrong,module,token,"R4026","one integer index is required for each array axis")
        at = self.instruction("load i64, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 48"))
        for axis in range(len(indices)):
            size = self.instruction("load i64, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 "+str(64+8*axis)))
            stride = self.instruction("load i64, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 "+str(128+8*axis)))
            negative = self.instruction("icmp slt i64 "+indices[axis]+", 0")
            adjusted = self.instruction("add i64 "+indices[axis]+", "+size)
            position = self.instruction("select i1 "+negative+", i64 "+adjusted+", i64 "+indices[axis])
            bad = self.instruction("icmp uge i64 "+position+", "+size)
            self.guard(bad,module,token,"R4006","index out of bounds")
            at = self.instruction("add i64 "+at+", "+self.instruction("mul i64 "+position+", "+stride))
        storage = self.instruction("load ptr, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 24"))
        start = self.instruction("getelementptr i8, ptr "+storage+", i64 64")
        return self.instruction("getelementptr i64, ptr "+start+", i64 "+at)

    # Copy on write for an array: its descriptor and its buffer must both have one owner.
    fn own_array(mut self, slot: str, array: str, element: str, coordinate: Value, module: int, token: lx.Token) -> str:
        result = self.temporary("ptr")
        self.line("store ptr "+element+", ptr "+result)
        shared = self.label()
        check = self.label()
        owned = self.label()
        self.branch(self.instruction("call i1 @wd.exclusive(ptr "+array+")"),check,shared)
        self.open(check)
        storage = self.instruction("load ptr, ptr "+self.instruction("getelementptr i8, ptr "+array+", i64 24"))
        self.branch(self.instruction("call i1 @wd.exclusive(ptr "+storage+")"),owned,shared)
        self.open(shared)
        self.site(module,token)
        copied = self.instruction("call ptr @wd_m_array_edit(ptr %ctx, ptr "+slot+", "+self.integer_span(coordinate)+")")
        self.propagate()
        self.line("store ptr "+copied+", ptr "+result)
        self.jump(owned)
        self.open(owned)
        return self.instruction("load ptr, ptr "+result)

    # A local list or array read at an index that calls nothing: nothing can change the collection while
    # the index is computed, so the element is read in place without pinning the collection.
    fn local_element(mut self, module: int, expression: int, target: int) -> str:
        tree = self.program.signatures.compilation.modules[module].tree
        node = tree.expressions[expression]
        facts = self.program.facts[module]
        base = node.children[0]
        kind = self.program.signatures.pool.types[facts.types[base]].kind
        coordinate = self.program.signatures.pool.types[facts.types[node.children[1]]].kind
        if tree.expressions[base].kind != "Name" or not (kind == "List" or (kind == "Array" and coordinate in ["Int","Tuple"])) or not self.call_free(module,node.children[1]):
            return ""
        slot = self.projection(module,base)
        if slot == "":
            return ""
        index = self.expression(module,node.children[1])
        collection = self.instruction("load ptr, ptr "+slot)
        if kind == "Array":
            return self.array_element(collection,index,module,node.token)
        return self.element(collection,self.position(collection,index.text,module,node.token),target)

    fn call_free(self, module: int, expression: int) -> bool:
        tree = self.program.signatures.compilation.modules[module].tree
        node = tree.expressions[expression]
        if expression in self.program.facts[module].calls or node.kind not in ["Integer","Bool","Name","Unary","Binary","Member","Index","Tuple","Conditional","CompareChain"]:
            return false
        for child in node.children:
            if child >= 0 and not self.call_free(module,child):
                return false
        return true

    fn path(mut self, module: int, expression: int) -> str:
        return self.address(self.place(module,expression),true,true)

    fn projection(mut self, module: int, expression: int) -> str:
        facts = self.program.facts[module]
        node = self.program.signatures.compilation.modules[module].tree.expressions[expression]
        if node.kind == "Name":
            return self.slots[facts.symbols[expression]] if expression not in facts.calls else ""
        if node.kind not in ["Member","Index"]:
            return ""
        base = node.children[0]
        kind = self.program.signatures.pool.types[facts.types[base]].kind
        if (node.kind == "Member" and kind not in ["Record","Error"]) or (node.kind == "Index" and kind != "Tuple"):
            return ""
        pointer = self.projection(module,base)
        if pointer == "":
            return ""
        field = facts.symbols[expression]
        if kind == "Error":
            field = {"code":0,"message":1,"file":2,"line":3,"column":4}[node.token.text]
        return self.instruction("getelementptr "+self.type(facts.types[base])+", ptr "+pointer+", i32 0, i32 "+str(field))

    fn rooted(self, module: int, expression: int) -> bool:
        node = self.program.signatures.compilation.modules[module].tree.expressions[expression]
        if node.kind == "Name":
            return expression not in self.program.facts[module].calls
        return node.kind in ["Member","Index"] and self.rooted(module,node.children[0])

    fn passive(self, module: int, expression: int) -> bool:
        # There are no overload/property effects. Native closures/foreign calls
        # remain unsupported. Unknown calls conservatively require a snapshot.
        facts = self.program.facts[module]
        node = self.program.signatures.compilation.modules[module].tree.expressions[expression]
        if expression in facts.calls:
            call = facts.calls[expression]
            if call.kind == "function":
                return true
            if call.kind == "declared":
                declaration = self.program.signatures.declarations[call.target]
                statement = self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement]
                if not statement.method or statement.mutating or statement.external:
                    return false
                for parameter in statement.parameters:
                    if parameter.mutable_borrow:
                        return false
            elif call.kind == "builtin":
                if call.name not in ["len","str","int","float","byte_value","byte_string","find","starts_with","ends_with","unwrap"]:
                    return false
            elif call.kind not in ["construct","snapshot"]:
                return false
            for ref in call.arguments:
                if not self.passive(ref.module,ref.expression):
                    return false
            return true
        if node.kind not in ["Name","Integer","Float","Bool","None","String","Tuple","List","Dict","Member","Index","Slice","Unary","Binary","Conditional","CompareChain"]:
            return false
        for child in node.children:
            if child >= 0 and not self.passive(module,child):
                return false
        return true

    fn stringify(mut self, value: Value, quoted: bool, module: int, token: lx.Token) -> Value:
        node = self.program.signatures.pool.types[value.type]
        target = self.kind_id("Str")
        self.require_type(target,module,token)
        if node.kind == "Str":
            return self.runtime_value(target,"wd_m_repr_str",["ptr "+self.spill(value)]) if quoted else value
        if node.kind in ["Int","Float"]:
            return self.runtime_value(target,"wd_m_int_str" if node.kind == "Int" else "wd_m_float_str",[self.type(value.type)+" "+value.text])
        if node.kind == "Array":
            return self.runtime_value(target,"wd_m_array_str",["ptr "+value.text])
        if node.kind == "None":
            return Value(target,self.string("None"))
        if node.kind == "Bool":
            return Value(target,self.instruction("select i1 "+value.text+", %wd.str "+self.string("true")+", %wd.str "+self.string("false")))
        if node.kind in ["Function","Callable","Closure","Cursor","Range"]:
            return Value(target,self.string({"Function":"<function>","Callable":"<callable>","Closure":"<closure>","Cursor":"<cursor>","Range":"<range>"}[node.kind]))
        self.require_format(value.type,module,token)
        return self.runtime_value(target,"wd_m_format_value",["ptr @wd.format.type."+str(value.type),"ptr "+self.spill(value),"i64 "+("1" if quoted else "0")])

    fn print_value(mut self, value: Value, fd: str, module: int, token: lx.Token):
        if self.program.signatures.pool.types[value.type].kind == "Int":
            self.line("call void @wd.checked_integer(ptr %ctx, i64 "+fd+", i64 "+value.text+")")
            self.propagate()
            return
        text = self.stringify(value,false,module,token)
        self.output_text(text.text,fd)

    fn output_text(mut self, text: str, fd: str):
        self.line("call void @wd.checked_text(ptr %ctx, i64 "+fd+", %wd.str "+text+")")
        self.propagate()

    fn call(mut self, module: int, expression: int) -> Value:
        # Calls nested in its arguments are not the statement, so this ends here.
        whole_statement = expression == self.statement_call and module == self.statement_module
        self.statement_call = -1
        call = self.program.facts[module].calls[expression]
        token = self.program.signatures.compilation.modules[module].tree.expressions[expression].token
        target = self.program.facts[module].types[expression]
        self.require_type(target,module,token)
        if call.kind == "function":
            return Value(target,"@wd.f"+str(self.program.signatures.declarations[call.target].symbol))
        if call.kind == "snapshot":
            ref = call.arguments[0]
            return self.expression(ref.module,ref.expression)
        if call.kind == "builtin" and call.name == "next":
            ref = call.arguments[0]
            place = self.place(ref.module,ref.expression)
            self.address(place,false)
            pointer = self.address(place,true)
            actual = self.program.facts[ref.module].types[ref.expression]
            item = self.program.signatures.pool.types[target].element
            present = self.native_step(pointer,actual,item,module,token)
            aggregate = self.instruction("insertvalue "+self.type(target)+" zeroinitializer, i1 "+present[0]+", 0")
            return Value(target,self.instruction("insertvalue "+self.type(target)+" "+aggregate+", "+self.type(item)+" "+present[1].text+", 1"))
        if call.kind == "closure" or (call.kind == "indirect" and self.program.signatures.pool.types[self.program.facts[call.arguments[0].module].types[call.arguments[0].expression]].kind == "Callable"):
            return self.invocation(module,expression)
        if call.kind == "builtin" and call.name in ["append","pop","remove"]:
            ref = call.arguments[0]
            # Builtins cache indexes, evaluate remaining arguments, then borrow
            # the current path. Methods/borrowed parameters retain early checks.
            place = self.place(ref.module,ref.expression,false)
            value = Value(target,"")
            if call.name in ["append","remove"]:
                ref = call.arguments[1]
                container = self.program.signatures.pool.types[self.program.facts[call.arguments[0].module].types[call.arguments[0].expression]]
                element = container.key if call.name == "remove" else container.element
                value = self.convert(self.expression(ref.module,ref.expression),element)
            if whole_statement:
                self.settle(self.statement_pins,[value]+self.path_values(place))
            self.site(module,token)
            pointer = self.address(place,true)
            if call.name == "remove":
                removed = self.instruction("call i64 @wd_m_map_remove(ptr %ctx, ptr "+pointer+", ptr "+self.spill(value)+")")
                self.propagate()
                return Value(target,self.instruction("icmp ne i64 "+removed+", 0"))
            if call.name == "append":
                self.line("call void @wd_m_seq_append(ptr %ctx, ptr "+pointer+", ptr "+self.spill(value)+")")
                self.propagate()
                return Value(target,"")
            out = self.owned_slot(target)
            self.line("call void @wd_m_seq_pop(ptr %ctx, ptr "+pointer+", ptr "+out+")")
            self.propagate()
            return Value(target,self.instruction("load "+self.type(target)+", ptr "+out))
        if call.kind not in ["declared","construct","builtin","indirect"]:
            self.unsupported(module,token,"call kind "+call.kind)
        arguments: list[Value] = []
        pointers: dict[int,str] = {}
        places: dict[int,Place] = {}
        mutations: dict[int,bool] = {}
        snapshots: list[Value] = []
        if call.kind in ["declared","construct"]:
            declaration = self.program.signatures.declarations[call.target]
            stmt = self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement]
            for parameter in declaration.parameters:
                append(arguments,Value(parameter.type,""))
        for i in range(len(call.arguments)):
            reference = call.arguments[i]
            if call.kind in ["declared","construct"]:
                declaration = self.program.signatures.declarations[call.target]
                stmt = self.program.signatures.compilation.modules[declaration.module].tree.statements[declaration.statement]
                position = call.order[i]
                borrowed = call.kind == "declared" and ((stmt.method and stmt.mutating and position == 0) or stmt.parameters[position].mutable_borrow)
                if borrowed:
                    places[position] = self.place(reference.module,reference.expression)
                    mutations[position] = true
                    self.address(places[position],false)
                elif call.kind == "declared" and stmt.method and position == 0:
                    safe = self.rooted(reference.module,reference.expression)
                    for j in range(len(call.arguments)):
                        if j != i:
                            ref = call.arguments[j]
                            safe = safe and self.passive(ref.module,ref.expression)
                    if safe:
                        places[position] = self.place(reference.module,reference.expression)
                        mutations[position] = false
                        self.address(places[position],false)
                    else:
                        # Snapshot before effectful later arguments; the callee
                        # borrows only this privately owned receiver value.
                        value = self.expression(reference.module,reference.expression)
                        append(snapshots,value)
                        pointers[position] = self.spill(value)
                else:
                    arguments[position] = self.convert(self.expression(reference.module,reference.expression),declaration.parameters[position].type)
            else:
                append(arguments,self.expression(reference.module,reference.expression))
        if call.kind == "construct":
            aggregate = "zeroinitializer"
            for i in range(len(arguments)):
                item = arguments[i]
                aggregate = self.instruction("insertvalue "+self.type(target)+" "+aggregate+", "+self.type(item.type)+" "+item.text+", "+str(i))
            return Value(target,aggregate)
        if call.kind in ["declared","indirect"]:
            if whole_statement and True in [mutations[position] for position in places]:
                kept = arguments+snapshots
                for position in places:
                    kept = kept+self.path_values(places[position])
                self.settle(self.statement_pins,kept)
            for position in places:
                pointers[position] = self.address(places[position],mutations[position])
            function = ""
            if call.kind == "declared":
                function = "@wd.f"+str(self.program.signatures.declarations[call.target].symbol)
            else:
                function = arguments[0].text
                signature = self.program.signatures.pool.types[arguments[0].type]
                arguments = arguments[1:]
                for i in range(len(arguments)):
                    arguments[i] = self.convert(arguments[i],signature.parameters[i])
            operands = ["ptr %ctx"]
            for i in range(len(arguments)):
                append(operands,("ptr "+pointers[i]) if i in pointers else (self.type(arguments[i].type)+" "+arguments[i].text))
            command = "call "+self.type(target)+" "+function+"("+join(operands,", ")+")"
            result = ""
            if self.program.signatures.pool.types[target].kind == "Void":
                self.line(command)
            else:
                result = self.instruction(command)
            self.propagate()
            return self.hold(Value(target,result),true)
        name = call.name
        self.site(module,token)
        if starts_with(name,"db_") or starts_with(name,"stmt_") or starts_with(name,"py_"):
            # A used optional service selects an explicit Linux system-library
            # profile. Ordinary native compiler/application builds stay static.
            self.system_libraries = true
            self.python_used = self.python_used or starts_with(name,"py_")
            operands: list[str] = []
            for item in arguments:
                append(operands,("ptr "+self.spill(item)) if self.program.signatures.pool.types[item.type].kind == "Str" else (self.type(item.type)+" "+item.text))
            if self.program.signatures.pool.types[target].kind == "Str":
                return self.runtime_value(target,"wd_m_"+name,operands)
            result_type = "i64" if self.program.signatures.pool.types[target].kind == "Bool" else self.type(target)
            command = "call "+result_type+" @wd_m_"+name+"("+join(["ptr %ctx"]+operands,", ")+")"
            value = ""
            if result_type == "void":
                self.line(command)
            else:
                value = self.instruction(command)
            self.propagate()
            if self.program.signatures.pool.types[target].kind == "Bool":
                value = self.instruction("icmp ne i64 "+value+", 0")
            return self.hold(Value(target,value),true)
        if name == "array_full":
            floating = self.program.signatures.pool.types[self.program.signatures.pool.types[target].element].kind == "Float"
            result = self.instruction("call ptr @wd_m_array_full(ptr %ctx, "+self.integer_span(arguments[0])+", ptr "+self.spill(arguments[1])+", i64 "+("1" if floating else "0")+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "array_from_list":
            floating = self.program.signatures.pool.types[self.program.signatures.pool.types[target].element].kind == "Float"
            result = self.instruction("call ptr @wd_m_array_from_list(ptr %ctx, ptr "+arguments[0].text+", i64 "+("1" if floating else "0")+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name in ["array_rank","array_contiguous"]:
            result = self.instruction("call i64 @wd_m_"+name+"(ptr "+arguments[0].text+")")
            return Value(target,self.instruction("icmp ne i64 "+result+", 0") if name == "array_contiguous" else result)
        if name in ["array_sum","array_dot"]:
            type = self.type(target)
            result = self.instruction("call "+type+" @wd_m_array_reduce_"+("f" if type == "double" else "i")+"(ptr %ctx, ptr "+arguments[0].text+", ptr "+(arguments[1].text if name == "array_dot" else "null")+")")
            self.propagate()
            return Value(target,result)
        if name in ["array_shape","array_copy","array_to_list","array_reshape","array_transpose","array_slice","array_matmul","array_affine","array_floats","array_integers"]:
            operands = "ptr %ctx, ptr "+arguments[0].text
            helper = name
            if name == "array_reshape":
                operands += ", "+self.integer_span(arguments[1])
            elif name == "array_slice":
                operands += ", "+join(["i64 "+item.text for item in arguments[1:]],", ")+", i64 1, i64 1"
            elif name in ["array_transpose","array_matmul","array_affine"]:
                operands += ", ptr "+arguments[1].text
            elif name in ["array_floats","array_integers"]:
                helper = "array_convert"
                operands += ", i64 "+("1" if name == "array_floats" else "0")
            result = self.instruction("call ptr @wd_m_"+helper+"("+operands+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name in ["math_sin","math_cos"]:
            self.site(module,token)
            value = self.convert(arguments[0],self.kind_id("Float"))
            result = self.instruction("call double @wd_m_"+name+"(ptr %ctx, double "+value.text+")")
            self.propagate()
            return Value(target,result)
        if name in ["math_finite","math_sqrt"]:
            value = arguments[0].text
            bits = self.instruction("bitcast double "+value+" to i64")
            exponent = self.instruction("and i64 "+bits+", 9218868437227405312")
            finite = self.instruction("icmp ne i64 "+exponent+", 9218868437227405312")
            if name == "math_finite":
                return Value(target,finite)
            bad = self.instruction("xor i1 "+finite+", true")
            negative = self.instruction("fcmp olt double "+value+", 0.0")
            self.guard(self.instruction("or i1 "+bad+", "+negative),module,token,"R4027","sqrt requires a finite nonnegative value")
            return Value(target,self.instruction("call double @llvm.sqrt.f64(double "+value+")"))
        if name == "iter":
            return self.make_cursor(arguments[0],target)
        if name == "finished":
            return Value(target,"zeroinitializer")
        if name == "yielded":
            value = self.convert(arguments[0],self.program.signatures.pool.types[target].element)
            aggregate = self.instruction("insertvalue "+self.type(target)+" zeroinitializer, i1 true, 0")
            return Value(target,self.instruction("insertvalue "+self.type(target)+" "+aggregate+", "+self.type(value.type)+" "+value.text+", 1"))
        if name in ["has_item","step_value"]:
            value = arguments[0]
            present = self.instruction("extractvalue "+self.type(value.type)+" "+value.text+", 0")
            if name == "has_item":
                return Value(target,present)
            self.guard(self.instruction("xor i1 "+present+", true"),module,token,"R4024","cannot read an exhausted iterator step")
            return Value(target,self.instruction("extractvalue "+self.type(value.type)+" "+value.text+", 1"))
        if name == "args":
            result = self.instruction("call ptr @wd_m_args(ptr %ctx)")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "task_spawn":
            self.site(module,token)
            result = self.instruction("call ptr @wd_m_task_spawn(ptr %ctx, ptr "+arguments[0].text+", ptr "+arguments[1].text+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "task_spawn_io":
            self.system_libraries = true
            self.site(module,token)
            file = self.spill(Value(self.kind_id("Str"),self.string(self.program.signatures.compilation.modules[module].file)))
            result = self.instruction("call ptr @wd_m_task_spawn_io(ptr %ctx, ptr "+arguments[0].text+", ptr "+arguments[1].text+", ptr "+arguments[2].text+", ptr "+file+", i64 "+str(token.line)+", i64 "+str(token.column)+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "task_wait":
            self.site(module,token)
            result = self.instruction("call ptr @wd_m_task_wait(ptr %ctx, ptr "+arguments[0].text+", i64 "+arguments[1].text+")")
            self.propagate()
            return self.hold(Value(target,result),true)
        if name == "task_checkpoint":
            self.site(module,token)
            self.line("call void @wd_m_task_checkpoint(ptr %ctx)")
            self.propagate()
            return Value(target,"")
        if name == "random_bytes":
            self.site(module,token)
            return self.runtime_value(target,"wd_m_random_bytes",["i64 "+arguments[0].text])
        if name in ["task_done","task_cancel","task_close","task_cancelled"]:
            self.site(module,token)
            if name == "task_close":
                self.line("call void @wd_m_task_close(ptr "+arguments[0].text+")")
                return Value(target,"")
            if name == "task_cancel":
                self.line("call void @wd_m_task_cancel(ptr %ctx, ptr "+arguments[0].text+")")
                self.propagate()
                return Value(target,"")
            result = self.instruction("call i64 @wd_m_"+name+"("+("" if name == "task_cancelled" else "ptr %ctx, ptr "+arguments[0].text)+")")
            self.propagate()
            return Value(target,self.instruction("icmp ne i64 "+result+", 0"))
        if name in ["eof","time_monotonic","time_monotonic_ns"]:
            self.site(module,token)
            function = "wd_m_eof" if name == "eof" else "wd_m_time_ns" if name == "time_monotonic_ns" else "wd_m_time_seconds"
            value = self.instruction("call "+("double" if name == "time_monotonic" else "i64")+" @"+function+"(ptr %ctx)")
            self.propagate()
            return Value(target,self.instruction("icmp ne i64 "+value+", 0") if name == "eof" else value)
        if name == "read_line":
            return self.runtime_value(target,"wd_m_read_line",[])
        if name == "time_sleep":
            duration = self.convert(arguments[0],self.kind_id("Float"))
            self.site(module,token)
            self.line("call void @wd_m_time_sleep(ptr %ctx, double "+duration.text+")")
            self.propagate()
            return Value(target,"")
        if name in ["fs_size","fs_mkdirs","fs_remove"]:
            self.site(module,token)
            result = self.instruction("call i64 @wd_m_"+name+"(ptr %ctx, ptr "+self.spill(arguments[0])+")")
            self.propagate()
            if name != "fs_size":
                result = self.instruction("icmp ne i64 "+result+", 0")
            return Value(target,result)
        if name == "env_get":
            self.site(module,token)
            string = self.program.signatures.pool.intern("Str")
            out = self.owned_slot(string)
            found = self.instruction("call i64 @wd_m_env_get(ptr %ctx, ptr "+out+", ptr "+self.spill(arguments[0])+")")
            self.propagate()
            present = self.instruction("icmp ne i64 "+found+", 0")
            result = self.instruction("insertvalue "+self.type(target)+" zeroinitializer, i1 "+present+", 0")
            text = self.instruction("load %wd.str, ptr "+out)
            return Value(target,self.instruction("insertvalue "+self.type(target)+" "+result+", %wd.str "+text+", 1"))
        if name == "read_text":
            self.site(module,token)
            out = self.owned_slot(target)
            self.line("call void @wd_m_read_text(ptr %ctx, ptr "+out+", ptr "+self.spill(arguments[0])+")")
            self.propagate()
            return Value(target,self.instruction("load %wd.str, ptr "+out))
        if name == "write_text":
            self.line("call void @wd_m_write_text(ptr %ctx, ptr "+self.spill(arguments[0])+", ptr "+self.spill(arguments[1])+")")
            self.propagate()
            return Value(target,"")
        if name in ["path_join","path_name","path_parent","path_normalize","path_absolute","path_resolve","path_identity","fs_kind"]:
            operands = ["ptr "+self.spill(arguments[0])]
            if name == "path_join":
                append(operands,"ptr "+self.spill(arguments[1]))
            if name == "path_resolve":
                append(operands,"i64 "+self.instruction("zext i1 "+arguments[1].text+" to i64"))
            return self.runtime_value(target,"wd_m_"+name,operands)
        if name in ["path_is_absolute","path_exists","path_within","fs_list"]:
            operands = ["ptr %ctx","ptr "+self.spill(arguments[0])]
            if name == "path_within":
                append(operands,"ptr "+self.spill(arguments[1]))
            if name == "fs_list":
                append(operands,"i64 "+arguments[1].text)
