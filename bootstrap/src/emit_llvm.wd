            if kind == "List":
                return Value(target,self.instruction("call i64 @wd_m_seq_len(ptr "+arguments[0].text+")"))
            if kind == "Array":
                return Value(target,self.instruction("call i64 @wd_m_array_len(ptr "+arguments[0].text+")"))
            if kind == "Dict":
                return Value(target,self.instruction("call i64 @wd_m_map_len(ptr "+arguments[0].text+")"))
            if kind == "Tuple":
                return Value(target,str(len(self.program.signatures.pool.types[arguments[0].type].parameters)))
        if name == "get":
            index = self.instruction("call i64 @wd_m_map_find(ptr "+arguments[0].text+", ptr "+self.spill(arguments[1])+")")
            found = self.instruction("icmp sge i64 "+index+", 0")
            output = self.owned_slot(target)
            yes = self.label()
            no = self.label()
            end = self.label()
            self.branch(found,yes,no)
            self.open(yes)
            pointer = self.instruction("call ptr @wd_m_map_entry(ptr "+arguments[0].text+", i64 "+index+", i64 1)")
            value = Value(target,self.instruction("load "+self.type(target)+", ptr "+pointer))
            self.store(value,output)
            self.jump(end)
            self.open(no)
            self.store(self.convert(arguments[2],target),output)
            self.jump(end)
            self.open(end)
            return Value(target,self.instruction("load "+self.type(target)+", ptr "+output))
        if name in ["keys","values"]:
            node = self.program.signatures.pool.types[target]
            size = self.instruction("call i64 @wd_m_map_len(ptr "+arguments[0].text+")")
            owner = self.instruction("call ptr @wd_m_seq_new(ptr %ctx, i64 "+self.stride(node.element)+", i64 "+size+", i64 "+size+", "+self.callbacks(node.element)+")")
            self.propagate()
            result = self.hold(Value(target,owner),true)
            position = self.temporary("i64")
