import lexer as lx

fn check_error(source: str, code: str, offset: int, line: int, column: int):
    result = lx.lex(source)
    assert(result.code == code)
    assert(len(result.tokens) == 0)
    assert(result.offset == offset and result.line == line and result.column == column)

empty = lx.lex("")
assert(empty.code == "" and len(empty.tokens) == 1)
assert(empty.tokens[0] == lx.Token("Eof","",0,1,1))
source = "fn twice(x: int):\r\n  # comment\r\n  return x * 2"
result = lx.lex(source)
assert(result.code == "" and result.offset == len(source))
assert(result.tokens[0] == lx.Token("Fn","fn",0,1,1))
assert(result.tokens[1] == lx.Token("Identifier","twice",3,1,4))
assert(result.tokens[8].kind == "Newline")
assert(result.tokens[9].kind == "Indent" and result.tokens[9].line == 3)
assert(result.tokens[-2].kind == "Dedent" and result.tokens[-1].kind == "Eof")
saved = result.tokens
append(result.tokens,lx.Token("Identifier","changed",0,1,1))
assert(saved[-1].kind == "Eof")

strings = lx.lex("'a\\n\\0\\t\\r\\\\\\\"\\\''")
assert(strings.code == "")
assert(strings.tokens[0].text == "a\n\0\t\r\\\"'")
raw = "'" + byte_string(255) + "'"
assert(lx.lex(raw).tokens[0].text == byte_string(255))
utf8 = lx.lex("'á🌳' name")
assert(utf8.tokens[1].offset == 9 and utf8.tokens[1].column == 10)
bom = lx.lex(byte_string(239)+byte_string(187)+byte_string(191)+"x")
assert(bom.tokens[0] == lx.Token("Identifier","x",3,1,1))
assert(lx.lex("record def True False None self").tokens[0].kind == "Identifier")
assert(lx.lex("x=(\n # inside\n  1\n)\n").code == "")
for op in ["+=","-=","*=","/=","%=","&=","|=","^=","<<=",">>=","//="]:
    operation = lx.lex(op)
    assert(operation.code == "" and operation.offset == len(op))
    assert(operation.tokens[0].kind == "Augment" and operation.tokens[0].text == op[:-1])

check_error("\t", "E1001",0,1,1)
check_error("a\n  b\n c", "E1002",7,3,2)
check_error("1.", "E1003",2,1,3)
check_error("2e+", "E1003",3,1,4)
check_error("2word", "E1003",1,1,2)
check_error("'abc", "E1004",0,1,1)
check_error("'\\q'", "E1005",2,1,3)
check_error("'"+byte_string(0)+"'", "E1005",1,1,2)
check_error("([)]", "E1006",2,1,3)
check_error("(\n [", "E1006",3,2,2)
check_error("@", "E1007",0,1,1)
check_error("python@x", "E1007",6,1,7)
check_error("import ordinary@x", "E1007",15,1,16)
provider = lx.lex("import python@math as m\n")
assert(provider.code == "" and len(provider.tokens) == 8)
assert(provider.tokens[2] == lx.Token("At","@",13,1,14))
assert(provider.tokens[3] == lx.Token("Identifier","math",14,1,15))
assert(lx.lex("("*256+")"*256).code == "")
check_error("["*257, "E1006",256,1,257)

assert(lx.lex("abc",max_bytes=2).code == "B1001")
assert(lx.lex("",max_bytes=-1).code == "B1001")
assert(lx.lex("",max_tokens=0).code == "B1001")
assert(lx.lex("",max_tokens=1048577).code == "B1001")
assert(lx.lex("",max_bytes=0,max_tokens=1).code == "")
assert(lx.lex("x",max_tokens=3).code == "")
limited = lx.lex("x",max_tokens=2)
assert(limited.code == "B1002" and len(limited.tokens) == 0)
assert(limited.offset == 1 and limited.column == 2)
assert(lx.lex("x y",max_tokens=1).code == "B1002")
large = "#" + "x" * 65535
assert(lx.lex(large,max_bytes=65536,max_tokens=1).offset == 65536)
assert(lx.lex(large,max_bytes=65535).code == "B1001")
print("bootstrap lexer unit checks passed")
